  "semantics": {
    "identity_rule": "Every machine-significant AccessCore policy has an explicit stable identity.",
    "scope_rule": "Policy scope identifies the governed instance/resource namespace or explicit target set.",
    "owner_rule": "Policy ownership is explicit and separate from the identities governed by the policy.",
    "ui_rule": "Editor nesting or page location does not define policy identity/scope.",
    "state_rule": "Policy definition is declarative; evaluation decisions are runtime results.",
    "version_rule": "Machine-significant policy change creates explicit version/change evidence according to canonical change rules."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCESSCORE_AUTHORITY_EXPLICIT",
        "rule": "AccessCore decisions are explicit policy evaluations over identity, resource and operation context; authentication assurance, visibility and ownership never silently become authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "policy identity inferred only from file/UI path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "policy scope implicit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "policy definition conflated with runtime allow/deny state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "governed identity assumed to own governing policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "policy change lacks traceable change evidence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_AUTH",
      "target_ref": "AIGMOS_ACCESSCORE_AUTHORIZATION_CONTRACT",
      "purpose": "Policy identities feed AccessCore authorization."
    }
  ],
  "prose": {
    "summary": "Define AccessCore policy objects as explicit stable canonical identities with scope, resource targets and rule ownership separate from UI configuration and runtime decision state.",
    "notes": [
      "Unlocked pending reconciliation against existing AccessCore/IAM contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
