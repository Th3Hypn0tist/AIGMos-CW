    "id": "AIGMOS_ACCESSCORE_RIGHTS_EVALUATION_CONTRACT",
    "name": "AccessCore Rights Evaluation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define deterministic allow/deny evaluation from caller identity, group memberships, resource/operation target, assurance requirements and explicit policy rules.",
  "scope": {
    "owns": [
      "AccessCore Rights Evaluation semantics"
    ],
    "does_not_own": [
      "IAM identity proofing",
      "domain data semantics",
      "presentation-only access hints"
    ]
  },
  "members": [
    {
      "id": "TOPIC_ACCESSCORE_RIGHTS_EVALUATION",
      "name": "AccessCore Rights Evaluation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define deterministic allow/deny evaluation from caller identity, group memberships, resource/operation target, assurance requirements and explicit policy rules.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "inputs": [
      "identity_ref",
      "group_refs",
      "resource_ref",
      "operation",
      "current_assurance",
      "policy_context"
    ],
    "result": [
      "allow",
      "deny",
      "reauth_required"
    ],
    "default_rule": "Missing explicit permission fails closed unless an owning policy explicitly defines another safe default.",
    "assurance_rule": "Insufficient assurance produces reauth_required/deny according to resource policy; assurance never grants rights itself.",
    "group_rule": "Group rights contribute only through explicit membership/policy.",
    "conflict_rule": "Conflicting rules resolve through explicit precedence semantics rather than file/order heuristics.",
    "decision_rule": "Decision retains policy/rule provenance.",
    "ui_rule": "UI enable/disable state is a projection of the decision, not the enforcement mechanism."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCESSCORE_AUTHORITY_EXPLICIT",
        "rule": "AccessCore decisions are explicit policy evaluations over identity, resource and operation context; authentication assurance, visibility and ownership never silently become authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "missing permission defaults to allow without explicit policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "assurance treated as permission",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "decision precedence inferred from file/array order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "decision lacks policy provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "UI state used as sole enforcement",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ASSURE",
      "target_ref": "AIGMOS_IAM_ASSURANCE_LIFECYCLE_CONTRACT",
      "purpose": "Assurance is an evaluation input, not authorization."
    }
  ],
  "prose": {
    "summary": "Define deterministic allow/deny evaluation from caller identity, group memberships, resource/operation target, assurance requirements and explicit policy rules.",
    "notes": [
      "Unlocked pending reconciliation against existing AccessCore/IAM contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
