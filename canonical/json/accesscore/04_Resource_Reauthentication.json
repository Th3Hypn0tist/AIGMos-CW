  "semantics": {
    "resource_rule": "Resource/operation may declare required assurance independently from its authorization rule.",
    "methods_rule": "Allowed reauthentication methods are explicit per resource/policy.",
    "lifetime_rule": "Successful reauth produces a resource/session assurance elevation with explicit lifetime.",
    "rotation_rule": "Successful reauth may rotate applicable keys/credentials when the owning policy declares it.",
    "failure_rule": "Failed/expired reauth leaves the protected operation denied.",
    "identity_rule": "Reauthentication preserves semantic identity.",
    "scope_rule": "Reauth elevation applies only to its declared session/resource scope and cannot silently elevate unrelated resources."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCESSCORE_AUTHORITY_EXPLICIT",
        "rule": "AccessCore decisions are explicit policy evaluations over identity, resource and operation context; authentication assurance, visibility and ownership never silently become authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "reauth grants unrelated rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "resource requirement inferred from UI",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "reauth validity unbounded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "failed reauth still allows operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "reauth changes semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "resource-scoped elevation silently becomes global",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ASSURE",
      "target_ref": "AIGMOS_IAM_ASSURANCE_LIFECYCLE_CONTRACT",
      "purpose": "Reauth changes current assurance state."
    },
    {
      "id": "REF_ROT",
      "target_ref": "AIGMOS_IAM_CREDENTIAL_ROTATION_CONTRACT",
      "purpose": "Policy may explicitly rotate credentials/keys."
    }
  ],
  "prose": {
    "summary": "Define per-resource reauthentication requirements with minimum assurance, allowed authentication methods, bounded validity and optional key rotation.",
