  "semantics": {
    "config_key": "AC",
    "config_rule": "Instance configuration explicitly declares whether AccessCore is enabled.",
    "definition_rule": "AC-enabled configuration is canonical/config state, not itself an authenticated runtime session.",
    "activation_rule": "A runtime using AC-enabled config activates AccessCore through explicit reload/start semantics.",
    "disable_rule": "Changing AC-enabled configuration is a governed configuration change.",
    "runtime_rule": "When AccessCore is already active, an ungoverned runtime command cannot disable it.",
    "identity_rule": "AC configuration does not define caller identity.",
    "authority_rule": "Config visibility does not grant policy-admin authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCESSCORE_ACTIVATION_GOVERNED",
        "rule": "AccessCore activation, login, assurance and runtime protection are explicit lifecycle semantics; once active, AccessCore cannot be silently bypassed or disabled by an ungoverned runtime/config mutation."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "AC enabled state inferred from login session only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "active AC disabled by ungoverned runtime mutation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "config visibility grants admin authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "AC flag treated as caller identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "AC enabled configuration silently bypassed",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_INST",
      "target_ref": "AIGMOS_INSTANCE_CONFIG_OWNERSHIP_CONTRACT",
      "purpose": "AC enablement is an explicit instance configuration binding."
    }
  ],
  "prose": {
    "summary": "Define the instance configuration flag controlling whether AccessCore is enabled for the instance, while keeping configuration state separate from current runtime login/session state.",
    "notes": [
      "Unlocked pending reconciliation against existing AccessCore/IAM/runtime activation contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
