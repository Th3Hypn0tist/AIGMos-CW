  "semantics": {
    "command": "reload ac",
    "reload_rule": "Command reloads AccessCore configuration/policy through normal runtime reload semantics.",
    "login_rule": "If no valid authenticated context satisfies AccessCore/IAM requirements, the transition invokes the applicable login/authentication flow.",
    "session_rule": "Successful login binds the runtime session to an exact identity and assurance level.",
    "failure_rule": "Failed/cancelled login leaves governed resources denied and does not disable AccessCore.",
    "policy_rule": "Reloading AC does not grant rights beyond the loaded AccessCore policy.",
    "authority_rule": "The command itself requires the applicable lifecycle/config authority.",
    "trace_rule": "Result records policy/config version, identity/session outcome and activation state."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCESSCORE_ACTIVATION_GOVERNED",
        "rule": "AccessCore activation, login, assurance and runtime protection are explicit lifecycle semantics; once active, AccessCore cannot be silently bypassed or disabled by an ungoverned runtime/config mutation."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "reload ac grants rights without policy evaluation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "failed login disables AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "login identity unresolved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reload ac bypasses runtime reload validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "command usable as universal admin bypass",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
