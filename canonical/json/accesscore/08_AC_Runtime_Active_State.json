    "id": "AIGMOS_ACCESSCORE_RUNTIME_ACTIVE_STATE_CONTRACT",
    "name": "AccessCore Runtime Active State",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define AccessCore runtime active state separately from configured enablement and current caller authentication, including protection against accidental or unauthorized deactivation.",
  "scope": {
    "owns": [
      "AccessCore Runtime Active State semantics"
    ],
    "does_not_own": [
      "IdentityCore identity semantics",
      "commercial licensing",
      "domain business semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_ACCESSCORE_RUNTIME_ACTIVE_STATE",
      "name": "AccessCore Runtime Active State",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define AccessCore runtime active state separately from configured enablement and current caller authentication, including protection against accidental or unauthorized deactivation.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "states": [
      "configured_disabled",
      "configured_enabled_inactive",
      "active_unauthenticated",
      "active_authenticated",
      "reload_required",
      "error_protected"
    ],
    "active_rule": "When active, AccessCore enforcement remains in the runtime request/operation path.",
    "auth_rule": "Active AccessCore may exist with no currently authenticated caller; this results in denied/login-required governed access rather than disabled enforcement.",
    "disable_rule": "Active AccessCore cannot be disabled by ordinary ungoverned runtime mutation.",
    "change_rule": "Disabling/removing AC requires an explicit authorized configuration/change workflow and subsequent lifecycle transition.",
    "failure_rule": "Policy/auth subsystem failure fails protected/closed rather than silently falling back to AC-off behavior.",
    "visibility_rule": "Runtime state is observable separately from instance config flag.",
    "authority_rule": "AC runtime state never substitutes for the caller's rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCESSCORE_ACTIVATION_GOVERNED",
        "rule": "AccessCore activation, login, assurance and runtime protection are explicit lifecycle semantics; once active, AccessCore cannot be silently bypassed or disabled by an ungoverned runtime/config mutation."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "authentication failure treated as AC disabled",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "policy error falls back open",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "ordinary runtime command disables active AC",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "configured flag and runtime active state conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "active state grants caller rights",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_FLAG",
      "target_ref": "AIGMOS_ACCESSCORE_CONFIG_FLAG_CONTRACT",
      "purpose": "Runtime state remains distinct from config state."
    }
  ],
  "prose": {
    "summary": "Define AccessCore runtime active state separately from configured enablement and current caller authentication, including protection against accidental or unauthorized deactivation.",
    "notes": [
      "Unlocked pending reconciliation against existing AccessCore/IAM/runtime activation contracts and whole-tree Contract Format 1.4 validation."
