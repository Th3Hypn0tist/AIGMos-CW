  "semantics": {
    "origin_rule": "Remote request carries exact origin identity/session/assurance provenance according to protocol policy.",
    "remote_rule": "Remote target evaluates its own AccessCore authorization policy.",
    "nonexpansion_rule": "Delegated remote path cannot expand rights beyond explicit delegation.",
    "local_rule": "A local owner may hold broader local rights where local policy permits; this does not imply those rights remotely.",
    "dwh_rule": "With AccessCore active, governed DWH remote access uses the DWH remote path rather than direct `$EXT` dereference.",
    "assurance_rule": "Remote target may impose its own minimum assurance requirement.",
    "transport_rule": "Secure transport/peer reachability does not grant remote authorization.",
    "trace_rule": "Remote decision retains origin identity plus remote policy/rule evidence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCESSCORE_ACTIVATION_GOVERNED",
        "rule": "AccessCore activation, login, assurance and runtime protection are explicit lifecycle semantics; once active, AccessCore cannot be silently bypassed or disabled by an ungoverned runtime/config mutation."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "origin local rights copied wholesale to remote target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "secure transport treated as remote authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "direct $EXT bypasses governed DWH path under AC",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "remote target skips its own policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "delegated remote rights expand silently",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DWH",
