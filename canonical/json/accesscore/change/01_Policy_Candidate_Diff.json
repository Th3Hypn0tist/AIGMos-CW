  "semantics": {
    "candidate_rule": "Policy edit produces a candidate identity.",
    "base_rule": "Candidate references exact accepted base revision.",
    "diff_rule": "Semantic diff identifies changed subjects, rights, resources, conditions and precedence.",
    "impact_rule": "Potential authority expansion/reduction is explicit evidence.",
    "model_rule": "AI-generated policy edits remain inert candidates.",
    "validation_rule": "Candidate must validate before apply.",
    "authority_rule": "Creating/editing candidate does not grant policy-apply authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_AUTHORITY_SEPARATION",
        "rule": "Identity, authentication assurance, authorization policy, authorization decision, delegation and runtime execution remain separate machine-significant identities/evidence; no one layer silently substitutes for another."
      },
      {
        "id": "FAIL_CLOSED_AUTHORITY",
        "rule": "Ambiguous, missing, stale or unverifiable authority for a protected effect fails closed rather than inheriting trust from locality, transport reachability, process ownership, UI visibility or previous success."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "editing live policy directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "AI suggestion auto-applies",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "authority expansion hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "base revision omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "candidate grants rights before apply",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REV",
      "target_ref": "AIGMOS_ACCESS_POLICY_REVISION_CONTRACT",
      "purpose": "Candidate compares against exact accepted revision."
    }
  ],
  "prose": {
    "summary": "Define policy edits as inert candidates with exact base revision and semantic authorization-impact diff before apply.",
