    "identity_rule": "Audit records have explicit evidence identities.",
    "actor_rule": "Actor/request/session refs are explicit.",
    "target_rule": "Exact policy/delegation/membership/resource refs are explicit.",
    "revision_rule": "Before/after revision refs are explicit where applicable.",
    "secret_rule": "Authentication/secret material is redacted.",
    "immutability_rule": "Audit history is append/history governed.",
    "authority_rule": "Audit record never grants authority."
