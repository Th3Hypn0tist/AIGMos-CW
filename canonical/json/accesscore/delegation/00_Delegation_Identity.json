    "identity_rule": "Each delegation grant has an explicit identity.",
    "delegator_rule": "Delegator identity/authority source is explicit.",
    "delegatee_rule": "Delegatee identity is explicit.",
    "right_rule": "Delegated rights/operations are exact.",
