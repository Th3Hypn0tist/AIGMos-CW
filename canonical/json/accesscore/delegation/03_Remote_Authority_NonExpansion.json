    "remote_rule": "Remote request authority is evaluated from exact remote identity/delegation/target-side policy.",
    "local_rule": "Local owner/admin rights are not copied into remote caller context.",
    "peer_rule": "Peer registration/reachability is not authority.",
    "transport_rule": "TLS/PGP/WebRTC identity/reachability does not substitute for AccessCore delegation.",
    "resource_rule": "Target-side resource scope remains exact.",
    "reauth_rule": "Target may require assurance independently from delegation.",
    "failure_rule": "Missing/expired/revoked delegation denies remote effect."
  },
