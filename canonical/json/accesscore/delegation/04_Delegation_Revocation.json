  "semantics": {
    "target_rule": "Revocation targets exact delegation identity or declared grant set.",
    "authority_rule": "Revocation requires exact applicable authority.",
    "dependent_rule": "Dependent child delegations invalidate according to chain semantics.",
    "cache_rule": "Relevant authorization caches/leases are invalidated or bounded explicitly.",
    "session_rule": "Revocation does not necessarily revoke authentication sessions unless declared separately.",
    "history_rule": "Past accepted decisions/executions remain audit-visible.",
    "propagation_rule": "Distributed revocation propagation state is explicit.",
    "failure_rule": "Partially propagated revocation cannot be reported globally complete."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_AUTHORITY_SEPARATION",
        "rule": "Identity, authentication assurance, authorization policy, authorization decision, delegation and runtime execution remain separate machine-significant identities/evidence; no one layer silently substitutes for another."
      },
      {
        "id": "FAIL_CLOSED_AUTHORITY",
        "rule": "Ambiguous, missing, stale or unverifiable authority for a protected effect fails closed rather than inheriting trust from locality, transport reachability, process ownership, UI visibility or previous success."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "revocation deletes audit history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "revoking delegation logs user out implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "child grant survives without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "cache keeps revoked authority indefinitely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "partial propagation hidden",
        "result": "hard_fail"
      }
    ]
  },
