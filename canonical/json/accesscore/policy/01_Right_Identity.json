  "semantics": {
    "identity_rule": "Each reusable right/permission has an explicit identity.",
    "operation_rule": "Right maps to exact operations/command scopes or declared action classes.",
    "readwrite_rule": "Read/write/mutate/admin/destructive distinctions are explicit rather than implied by naming.",
    "assignment_rule": "Defining a right does not assign it to anyone.",
    "resource_rule": "Resource applicability is explicit.",
    "composition_rule": "Composite rights expand only through explicit member refs.",
    "authority_rule": "Right visibility does not grant the right."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_AUTHORITY_SEPARATION",
        "rule": "Identity, authentication assurance, authorization policy, authorization decision, delegation and runtime execution remain separate machine-significant identities/evidence; no one layer silently substitutes for another."
      },
      {
        "id": "FAIL_CLOSED_AUTHORITY",
        "rule": "Ambiguous, missing, stale or unverifiable authority for a protected effect fails closed rather than inheriting trust from locality, transport reachability, process ownership, UI visibility or previous success."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "right name implies hidden operations",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "right definition auto-assigned",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "admin string grants all unknown future commands",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "resource scope omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "nested right inferred by prefix",
        "result": "hard_fail"
      }
    ]
  },
