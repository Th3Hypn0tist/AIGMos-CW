        "id": "FAIL_CLOSED_AUTHORITY",
        "rule": "Ambiguous, missing, stale or unverifiable authority for a protected effect fails closed rather than inheriting trust from locality, transport reachability, process ownership, UI visibility or previous success."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "challenge executes operation before satisfaction",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "challenge reused for different target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "expired challenge accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "raw password stored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "successful challenge bypasses authorization refresh",
        "result": "hard_fail"
      }
    ]
  },
