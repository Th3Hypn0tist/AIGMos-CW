  "semantics": {
    "evidence_rule": "Successful reauth produces explicit evidence linked to auth attempt/session/challenge.",
    "scope_rule": "Reuse scope is explicit: resource, operation/right, assurance level and session/identity.",
    "lifetime_rule": "Validity start/end are explicit.",
    "rotation_rule": "Where configured, successful reauth may rotate session/auth keys through explicit IAM lifecycle semantics.",
    "expiry_rule": "Expired evidence cannot satisfy new requests.",
    "nonexpansion_rule": "Evidence for one scope cannot broaden to unrelated sensitive resources.",
    "revocation_rule": "Session/identity/relevant-factor revocation invalidates dependent evidence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_AUTHORITY_SEPARATION",
        "rule": "Identity, authentication assurance, authorization policy, authorization decision, delegation and runtime execution remain separate machine-significant identities/evidence; no one layer silently substitutes for another."
      },
      {
        "id": "FAIL_CLOSED_AUTHORITY",
        "rule": "Ambiguous, missing, stale or unverifiable authority for a protected effect fails closed rather than inheriting trust from locality, transport reachability, process ownership, UI visibility or previous success."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "one reauth unlocks all resources",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "reauth lasts forever",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "expired evidence accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "evidence grants new rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "revoked session evidence remains valid",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
