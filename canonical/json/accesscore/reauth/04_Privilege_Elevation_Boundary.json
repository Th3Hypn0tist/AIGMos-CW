    "identity_rule": "Temporary elevation, if supported, has an explicit grant/evidence identity.",
    "source_rule": "Elevation source policy/approver/delegation is explicit.",
    "scope_rule": "Elevated rights/resources/operations are exact.",
    "assurance_rule": "Higher assurance may be prerequisite but never sole source of elevated rights.",
    "lifetime_rule": "Elevation lifetime is explicit and bounded.",
    "revocation_rule": "Elevation can be revoked independently from session authentication.",
    "nonexpansion_rule": "Elevation cannot exceed its exact authorized grant.",
    "audit_rule": "Elevation creation/use/revocation is audited."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_AUTHORITY_SEPARATION",
        "rule": "Identity, authentication assurance, authorization policy, authorization decision, delegation and runtime execution remain separate machine-significant identities/evidence; no one layer silently substitutes for another."
      },
      {
        "id": "FAIL_CLOSED_AUTHORITY",
        "rule": "Ambiguous, missing, stale or unverifiable authority for a protected effect fails closed rather than inheriting trust from locality, transport reachability, process ownership, UI visibility or previous success."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "strong auth automatically becomes admin",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "elevation hidden in session flag without identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "elevation unlimited lifetime",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "elevation expands beyond grant",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "logout required as only revocation mechanism",
        "result": "hard_fail"
      }
    ]
