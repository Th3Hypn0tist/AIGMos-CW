  "semantics": {
    "identity_rule": "Each backend/provider has an explicit identity.",
    "examples": [
      "dummyLLM",
      "doubleword",
      "nvidia",
      "other declared backend"
    ],
    "model_rule": "Backend may expose one or more exact model identities/profiles.",
    "binding_rule": "Endpoint/process/device/config bindings are explicit.",
    "capability_rule": "Context length/modalities/tool support are explicit validated capabilities.",
    "target_rule": "Backend identity never determines q/qc target by implication.",
    "authority_rule": "Backend availability grants no operation/data authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "backend name used as q target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "available backend trusted as authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "model identity conflated with endpoint",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "capability guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "provider controls AccessCore",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_QB",
      "target_ref": "AIGMOS_Q_BACKEND_BINDING_CONTRACT",
      "purpose": "q uses exact backend binding."
    }
  ],
  "prose": {
    "summary": "Define each q-family model/backend provider as an explicit identity/binding separate from model identity, command identity and target resource.",
