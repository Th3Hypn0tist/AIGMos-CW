  "semantics": {
    "identity_rule": "Each machine-significant output has an explicit output/result identity.",
    "request_rule": "Output references exact inference request.",
    "model_rule": "Model/backend/profile refs are exact.",
    "content_rule": "Text/code/structured/tool-call proposal remains inert output.",
    "confidence_rule": "Model self-confidence is descriptive and not verification evidence.",
    "canonical_rule": "Generated content does not become canonical data/config/code merely by generation.",
    "authority_rule": "Output cannot execute operations or grant rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "generated JSON auto-applies",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "model code auto-runs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "confidence treated validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "output becomes canonical contract immediately",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "text command executes",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_BOUND",
      "target_ref": "AIGMOS_MODEL_OUTPUT_OPERATION_BOUNDARY_CONTRACT",
      "purpose": "Output must cross explicit effect boundary."
