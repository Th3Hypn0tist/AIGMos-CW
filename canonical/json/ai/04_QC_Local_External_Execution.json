  "semantics": {
    "mode_values": [
      "local",
      "external"
    ],
    "mode_rule": "QC mode is explicit per request/session/profile.",
    "target_rule": "Exact source/code/project target is explicit.",
    "external_rule": "External mode uses exact external endpoint/repository/target binding and applicable remote authority.",
    "local_rule": "Local mode cannot silently dereference remote targets.",
    "write_rule": "QC analysis/result remains inert; code/file changes use explicit candidate diff→validate→authorize→apply.",
    "secret_rule": "External requests minimize/redact local secrets/context.",
    "authority_rule": "Mode selection grants no extra source/write rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "external QC chosen automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "local secrets sent externally",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "QC output edits file immediately",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "external endpoint gains repo rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "target inferred from current editor tab",
        "result": "hard_fail"
      }
    ]
  },
