  "topics": [
    {
      "id": "TOPIC_ARCHITECTURE_COMPOSITION",
      "name": "Architecture Composition",
      "purpose": "Define validation for Universal Module, Domain, Meta and Relation compositions so composed semantics remain traceable, non-duplicated and ownership-consistent.",
      "parent_topic_refs": [
        "TOPIC_CORE"
      ],
      "composed_topic_refs": [
        "TOPIC_DOMAIN_COMPOSITION",
        "TOPIC_UNIVERSAL_MODULE",
        "TOPIC_META",
        "TOPIC_MASTER_RELATION",
        "TOPIC_CORE_VALIDATION"
      ],
      "member_refs": [
        "AIGMOS_ARCHITECTURE_COMPOSITION_VALIDATION_CONTRACT",
        "ARCHITECTURE_COMPOSITION_EXPLICIT",
        "GATE_1",
        "GATE_2",
        "GATE_3",
        "GATE_4",
        "GATE_5",
        "GATE_6"
      ],
      "relation_refs": [],
      "operation_refs": [
        "OP_COMPOSITION_RESOLVE",
        "OP_COMPOSITION_VALIDATE"
      ],
      "event_refs": [],
      "flow_refs": [],
      "child_topics": [],
      "metadata": {}
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_COMPOSITION_RESOLVE",
        "name": "Resolve architecture composition",
        "inputs": [
          "Domain/Meta definition",
          "substrate refs",
          "relation refs"
        ],
        "outputs": [
          "resolved composition graph"
        ],
        "errors": [
          "component unresolved",
          "relation unresolved"
        ],
        "side_effects": []
      },
      {
        "id": "OP_COMPOSITION_VALIDATE",
        "name": "Validate architecture composition",
        "inputs": [
          "resolved graph"
        ],
        "outputs": [
          "valid composition | gap/conflict report"
        ],
        "errors": [
          "ownership overlap",
          "semantic duplication",
          "missing relation",
          "cycle invalid"
        ],
        "side_effects": []
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "validation_dimensions": [
      "identity closure",
      "substrate refs",
      "relation refs",
      "semantic ownership",
      "duplication",
      "Topic coverage",
      "reference closure",
      "traceability"
    ],
    "ownership_rule": "The same semantic fact has one authoritative owner unless explicit reconciliation says otherwise.",
    "duplication_rule": "Composition references owned semantics instead of copying them into each consumer.",
    "relation_rule": "Cross-component links use explicit relation identities.",
    "trace_rule": "A generic reader can trace Domain -> substrate -> relation -> owner and reverse.",
    "gap_rule": "Missing substrate/relation/ownership semantics become explicit gaps.",
    "lock_rule": "Composition cannot be lock-eligible while active ownership/ref/trace gaps remain."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ARCHITECTURE_COMPOSITION_EXPLICIT",
        "rule": "Universal substrates, domain compositions, Meta ownership and relations remain explicit and non-duplicated."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "same semantic fact has conflicting active owners",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Domain duplicates substrate semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "cross-component relation inferred instead of explicit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "composition trace requires path/name heuristic",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "missing component silently omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "composition locked while active semantic gap remains",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DOMAIN",
      "target_ref": "AIGMOS_DOMAIN_COMPOSITION_CONTRACT",
      "purpose": "Validates Domain compositions."
    },
    {
      "id": "REF_UMOD",
      "target_ref": "AIGMOS_UNIVERSAL_MODULE_SUBSTRATE_CONTRACT",
      "purpose": "Validates substrate reuse."
    },
    {
      "id": "REF_META",
      "target_ref": "AIGMOS_META_OWNERSHIP_CONTRACT",
      "purpose": "Validates semantic ownership."
    },
    {
      "id": "REF_MASTER_REL",
      "target_ref": "AIGMOS_MASTER_RELATION_CONTRACT",
      "purpose": "Validates relation discovery."
    }
  ],
  "prose": {
    "summary": "Define validation for Universal Module, Domain, Meta and Relation compositions so composed semantics remain traceable, non-duplicated and ownership-consistent.",
    "notes": [
      "Unlocked until reconciled against existing universal_module/domain/Meta/relation contracts and repository-wide Contract Format 1.4 validation."
    ]
  }
}
