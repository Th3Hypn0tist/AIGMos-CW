  "identity": {
    "id": "AIGMOS_ARCHITECTURE_COMPOSITION_VALIDATION_CONTRACT",
    "name": "Architecture Composition Validation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "locked",
  "source_role": "definition",
  "purpose": "Define validation for Universal Module, Domain, Meta and Relation compositions so composed semantics remain traceable, non-duplicated and ownership-consistent.",
  "scope": {
    "owns": [
      "Architecture Composition Validation semantics"
    ],
    "does_not_own": [
