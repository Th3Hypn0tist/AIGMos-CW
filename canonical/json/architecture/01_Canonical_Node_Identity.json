  "semantics": {
    "identity_rule": "Every machine-significant canonical node has an explicit stable identity appropriate to its node kind.",
    "path_rule": "Filesystem path is storage location, not semantic identity.",
    "label_rule": "Human-readable name/label is not sufficient identity.",
    "move_rule": "Moving a node/document does not change semantic identity.",
    "reference_rule": "Machine-significant cross-node references target canonical identities.",
    "collision_rule": "Active identity collisions hard-fail."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GRAPH_READING_DETERMINISTIC",
        "rule": "A generic reader can resolve canonical identity, Topic context, references and semantic ownership without filesystem or prose heuristics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "node lacks required canonical identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "path or display label is sole identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "move changes semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "active identity collision accepted",
        "result": "hard_fail"
      }
    ]
  },
