  "semantics": {
    "identity_rule": "Each occurrence has an explicit identity.",
    "automation_rule": "Occurrence references exact automation definition/revision.",
    "schedule_rule": "Schedule occurrence/wall-clock/timezone evidence is exact.",
    "condition_rule": "Condition occurrence/evaluation evidence is exact where applicable.",
    "state_values": [
      "due",
      "suppressed",
      "missed",
      "dispatched",
      "completed",
      "failed",
      "cancelled"
    ],
    "execution_rule": "Occurrence may create a separate invocation/execution through explicit binding.",
    "dedupe_rule": "Same semantic occurrence is not dispatched repeatedly unless replay policy is explicit.",
    "authority_rule": "Occurrence does not grant action authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "same cron tick dispatched twice invisibly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "occurrence reused as Runner execution identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "due means operation authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "condition occurrence inferred from polling time only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "missed occurrence shown completed",
        "result": "hard_fail"
      }
    ]
  },
