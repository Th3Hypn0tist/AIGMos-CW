        "id": "AUTOMATION_CAUSALITY_EXPLICIT",
        "rule": "Automation semantics remain explicit across Event, Trigger, Runner and Routine identities, and execution order never derives from incidental structure or serialization order."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "runner execution untracked",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "runner runtime identity conflated with canonical definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "cancel/error skips cleanup",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "autostart inferred from file presence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "OSC input boot conflated with Runner autostart",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "runner bypasses target authorization",
        "result": "hard_fail"
      }
    ]
