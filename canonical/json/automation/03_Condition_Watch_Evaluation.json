        "condition": "condition inferred from model narrative",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "true means authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "last state guessed from log text",
        "result": "hard_fail"
      }
    ]
