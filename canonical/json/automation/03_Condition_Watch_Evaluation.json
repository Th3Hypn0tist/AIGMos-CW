    "condition_rule": "Condition definition/Trigger/query is exact.",
    "cadence_rule": "Evaluation cadence is explicit.",
    "read_rule": "Condition check is read-only unless separately declared.",
    "transition_rule": "Notify/dispatch semantics are based on explicit false→true/threshold/rearm policy.",
    "dedupe_rule": "Persistent true condition does not repeatedly create duplicate semantic notifications unless recurrence is explicit.",
    "state_rule": "Last evaluated/last satisfied/rearm state is explicit.",
    "authority_rule": "Condition satisfaction does not grant downstream authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "polling causes mutation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "persistent true spams duplicate actions",
        "result": "hard_fail"
      },
      {
