  "semantics": {
    "root": "#R",
    "definition_rule": "Routine definition is inert authored data.",
    "registry_rule": "Each Routine has exact canonical identity.",
    "content_rule": "Routine contains explicit ordered/causal step semantics rather than relying on incidental JSON array order alone.",
    "invocation_rule": "Routine starts only through explicit `&` or canonical run operation.",
    "status_rule": "Active Routine execution status belongs to tracked runtime state.",
    "cycle_rule": "Cycle/loop behavior is explicit and bounded.",
    "authority_rule": "Reading/editing a Routine does not grant run authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "AUTOMATION_CAUSALITY_EXPLICIT",
        "rule": "Automation semantics remain explicit across Event, Trigger, Runner and Routine identities, and execution order never derives from incidental structure or serialization order."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "loading #R executes routine",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "routine identity inferred from file path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "execution order derived only from incidental array order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "read access grants run authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "unbounded cycle accepted",
        "result": "hard_fail"
      }
    ]
  },
