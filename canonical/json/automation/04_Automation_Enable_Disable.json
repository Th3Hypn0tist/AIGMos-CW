      "defined",
      "disabled",
      "enabled",
      "paused",
      "degraded",
      "failed",
      "retired"
    ],
    "enable_rule": "Enable targets exact automation definition and validates dependencies/bindings.",
    "disable_rule": "Disable prevents future dispatch but does not rewrite prior occurrence/execution history.",
    "pause_rule": "Pause semantics for due occurrences are explicit.",
    "retire_rule": "Retired automation remains historical definition evidence.",
    "schedule_rule": "Defined schedule existence never implies enabled automation.",
    "authority_rule": "Lifecycle changes require explicit automation-admin authority."
  },
