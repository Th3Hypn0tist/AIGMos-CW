  "semantics": {
    "rule": "A prune directive removes an explicitly identified capability from the candidate boot set.",
    "order_rule": "Pruning occurs before final dependency validation/activation.",
    "dependency_rule": "If pruning breaks a required dependency, validation hard-fails unless the dependent capability is also explicitly pruned/changed.",
    "no_repair_rule": "Runtime never re-adds a pruned dependency automatically.",
    "trace_rule": "Final resolution records which capabilities were removed and why."
  },
  "constraints": {
    "invariants": [
      {
        "id": "BOOT_EXPLICIT",
        "rule": "Boot selection, pruning, dependency validation and activation are explicit; the runtime never silently enables missing dependencies."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "pruned capability silently re-added",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "broken dependency silently repaired",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "prune target resolved heuristically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "pruning provenance omitted",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
