  "semantics": {
    "input": "resolved selected/pruned capability graph",
    "required_rule": "Every required dependency must be explicitly present and compatible.",
    "optional_rule": "Optional dependencies remain optional and are never auto-enabled.",
    "cycle_rule": "Dependency cycles follow explicit graph-safety policy.",
    "failure_rule": "Invalid boot graph hard-fails before affected capability activation.",
    "remediation_rule": "Error UX returns a concise actionable remediation derived from the actual missing/conflicting dependency.",
    "no_guess_rule": "Validator never guesses a substitute capability."
  },
  "constraints": {
    "invariants": [
      {
        "id": "BOOT_EXPLICIT",
        "rule": "Boot selection, pruning, dependency validation and activation are explicit; the runtime never silently enables missing dependencies."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "required dependency absent but activation continues",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "optional dependency auto-enabled",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "dependency substitute guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "invalid graph partially activated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "error remediation unrelated to actual dependency failure",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DEP",
      "target_ref": "AIGMOS_STRUCTURE_DEPENDENCY_CONTRACT",
      "purpose": "Boot graph uses explicit dependency semantics."
    }
  ],
