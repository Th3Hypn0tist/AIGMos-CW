    "priority": [
      "project/package root exact Contract Format filename",
      "explicit caller-supplied compatible bootstrap artifact",
      "bundled exact Contract Format artifact where the tool contract permits it"
    ],
    "forbidden_fallback": "canonical/json/00_Contract_Format.json",
    "exact_rule": "Resolution is exact and version/profile-aware; no fuzzy filename search.",
    "failure_rule": "No valid bootstrap source produces explicit hard failure.",
    "local_rule": "Local-source resolution cannot reinterpret an ordinary canonical contract as the format authority.",
    "provenance_rule": "Resolved bootstrap source/path/hash/version is retained in validation/build evidence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "BOOTSTRAP_SEPARATION",
        "rule": "Contract Format bootstrap authority is resolved before the canonical contract tree and is never treated as an ordinary canonical contract inside canonical/json/**."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "legacy canonical/json bootstrap used as fallback",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "bootstrap filename matched fuzzily",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "missing bootstrap silently guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "bootstrap source provenance lost",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "wrong version accepted without compatibility validation",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_BOOT",
      "target_ref": "AIGMOS_CONTRACT_FORMAT_BOOTSTRAP_CONTRACT",
      "purpose": "Resolver locates the actual bootstrap artifact."
