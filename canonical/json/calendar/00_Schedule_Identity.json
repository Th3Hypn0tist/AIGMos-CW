  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define each `#CAL` schedule as a stable declarative temporal identity separate from its next occurrence, emitted Event, Trigger binding and downstream execution.",
  "scope": {
    "owns": [
      "Schedule Identity semantics"
    ],
    "does_not_own": [
      "Runner execution semantics",
      "AccessCore policy ownership",
      "external calendar provider semantics"
    ]
  },
