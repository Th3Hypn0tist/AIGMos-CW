  "constraints": {
    "invariants": [
      {
        "id": "SCHEDULE_NONEXECUTION",
        "rule": "A schedule determines when a scheduling occurrence may be emitted; it never directly executes a Routine, command or operation. Execution requires the normal explicit Event→Trigger→Runner/operation causality chain."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "due time directly executes code",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "scheduling Event lacks schedule/occurrence refs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "duplicate occurrence emitted without dedupe evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "time occurrence grants authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "failed event emission shown as executed",
        "result": "hard_fail"
      }
    ]
