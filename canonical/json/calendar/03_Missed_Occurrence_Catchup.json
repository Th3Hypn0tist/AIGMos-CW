    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define explicit handling for scheduled occurrences missed while runtime/service is unavailable, preventing silent replay storms or loss.",
  "scope": {
    "owns": [
      "Missed Occurrence and Catch-up semantics"
    ],
    "does_not_own": [
      "Runner execution semantics",
      "AccessCore policy ownership",
      "external calendar provider semantics"
    ]
  },
