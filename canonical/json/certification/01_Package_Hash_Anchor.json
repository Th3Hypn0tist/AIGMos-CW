    {
      "id": "TOPIC_CERTIFICATION_PACKAGE_HASH_ANCHOR",
      "name": "Certification Package Hash Anchor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define certification anchoring to exact package/member hash evidence so certification validity applies only to the byte/semantic package snapshot that was actually certified.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
