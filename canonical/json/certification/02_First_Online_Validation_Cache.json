    "events": [],
    "flows": []
  },
  "semantics": {
    "first_rule": "First validation of an unseen certification/package pair is performed online against the authoritative registry/service.",
    "cache_rule": "Successful validation result may be cached locally.",
    "cache_key_rule": "Cache key binds certification identity plus exact package/hash subject.",
    "freshness_rule": "Cache lifetime/freshness policy is explicit.",
    "offline_rule": "Offline use may rely on a still-valid cached result according to policy.",
    "revocation_rule": "Online revalidation can observe revocation/supersession/expiry and invalidate cached acceptance.",
    "failure_rule": "No prior valid cache plus unavailable online validation results in explicit unverifiable state rather than silent pass."
  },
  "constraints": {
    "invariants": [
      {
        "id": "CERTIFICATION_EVIDENCE_BOUND",
        "rule": "Certification is explicit technical evidence bound to an exact package/artifact snapshot; commercial payment, license status or runtime authorization never substitute for certification evidence."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "first-ever validation passes offline without evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "cache keyed only by filename",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "expired cache treated as indefinitely valid",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "revocation never invalidates cache",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "unavailable registry silently treated as valid",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CERT",
      "target_ref": "AIGMOS_CERTIFICATION_IDENTITY_CONTRACT",
      "purpose": "Cache tracks exact certification subject."
    }
  ],
  "prose": {
    "summary": "Define certification validation lifecycle where first validation is online against authoritative registry evidence and successful results may then be cached locally with explicit freshness/expiry semantics.",
    "notes": [
      "Unlocked pending reconciliation against existing certification/distribution/licensing contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
