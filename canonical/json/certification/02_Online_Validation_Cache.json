  "semantics": {
    "first_rule": "Initial certification validation requires online registry/service validation unless an explicit offline bootstrap profile exists.",
    "cache_rule": "Successful validation may be cached locally.",
    "cache_identity_rule": "Cached validation references exact certification/token/hash/status revision.",
    "lifetime_rule": "Cache validity/refresh policy is explicit.",
    "revocation_rule": "Known revoked/expired state invalidates cached acceptance according to policy.",
    "offline_rule": "Offline cached validation is bounded and never silently permanent.",
    "authority_rule": "Certification cache does not grant runtime authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "first validation trusts local token only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "cache valid forever",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "revocation ignored offline indefinitely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "different package reuses cache",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cached valid means install-authorized",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TOKEN",
      "target_ref": "AIGMOS_CERTIFICATION_TOKEN_CONTRACT",
      "purpose": "Online validation verifies exact token/hash."
    }
  ],
  "prose": {
    "summary": "Define first online certification validation followed by bounded cached validation evidence, with revocation/expiry handling.",
