    "commercial_rule": "Certification service is commercially separate from software license entitlement.",
    "price_rule": "Certification starts from EUR 5000 under the current commercial model; exact scope/quote may vary explicitly.",
    "workflow_rule": "Submission, validation, findings, remediation, acceptance and issuance are separate states.",
    "target_rule": "Certification is issued to exact package/module revision/hash/profile.",
    "license_rule": "Holding a software license does not imply certification.",
    "support_rule": "Supported/OEM entitlement does not automatically certify packages.",
    "authority_rule": "Commercial status does not bypass technical conformance."
  },
