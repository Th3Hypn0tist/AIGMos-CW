  "semantics": {
    "identity_rule": "Each executable command has an explicit stable command identity.",
    "parent_rule": "Parent command-family ref is exact.",
    "operation_rule": "Command maps to one exact canonical operation or declared command execution semantics.",
    "argument_rule": "Argument/options schema is explicit.",
    "execution_rule": "Concrete command invocation creates a separate request/execution identity.",
    "alias_rule": "Aliases are explicit and never create duplicate command semantics.",
    "authority_rule": "Command registration does not authorize caller."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "command path reused as execution identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "operation binding guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "alias shadows unrelated command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "arguments free-form without declared semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "registration grants execution rights",
        "result": "hard_fail"
      }
    ]
  },
