  "semantics": {
    "root_rule": "`import` is a non-executable family root by default.",
    "family_rule": "Intermediate modality/type families may contain deeper subcommands.",
    "concrete_rule": "Only explicit concrete import descendants are invocable.",
    "profile_rule": "Each concrete command binds exact import/parser/profile identity.",
    "candidate_rule": "Import command produces candidate imported content until explicit apply.",
    "help_rule": "Help is recursively generated from family metadata.",
    "authority_rule": "Import command availability grants no apply authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "import root auto-detects and applies everything",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unknown format guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "import command mutates live state on parse",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "family node executable accidentally",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "file extension alone selects authority",
        "result": "hard_fail"
      }
    ]
  },
