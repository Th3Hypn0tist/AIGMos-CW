  "identity": {
    "id": "AIGMOS_Q_BACKEND_SELECTION_CONTRACT",
    "name": "q Backend Selection",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define backend selection for q-family commands through explicit logical aliases and compatible backend bindings, never by ad hoc provider inference from UI, payload or response content.",
  "scope": {
    "owns": [
      "q Backend Selection semantics"
    ],
    "does_not_own": [
      "backend provider implementation",
      "UI presentation",
      "unrelated runtime authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_Q_BACKEND_SELECTION",
      "name": "q Backend Selection",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define backend selection for q-family commands through explicit logical aliases and compatible backend bindings, never by ad hoc provider inference from UI, payload or response content.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "selection_rule": "Each q-family invocation resolves an explicit configured backend alias.",
    "alias_rule": "Logical alias is stable caller-facing backend identity.",
    "binding_rule": "Alias may map to concrete providers/models such as dummyLLM, doubleword or nvidia according to configuration.",
    "fallback_rule": "Fallback is explicit policy; silent provider substitution is forbidden.",
    "queue_rule": "Resolved alias determines q-family queue identity.",
    "ui_rule": "q Editor configures aliases/bindings but does not become backend authority.",
    "response_rule": "Backend response cannot select a new backend/root/command unless an explicit bounded owning operation permits it."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMMAND_AI_BOUNDARY_EXPLICIT",
        "rule": "q-family roles, backend aliases, targets, command namespaces and help metadata remain explicit and do not derive authority from model/backend output."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "provider/model inferred without explicit alias",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "silent provider fallback",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "UI display name used as backend semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "response dynamically selects arbitrary backend/root/command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "queue keyed by transient provider endpoint instead of alias",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_BACKEND",
      "target_ref": "AIGMOS_RUNTIME_BACKEND_ALIAS_CONTRACT",
      "purpose": "Selection resolves stable backend aliases."
    },
    {
      "id": "REF_QEDITOR",
      "target_ref": "AIGMOS_EXPOSE_Q_EDITOR_CONTRACT",
      "purpose": "q Editor edits bindings only."
    }
  ],
  "prose": {
    "summary": "Define backend selection for q-family commands through explicit logical aliases and compatible backend bindings, never by ad hoc provider inference from UI, payload or response content.",
    "notes": [
      "Unlocked pending reconciliation against existing q/qc/qt and command-tree contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
