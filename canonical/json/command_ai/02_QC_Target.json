    "name": "QC Target",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define qc target as an explicit canonical analysis/edit subject so qc can operate on a file, module, canonical identity, code surface or other declared target without inferring scope from conversation or filesystem proximity.",
  "scope": {
    "owns": [
      "QC Target semantics"
    ],
    "does_not_own": [
      "backend provider implementation",
      "UI presentation",
      "unrelated runtime authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_QC_TARGET",
      "name": "QC Target",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define qc target as an explicit canonical analysis/edit subject so qc can operate on a file, module, canonical identity, code surface or other declared target without inferring scope from conversation or filesystem proximity.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "owner": "qc",
    "target_rule": "qc target is explicit and machine-resolvable.",
    "target_kinds": [
      "canonical identity",
      "UserModule",
      "file/source artifact",
      "code surface",
      "explicit external target where supported"
    ],
    "identity_rule": "Canonical target identity remains separate from physical file path.",
    "scope_rule": "qc may only inspect/modify within its explicit target scope and invoked operation permissions.",
    "reference_rule": "Where a canonical identity exists, qc target should retain that identity even if a source file path is also present.",
    "projection_rule": "Editor/file UI selection may propose a qc target, but target semantics are explicit in the invocation/context.",
    "authority_rule": "Selecting a target does not grant write authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMMAND_AI_BOUNDARY_EXPLICIT",
        "rule": "q-family roles, backend aliases, targets, command namespaces and help metadata remain explicit and do not derive authority from model/backend output."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "qc target inferred solely from current directory or conversation proximity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "file path substitutes for existing canonical identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "qc writes outside declared target scope",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "target selection grants write authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "external target used without explicit external-reference semantics",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ADDRESS",
      "target_ref": "AIGMOS_CORE_ADDRESSING_CONTRACT",
      "purpose": "Targets resolve through explicit addressing/identity."
    },
    {
      "id": "REF_CHANGE",
      "target_ref": "AIGMOS_CORE_CANONICAL_CHANGE_BOUNDARY_CONTRACT",
      "purpose": "qc writes still use authoritative change boundaries."
    }
  ],
  "prose": {
    "summary": "Define qc target as an explicit canonical analysis/edit subject so qc can operate on a file, module, canonical identity, code surface or other declared target without inferring scope from conversation or filesystem proximity.",
    "notes": [
      "Unlocked pending reconciliation against existing q/qc/qt and command-tree contracts and whole-tree Contract Format 1.4 validation."
