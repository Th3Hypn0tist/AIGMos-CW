  },
  "identity": {
    "id": "AIGMOS_COMMAND_PARSING_CONTRACT",
    "name": "Command Parsing",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define deterministic parsing of command identities, namespace segments, literal arguments and control sigils before any runtime dispatch occurs.",
  "scope": {
    "owns": [
      "Command Parsing semantics"
    ],
    "does_not_own": [
      "backend implementation",
      "UI presentation",
      "domain semantics outside explicit command targets"
    ]
  },
  "members": [
    {
      "id": "TOPIC_COMMAND_PARSING",
      "name": "Command Parsing",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define deterministic parsing of command identities, namespace segments, literal arguments and control sigils before any runtime dispatch occurs.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "parse_order": [
      "identify leading control/sigil semantics if present",
      "parse canonical command namespace",
      "resolve exact executable command",
      "parse declared arguments/options",
      "validate target/value/address grammar",
      "dispatch only after successful parse"
    ],
    "namespace_separator": ".",
    "address_separator": ":",
    "literal_rule": "Literal argument data remains inert until consumed by the resolved command operation.",
    "exact_rule": "Executable command identity resolves exactly through the command registry.",
    "family_rule": "Intermediate command-family segments are namespaces and are not executed unless separately declared executable.",
    "error_rule": "Unknown command, invalid namespace or invalid argument produces a structured parse/validation error before effects.",
    "authority_rule": "Parsing never grants capability or authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMMAND_EXECUTION_EXPLICIT",
        "rule": "Command parsing, namespace resolution and execution remain explicit; namespace grouping never silently becomes executable behavior."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "unknown command falls through to arbitrary shell/string execution",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "family namespace executes merely because it resolves",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "arguments cause side effects during parsing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "fuzzy command resolution selects executable target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "parse failure still reaches dispatcher",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_NAMESPACE",
      "target_ref": "AIGMOS_RECURSIVE_COMMAND_NAMESPACE_CONTRACT",
      "purpose": "Parser follows recursive command namespaces."
    },
    {
      "id": "REF_COMMAND",
      "target_ref": "AIGMOS_RUNTIME_COMMAND_REGISTRY_CONTRACT",
      "purpose": "Executable targets resolve exactly."
    }
  ],
  "prose": {
    "summary": "Define deterministic parsing of command identities, namespace segments, literal arguments and control sigils before any runtime dispatch occurs.",
    "notes": [
      "Unlocked pending reconciliation against the existing command/runtime grammar and whole-tree Contract Format 1.4 validation."
    ]
  },
