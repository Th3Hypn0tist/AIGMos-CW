  "identity": {
    "id": "AIGMOS_COMMAND_NAMESPACE_EXECUTION_BOUNDARY_CONTRACT",
    "name": "Command Namespace Execution Boundary",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the hard boundary between non-executable command-family namespaces and executable concrete commands throughout the recursive command tree.",
  "scope": {
    "owns": [
      "Command Namespace Execution Boundary semantics"
    ],
    "does_not_own": [
      "backend implementation",
      "UI presentation",
      "domain semantics outside explicit command targets"
    ]
  },
  "members": [
    {
      "id": "TOPIC_COMMAND_NAMESPACE_EXECUTION",
      "name": "Command Namespace Execution Boundary",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the hard boundary between non-executable command-family namespaces and executable concrete commands throughout the recursive command tree.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "namespace_rule": "A command-family node groups descendants and may carry metadata/help without being executable.",
    "executable_rule": "Only nodes explicitly declared as executable commands may dispatch.",
    "mixed_rule": "A node may be both namespace and executable only when both semantics are explicitly declared.",
    "listing_rule": "Family invocation without executable semantics returns help/listing/error according to explicit command UX policy, never an inferred descendant.",
    "descendant_rule": "Concrete descendant identity includes the full namespace path.",
    "authority_rule": "Namespace membership does not broaden descendant command authority.",
    "example_rule": "export is a family namespace; concrete executable descendants may include export.code, export.file, export.json or deeper families such as export.files.json where defined."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMMAND_EXECUTION_EXPLICIT",
        "rule": "Command parsing, namespace resolution and execution remain explicit; namespace grouping never silently becomes executable behavior."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "namespace root implicitly dispatches first/default child",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "family membership grants descendant authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "descendant command drops namespace identity during dispatch",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "node treated executable without explicit executable semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "namespace help metadata interpreted as execution behavior",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_NAMESPACE",
      "target_ref": "AIGMOS_RECURSIVE_COMMAND_NAMESPACE_CONTRACT",
      "purpose": "Separates family grouping from executable commands."
    },
    {
      "id": "REF_HELP",
      "target_ref": "AIGMOS_COMMAND_HELP_METADATA_CONTRACT",
      "purpose": "Family roots may expose help without execution."
    }
  ],
  "prose": {
    "summary": "Define the hard boundary between non-executable command-family namespaces and executable concrete commands throughout the recursive command tree.",
    "notes": [
      "Unlocked pending reconciliation against the existing command/runtime grammar and whole-tree Contract Format 1.4 validation."
    ]
  },
