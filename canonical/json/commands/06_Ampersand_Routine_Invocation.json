  "semantics": {
    "sigil": "&",
    "role": "Routine invocation/control",
    "definition_root": "#R",
    "resolve_rule": "& resolves an explicit Routine identity from the canonical Routine registry.",
    "inert_rule": "The #R definition remains inert until & or another explicit canonical run operation invokes it.",
    "dispatch_rule": "Routine steps resolve commands/operations through normal registries and dispatcher.",
    "argument_rule": "Invocation arguments are validated against the Routine's declared input semantics.",
    "cycle_rule": "Routine recursion/cycles and chain depth follow Runtime Routine bounds.",
    "authority_rule": "Possessing/reading a Routine definition does not grant run authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMMAND_EXECUTION_EXPLICIT",
        "rule": "Command parsing, namespace resolution and execution remain explicit; namespace grouping never silently becomes executable behavior."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "& resolves routine fuzzily",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "reading #R executes Routine",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "Routine invocation bypasses command/operation dispatcher",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "invocation arguments bypass Routine input validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Routine run authority inferred from read access",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "Routine recursion/depth bounds bypassed",
        "result": "hard_fail"
      }
    ]
  },
