  "semantics": {
    "identity_rule": "Each backup has an explicit identity.",
    "source_rule": "Source datasets/config/artifacts/registries are exact.",
    "revision_rule": "Captured source revision/snapshot point is explicit.",
    "scope_rule": "Included/excluded data is explicit.",
    "integrity_rule": "Hash/verification profile is explicit.",
    "encryption_rule": "Encryption/key reference/profile is explicit where used.",
    "retention_rule": "Backup retention class/policy is explicit.",
    "authority_rule": "Backup possession grants no source restore/access authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "backup filename used as identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "backup scope unknown",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "unencrypted secret backup accepted silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "backup grants restore rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "source revision omitted",
        "result": "hard_fail"
      }
    ]
  },
