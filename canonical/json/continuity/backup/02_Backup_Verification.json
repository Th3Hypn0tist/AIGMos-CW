        "condition": "restore test uses production target implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "old verification reused after backup mutation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "invalid backup retained as valid",
        "result": "hard_fail"
      },
      {
