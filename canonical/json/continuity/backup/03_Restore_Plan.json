      {
        "id": "GATE_1",
        "condition": "restore target inferred from current environment",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "replace mode defaults silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "restore plan executes on save",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "schema mismatch ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "wildcard overwrite unbounded",
        "result": "hard_fail"
      }
    ]
  },
