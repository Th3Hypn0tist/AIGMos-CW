  "semantics": {
    "identity_rule": "Each recovery site/environment has explicit identity.",
    "capacity_rule": "Available service/resource capacity is explicit.",
    "data_rule": "Replicated/available data scopes and lag are explicit.",
    "secret_rule": "Required secret/key/provider readiness is explicit.",
    "network_rule": "Listener/DNS/routing dependencies are explicit.",
    "governance_rule": "IAM/AccessCore/governance remain active in recovery site.",
    "authority_rule": "Recovery-site availability grants no failover authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "recovery site bypasses AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "same hostname means same environment identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "data freshness assumed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "secret availability ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "standby means active",
        "result": "hard_fail"
      }
    ]
  },
