  "semantics": {
    "identity_rule": "Each failover execution has distinct identity.",
    "plan_rule": "Exact failover plan is referenced.",
    "fence_rule": "Primary fencing/isolation result is explicit before conflicting recovery activation where required.",
    "activation_rule": "Recovery services activate explicitly.",
    "traffic_rule": "Traffic switch result is explicit.",
    "validation_rule": "Data/service/security validation follows activation.",
    "result_states": [
      "completed",
      "failed",
      "partial",
      "split_brain_risk",
      "cancelled"
    ],
    "authority_rule": "Incident severity alone does not authorize failover."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "both primary and recovery writable without fencing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "failover by DNS change only considered complete",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "partial hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "incident auto-failover bypasses auth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "validation skipped",
        "result": "hard_fail"
      }
    ]
  },
