    "bootstrap_rule": "Repository-root AIGMos_Canonical_Contract_Format_v1.4.0.json is loaded before canonical/json.",
    "canonical_rule": "canonical/json/** definitions are interpreted only after bootstrap.",
    "self_reference_rule": "Canonical format-semantic contracts cannot recursively bootstrap themselves.",
    "legacy_rule": "canonical/json/00_Contract_Format.json cannot be active root bootstrap under the corrected model.",
    "authority_rule": "Root bootstrap owns format interpretation authority; semantic contracts refine repository-visible model only after boot."
  },
  "constraints": {
    "invariants": [
      {
        "id": "FORMAT_SECTION_MEANING_EXPLICIT",
        "rule": "Every Contract Format section and field has explicit machine-readable meaning; consumers never infer semantics from JSON ordering, filenames, indentation, prose style or neighboring fields."
      },
      {
        "id": "BOOTSTRAP_NONRECURSIVE_AUTHORITY",
        "rule": "These contracts document and constrain Contract Format semantics but do not replace the repository-root AIGMos_Canonical_Contract_Format_v1.4.0.json bootstrap authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "canonical child contract bootstraps itself",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "legacy in-tree format selected first",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "multiple roots selected by mtime",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "bootstrap generated from projection automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "root bootstrap treated ordinary domain contract",
        "result": "hard_fail"
      }
    ]
  },
