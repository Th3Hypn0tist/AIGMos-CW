  "semantics": {
    "identity_rule": "Each machine-significant semantic entity uses an explicit stable canonical identity.",
    "label_rule": "Human names/labels are mutable presentation metadata.",
    "address_rule": "Addresses/paths/URIs are locators or bindings, not identity unless an exact contract declares otherwise.",
    "runtime_rule": "PID/socket/object-memory handles are runtime metadata only.",
    "revision_rule": "Compatible revisions may preserve identity while exact content revision remains separately identifiable.",
    "collision_rule": "Two active incompatible semantic entities cannot silently share one canonical identity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_MEANING",
        "rule": "Machine-significant identity, type, relation, state and meaning are explicit and never inferred solely from display text, path, layout, file order, timestamp or implementation accident."
      },
      {
        "id": "DERIVED_NONAUTHORITY",
        "rule": "Resolved, projected, indexed, cached, formatted or derived representations never become source-of-truth or authority merely because they are convenient or available."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "display name used as canonical identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "path move changes identity automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "PID used as stable identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "duplicate active identity accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "runtime handle serialized as semantic identity",
        "result": "hard_fail"
      }
    ]
  },
