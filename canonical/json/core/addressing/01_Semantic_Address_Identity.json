  "semantics": {
    "identity_rule": "Machine-significant addresses may themselves have explicit identity/profile.",
    "target_rule": "Address resolves to an exact target identity or exact unresolved state.",
    "scheme_rule": "Addressing scheme/namespace is explicit.",
    "binding_rule": "Address→target binding is explicit and revisionable.",
    "mobility_rule": "Target identity may remain stable when address/binding changes.",
    "ambiguity_rule": "One address cannot resolve ambiguously under one active resolution profile.",
    "authority_rule": "Resolvable address grants no access authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_MEANING",
        "rule": "Machine-significant identity, type, relation, state and meaning are explicit and never inferred solely from display text, path, layout, file order, timestamp or implementation accident."
      },
      {
        "id": "DERIVED_NONAUTHORITY",
        "rule": "Resolved, projected, indexed, cached, formatted or derived representations never become source-of-truth or authority merely because they are convenient or available."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "address string becomes target identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "same address resolves multiple targets silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "target move creates new semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reachable address means authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "scheme guessed",
        "result": "hard_fail"
      }
    ]
  },
