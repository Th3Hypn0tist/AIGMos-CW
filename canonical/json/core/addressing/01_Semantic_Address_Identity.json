        "condition": "same address resolves multiple targets silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "target move creates new semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reachable address means authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
