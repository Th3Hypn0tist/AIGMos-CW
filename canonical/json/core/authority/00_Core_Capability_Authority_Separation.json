        "condition": "ownership is treated as runtime authority without explicit authority semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "payload/model/tool/backend output grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Topic membership or composition creates capability or authority",
        "result": "hard_fail"
      }
