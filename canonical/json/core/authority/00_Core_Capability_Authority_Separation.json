  "semantics": {
    "capability_question": "Does this capability exist canonically?",
    "authority_question": "Is this actor/context permitted to invoke/use the existing capability?",
    "rule": "Authority can narrow or deny use of an existing capability but cannot create a missing capability.",
    "payload_rule": "Payload/model/tool/backend output cannot grant authority or create capability.",
    "ownership_rule": "Semantic ownership does not automatically grant runtime authority.",
    "topic_rule": "Topic membership/composition does not create capability or authority."
  },
