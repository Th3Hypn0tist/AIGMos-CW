    "identity_rule": "Each Event type has explicit identity/version.",
    "payload_rule": "Payload record/type shape is explicit.",
    "producer_rule": "Allowed producer/component semantics are explicit.",
    "meaning_rule": "Event meaning is stable under compatible identity.",
    "compatibility_rule": "Payload evolution follows additive/breaking rules.",
