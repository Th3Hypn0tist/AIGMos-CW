        "id": "GATE_1",
        "condition": "event name alone defines payload",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "type and occurrence conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "new payload meaning breaks old type silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "producer guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "type executes trigger",
        "result": "hard_fail"
      }
    ]
