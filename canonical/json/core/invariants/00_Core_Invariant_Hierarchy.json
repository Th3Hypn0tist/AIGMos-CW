  "semantics": {
    "hierarchy_rule": "Applicable invariants propagate from Contract Format/Core/parent semantic boundaries to narrower child contracts.",
    "narrowing_rule": "A child may add constraints or narrow allowed behavior.",
    "weakening_rule": "A child may not permit behavior forbidden by an applicable parent/Core invariant.",
    "conflict_rule": "If two applicable authoritative invariants conflict and neither is a valid narrowing, emit an explicit source/semantic conflict gap.",
    "hard_gate_rule": "Hard gates are not overridden by lower-level convenience behavior."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_MACHINE_SEMANTICS",
        "rule": "Machine-significant meaning is explicit structured canonical data and is not reconstructed by hidden heuristics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "child contract weakens an applicable Core invariant",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "child hard gate overrides parent hard gate to permit forbidden behavior",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "conflicting invariants are silently resolved by file/path/version order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "applicable invariant is ignored because a lower-level contract omits restating it",
        "result": "hard_fail"
      }
    ]
  },
