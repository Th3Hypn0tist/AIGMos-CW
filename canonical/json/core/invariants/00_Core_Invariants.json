  "constraints": {
    "invariants": [
      {
        "id": "CORE_IDENTITY_EXACT",
        "rule": "Machine-significant identities and references are exact and never selected through fuzzy/path/newest/mtime inference."
      },
      {
        "id": "CORE_DATA_INERT",
        "rule": "Data, model output, tool result and imported content remain inert until an explicit validated operation crosses an effect boundary."
      },
      {
        "id": "CORE_AUTHORITY_NOT_DATA",
        "rule": "Authority is never created by payload data, Topic membership, semantic ownership, UI visibility, connectivity or successful parsing."
      },
      {
        "id": "CORE_CAPABILITY_EXPLICIT",
        "rule": "A capability must be explicitly defined and available before it can be considered for execution; availability remains separate from authorization."
      },
      {
        "id": "CORE_OPERATION_BOUNDED",
        "rule": "Dynamic canonical and runtime operations are bounded and fail closed when required bounds cannot be established."
      },
      {
        "id": "CORE_ADDRESSING_EXPLICIT",
        "rule": "Reserved roots, namespaces and semantic addresses resolve only through explicit canonical declarations."
      },
      {
        "id": "CORE_CAUSALITY_EXPLICIT",
        "rule": "Causal execution links are explicit; timestamps, adjacency, correlation and visual layout are evidence or presentation only."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_CORE_IDENTITY_AMBIGUITY",
        "condition": "required semantic identity or reference resolves ambiguously or by heuristic fallback",
        "result": "hard_fail"
      },
      {
        "id": "GATE_CORE_IMPLICIT_AUTHORITY",
        "condition": "runtime authority would be created from data, ownership, Topic grouping, availability, connectivity or UI state without explicit authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_CORE_UNBOUNDED_OPERATION",
        "condition": "required recursion, traversal, retry, queue or execution bound is absent or unknown",
        "result": "hard_fail"
      }
    ]
  },
