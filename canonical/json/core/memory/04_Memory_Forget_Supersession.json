  "semantics": {
    "target_rule": "Exact memory record/set is targeted.",
    "states": [
      "active",
      "superseded",
      "expired",
      "forgotten",
      "deleted_where_permitted"
    ],
    "supersession_rule": "Replacement/newer evidence explicitly references superseded record where appropriate.",
    "forget_rule": "Forgotten record is excluded from future context/retrieval according to policy.",
    "audit_rule": "Minimal governed lifecycle evidence may remain without reinjecting forgotten content.",
    "privacy_rule": "Deletion/retention follows applicable governance.",
    "authority_rule": "Forgetting memory does not alter unrelated canonical identity or Merit history."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_MEANING",
        "rule": "Machine-significant identity, type, relation, state and meaning are explicit and never inferred solely from display text, path, layout, file order, timestamp or implementation accident."
      },
      {
        "id": "DERIVED_NONAUTHORITY",
        "rule": "Resolved, projected, indexed, cached, formatted or derived representations never become source-of-truth or authority merely because they are convenient or available."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "forgotten text remains in model context",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "forget deletes unrelated audit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "new memory overwrites history silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "expiry inferred from mtime",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "memory deletion merges identities",
        "result": "hard_fail"
      }
    ]
  },
