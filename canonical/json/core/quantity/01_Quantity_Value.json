        "condition": "unit omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "null treated zero",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "incompatible units compared directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "conversion loses provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "display rounded value stored as source silently",
        "result": "hard_fail"
      }
    ]
  },
