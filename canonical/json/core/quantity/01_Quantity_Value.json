    "value_rule": "Numeric value representation is explicit.",
    "unit_rule": "Exact unit identity is required for unit-bearing quantities.",
    "precision_rule": "Stored/measurement precision is explicit where material.",
    "conversion_rule": "Converted value retains source/conversion provenance where material.",
    "comparison_rule": "Comparisons require compatible dimensions and explicit conversion semantics.",
