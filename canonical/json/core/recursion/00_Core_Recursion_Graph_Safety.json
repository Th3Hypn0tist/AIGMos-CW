    "name": "Core Recursion and Graph Safety",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define bounded deterministic recursion and cycle handling for canonical trees, Topic inheritance/composition, references, relations and flows without banning valid recursive semantic structures.",
  "scope": {
    "owns": [
      "Core Recursion and Graph Safety semantics"
    ],
    "does_not_own": [
      "domain-specific semantics",
      "runtime implementation details"
    ]
  },
  "members": [
    {
      "id": "TOPIC_CORE_RECURSION",
      "name": "Recursion",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define bounded deterministic recursion and cycle handling for canonical trees, Topic inheritance/composition, references, relations and flows without banning valid recursive semantic structures.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_GRAPH_TRAVERSE",
        "name": "Traverse recursive canonical graph",
        "inputs": [
          "entry refs",
          "graph semantics",
          "bounds"
        ],
        "outputs": [
          "reachable graph + cycle observations"
        ],
        "errors": [
          "bound exceeded"
        ],
        "side_effects": []
      },
      {
        "id": "OP_GRAPH_VALIDATE_CYCLE",
        "name": "Validate graph cycle",
        "inputs": [
          "cycle",
          "owning semantic dimension"
        ],
        "outputs": [
          "allowed | forbidden"
        ],
        "errors": [
          "cycle semantics unresolved"
        ],
        "side_effects": []
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "recursion_rule": "Recursion is allowed where the owning semantic model permits it.",
    "visited_rule": "Readers maintain visited identity/edge/ref context to prevent infinite traversal.",
    "cycle_rule": "Cycles are semantic facts to validate, not traversal bugs to silently remove.",
    "acyclic_rule": "Acyclicity applies only where explicitly required by the owning semantic dimension.",
    "bound_rule": "Traversal is bounded by resource rules but bound failures remain visible and cannot be reported as complete results.",
    "projection_rule": "A projection may choose a finite view depth, but truncation is projection metadata, not canonical absence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_SEMANTIC_BOUNDARY",
        "rule": "Machine-significant semantics are explicit and deterministic."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "valid recursive structure rejected solely because it is recursive",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "forbidden cycle silently ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "reader loops indefinitely because visited tracking is absent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "bounded/truncated graph reported as complete canonical graph",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "projection depth truncation interpreted as semantic absence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
