    "identity_rule": "Each machine-significant logical resource has explicit identity.",
    "type_rule": "Resource type/class is explicit.",
    "owner_rule": "Semantic owner is explicit.",
    "binding_rule": "One or more storage/network/address bindings may refer to the resource.",
