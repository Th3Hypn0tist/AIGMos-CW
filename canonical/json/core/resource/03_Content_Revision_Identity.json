  "semantics": {
    "identity_rule": "Each accepted content revision has explicit revision identity/hash/version evidence.",
    "resource_rule": "Revision belongs to exact logical resource.",
    "parent_rule": "Predecessor/base revision refs are explicit where applicable.",
    "immutability_rule": "Accepted revision content is immutable; correction creates new revision.",
    "hash_rule": "Content hash may identify bytes but stable resource identity remains separate.",
    "ordering_rule": "Revision ancestry/sequence is explicit rather than mtime-based.",
    "authority_rule": "Newer revision has no automatic authority/preference."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_MEANING",
        "rule": "Machine-significant identity, type, relation, state and meaning are explicit and never inferred solely from display text, path, layout, file order, timestamp or implementation accident."
      },
      {
        "id": "DERIVED_NONAUTHORITY",
        "rule": "Resolved, projected, indexed, cached, formatted or derived representations never become source-of-truth or authority merely because they are convenient or available."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "mtime is revision identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "old revision overwritten",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "newest always selected",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "hash used as stable resource id universally",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "revision grants write rights",
        "result": "hard_fail"
      }
    ]
  },
