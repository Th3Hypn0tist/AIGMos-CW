  "semantics": {
    "identity_rule": "Each index build/revision has explicit identity.",
    "index_rule": "Exact index identity/profile is referenced.",
    "source_rule": "Exact source snapshot/cursor/revision is explicit.",
    "result_states": [
      "complete",
      "partial",
      "failed",
      "stale",
      "building"
    ],
    "lag_rule": "Freshness/lag evidence is explicit.",
    "delete_rule": "Source deletions/tombstones propagate according to explicit profile.",
    "failure_rule": "Partial index never masquerades as complete.",
    "authority_rule": "Index builder authority does not become source application authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_MEANING",
        "rule": "Machine-significant identity, type, relation, state and meaning are explicit and never inferred solely from display text, path, layout, file order, timestamp or implementation accident."
      },
      {
        "id": "DERIVED_NONAUTHORITY",
        "rule": "Resolved, projected, indexed, cached, formatted or derived representations never become source-of-truth or authority merely because they are convenient or available."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "partial index shown current",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "deleted source remains searchable indefinitely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "source revision omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "mtime used as freshness only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "builder gets all application rights",
        "result": "hard_fail"
      }
    ]
  },
