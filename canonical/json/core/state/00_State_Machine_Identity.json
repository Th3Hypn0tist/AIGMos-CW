        "id": "GATE_1",
        "condition": "state names alone define lifecycle",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "any transition allowed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "initial state guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "terminal state inferred from word closed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "definition executes transitions",
        "result": "hard_fail"
      }
    ]
