  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define append/history evidence for one attempted/accepted/rejected state transition with exact old/new state, trigger, guards, authorization and execution refs.",
  "scope": {
    "owns": [
      "State Transition Evidence semantics"
    ],
    "does_not_own": [
