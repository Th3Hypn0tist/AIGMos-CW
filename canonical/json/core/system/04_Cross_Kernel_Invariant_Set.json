    "identity_rule": "Each invariant set/profile has explicit identity/version.",
    "invariant_examples": [
      "definition != execution",
      "identity != address",
      "authentication != authorization",
      "capability != authorization",
      "availability != authorization",
      "installed != enabled != running",
      "running != healthy != ready",
      "projection != source_of_truth",
      "candidate != accepted",
      "accepted_release != deployment",
      "event_correlation != causality",
      "domain_composition != substrate_ownership"
    ],
    "scope_rule": "Each invariant declares exact component/contract applicability.",
    "validation_rule": "Whole-tree conformance evaluates required invariants.",
    "exception_rule": "Any exception must be explicit new semantics rather than an accidental implementation shortcut.",
    "authority_rule": "Invariant set governs semantic conformance, not user authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_MEANING",
        "rule": "Machine-significant identity, type, relation, state and meaning are explicit and never inferred solely from display text, path, layout, file order, timestamp or implementation accident."
      },
      {
        "id": "DERIVED_NONAUTHORITY",
        "rule": "Resolved, projected, indexed, cached, formatted or derived representations never become source-of-truth or authority merely because they are convenient or available."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "implementation shortcut silently violates invariant",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "exception documented only in prose",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "invariant evaluated per-file only despite cross-kernel scope",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "projection used as source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "availability treated authority",
        "result": "hard_fail"
      }
    ]
  },
