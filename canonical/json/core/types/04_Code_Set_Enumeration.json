  "semantics": {
    "identity_rule": "Each code set and machine-significant member has explicit identity/code.",
    "code_rule": "Machine code is distinct from localized display label.",
    "unknown_rule": "Unknown code handling is explicit.",
    "additive_rule": "New optional codes may be additive only when consumers support unknown-code semantics.",
    "breaking_rule": "Changing meaning of an existing code is breaking.",
    "alias_rule": "Deprecated code aliases/mappings are explicit.",
    "authority_rule": "Enumeration value never grants AccessCore rights merely by name."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_MEANING",
        "rule": "Machine-significant identity, type, relation, state and meaning are explicit and never inferred solely from display text, path, layout, file order, timestamp or implementation accident."
      },
      {
        "id": "DERIVED_NONAUTHORITY",
        "rule": "Resolved, projected, indexed, cached, formatted or derived representations never become source-of-truth or authority merely because they are convenient or available."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "localized label used as code",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "existing code meaning changed silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "unknown code mapped to nearest label",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "admin enum implies rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "deprecated code deleted without mapping",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define finite code/enumeration sets as explicit identities with stable code values, labels and additive/breaking evolution rules.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
