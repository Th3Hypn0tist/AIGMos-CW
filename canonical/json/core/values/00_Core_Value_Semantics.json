    "allowed_value_kinds": [
      "null",
      "boolean",
      "number",
      "string",
      "array",
      "object"
    ],
    "inert_rule": "Canonical values are inert unless interpreted by an explicit owning operation/runtime contract.",
    "code_rule": "Arbitrary executable code or callable values are not baseline canonical value kinds.",
    "authority_rule": "A value cannot grant authority.",
    "identity_rule": "References represented as values must still use explicit canonical reference semantics when machine-significant.",
    "normalization_rule": "Normalization may change serialization form but not semantic value."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_SEMANTIC_BOUNDARY",
        "rule": "Machine-significant semantics are explicit and deterministic."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "canonical value executes because it is loaded or read",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "payload/value grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "callable/code value accepted without explicit owning contract",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "normalization changes semantic value",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "machine-significant reference is hidden inside an opaque string requiring interpretation",
        "result": "hard_fail"
      }
    ]
  },
