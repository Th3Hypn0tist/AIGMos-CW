    "identity_rule": "Each environment has an explicit stable identity.",
    "class_rule": "Environment class/name is descriptive metadata, not the sole identity.",
    "resource_rule": "Bound hosts/nodes/listeners/storage/endpoints are explicit.",
    "governance_rule": "Environment-specific AccessCore/governance/secrets/deployment policies are explicit.",
    "isolation_rule": "Environment boundaries are explicit and do not collapse because resources share a host/network.",
    "promotion_rule": "Promotion between environments is a separate deployment action.",
    "authority_rule": "Access to one environment grants no authority to another."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
