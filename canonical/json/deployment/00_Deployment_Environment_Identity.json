        "id": "GATE_1",
        "condition": "staging credentials accepted in production",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "same hostname merges environments",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "environment inferred from directory name",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "promotion copies authority automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "production selected by default fallback",
        "result": "hard_fail"
      }
    ]
  },
