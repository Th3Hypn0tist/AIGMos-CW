  "semantics": {
    "identity_rule": "Each deployment plan has an explicit identity/revision.",
    "release_rule": "Plan references exact accepted release identity/hash set.",
    "environment_rule": "Target environment identity is exact.",
    "target_rule": "Target service/module/instance set is exact.",
    "strategy_rule": "Rollout strategy/profile is explicit.",
    "migration_rule": "Required schema/config/data migrations are explicit.",
    "gate_rule": "Pre/post deployment verification gates are explicit.",
    "inert_rule": "Plan definition performs no deployment effect."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "plan uses latest release implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "environment inferred",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "target selected by wildcard without bound semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "plan creation deploys immediately",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "migration hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_RELEASE",
      "target_ref": "AIGMOS_RELEASE_GATE_CONTRACT",
      "purpose": "Deployment consumes an accepted release, not merely a candidate."
    }
  ],
  "prose": {
    "summary": "Define each deployment plan as an inert exact composition of accepted release, target environment, target instances, rollout strategy, migrations and validation gates.",
