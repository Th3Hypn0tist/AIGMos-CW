  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define pre-deployment verification of target environment, dependencies, capacity, secrets, configuration, migrations, entitlements and health prerequisites before effectful rollout.",
  "scope": {
    "owns": [
      "Deployment Preflight semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "canonical documentation ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DEPLOYMENT_PREFLIGHT",
      "name": "Deployment Preflight",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define pre-deployment verification of target environment, dependencies, capacity, secrets, configuration, migrations, entitlements and health prerequisites before effectful rollout.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "checks": [
      "release_integrity",
      "target_identity",
      "dependency_compatibility",
      "capacity",
      "configuration",
      "secret_refs",
      "network_bindings",
      "migration_readiness",
      "license_entitlement_where_applicable",
      "backup_or_restore_point_where_required",
      "other declared check"
    ],
    "plan_rule": "Preflight references exact deployment plan/execution.",
    "snapshot_rule": "Material target-state snapshot/revisions are explicit.",
    "failure_rule": "Failed required preflight blocks rollout.",
    "stale_rule": "Materially changed target state after preflight may require revalidation.",
    "authority_rule": "Preflight pass grants no deployment authority by itself."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "failed preflight only warns",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "secret missing discovered after destructive migration begins",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "target changed but old preflight reused",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "preflight pass deploys",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "entitlement treated AccessCore allow",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EXEC",
      "target_ref": "AIGMOS_DEPLOYMENT_EXECUTION_CONTRACT",
      "purpose": "Preflight gates exact deployment execution."
    }
  ],
  "prose": {
    "summary": "Define pre-deployment verification of target environment, dependencies, capacity, secrets, configuration, migrations, entitlements and health prerequisites before effectful rollout.",
