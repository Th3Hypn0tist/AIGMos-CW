  "semantics": {
    "execution_rule": "Verification targets exact deployment execution/target instances.",
    "version_rule": "Observed deployed artifact/revision is exact.",
    "health_rule": "Health/readiness evidence is explicit.",
    "config_rule": "Effective configuration revision is verified.",
    "migration_rule": "Required migration completion/invariants are verified.",
    "functional_rule": "Declared smoke/verification suite may be required.",
    "failure_rule": "Failed post-verification yields failed/partial deployment or rollback policy.",
    "completion_rule": "Deployment completed and service healthy remain distinct evidence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "process started means deployment verified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "health inferred from port open only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "wrong version accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "migration completion guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "post-check failure hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TEST",
      "target_ref": "AIGMOS_TEST_RESULT_EVIDENCE_CONTRACT",
      "purpose": "Post-verification may consume exact verification evidence."
    }
  ],
  "prose": {
    "summary": "Define post-deployment health, readiness, version, configuration, migration and functional verification before deployment is considered completed.",
