      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "first target used as canary implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "observation window skipped",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "elapsed time means success",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unknown metric treated pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "canary success deploys all without plan",
        "result": "hard_fail"
      }
    ]
