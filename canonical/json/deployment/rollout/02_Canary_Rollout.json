    "subset_rule": "Canary targets are exact or deterministically selected by declared policy.",
    "size_rule": "Canary size/count/percentage is explicit.",
    "window_rule": "Observation duration/criteria are explicit.",
    "metric_rule": "Required health/performance/error/security signals are exact.",
