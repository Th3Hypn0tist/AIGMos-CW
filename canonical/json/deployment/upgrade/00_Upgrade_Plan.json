      },
      {
        "id": "GATE_2",
        "condition": "migration order inferred",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "point-of-no-return hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "mixed-version compatibility assumed",
        "result": "hard_fail"
      },
      {
