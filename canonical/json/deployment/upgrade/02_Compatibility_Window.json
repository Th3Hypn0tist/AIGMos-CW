        "condition": "window never closes",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "unsupported writer accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "version selected by newest",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "compatibility changes authority",
        "result": "hard_fail"
      }
    ]
