      {
        "id": "GATE_1",
        "condition": "resume assumes last log line succeeded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "ambiguous state continues automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed non-idempotent step reruns blindly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "rollback eligibility stale",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "resume bypasses preflight",
        "result": "hard_fail"
      }
    ]
