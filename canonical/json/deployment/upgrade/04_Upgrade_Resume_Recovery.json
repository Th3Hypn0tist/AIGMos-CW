  "semantics": {
    "execution_rule": "Resume references exact interrupted deployment/upgrade execution.",
    "state_rule": "Completed/pending/failed migration and rollout stages are explicit.",
    "target_rule": "Current actual artifact/config/schema state is re-read and verified.",
    "resume_rule": "Only safe pending/idempotent steps may resume.",
    "rollback_rule": "Rollback/restore eligibility is re-evaluated.",
    "unknown_rule": "Ambiguous current state blocks automated resume.",
    "authority_rule": "Resume requires explicit operational authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "resume assumes last log line succeeded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "ambiguous state continues automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed non-idempotent step reruns blindly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "rollback eligibility stale",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "resume bypasses preflight",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SEQ",
      "target_ref": "AIGMOS_UPGRADE_MIGRATION_SEQUENCE_CONTRACT",
      "purpose": "Resume uses exact migration-step state."
