        "condition": "hash manifest omits packaged machine-significant member without explicit rule",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "different package contents accepted under same verified package hash claim",
        "result": "hard_fail"
      },
      {
