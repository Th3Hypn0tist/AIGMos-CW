  "semantics": {
    "anchor_rule": "Certification token anchors an exact package hash.",
    "conformance_rule": "Certification evidence identifies applicable conformance/closure results.",
    "first_validation_rule": "Initial validation may require online registry verification; subsequent validation may use explicitly bounded/cacheable registry evidence.",
    "separation_rule": "Certification does not grant license rights, semantic ownership or runtime authorization.",
    "change_rule": "Package content change invalidates certification tied to the prior package hash.",
    "evidence_rule": "Certification result retains package, validator/registry and validation provenance."
  },
