    "role": "public certification index/verification surface",
    "ownership_rule": "Registry does not own certified package semantics.",
    "status_rule": "Registry entry explicitly identifies certification status and package hash.",
    "cache_rule": "Clients may cache verified registry evidence according to explicit policy.",
    "revocation_rule": "Revoked/invalid certification status is explicit and machine-readable.",
    "format_rule": "CSV/hash files are serialization/publication formats only."
  },
