        "condition": "revoked certification remains represented as valid",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "registry lookup result grants runtime authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "CSV/file format treated as semantic authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "package hash absent from certification registry entry",
        "result": "hard_fail"
      }
    ]
  },
