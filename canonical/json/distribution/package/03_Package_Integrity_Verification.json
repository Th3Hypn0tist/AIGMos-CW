  "identity": {
    "id": "AIGMOS_PACKAGE_INTEGRITY_VERIFICATION_CONTRACT",
    "name": "Package Integrity Verification",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define deterministic verification of manifest/member hashes, expected package identity and structural completeness before package acceptance.",
  "scope": {
    "owns": [
      "Package Integrity Verification semantics"
    ],
    "does_not_own": [
      "runtime execution authority",
      "AccessCore policy ownership",
      "domain semantic ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_PACKAGE_INTEGRITY_VERIFICATION",
      "name": "Package Integrity Verification",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define deterministic verification of manifest/member hashes, expected package identity and structural completeness before package acceptance.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "flow": [
      "parse manifest",
      "resolve expected package identity",
      "enumerate declared members",
      "verify hashes",
      "verify required members",
      "verify structural constraints",
      "produce integrity evidence"
    ],
    "result_states": [
      "valid",
      "invalid",
      "incomplete",
      "unknown"
    ],
    "extra_rule": "Unexpected extra members follow explicit allow/reject policy.",
    "missing_rule": "Required missing member hard-fails.",
    "evidence_rule": "Verification result references exact package/artifact revisions.",
    "execution_rule": "Integrity validation never executes package contents.",
    "authority_rule": "Valid integrity does not imply trusted publisher/certified/license-entitled/install-authorized."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "valid hash means certified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "verification executes installer",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "missing required file ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unexpected executable accepted silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "valid package auto-installed",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_HASH",
      "target_ref": "AIGMOS_ARTIFACT_CONTENT_HASH_CONTRACT",
      "purpose": "Verification checks exact member hashes."
    }
  ],
  "prose": {
    "summary": "Define deterministic verification of manifest/member hashes, expected package identity and structural completeness before package acceptance.",
