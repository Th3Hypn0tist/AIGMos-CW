    "flows": []
  },
  "semantics": {
    "publisher_rule": "Publisher identity is explicit where known.",
    "source_rule": "Repository/source revision ref is explicit where available.",
    "build_rule": "Build/export profile/tool revision is explicit where relevant.",
    "integrity_rule": "Provenance and content integrity are distinct evidence dimensions.",
    "certification_rule": "Publisher provenance does not imply certification.",
    "license_rule": "Publisher provenance does not imply recipient entitlement.",
    "history_rule": "Repacked/derived packages preserve source provenance."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "publisher means certified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "repo URL becomes package identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "repack loses original provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "valid provenance grants license",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "build timestamp used as authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define package publisher/source/build/export provenance separately from integrity, certification and license entitlement.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
