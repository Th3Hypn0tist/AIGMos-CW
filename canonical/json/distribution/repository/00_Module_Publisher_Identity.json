  "semantics": {
    "identity_rule": "Each publisher has an explicit identity.",
    "organization_rule": "Publisher may map to exact organization IdentityCore identity.",
    "repository_rule": "Repository account/path is a binding only.",
    "module_rule": "Publishing a module does not transfer the module's semantic ownership unless the module contract says so.",
    "license_rule": "Publisher eligibility may depend on commercial/license policy.",
    "certification_rule": "Publisher status does not imply certification.",
    "authority_rule": "Publisher identity grants no runtime authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "repo username used as canonical publisher identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "publisher means certified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "publisher automatically owns every uploaded dependency",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "publisher grants runtime rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "repository path proves organization identity",
        "result": "hard_fail"
      }
    ]
  },
