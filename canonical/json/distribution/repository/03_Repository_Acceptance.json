  "semantics": {
    "flow": [
      "resolve publisher",
      "verify package integrity",
      "validate module contract surface",
      "validate identity/version",
      "validate distribution/license policy",
      "validate certification refs if claimed",
      "accept repository entry"
    ],
    "candidate_rule": "Upload/submission is candidate-only until accepted.",
    "publisher_rule": "Publisher eligibility is explicit.",
    "identity_rule": "Module identity/version compatibility is validated.",
    "certification_rule": "Certification claim must target exact hash/package.",
    "execution_rule": "Repository acceptance never executes module code.",
    "authority_rule": "Accepted entry does not auto-install/enable."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "upload instantly published",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "repository scanner executes package",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "certification claim accepted by filename",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "accepted entry auto-installs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "publisher eligibility guessed",
        "result": "hard_fail"
      }
    ]
  },
