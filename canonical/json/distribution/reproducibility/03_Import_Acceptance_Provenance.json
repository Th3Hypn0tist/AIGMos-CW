  "semantics": {
    "flow": [
      "receive external artifact",
      "identify source/package",
      "verify integrity where applicable",
      "parse",
      "normalize",
      "validate",
      "resolve target",
      "semantic diff",
      "authorize",
      "apply",
      "record accepted revision/provenance"
    ],
    "candidate_rule": "Imported content remains inert candidate until apply.",
    "source_rule": "External source/package/hash refs are preserved.",
    "normalization_rule": "Normalized candidate retains source provenance.",
    "authority_rule": "Valid import does not imply apply authority.",
    "history_rule": "Accepted changes reference exact import execution/source.",
    "failure_rule": "Rejected import never masquerades as accepted canonical state."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "opening import file mutates live state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "validation auto-applies",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "source provenance dropped after normalization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "valid package grants apply rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "rejected import appears in accepted revision",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_IMPORT",
