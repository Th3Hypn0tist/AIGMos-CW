    "name": "Generated Documentation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define deterministic generation of human documentation, indexes, Topic views, relation maps, help and other derived documentation from the canonical graph.",
  "scope": {
    "owns": [
      "Generated Documentation semantics"
    ],
    "does_not_own": [
      "source semantic authority",
      "runtime execution authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DOCUMENTATION_GENERATED",
      "name": "Generated Documentation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define deterministic generation of human documentation, indexes, Topic views, relation maps, help and other derived documentation from the canonical graph.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "generation_rule": "Generated documentation reads canonical semantics through the generic recursive reader.",
    "outputs": [
      "human-readable docs",
      "Topic indexes",
      "relation maps",
      "registry catalogs",
      "command help listings",
      "architecture summaries"
    ],
    "determinism_rule": "Same canonical graph plus same generator version/config produces semantically equivalent documentation.",
    "source_ref_rule": "Generated sections retain canonical source refs where useful for traceability.",
    "nonauthority_rule": "Generated output is derived_projection source role.",
    "edit_rule": "Machine-significant edits must be made to canonical source semantics, not only to generated output.",
    "staleness_rule": "Stale generated output is detectable by source/generator metadata or regeneration comparison."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PROJECTION_NONAUTHORITY",
        "rule": "Documentation, diagrams, serializers and projection tools derive from canonical semantics and never become semantic authority by convenience."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "generated document treated as semantic definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "manual edit to generated output becomes sole machine-significant change",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "generator requires undocumented filesystem heuristic",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "generated output drops source traceability where required",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "stale generated docs silently presented as current canonical truth",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_READ",
      "target_ref": "AIGMOS_RECURSIVE_READ_CONTRACT",
      "purpose": "Generators use deterministic recursive reading."
    },
    {
      "id": "REF_SOURCE",
      "target_ref": "AIGMOS_CANONICAL_SOURCE_ROLE_REGISTRY_CONTRACT",
      "purpose": "Generated docs are derived projections."
    }
  ],
  "prose": {
    "summary": "Define deterministic generation of human documentation, indexes, Topic views, relation maps, help and other derived documentation from the canonical graph.",
    "notes": [
      "Unlocked pending reconciliation against documentation/UML/projector artifacts and whole-tree Contract Format 1.4 validation."
    ]
  },
