    "identity_rule": "Concrete domain instance/context has an explicit identity.",
    "domain_rule": "References exact Domain definition/version.",
    "module_instance_rule": "Composed Universal Module instances are exact refs.",
    "context_rule": "Organization/project/site/customer/context bindings are explicit.",
    "data_rule": "Domain context does not merge underlying module-instance data scopes by implication.",
    "lifecycle_rule": "Configured/active context state is separate from Domain definition.",
    "authority_rule": "Context membership is not AccessCore authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMPOSITION_NONOWNERSHIP",
        "rule": "Composition never silently transfers semantic ownership: universal modules own their primitives, domains own their composition semantics, and composed members retain their own identities and contracts."
      },
      {
        "id": "EXPLICIT_STRUCTURE",
        "rule": "Containment, relation, dependency, composition and projection edges exist only through explicit typed references; naming, file hierarchy, UI adjacency or shared values never create semantic structure."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "domain context inferred from login only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "module instances merged automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "site name becomes domain identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "active context grants rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "domain definition modified by instance data",
        "result": "hard_fail"
      }
    ]
  },
