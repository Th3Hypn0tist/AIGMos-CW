  "semantics": {
    "marker": ">",
    "example": "#DWH:>warehouse:lights",
    "resolution_rule": "Remote marker resolves an explicit EXT endpoint identity and declared remote data binding.",
    "ac_rule": "With AccessCore active, governed remote dereference passes through DWH and remote authorization evaluation.",
    "direct_rule": "Direct `$EXT` dereference is disallowed for governed data access while AC is active.",
    "identity_rule": "Remote object/data identity remains owned by its origin/remote schema.",
    "readonly_rule": "Read-only external defaults remain enforced unless explicit remote mutation policy exists.",
    "failure_rule": "Unresolved endpoint/binding/authorization fails closed."
  },
