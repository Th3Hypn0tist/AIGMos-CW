    "invariants": [
      {
        "id": "DWH_BOUNDARY_EXPLICIT",
        "rule": "DWH data movement preserves explicit origin identity, schema, scope and remote authority boundaries; transport connectivity never becomes data authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "remote marker resolved fuzzily",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "AC-active remote read bypasses DWH",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "remote data copied into new local semantic identity without explicit import",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unresolved remote binding defaults open",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "read-only default bypassed",
        "result": "hard_fail"
      }
    ]
  },
