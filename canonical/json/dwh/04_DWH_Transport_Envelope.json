  "semantics": {
    "payload_types": [
      "text",
      "binary_file"
    ],
    "envelope_rule": "Transport envelope carries origin, target/binding, payload type and required provenance/security metadata.",
    "webrtc_rule": "WebRTC may provide the peer transport.",
    "crypto_rule": "PGP/session-key protection and handshake metadata are transport/security concerns and do not redefine payload semantics.",
    "md5_rule": "Where legacy/current handshake contract specifies MD5, its role is handshake compatibility/integrity metadata only and not semantic identity.",
    "domain_rule": "Transport envelope never becomes owner of domain payload semantics.",
    "validation_rule": "Unsupported payload type or invalid envelope fails before domain dispatch."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_BOUNDARY_EXPLICIT",
        "rule": "DWH data movement preserves explicit origin identity, schema, scope and remote authority boundaries; transport connectivity never becomes data authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "arbitrary undeclared payload type accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "transport session becomes domain identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "crypto metadata treated as payload semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "invalid envelope dispatched anyway",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "payload origin/binding metadata lost",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_WEBRTC",
      "target_ref": "AIGMOS_WEBRTC_TRANSPORT_CONTRACT",
