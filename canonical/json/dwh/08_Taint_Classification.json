    "role": "data-governance metadata",
    "classification_rule": "Taint labels are explicit typed metadata attached to lineage-tracked data.",
    "dimensions_example": [
      "external",
      "untrusted",
      "identity_scoped",
      "restricted",
      "derived_from_restricted"
    ],
    "policy_rule": "Exact labels and meanings are owned by explicit policy contracts; this contract defines the propagation mechanism, not business-specific label taxonomy.",
    "origin_rule": "Input may receive taint from origin classification before downstream transformation.",
    "identity_rule": "Taint metadata does not alter the canonical identity of the underlying value.",
    "authority_rule": "Taint classification does not itself grant read/write authority; policy may use it as an authorization/filtering input.",
    "visibility_rule": "Taint state is machine-readable for validation and monitoring."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_LINEAGE_EXPLICIT",
        "rule": "DWH lineage and taint state remain explicit, monotonic unless an authorized transformation says otherwise, and traceable to source evidence."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "taint inferred only from field name/path heuristic",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "taint metadata changes value identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "taint label grants authority by itself",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "untrusted/external input enters governed DWH without applicable classification evaluation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "taint state hidden from machine validation",
        "result": "hard_fail"
      }
    ]
  },
