  "semantics": {
    "origin_rule": "Input governance is evaluated at the origin where data enters the governed DWH path.",
    "scope_examples": [
      "all",
      "ext",
      "id"
    ],
    "scope_rule": "Remote input scope is explicit and evaluated against the origin input classification/policy.",
    "identity_rule": "Where identity-scoped input is used, exact resolved identity context is required.",
    "separation_rule": "Input permission does not imply output permission.",
    "ac_rule": "When AccessCore is active, AccessCore authorization is evaluated in addition to DWH input-boundary policy.",
    "failure_rule": "Unclassified/unresolved governed input fails according to explicit policy rather than default expansion.",
    "trace_rule": "Accepted/rejected input retains origin, scope, identity and policy refs."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_ORIGIN_TARGET_GOVERNANCE",
        "rule": "DWH applies data-boundary policy at the origin and target independently; remote addressing, transport reachability and external registration never substitute for AccessCore authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "input permission implies output permission",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "identity-scoped input has no exact identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "AC-active input bypasses AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unresolved scope expands to all",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "origin provenance lost",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_AC",
      "target_ref": "AIGMOS_ACCESSCORE_ASSURANCE_GATED_RESOURCE_CONTRACT",
      "purpose": "AC authorization remains orthogonal to DWH boundary policy."
    }
  ],
  "prose": {
    "summary": "Define DWH input governance at the data origin before local or remote processing, using the origin's declared input boundary independently from downstream output policy.",
    "notes": [
