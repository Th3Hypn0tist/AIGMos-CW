  "semantics": {
    "default_rule": "Taint cannot disappear implicitly.",
    "operation_rule": "Sanitization/declassification is an explicit canonical operation/transformation identity.",
    "authority_rule": "Operation requires explicit authority/policy approval for the affected classification.",
    "evidence_rule": "Result records source taint, transformation, authority/policy and resulting taint state.",
    "scope_rule": "Declassification applies only to the exact transformed output scope.",
    "partial_rule": "An operation may remove one taint dimension while preserving others.",
    "failure_rule": "If sanitization cannot prove its declared post-condition, output retains applicable source taint or operation fails."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_LINEAGE_EXPLICIT",
        "rule": "DWH lineage and taint state remain explicit, monotonic unless an authorized transformation says otherwise, and traceable to source evidence."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "taint disappears without explicit sanitization/declassification operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "declassification occurs without applicable authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "result lacks source/result taint evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "declassification broadens beyond exact transformed output",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "failed sanitization still emits clean-classified output",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_PROP",
      "target_ref": "AIGMOS_DWH_TAINT_PROPAGATION_CONTRACT",
      "purpose": "Default propagation remains monotonic unless explicitly declassified."
    },
    {
      "id": "REF_AUTH",
      "target_ref": "AIGMOS_STRUCTURE_AUTHORITY_CONTRACT",
      "purpose": "Declassification authority is explicit."
    }
  ],
  "prose": {
    "summary": "Define the only explicit path for reducing or transforming DWH taint: an authorized declared sanitization/declassification operation with evidence, scope and resulting classification.",
