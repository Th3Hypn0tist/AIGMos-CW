  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define `>` as the governed DWH remote-address marker, separating remote target resolution from local DWH addressing and from raw `$EXT` registration.",
  "scope": {
    "owns": [
      "DWH Remote Addressing semantics"
    ],
