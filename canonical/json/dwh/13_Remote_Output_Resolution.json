    "schema_rule": "Output fields/types follow the declared resolved schema.",
    "relation_rule": "Relation-based remote resolution requires predeclared relation/FK semantics.",
    "raw_rule": "Raw remote source state is not exposed as canonical output unless explicitly modeled.",
