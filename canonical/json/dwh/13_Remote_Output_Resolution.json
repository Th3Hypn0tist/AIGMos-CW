        "condition": "undeclared relation/FK used for remote resolution",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "schema validation bypassed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "output drops lineage/taint",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "resolution bypasses authorization",
        "result": "hard_fail"
      }
    ]
