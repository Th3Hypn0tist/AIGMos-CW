  "semantics": {
    "readonly_rule": "Read-only remote projection exposes no mutating operations.",
    "interface_rule": "Mutators are absent/hidden from the projected interface where the boundary is read-only.",
    "policy_rule": "A separate explicit writable remote contract/policy is required to expose mutation.",
    "ac_rule": "Remote AccessCore authorization still applies to reads and any separately permitted writes.",
    "schema_rule": "Read-only projection retains the same schema/identity provenance as its source.",
    "failure_rule": "Attempted undeclared mutation hard-fails and cannot fall through to raw transport/EXT operation.",
    "transport_rule": "Transport capability to send data does not imply writable semantic interface."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_ORIGIN_TARGET_GOVERNANCE",
        "rule": "DWH applies data-boundary policy at the origin and target independently; remote addressing, transport reachability and external registration never substitute for AccessCore authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "read-only interface exposes mutators as normal operations",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "transport send capability treated as write authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "raw EXT mutation bypasses DWH read-only boundary",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "AccessCore skipped for remote reads",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "writable mode inferred implicitly",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ADDR",
      "target_ref": "AIGMOS_DWH_REMOTE_ADDRESSING_CONTRACT",
      "purpose": "Read-only projection applies after governed remote resolution."
