      "semantics": {
        "purpose": "Define lineage records as explicit provenance graphs connecting exact source data identities, transformations and derived outputs without turning lineage itself into the semantic owner of the data.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
