  "semantics": {
    "identity_rule": "Caller identity/assurance context is propagated from origin according to IAM semantics.",
    "rights_rule": "Remote target evaluates rights using its own AccessCore policy.",
    "nonexpansion_rule": "Delegated remote path cannot expand rights beyond what the remote policy grants.",
    "local_rule": "Local owner authority and delegated remote authority remain distinct.",
    "transport_rule": "Authenticated/encrypted transport does not itself grant DWH rights.",
    "failure_rule": "Denied remote operation returns explicit authorization failure without fallback to direct EXT access."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_POLICY_EXPLICIT",
        "rule": "DWH scope, release, remote access and policy decisions remain explicit, provenance-preserving and separate from transport reachability."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "remote rights copied blindly from origin",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "transport authentication grants DWH rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "delegated remote path expands remote rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "denial falls back to direct EXT dereference",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "caller identity lost at remote policy boundary",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_AC",
      "target_ref": "AIGMOS_ACCESSCORE_AUTHORIZATION_CONTRACT",
      "purpose": "Remote target owns authorization decision."
    },
    {
      "id": "REF_ID",
      "target_ref": "AIGMOS_IAM_IDENTITY_PROPAGATION_CONTRACT",
      "purpose": "Origin identity remains traceable."
    }
  ],
  "prose": {
    "summary": "Define remote DWH authorization so identity originates at the caller/origin while rights are evaluated by the remote target's AccessCore policy.",
    "notes": [
