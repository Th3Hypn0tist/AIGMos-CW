    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the final DWH release decision as composition of requested scope, schema resolution, taint/classification, identity/authorization and destination policy before data crosses an external boundary.",
  "scope": {
    "owns": [
      "DWH Data Release Policy semantics"
    ],
    "does_not_own": [
      "domain payload semantics",
      "transport implementation",
      "presentation semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DWH_DATA_RELEASE",
      "name": "DWH Data Release Policy",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the final DWH release decision as composition of requested scope, schema resolution, taint/classification, identity/authorization and destination policy before data crosses an external boundary.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "inputs": [
      "requested remote scope",
      "resolved schema/data target",
      "lineage/taint state",
      "caller identity/assurance",
      "AccessCore rights",
      "destination/external identity"
    ],
    "decision_states": [
      "allow",
      "deny",
      "allow_transformed"
    ],
    "transform_rule": "allow_transformed requires an explicit authorized projection/sanitization/declassification operation.",
    "least_release_rule": "Only data required and permitted for the explicit request is released.",
    "evidence_rule": "Decision records policy inputs, result and transformation refs where applicable.",
    "failure_rule": "Missing required policy input fails closed.",
    "transport_rule": "Release decision occurs independently from transport availability."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_POLICY_EXPLICIT",
        "rule": "DWH scope, release, remote access and policy decisions remain explicit, provenance-preserving and separate from transport reachability."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "missing policy input defaults to allow",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "release exceeds requested/authorized scope",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "taint ignored in release decision",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "allow_transformed lacks explicit transformation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "transport availability treated as release permission",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DEC",
      "target_ref": "AIGMOS_DWH_SANITIZATION_DECLASSIFICATION_CONTRACT",
      "purpose": "Transformed release uses explicit declassification/sanitization."
    }
  ],
  "prose": {
    "summary": "Define the final DWH release decision as composition of requested scope, schema resolution, taint/classification, identity/authorization and destination policy before data crosses an external boundary.",
    "notes": [
      "Unlocked pending reconciliation against DWH local/remote, AC/IAM and lineage contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
