  "semantics": {
    "operation_rule": "Declassification is an explicit canonical operation/policy decision.",
    "authority_rule": "Lowering classification requires explicit authority independent from ordinary read/transform rights.",
    "evidence_rule": "Operation records source classification, target classification, method/rule, actor, reason/policy and output refs.",
    "sanitization_rule": "Sanitization/anonymization claims are tied to an explicit method/profile/version.",
    "nonimplicit_rule": "Aggregation, formatting, serialization or transport never implicitly declassifies data.",
    "failure_rule": "Failed/unsupported declassification leaves original classification in force.",
    "trace_rule": "Declassified output retains provenance to original restricted sources and declassification evidence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LINEAGE_PROVENANCE_PRESERVED",
        "rule": "Derived DWH data retains explicit source lineage, transformation provenance and applicable classification/taint state; transformations never silently erase origin or governance metadata."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "aggregation silently lowers classification",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "ordinary write permission allows declassification",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "declassification lacks actor/rule/evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "failed sanitization emits lower-classified output",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "original restricted lineage erased",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TAINT",
      "target_ref": "AIGMOS_DWH_TAINT_PROPAGATION_CONTRACT",
      "purpose": "Only explicit declassification may lower propagated classification."
    }
  ],
  "prose": {
    "summary": "Define explicit authorized declassification/sanitization operations as the only mechanism allowed to lower governed classification/taint on derived data.",
