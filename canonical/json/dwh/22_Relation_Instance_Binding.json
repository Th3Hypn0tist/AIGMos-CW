  "semantics": {
    "binding_type": "relation",
    "source_rule": "Relation binding starts from an exact source instance/schema/record identity.",
    "relation_rule": "Binding references an exact predeclared canonical relation identity.",
    "fk_rule": "Required foreign-key/reference field binding must already be declared and schema-valid.",
    "target_rule": "Relation resolution yields exact target instance/record/resource identity according to the relation contract.",
    "inference_rule": "Relations are never inferred from matching names, values or physical proximity.",
    "cardinality_rule": "Resolution obeys declared relation cardinality.",
    "ownership_rule": "Traversing a relation does not transfer ownership.",
    "authority_rule": "Each target data access remains independently governed."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_SCHEMA_OWNERSHIP_PRESERVED",
        "rule": "DWH resolves and projects schemas/relations but never becomes the semantic owner of module domain models; local/relation bindings require exact declared identities and cannot be inferred from names or proximity."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "relation inferred from equal field names",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "undeclared FK used",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "target instance guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "relation cardinality ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "source authorization automatically grants target access",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
