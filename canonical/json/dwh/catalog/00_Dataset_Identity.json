  "semantics": {
    "identity_rule": "Every cataloged dataset has an explicit stable dataset identity.",
    "resource_rule": "Dataset references exact instance/schema/resource/field/query/projection identities as applicable.",
    "schema_rule": "Dataset schema binding is explicit and does not replace schema identity.",
    "storage_rule": "Physical storage location/backend is a binding only.",
    "result_rule": "A transient query result is not automatically a dataset identity.",
    "ownership_rule": "Dataset catalog identity does not transfer ownership from underlying resource owners.",
    "version_rule": "Dataset version/profile is explicit where its semantic scope changes.",
    "authority_rule": "Dataset visibility does not grant data access."
  },
  "constraints": {
    "invariants": [
      {
        "id": "CATALOG_NONAUTHORITY",
        "rule": "Catalog and metadata records describe exact DWH resources and evidence; discovery, labels, annotations, ranking or catalog visibility never replace canonical resource identity, semantic ownership, classification policy or authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "storage path used as dataset identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "query result auto-promoted to dataset",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "dataset becomes owner of source schema",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "dataset visibility grants read authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "schema and dataset identities conflated",
        "result": "hard_fail"
      }
    ]
  },
