  "identity": {
    "id": "AIGMOS_DWH_METADATA_ANNOTATION_CONTRACT",
    "name": "DWH Metadata Annotation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define descriptive annotations, tags, labels, owners/stewards, glossary refs and documentation as explicit metadata records bound to exact target identities without becoming semantic truth by annotation alone.",
  "scope": {
    "owns": [
      "DWH Metadata Annotation semantics"
    ],
    "does_not_own": [
      "source domain semantics",
      "AccessCore policy ownership",
      "physical storage ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DWH_METADATA_ANNOTATION",
      "name": "DWH Metadata Annotation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define descriptive annotations, tags, labels, owners/stewards, glossary refs and documentation as explicit metadata records bound to exact target identities without becoming semantic truth by annotation alone.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "annotation_rule": "Each machine-significant annotation has an explicit identity or explicit target+key/value record identity according to profile.",
    "target_rule": "Annotation binds exact dataset/schema/field/relation/resource identity.",
    "types": [
      "description",
      "tag",
      "label",
      "owner_ref",
      "steward_ref",
      "glossary_ref",
      "business_term_ref",
      "documentation_ref",
      "custom declared metadata"
    ],
    "source_rule": "Annotation source/author/provenance is explicit where relevant.",
    "truth_rule": "Human-authored metadata is descriptive evidence and never canonical domain truth merely by presence.",
    "conflict_rule": "Conflicting annotations coexist/reconcile explicitly rather than newest-wins by timestamp.",
    "localization_rule": "Human-facing labels/descriptions may use localization refs without changing internal identifiers.",
    "authority_rule": "Metadata authorship/ownership label does not automatically create AccessCore rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "CATALOG_NONAUTHORITY",
        "rule": "Catalog and metadata records describe exact DWH resources and evidence; discovery, labels, annotations, ranking or catalog visibility never replace canonical resource identity, semantic ownership, classification policy or authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "annotation label replaces canonical field identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "latest annotation silently overwrites conflicting meaning",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "owner tag grants AccessCore authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "description treated as executable rule",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "localized label changes internal identifier",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_LABEL",
      "target_ref": "AIGMOS_LOCALIZATION_LABEL_CONTEXT_CONTRACT",
      "purpose": "Human-facing metadata can use localized labels/context."
    }
  ],
  "prose": {
    "summary": "Define descriptive annotations, tags, labels, owners/stewards, glossary refs and documentation as explicit metadata records bound to exact target identities without becoming semantic truth by annotation alone.",
    "notes": [
      "Unlocked pending reconciliation against DWH schema, lineage, classification and discovery contracts."
    ]
  },
