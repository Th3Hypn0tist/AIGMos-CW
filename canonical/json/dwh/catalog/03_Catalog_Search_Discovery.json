    {
      "id": "TOPIC_DWH_CATALOG_SEARCH_DISCOVERY",
      "name": "DWH Catalog Search and Discovery",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define metadata search, filtering, faceting and ranking as non-authoritative discovery projections over catalog entries, with exact result identities and governance-aware visibility.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "query_rule": "Catalog search query/filter/facet profile is explicit.",
    "result_rule": "Search results return exact catalog-entry and underlying resource refs.",
    "ranking_rule": "Ranking/relevance is derived discovery evidence and not semantic priority.",
    "visibility_rule": "Search only exposes metadata permitted by catalog/access policy.",
    "data_rule": "Catalog discovery does not read underlying data unless a separate authorized preview/query is invoked.",
    "facet_rule": "Facets derive from explicit metadata fields/tags/classifications.",
    "ambiguity_rule": "Similar names never merge resource identities.",
    "authority_rule": "Search-result presence grants no data access or mutation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "CATALOG_NONAUTHORITY",
        "rule": "Catalog and metadata records describe exact DWH resources and evidence; discovery, labels, annotations, ranking or catalog visibility never replace canonical resource identity, semantic ownership, classification policy or authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "ranked first result treated as canonical source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "similar names merged",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "catalog search reads restricted source data implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "result presence grants read authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "facet invents classification",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REG",
      "target_ref": "AIGMOS_DWH_CATALOG_REGISTRATION_CONTRACT",
      "purpose": "Search operates on explicit catalog entries."
    }
  ],
  "prose": {
    "summary": "Define metadata search, filtering, faceting and ranking as non-authoritative discovery projections over catalog entries, with exact result identities and governance-aware visibility.",
    "notes": [
      "Unlocked pending reconciliation against DWH schema, lineage, classification and discovery contracts."
    ]
  },
