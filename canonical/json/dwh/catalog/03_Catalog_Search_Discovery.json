    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define metadata search, filtering, faceting and ranking as non-authoritative discovery projections over catalog entries, with exact result identities and governance-aware visibility.",
  "scope": {
    "owns": [
      "DWH Catalog Search and Discovery semantics"
    ],
    "does_not_own": [
      "source domain semantics",
      "AccessCore policy ownership",
      "physical storage ownership"
    ]
  },
