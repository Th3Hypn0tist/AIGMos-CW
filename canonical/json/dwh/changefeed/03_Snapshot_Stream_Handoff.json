    "name": "DWH Snapshot to Stream Handoff",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a lossless/explicit handoff from an initial DWH snapshot/query result into subsequent changefeed consumption without gaps or ambiguous double-application.",
  "scope": {
    "owns": [
      "DWH Snapshot to Stream Handoff semantics"
    ],
    "does_not_own": [
      "source domain ownership",
      "Event execution authority",
      "AccessCore policy ownership"
    ]
  },
