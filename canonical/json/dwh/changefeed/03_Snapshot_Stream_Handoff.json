    {
      "id": "TOPIC_DWH_SNAPSHOT_STREAM_HANDOFF",
      "name": "DWH Snapshot to Stream Handoff",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a lossless/explicit handoff from an initial DWH snapshot/query result into subsequent changefeed consumption without gaps or ambiguous double-application.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "snapshot_rule": "Initial state is anchored to an exact snapshot/revision/watermark boundary.",
    "stream_rule": "Changefeed begins from the exact continuation position associated with that boundary.",
    "gap_rule": "No-gap guarantee may be claimed only when source profile proves snapshot/stream continuity.",
    "duplicate_rule": "Overlap, if used for safety, requires explicit deduplication by exact change identity/revision.",
    "identity_rule": "Snapshot identity, subscription identity and stream cursor remain distinct.",
    "consistency_rule": "Handoff consistency profile is explicit.",
    "failure_rule": "Unknown handoff point hard-fails/requires resnapshot rather than guessing.",
    "lineage_rule": "Consumers can trace current state back to snapshot plus subsequent changes."
  },
  "constraints": {
    "invariants": [
      {
        "id": "CHANGEFEED_NONEXECUTION",
        "rule": "DWH changefeeds expose committed mutation evidence as ordered provenance-bearing data/events; subscription delivery never directly executes downstream operations and never replaces the underlying record/revision identities."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "snapshot and stream positions guessed independently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "gap silently ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "overlap duplicates mutations without dedupe",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "snapshot id reused as cursor",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "no-gap guarantee claimed without source evidence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SNAP",
      "target_ref": "AIGMOS_DWH_SNAPSHOT_CHECKPOINT_CONTRACT",
      "purpose": "Initial state anchors exact snapshot boundary."
    },
    {
      "id": "REF_WATER",
      "target_ref": "AIGMOS_DWH_SYNC_WATERMARK_CONTRACT",
      "purpose": "Stream continuation uses exact source position."
    }
  ],
  "prose": {
    "summary": "Define a lossless/explicit handoff from an initial DWH snapshot/query result into subsequent changefeed consumption without gaps or ambiguous double-application.",
    "notes": [
      "Unlocked pending reconciliation against DWH mutation/persistence, Event causality, sync and remote-sharing contracts."
    ]
  },
