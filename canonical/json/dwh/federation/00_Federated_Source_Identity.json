  "semantics": {
    "identity_rule": "Each federated source has an explicit logical source/origin identity.",
    "origin_rule": "Origin identity remains distinct from transport endpoint, EXT registration and local federation alias.",
    "instance_rule": "Source resolves exact remote/local instance identity.",
    "schema_rule": "Participating schemas/resources are explicit refs.",
    "governance_rule": "Each source retains its own authorization, assurance, classification and output-governance boundary.",
    "ownership_rule": "Federation never transfers semantic ownership to the querying node.",
    "availability_rule": "reachable, authorized, schema-compatible and query-participating are distinct states.",
    "alias_rule": "Federation aliases are bindings only and never replace origin identity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "FEDERATION_PRESERVES_ORIGIN",
        "rule": "Federated DWH access preserves each origin's exact identity, schema, governance, lineage and consistency evidence; combining results never centralizes semantic ownership or silently expands authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "remote endpoint used as semantic source identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "local alias replaces origin identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "federation query node becomes owner of remote data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reachability treated as authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "source schema inferred fuzzily",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
