    "definition_rule": "Canonical query definition remains distinct from derived federated execution plan.",
    "plan_rule": "Plan identifies exact participating source identities and per-source query fragments.",
    "combine_rule": "Cross-source join/union/aggregation operations are explicit plan nodes.",
    "capability_rule": "Plan respects each source's declared query capabilities and schema compatibility.",
    "optimization_rule": "Optimizer may choose among semantically equivalent plans but cannot change query semantics or governance.",
    "identity_rule": "Plan/execution identity is distinct from source, query definition and result-set identity.",
