    "pushdown_types": [
      "filter",
      "projection",
      "aggregation",
      "limit/order where semantically safe",
      "other declared compatible operation"
    ],
    "capability_rule": "Pushdown requires explicit source capability support.",
    "semantic_rule": "Delegated operation must be semantically equivalent under the source profile.",
    "governance_rule": "Pushdown must not require unauthorized hidden fields/data exposure.",
    "classification_rule": "Remote/local processing preserves equivalent classification/taint semantics.",
    "lineage_rule": "Pushed-down derived results retain origin and transformation provenance.",
    "fallback_rule": "If safe pushdown is unavailable, planner may process locally only if authorized data projection permits it.",
    "authority_rule": "Remote execution capability does not grant query authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "FEDERATION_PRESERVES_ORIGIN",
        "rule": "Federated DWH access preserves each origin's exact identity, schema, governance, lineage and consistency evidence; combining results never centralizes semantic ownership or silently expands authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "filter pushdown changes null semantics silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "aggregation pushdown declassifies data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "remote capability treated as authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "hidden restricted field fetched for local filtering without governance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "fallback silently broadens projected data",
        "result": "hard_fail"
      }
    ]
  },
