    "decision_states": [
      "allow",
      "deny",
      "filtered",
      "masked",
      "redacted",
      "unknown",
      "error"
    ],
    "identity_rule": "Each machine-significant governance decision/evaluation has an explicit execution/evidence identity.",
    "policy_rule": "Decision references exact governance policy/binding version.",
    "subject_rule": "Caller/session/peer/context refs are explicit where applicable.",
    "target_rule": "Decision references exact resource/field/query/projection scope.",
    "revision_rule": "Decision may bind to exact source revision/snapshot/watermark where relevant.",
    "redaction_rule": "Decision evidence must not leak values that the decision itself denied.",
    "accesscore_rule": "DWH governance evidence is distinct from AccessCore authorization-decision evidence.",
    "immutability_rule": "Past decision evidence is append/history governed."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_GOVERNANCE_NONEXPANSION",
        "rule": "DWH governance may restrict or project data according to exact schema/classification/scope policy but never creates AccessCore rights, semantic ownership or broader visibility than the underlying authorized source set."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "denial log leaks denied field value",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "decision lacks policy version",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "DWH decision conflated with AccessCore result",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "past denial rewritten",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "target scope ambiguous",
        "result": "hard_fail"
      }
    ]
  },
