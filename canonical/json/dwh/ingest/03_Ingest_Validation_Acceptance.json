  },
  "semantics": {
    "flow": [
      "parse source profile",
      "resolve field mappings",
      "apply declared transformations",
      "validate destination schema",
      "evaluate quality profile",
      "evaluate origin/input scope",
      "authorize destination mutation",
      "commit write/transaction",
      "record lineage/result"
    ],
    "candidate_rule": "Parsed/mapped/transformed data remains candidate/inert until accepted.",
    "schema_rule": "Destination schema validation precedes accepted write.",
    "quality_rule": "Applicable quality validation/gates are explicit.",
    "scope_rule": "Remote/local input scope is evaluated at origin/receiving boundary.",
    "authorization_rule": "Destination write authorization is evaluated independently from source reachability.",
    "atomic_rule": "Failed ingest does not partially mutate accepted state unless an explicit partial-batch profile says so.",
    "lineage_rule": "Accepted data retains source, mapping, transformation and write provenance.",
    "failure_rule": "Rejected input remains rejected/quarantined/evidenced according to profile and never masquerades as accepted."
  },
  "constraints": {
    "invariants": [
      {
        "id": "INGEST_MAPPING_EXPLICIT",
        "rule": "External/input data enters DWH only through explicit source profiles, exact field/schema mappings and validated transformations; mapping never transfers ownership, fabricates missing semantics or bypasses origin governance."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "mapped data writes before schema validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "source reachability substitutes for authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed ingest leaves ambiguous partial state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "rejected input shown as accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "lineage loses source/mapping/transform refs",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_QUALITY",
      "target_ref": "AIGMOS_DWH_QUALITY_VALIDATION_PROFILE_CONTRACT",
      "purpose": "Quality gates participate in ingest acceptance."
    },
    {
      "id": "REF_WRITE",
      "target_ref": "AIGMOS_DWH_WRITE_OPERATION_IDENTITY_CONTRACT",
