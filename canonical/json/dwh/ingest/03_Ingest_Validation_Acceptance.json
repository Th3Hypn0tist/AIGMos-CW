  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define ingest as parse→map→transform→schema validate→quality validate→authorize→write, with candidate data inert until all required acceptance gates succeed.",
  "scope": {
    "owns": [
      "DWH Ingest Validation and Acceptance Boundary semantics"
    ],
    "does_not_own": [
      "source domain ownership",
      "destination schema ownership",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DWH_INGEST_VALIDATION_ACCEPTANCE",
      "name": "DWH Ingest Validation and Acceptance Boundary",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define ingest as parse→map→transform→schema validate→quality validate→authorize→write, with candidate data inert until all required acceptance gates succeed.",
