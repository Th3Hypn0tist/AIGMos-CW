    "events": [],
    "flows": []
  },
  "semantics": {
    "binding_rule": "Mapping profile binds exact source-profile version and destination-schema version/compatibility range.",
    "change_rule": "Source/destination version change triggers explicit compatibility evaluation.",
    "compatibility_states": [
      "compatible",
      "revalidation_required",
      "remap_required",
      "migration_required",
      "incompatible"
    ],
    "stale_rule": "Stale mapping never continues silently when referenced field identities/types/semantics changed incompatibly.",
    "identity_rule": "Mapping version/profile identity is separate from source/destination schema identities.",
    "migration_rule": "Mapping migration is explicit and preserves prior mapping history.",
    "test_rule": "Compatible mapping claims may require fixtures/conformance tests where declared.",
    "failure_rule": "Unresolved mapping incompatibility blocks ingest rather than guessing new bindings."
  },
  "constraints": {
    "invariants": [
      {
        "id": "INGEST_MAPPING_EXPLICIT",
        "rule": "External/input data enters DWH only through explicit source profiles, exact field/schema mappings and validated transformations; mapping never transfers ownership, fabricates missing semantics or bypasses origin governance."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "stale mapping silently continues",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "renamed field auto-bound by display name",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "source version change ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "mapping history overwritten",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "incompatible mapping falls back to positional mapping",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SCHEMA_MIG",
      "target_ref": "AIGMOS_DWH_SCHEMA_COMPATIBILITY_PROFILE_CONTRACT",
      "purpose": "Destination schema changes use explicit compatibility evidence."
    },
    {
      "id": "REF_MAP",
      "target_ref": "AIGMOS_DWH_FIELD_MAPPING_CONTRACT",
      "purpose": "Mapping version governs exact field bindings."
    }
  ],
  "prose": {
    "summary": "Define compatibility and migration rules when source schema/profile, field mapping or destination schema versions change, preventing stale mappings from silently producing wrong semantics.",
