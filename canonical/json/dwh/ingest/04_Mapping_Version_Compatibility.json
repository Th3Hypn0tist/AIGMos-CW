    "name": "DWH Mapping Version Compatibility",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define compatibility and migration rules when source schema/profile, field mapping or destination schema versions change, preventing stale mappings from silently producing wrong semantics.",
  "scope": {
    "owns": [
      "DWH Mapping Version Compatibility semantics"
    ],
    "does_not_own": [
      "source domain ownership",
      "destination schema ownership",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DWH_MAPPING_VERSION_COMPATIBILITY",
      "name": "DWH Mapping Version Compatibility",
      "type": "topic",
