        "id": "RETENTION_EXPLICIT",
        "rule": "Retention, archival, expiry, purge and hold state are explicit lifecycle semantics over exact data identities; time passage, storage movement or archive location never silently deletes, declassifies, transfers ownership or restores data."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "archive path used as lifecycle identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "moving storage silently changes ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "archived data implicitly declassified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "time passage silently purges without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "lifecycle visibility grants delete authority",
        "result": "hard_fail"
      }
