    "policy_rule": "Each retention policy has an explicit canonical identity.",
    "scope_rule": "Policy targets exact schema/resource/classification/instance/data-scope identities.",
    "duration_rule": "Retention duration or condition is explicit.",
    "anchor_rule": "Retention anchor is explicit, e.g. creation time, accepted revision time, project completion or other declared event.",
    "transition_rule": "Policy declares resulting action such as archive, expire, tombstone or purge-candidate.",
    "priority_rule": "Multiple applicable policies use explicit precedence/combination semantics, never file order.",
    "classification_rule": "Retention policy does not override classification/declassification semantics.",
    "authority_rule": "Policy eligibility does not itself authorize destructive transition."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RETENTION_EXPLICIT",
        "rule": "Retention, archival, expiry, purge and hold state are explicit lifecycle semantics over exact data identities; time passage, storage movement or archive location never silently deletes, declassifies, transfers ownership or restores data."
      }
    ],
    "hard_gates": [
