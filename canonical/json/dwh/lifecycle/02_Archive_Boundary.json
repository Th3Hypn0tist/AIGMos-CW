        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed copy marks source archived",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "lineage lost in archive",
        "result": "hard_fail"
      },
      {
