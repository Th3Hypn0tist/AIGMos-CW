    "archive_rule": "Archive operation targets exact data scope/revision/snapshot identities.",
    "storage_rule": "Archive may move data to a different storage binding/tier through explicit migration.",
    "identity_rule": "Archival does not create a new semantic data identity merely because physical location changes.",
    "integrity_rule": "Archive artifact/binding retains explicit integrity evidence.",
    "lineage_rule": "Source lineage and revision provenance remain preserved.",
    "classification_rule": "Archived data retains source classification and AccessCore governance.",
    "availability_rule": "Read/restore availability of archived data is explicit.",
    "failure_rule": "Failed archive does not mark source archived unless transition completed according to profile."
  },
