    "identity_rule": "Every machine-significant migration has an explicit stable identity.",
    "source_rule": "Migration references exact source schema identity/version.",
    "target_rule": "Migration references exact target schema identity/version.",
    "direction_rule": "Forward and reverse/rollback migrations are separate explicit semantics.",
    "transformation_rule": "Field/relation/data transformation operations are explicit refs.",
    "criteria_rule": "Preconditions, validation criteria and postconditions are explicit.",
    "ownership_rule": "Migration does not transfer domain ownership away from the schema owner.",
    "authority_rule": "Migration definition visibility does not grant execution authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SCHEMA_EVOLUTION_EXPLICIT",
        "rule": "Schema evolution is an explicit versioned migration between exact schema identities/versions with validated compatibility and data transformation provenance; runtime/file order never silently changes active data meaning."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "migration inferred only from version number difference",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "source/target schema ambiguous",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "reverse migration assumed automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "migration changes ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "migration visibility grants execution authority",
        "result": "hard_fail"
      }
    ]
  },
