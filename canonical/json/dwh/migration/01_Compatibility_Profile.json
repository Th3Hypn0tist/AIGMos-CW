    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "classes": [
      "backward_compatible",
      "forward_compatible",
      "bidirectionally_compatible",
      "migration_required",
      "breaking_new_identity"
    ],
    "field_rule": "Add/remove/rename/type/cardinality/default/nullability changes are classified explicitly.",
    "relation_rule": "Relation/FK/cardinality changes participate in compatibility analysis.",
    "identity_rule": "Breaking semantic identity change requires a new identity when additive evolution cannot preserve meaning.",
    "default_rule": "Missing compatibility metadata never defaults to compatible.",
    "consumer_rule": "Compatibility is evaluated against exact consumer/profile requirements.",
    "order_rule": "Version string ordering alone does not prove compatibility.",
    "validation_rule": "Compatibility result is derived evidence tied to exact source/target schema versions."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SCHEMA_EVOLUTION_EXPLICIT",
        "rule": "Schema evolution is an explicit versioned migration between exact schema identities/versions with validated compatibility and data transformation provenance; runtime/file order never silently changes active data meaning."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "version number increase assumed compatible",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "breaking semantic change kept under same identity without explicit policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "missing metadata treated compatible",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "relation change ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "compatibility decided by file order",
        "result": "hard_fail"
      }
    ]
  },
