  "semantics": {
    "source_rule": "Backfill reads exact source schema/version/record revisions.",
    "target_rule": "Writes target exact target schema/version/instance identities.",
    "transform_rule": "Transformation rule/profile/version is explicit.",
    "lineage_rule": "Migrated values retain source record/revision and transformation provenance.",
    "classification_rule": "Classification/taint propagates through migration.",
    "quality_rule": "Target validation/quality rules run before migrated data is accepted.",
    "batch_rule": "Batching/chunking is execution strategy and does not alter migration semantics.",
    "idempotency_rule": "Re-running an accepted migration batch is idempotent or explicitly conflict-detected.",
    "authority_rule": "Backfill uses normal DWH write/transaction authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SCHEMA_EVOLUTION_EXPLICIT",
        "rule": "Schema evolution is an explicit versioned migration between exact schema identities/versions with validated compatibility and data transformation provenance; runtime/file order never silently changes active data meaning."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "backfill loses source revision provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "migration silently declassifies",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "batch order changes semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "invalid target data accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "rerun duplicates records silently",
        "result": "hard_fail"
      }
    ]
  },
