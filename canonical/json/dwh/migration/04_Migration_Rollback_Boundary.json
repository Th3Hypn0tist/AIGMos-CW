  "semantics": {
    "reversible_rule": "Migration explicitly declares reversible, conditionally_reversible or irreversible.",
    "snapshot_rule": "Rollback requirements may include exact pre-migration snapshot/checkpoint.",
    "reverse_rule": "Reverse transformation is an explicit migration operation/profile.",
    "loss_rule": "Potential data loss or non-representable target-version data is detected and surfaced before rollback.",
    "conflict_rule": "Writes made after cutover are considered explicitly during rollback planning.",
    "authority_rule": "Rollback requires explicit migration/recovery authorization.",
    "atomic_rule": "Rollback accepted-state transition follows explicit transaction/restore semantics.",
    "history_rule": "Forward migration and rollback evidence remain preserved."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SCHEMA_EVOLUTION_EXPLICIT",
        "rule": "Schema evolution is an explicit versioned migration between exact schema identities/versions with validated compatibility and data transformation provenance; runtime/file order never silently changes active data meaning."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "forward migration assumed reversible",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "rollback silently drops new-version data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "pre-migration state guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "post-cutover writes ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "rollback erases migration history",
        "result": "hard_fail"
      }
    ]
  },
