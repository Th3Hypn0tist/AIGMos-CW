  "semantics": {
    "statistics_types": [
      "row_count",
      "distinct_count",
      "null_fraction",
      "distribution/histogram",
      "size",
      "selectivity",
      "other declared metric"
    ],
    "identity_rule": "Each statistics set/evidence record has an explicit identity.",
    "scope_rule": "Statistics reference exact schema/resource/field and source revision/snapshot/watermark.",
    "derived_rule": "Statistics are derived evidence and never canonical business/domain truth.",
    "freshness_rule": "Collection time and source revision/watermark are explicit.",
    "stale_rule": "Stale statistics remain identifiable and may affect planning quality but not query semantics.",
    "privacy_rule": "Statistics exposure obeys governance where distributions may reveal sensitive information.",
    "authority_rule": "Statistics do not grant source data authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "OPTIMIZATION_NONSEMANTIC",
        "rule": "Indexes, statistics, caches and optimizer plans may change execution strategy only; they never change canonical query semantics, data identity, ownership, classification or authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "statistics shown as domain truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "source revision omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "stale stats treated as current without evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "statistics bypass privacy governance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "statistics grant underlying data access",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
