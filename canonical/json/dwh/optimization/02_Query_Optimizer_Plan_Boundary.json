    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define optimizer plans as derived execution strategies that may choose indexes, join order, pushdown and algorithms only when semantically and governance equivalent to the canonical query.",
  "scope": {
    "owns": [
      "DWH Query Optimizer Plan Boundary semantics"
    ],
    "does_not_own": [
      "source schema ownership",
      "AccessCore policy ownership",
      "query semantic ownership"
    ]
  },
