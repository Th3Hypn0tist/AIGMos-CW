    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define consistent DWH snapshots/checkpoints as explicit captured state identities over exact data scopes and revisions, separate from live data and runtime activation snapshots.",
  "scope": {
    "owns": [
      "DWH Snapshot and Checkpoint semantics"
    ],
    "does_not_own": [
      "domain schema ownership",
      "AccessCore policy ownership",
      "storage-engine implementation internals"
    ]
  },
