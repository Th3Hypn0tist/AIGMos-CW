  "semantics": {
    "identity_rule": "Every quality rule has an explicit stable canonical identity.",
    "target_rule": "Rule targets exact schema, field, relation, record type or declared resource identities.",
    "rule_types": [
      "required",
      "type",
      "range",
      "pattern",
      "referential",
      "uniqueness",
      "completeness",
      "consistency",
      "freshness",
      "custom declared rule"
    ],
    "semantics_rule": "Evaluation predicate/profile and pass/fail/unknown semantics are explicit.",
    "version_rule": "Rule version/profile is explicit where changes affect interpretation.",
    "ownership_rule": "Quality rule does not take ownership of the data it evaluates.",
    "authority_rule": "Rule pass/fail is not an AccessCore authorization decision.",
    "mutation_rule": "Rule evaluation is read-only unless a separate remediation operation is invoked."
  },
  "constraints": {
    "invariants": [
      {
        "id": "QUALITY_EVIDENCE_NONAUTHORITY",
        "rule": "Data-quality rules and results produce explicit evidence about exact data/schema identities; they never silently rewrite source data, change semantic ownership, declassify content or become authorization decisions."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "quality rule target inferred by display label",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "rule mutates source while evaluating",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "rule result grants/denies AccessCore directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "rule identity inferred from filename",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "rule semantics change without version/profile evidence",
        "result": "hard_fail"
      }
    ]
  },
