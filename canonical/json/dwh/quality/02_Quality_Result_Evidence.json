  "semantics": {
    "result_states": [
      "pass",
      "fail",
      "warning",
      "unknown",
      "not_evaluated"
    ],
    "result_rule": "Each machine-significant result has an explicit result/evidence identity.",
    "rule_ref": "Result references exact quality rule/profile/version.",
    "target_rule": "Result references exact evaluated record/resource/field and applicable revision/snapshot.",
    "observation_rule": "Observed violating values/metrics may be recorded subject to redaction policy.",
    "time_rule": "Evaluation time and source revision are explicit.",
    "immutability_rule": "Past result evidence is append/history governed and never rewritten to hide prior failures.",
    "derived_rule": "Quality score/status is derived evidence and not source data identity.",
    "classification_rule": "Quality evidence inherits/protects sensitive source content according to governance."
  },
  "constraints": {
    "invariants": [
      {
        "id": "QUALITY_EVIDENCE_NONAUTHORITY",
        "rule": "Data-quality rules and results produce explicit evidence about exact data/schema identities; they never silently rewrite source data, change semantic ownership, declassify content or become authorization decisions."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "quality failure overwritten after later pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "result detached from exact source revision",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "quality score replaces source identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "sensitive violating value exposed without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "result fabricated without rule/execution refs",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_RULE",
      "target_ref": "AIGMOS_DWH_QUALITY_RULE_IDENTITY_CONTRACT",
      "purpose": "Every result binds exact rule semantics."
    },
    {
      "id": "REF_REV",
      "target_ref": "AIGMOS_DWH_RECORD_REVISION_CONTRACT",
      "purpose": "Results bind exact evaluated revision when applicable."
    }
  ],
  "prose": {
    "summary": "Define quality evaluation results as immutable provenance-bearing evidence tied to exact rule, validation execution, target data identity/revision and observed values without becoming canonical source truth.",
