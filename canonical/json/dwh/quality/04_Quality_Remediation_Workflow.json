  },
  "identity": {
    "id": "AIGMOS_DWH_QUALITY_REMEDIATION_CONTRACT",
    "name": "DWH Quality Remediation Workflow",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define remediation as explicit candidate changes linked to quality failures, with validation, provenance, authorization and re-evaluation before acceptance.",
  "scope": {
    "owns": [
      "DWH Quality Remediation Workflow semantics"
    ],
    "does_not_own": [
      "source domain ownership",
      "AccessCore policy ownership",
      "source mutation authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DWH_QUALITY_REMEDIATION",
      "name": "DWH Quality Remediation Workflow",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define remediation as explicit candidate changes linked to quality failures, with validation, provenance, authorization and re-evaluation before acceptance.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "flow": [
      "select exact quality failure",
      "create remediation candidate",
      "compute semantic diff",
      "validate destination schema",
      "authorize mutation",
      "apply explicit write/transaction",
      "re-run applicable quality rules",
      "accept or remain failed/quarantined"
    ],
    "candidate_rule": "Remediation proposal is inert candidate data until explicit apply.",
    "source_rule": "Candidate references exact failing quality result and source revision.",
    "mutation_rule": "Correction uses normal DWH mutation/transaction contracts.",
    "automation_rule": "Automated repair is allowed only through an explicit bounded remediation rule/operation profile.",
    "conflict_rule": "If source revision changed since failure, remediation enters concurrency conflict handling.",
    "history_rule": "Original failure and pre-remediation revision remain traceable.",
    "success_rule": "A successful write is not equivalent to successful remediation until required revalidation passes."
  },
  "constraints": {
    "invariants": [
      {
        "id": "QUALITY_EVIDENCE_NONAUTHORITY",
        "rule": "Data-quality rules and results produce explicit evidence about exact data/schema identities; they never silently rewrite source data, change semantic ownership, declassify content or become authorization decisions."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "quality checker silently edits source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "remediation applies to stale revision without conflict check",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "original failure erased",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "successful write assumed quality pass without revalidation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "model/tool recommendation auto-applied",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_PATCH",
      "target_ref": "AIGMOS_DWH_PATCH_MUTATION_CONTRACT",
      "purpose": "Remediation uses explicit semantic delta."
    },
    {
      "id": "REF_CONFLICT",
      "target_ref": "AIGMOS_DWH_CONCURRENCY_CONFLICT_CONTRACT",
      "purpose": "Stale remediation cannot overwrite newer state."
    },
    {
      "id": "REF_BOUND",
      "target_ref": "AIGMOS_MODEL_OUTPUT_OPERATION_BOUNDARY_CONTRACT",
      "purpose": "AI/tool remediation suggestions remain inert until governed apply."
    }
  ],
  "prose": {
    "summary": "Define remediation as explicit candidate changes linked to quality failures, with validation, provenance, authorization and re-evaluation before acceptance.",
    "notes": [
      "Unlocked pending reconciliation against DWH schema, mutation, lineage and monitoring contracts."
    ]
  },
