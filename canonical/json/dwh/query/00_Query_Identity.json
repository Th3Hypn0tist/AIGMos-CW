    "identity_rule": "Reusable/saved machine-significant queries have explicit canonical identities.",
    "execution_rule": "Each concrete query execution has a distinct runtime execution identity.",
    "source_rule": "Query sources resolve exact DWH schema/instance/relation/resource identities.",
    "parameter_rule": "Query parameters are explicit typed bindings.",
    "result_rule": "Result-set identity is distinct from query definition and execution identities.",
