        "condition": "query silently mutates source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "query visibility grants read authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "UI label becomes semantic query identity",
