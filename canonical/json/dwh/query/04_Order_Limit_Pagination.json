  "semantics": {
    "order_rule": "Ordering keys/directions/null ordering are explicit.",
    "stable_rule": "When deterministic pagination is required, ordering includes a stable total or tie-breaking key/profile.",
    "limit_rule": "Limit is an explicit result-bound parameter and does not alter source semantics.",
    "offset_rule": "Offset/page/cursor semantics are explicit and profile-specific.",
    "cursor_rule": "Cursor tokens are transient query-state identities and never source record identities.",
    "priority_rule": "Result order is presentation/query semantics and does not imply domain priority unless an explicit priority field is queried.",
    "change_rule": "Pagination over changing source data may shift unless snapshot/cursor consistency is explicitly requested.",
    "authority_rule": "Pagination does not broaden authorized result scope."
  },
  "constraints": {
    "invariants": [
      {
        "id": "QUERY_EXPLICIT_AND_NONOWNING",
        "rule": "A DWH query is an explicit read/projection definition over exact resolved schema/instance/relation identities; querying, filtering, joining, aggregating, ordering or paginating never silently changes source ownership, identity or authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "pagination without deterministic order claimed stable",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "cursor token becomes record identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "display order treated as domain priority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "limit changes source state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "page traversal broadens authorization scope",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_QUERY",
      "target_ref": "AIGMOS_DWH_QUERY_IDENTITY_CONTRACT",
      "purpose": "Ordering/pagination belong to exact query semantics."
    }
  ],
  "prose": {
    "summary": "Define ordering, limiting and pagination semantics explicitly so result subsets are deterministic where required and never acquire semantic priority accidentally.",
