    "identity_rule": "Every machine-significant remote sharing scope/profile has an explicit stable identity.",
    "source_rule": "Scope binds to exact local/origin instance, schema and resource identities.",
    "peer_rule": "Applicable remote peer/identity/group binding is explicit where policy is peer-specific.",
    "direction_rule": "Read/export/write-delegation directions are explicit and independent.",
    "schema_rule": "Exposed data is constrained by resolved schema/field governance.",
    "transport_rule": "Transport endpoint/address is a binding only and never the sharing-policy identity.",
    "ownership_rule": "Remote sharing does not transfer semantic ownership.",
    "authority_rule": "Scope existence does not grant access until normal governance succeeds."
  },
  "constraints": {
    "invariants": [
      {
        "id": "REMOTE_SHARING_NONEXPANSION",
        "rule": "Remote DWH sharing exposes only explicitly scoped and schema-governed data; transport reachability, endpoint registration, local authorization or broader local ownership never silently expands delegated remote rights."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "remote endpoint used as sharing-policy identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "sharing scope inferred from listener visibility",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "remote sharing transfers source ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "scope grants access without governance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "resource scope selected by display name only",
        "result": "hard_fail"
      }
    ]
  },
