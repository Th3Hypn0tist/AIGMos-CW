    "id": "AIGMOS_DWH_REMOTE_WRITE_DELEGATION_CONTRACT",
    "name": "DWH Remote Write Delegation Boundary",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define remote writes as explicitly delegated mutation operations over exact targets, never as an implied consequence of read access, EXT registration or transport capability.",
  "scope": {
    "owns": [
      "DWH Remote Write Delegation Boundary semantics"
    ],
    "does_not_own": [
      "source domain ownership",
      "AccessCore policy ownership",
      "transport cryptography"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DWH_REMOTE_WRITE_DELEGATION",
      "name": "DWH Remote Write Delegation Boundary",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define remote writes as explicitly delegated mutation operations over exact targets, never as an implied consequence of read access, EXT registration or transport capability.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "default_rule": "Remote DWH access is read-only unless explicit write delegation exists.",
    "delegation_rule": "Write delegation binds exact peer/identity, target resource/operation, allowed mutation scope and applicable lifetime/profile.",
    "target_rule": "Remote write resolves exact destination instance/schema/record/field before mutation.",
    "operation_rule": "Remote mutation uses the normal DWH write/patch/transaction contracts.",
    "authorization_rule": "Target-side AccessCore/governance is evaluated at execution time.",
    "nonexpansion_rule": "Delegated remote rights cannot exceed the declared delegation even if the remote caller has broader unrelated/local rights.",
    "transport_rule": "Ability to send a packet/request never implies remote write permission.",
    "revocation_rule": "Delegation revocation is explicit and prevents future writes without rewriting prior audit evidence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "REMOTE_SHARING_NONEXPANSION",
        "rule": "Remote DWH sharing exposes only explicitly scoped and schema-governed data; transport reachability, endpoint registration, local authorization or broader local ownership never silently expands delegated remote rights."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "remote read implies write",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "EXT registration grants mutation rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "transport send capability treated as write authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "remote caller local rights expand target delegation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "revoked delegation still accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "remote write bypasses target schema/transaction validation",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_WRITE",
      "target_ref": "AIGMOS_DWH_WRITE_OPERATION_IDENTITY_CONTRACT",
      "purpose": "Remote mutation uses exact DWH write semantics."
    },
    {
      "id": "REF_AC",
      "target_ref": "AIGMOS_ACCESSCORE_REMOTE_AUTHORIZATION_PROPAGATION_CONTRACT",
      "purpose": "Delegated remote authority is non-expanding."
    }
  ],
  "prose": {
    "summary": "Define remote writes as explicitly delegated mutation operations over exact targets, never as an implied consequence of read access, EXT registration or transport capability.",
    "notes": [
