  "semantics": {
    "identity_rule": "Every machine-significant freshness objective has an explicit canonical identity.",
    "scope_rule": "Objective binds exact dataset/schema/resource/field/query/materialized-view identities.",
    "anchor_rule": "Freshness anchor is explicit: source event time, accepted revision time, sync watermark, snapshot time or other declared source clock/profile.",
    "threshold_rule": "Target freshness threshold and evaluation window are explicit.",
    "lag_rule": "Observed lag is derived evidence from exact source position/time and current evaluation instant.",
    "replica_rule": "Replica freshness uses authoritative-source watermark/revision provenance where applicable.",
    "unknown_rule": "Unknown source time/watermark yields unknown freshness, never fresh by default.",
    "authority_rule": "Freshness status grants no read/write authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SLO_EVIDENCE_NONAUTHORITY",
        "rule": "Freshness, availability, completeness, latency and SLO results are derived service-health evidence over exact data/runtime scopes; they never change data identity, ownership, classification, authorization or execution authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "freshness computed from local file mtime",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unknown freshness treated as healthy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "replica age measured without authoritative watermark",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "scope inferred by UI label",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "freshness status grants access",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SYNC",
      "target_ref": "AIGMOS_DWH_SYNC_WATERMARK_CONTRACT",
      "purpose": "Replica freshness can use exact sync position."
    },
    {
      "id": "REF_CDC",
      "target_ref": "AIGMOS_DWH_CHANGEFEED_SUBSCRIPTION_CONTRACT",
      "purpose": "Streaming freshness can use exact subscription cursor."
    }
  ],
  "prose": {
    "summary": "Define explicit freshness objectives over exact datasets/resources using declared source-time/watermark anchors and thresholds rather than local observation time or guessed age.",
    "notes": [
      "Unlocked pending reconciliation against DWH quality, replication, changefeed, query and monitoring contracts."
    ]
  },
