    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define explicit freshness objectives over exact datasets/resources using declared source-time/watermark anchors and thresholds rather than local observation time or guessed age.",
  "scope": {
    "owns": [
      "DWH Freshness Objective semantics"
    ],
    "does_not_own": [
      "source domain ownership",
      "AccessCore policy ownership",
      "runtime execution authority"
    ]
  },
