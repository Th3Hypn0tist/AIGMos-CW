        "id": "SLO_EVIDENCE_NONAUTHORITY",
        "rule": "Freshness, availability, completeness, latency and SLO results are derived service-health evidence over exact data/runtime scopes; they never change data identity, ownership, classification, authorization or execution authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "timeout counted as successful low latency",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "security check skipped to meet budget",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "partial result returned as complete for speed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "measurement boundaries undocumented",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "latency target changes query semantics",
        "result": "hard_fail"
      }
    ]
