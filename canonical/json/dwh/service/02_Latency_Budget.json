    "budget_rule": "Each latency budget has explicit start/end measurement boundaries and threshold/window.",
    "scope_rule": "Budget binds exact operation/query/profile/source/destination scope.",
    "measurement_rule": "Queue, network, execution, validation and governance segments may be measured separately.",
