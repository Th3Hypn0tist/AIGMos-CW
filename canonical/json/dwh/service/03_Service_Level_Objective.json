  "semantics": {
    "identity_rule": "Each SLO has an explicit canonical identity.",
    "members_rule": "SLO references exact metric/objective/evidence definitions.",
    "window_rule": "Evaluation window and aggregation semantics are explicit.",
    "threshold_rule": "Pass/fail thresholds and error-budget semantics are explicit where used.",
    "unknown_rule": "Unknown/not-evaluated does not silently equal pass.",
    "scope_rule": "SLO scope binds exact dataset/service/query/replication/federation identity.",
    "result_rule": "Each evaluation produces distinct derived evidence identity.",
    "history_rule": "Past evaluations are append/history governed.",
    "authority_rule": "SLO state is operational evidence and never data-access authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SLO_EVIDENCE_NONAUTHORITY",
        "rule": "Freshness, availability, completeness, latency and SLO results are derived service-health evidence over exact data/runtime scopes; they never change data identity, ownership, classification, authorization or execution authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "unknown SLO state treated healthy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "SLO scope inferred from dashboard grouping",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "metric definition changes without version evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "past breach overwritten",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "SLO pass grants data authority",
        "result": "hard_fail"
      }
    ]
  },
