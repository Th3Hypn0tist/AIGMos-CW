  "identity": {
    "id": "AIGMOS_DWH_SERVICE_LEVEL_BREACH_EVENT_CONTRACT",
    "name": "DWH Service-Level Breach Event Boundary",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define optional conversion of SLO breaches/recoveries into inert Events with exact objective/evaluation provenance before any downstream alerting or remediation automation.",
  "scope": {
    "owns": [
      "DWH Service-Level Breach Event Boundary semantics"
    ],
    "does_not_own": [
      "source domain ownership",
      "AccessCore policy ownership",
      "runtime execution authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DWH_SERVICE_LEVEL_BREACH_EVENT",
      "name": "DWH Service-Level Breach Event Boundary",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define optional conversion of SLO breaches/recoveries into inert Events with exact objective/evaluation provenance before any downstream alerting or remediation automation.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "event_types": [
      "slo_breach",
      "slo_recovery",
      "freshness_breach",
      "availability_breach",
      "completeness_breach",
      "latency_breach",
      "other declared service event"
    ],
    "binding_rule": "Which objective/evaluation transitions emit Events is explicit.",
    "event_rule": "Emitted Event has distinct identity and references exact SLO/evaluation/scope evidence.",
    "payload_rule": "Event payload is inert and bounded to service-health metadata.",
    "dedupe_rule": "Repeated evaluation of the same state does not emit duplicate semantic transition Events unless replay identity is explicit.",
    "causality_rule": "Any alert/remediation action still uses explicit Event→Trigger→Runner/operation causality.",
    "authority_rule": "A breach Event never grants remediation authority.",
    "recovery_rule": "Recovery Event requires explicit return-to-compliant evidence, not merely elapsed time.",
    "failure_rule": "Event emission failure does not rewrite underlying SLO evaluation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SLO_EVIDENCE_NONAUTHORITY",
        "rule": "Freshness, availability, completeness, latency and SLO results are derived service-health evidence over exact data/runtime scopes; they never change data identity, ownership, classification, authorization or execution authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "SLO breach directly executes remediation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Event identity reused as SLO identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "repeated same breach spams duplicate transition without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "elapsed time alone marks recovery",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "breach grants authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EVENT",
      "target_ref": "AIGMOS_EVENT_IDENTITY_CONTRACT",
      "purpose": "Service-level transitions may emit inert Events."
    },
    {
      "id": "REF_CAUSE",
      "target_ref": "AIGMOS_EVENT_CAUSALITY_EDGE_CONTRACT",
      "purpose": "Remediation automation remains explicit."
    }
  ],
  "prose": {
    "summary": "Define optional conversion of SLO breaches/recoveries into inert Events with exact objective/evaluation provenance before any downstream alerting or remediation automation.",
    "notes": [
      "Unlocked pending reconciliation against DWH quality, replication, changefeed, query and monitoring contracts."
    ]
  },
