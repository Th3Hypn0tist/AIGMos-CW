  "semantics": {
    "identity_rule": "Each replica/sync participant has an explicit stable identity.",
    "source_rule": "Replica references exact authoritative/source instance/schema/data scope.",
    "destination_rule": "Replica references exact destination instance/storage scope.",
    "copy_rule": "Replicated records may have local storage identities but retain source semantic/lineage refs.",
    "role_rule": "authoritative, replica, cache and peer roles are explicit.",
    "ownership_rule": "Replica existence does not transfer semantic ownership from authoritative source.",
    "state_rule": "configured, syncing, current, stale, conflicted and failed states remain distinct.",
    "authority_rule": "Replica availability does not grant source or destination mutation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "REPLICA_NONOWNERSHIP",
        "rule": "Replica/sync state, transport position or local copy never replaces the semantic identity or ownership of the authoritative source data; propagation is explicit, provenance-bearing and conflict-aware."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "replica id replaces source data identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "copy becomes semantic owner automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "source role inferred from newest timestamp",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "replica availability grants write authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cache and authoritative replica conflated",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_STORE",
      "target_ref": "AIGMOS_DWH_STORAGE_BINDING_CONTRACT",
      "purpose": "Replica destination uses explicit persistence binding."
    },
