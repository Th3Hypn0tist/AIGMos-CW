  "semantics": {
    "conflict_rule": "Conflicts are detected using exact record identity, revision/version expectations and replication profile.",
    "authority_rule": "Authoritative-source policy, if used, is explicit per replication profile.",
    "merge_rule": "Semantic merge is a separate reconciliation operation with exact source states and provenance.",
    "last_write_rule": "Last-write-wins is forbidden unless explicitly declared with a trustworthy ordering source/profile.",
    "time_rule": "Local clocks/mtimes never decide conflict authority by themselves.",
    "result_rule": "Reconciliation produces an explicit accepted revision/state and records all contributing conflicting revisions.",
    "history_rule": "Losing/conflicting states remain traceable according to retention/audit policy.",
    "failure_rule": "Unresolvable conflict remains conflicted and does not silently advance the sync watermark."
  },
  "constraints": {
    "invariants": [
      {
        "id": "REPLICA_NONOWNERSHIP",
        "rule": "Replica/sync state, transport position or local copy never replaces the semantic identity or ownership of the authoritative source data; propagation is explicit, provenance-bearing and conflict-aware."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "mtime decides conflict",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "arrival order silently wins",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "conflict advances watermark before resolution",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "losing revision erased",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "merge lacks provenance",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
