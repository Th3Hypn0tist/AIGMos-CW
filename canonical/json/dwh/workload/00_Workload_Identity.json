  "semantics": {
    "workload_types": [
      "query",
      "ingest",
      "write",
      "federation",
      "migration",
      "replication",
      "maintenance",
      "other declared workload"
    ],
    "identity_rule": "Every managed workload/profile has an explicit identity.",
    "execution_rule": "Concrete executions reference workload identity but keep their own execution identities.",
    "scope_rule": "Workload may bind exact instance/project/user/service/profile scopes.",
    "resource_rule": "Workload resource constraints are explicit and separate from semantic operation definitions.",
    "priority_rule": "Priority is scheduling metadata and never semantic business priority unless separately modeled.",
    "authority_rule": "Workload classification does not grant operation/data authority.",
    "path_rule": "Queue name/process id/thread id is not canonical workload identity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "WORKLOAD_CONTROL_NONSEMANTIC",
        "rule": "Admission, quotas, concurrency, priority, cancellation and resource budgets may control when/how work executes but never change canonical query/write semantics, data ownership, classification or authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "queue name used as semantic workload identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "workload identity replaces query/write execution identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "priority treated as domain priority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "workload class grants authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "process id becomes canonical identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_QUERY",
      "target_ref": "AIGMOS_DWH_QUERY_IDENTITY_CONTRACT",
      "purpose": "Query executions may participate in managed workloads."
    },
    {
      "id": "REF_WRITE",
      "target_ref": "AIGMOS_DWH_WRITE_OPERATION_IDENTITY_CONTRACT",
      "purpose": "Mutation executions retain exact operation identity."
    }
  ],
  "prose": {
    "summary": "Define each query, ingest, mutation, federation, migration, replication or maintenance execution as belonging to an explicit workload identity/profile separate from the operation and execution identities themselves.",
