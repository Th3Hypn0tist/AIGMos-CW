  "identity": {
    "id": "AIGMOS_DWH_WORKLOAD_IDENTITY_CONTRACT",
    "name": "DWH Workload Identity",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define each query, ingest, mutation, federation, migration, replication or maintenance execution as belonging to an explicit workload identity/profile separate from the operation and execution identities themselves.",
  "scope": {
    "owns": [
      "DWH Workload Identity semantics"
    ],
    "does_not_own": [
      "query semantic ownership",
      "AccessCore policy ownership",
      "runtime scheduler implementation details"
    ]
  },
  "members": [
    {
      "id": "TOPIC_DWH_WORKLOAD_IDENTITY",
      "name": "DWH Workload Identity",
      "type": "topic",
