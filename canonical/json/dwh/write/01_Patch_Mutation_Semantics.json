  "semantics": {
    "delta_states": [
      "unchanged",
      "set",
      "set_null",
      "remove",
      "replace_explicit"
    ],
    "target_rule": "Each mutation entry references exact record/resource and field identity.",
    "absence_rule": "Field absence in a patch means unchanged unless the exact patch profile explicitly defines otherwise.",
    "null_rule": "Null is a value/state distinct from absent/unchanged.",
    "remove_rule": "Field removal is explicit and schema-valid.",
    "replace_rule": "Whole-record replacement is an explicit operation/profile and never inferred from partial payload.",
    "diff_rule": "Pre-apply semantic diff is machine-computable.",
    "validation_rule": "Unknown/non-writable fields hard-fail or follow an explicit extension policy.",
    "authority_rule": "Authorization may be evaluated per target/resource/field according to policy."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_MUTATION_EXACT",
        "rule": "Every DWH mutation resolves an exact destination instance/schema/record/field identity, validates intended change, evaluates authorization and conflict state, and records provenance; no write is inferred from query/display context or silently overwrites conflicting accepted state."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "missing field silently deleted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "null conflated with absent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "partial patch treated as whole-record replace",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unknown field silently written",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "patch target resolved by field display order",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_WRITE",
      "target_ref": "AIGMOS_DWH_WRITE_OPERATION_IDENTITY_CONTRACT",
      "purpose": "Patch semantics specialize exact DWH writes."
    },
    {
      "id": "REF_DIFF",
      "target_ref": "AIGMOS_SEMANTIC_DIFF_CONTRACT",
      "purpose": "Mutation delta can be reviewed before apply."
    }
  ],
  "prose": {
    "summary": "Define field-level mutation as an explicit semantic delta over exact target identities, distinguishing absent, unchanged, null, set, remove and replace operations.",
