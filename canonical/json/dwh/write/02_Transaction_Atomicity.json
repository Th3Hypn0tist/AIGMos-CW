  "constraints": {
    "invariants": [
      {
        "id": "DWH_MUTATION_EXACT",
        "rule": "Every DWH mutation resolves an exact destination instance/schema/record/field identity, validates intended change, evaluates authorization and conflict state, and records provenance; no write is inferred from query/display context or silently overwrites conflicting accepted state."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "atomic transaction partially commits silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "rollback deletes failure evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "external side effect claimed atomic without contract",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "member order inferred from filesystem/serialization order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "transaction identity conflated with individual write",
        "result": "hard_fail"
      }
    ]
  },
