  "semantics": {
    "trace_rule": "Event retains exact immediate origin refs.",
    "recursive_rule": "Origin refs can be recursively followed to causal root within configured trace bounds.",
    "external_rule": "Externally originated Events identify the external/input source boundary.",
    "runner_rule": "Runner-generated Events reference exact runner/step/execution identities.",
    "operation_rule": "Operation-generated Events reference exact canonical operation and dispatch execution.",
    "input_rule": "Input-derived Events preserve input source and UserModule instance refs.",
    "privacy_rule": "Trace details may be redacted for viewers while canonical provenance remains preserved.",
    "failure_rule": "Unknown provenance remains explicit unknown rather than fabricated."
  },
  "constraints": {
    "invariants": [
      {
        "id": "CAUSALITY_EXPLICIT",
        "rule": "Event, Trigger, Runner and resulting Event are separate explicit identities connected only by declared causality edges; matching or adjacency never implies execution."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "event provenance guessed from nearest log line",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "runner-generated event lacks runner ref",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "external event loses source boundary",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unknown provenance fabricated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "trace redaction deletes canonical provenance",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EDGE",
      "target_ref": "AIGMOS_EVENT_CAUSALITY_EDGE_CONTRACT",
      "purpose": "Trace follows explicit causal edges."
    },
    {
      "id": "REF_RUN",
      "target_ref": "AIGMOS_RUNNER_EXECUTION_CONTRACT",
      "purpose": "Runner events retain execution provenance."
    }
  ],
  "prose": {
    "summary": "Define end-to-end traceability from an observed Event back through its emitting operation/runner/Trigger/source Event or external origin.",
    "notes": [
      "Unlocked pending reconciliation against existing Event/Trigger/Runner contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
