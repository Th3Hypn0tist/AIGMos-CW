  "semantics": {
    "role": "shared editor substrate",
    "shared_capabilities": [
      "canonical target resolution",
      "schema rendering",
      "candidate staging",
      "validation",
      "diff preview",
      "AccessCore checks",
      "apply/reload dispatch",
      "error reporting"
    ],
    "identity_rule": "Editor target resolves by exact canonical identity.",
    "schema_rule": "Editor fields/ports/controls derive from explicit target schema/contract metadata.",
    "candidate_rule": "Edits are staged as candidate changes before authoritative apply where applicable.",
    "validation_rule": "Candidate changes validate before apply.",
    "authority_rule": "Every mutation uses normal AccessCore/runtime authority checks.",
    "reuse_rule": "Specialized editors reuse this foundation rather than reimplementing parallel change pipelines.",
    "state_rule": "UI-local state is distinct from canonical definition and runtime state."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EDITOR_NONAUTHORITY",
        "rule": "Editor surfaces project and mutate canonical semantics only through explicit validated operations; editor layout or widget state never becomes semantic or runtime authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "editor target resolved fuzzily",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "editor bypasses AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "UI-local state treated as canonical state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "candidate applied before validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "specialized editor creates incompatible private mutation path",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_AC",
      "target_ref": "AIGMOS_ACCESSCORE_RIGHTS_EVALUATION_CONTRACT",
      "purpose": "All editor writes remain AC-governed."
    },
    {
      "id": "REF_CHANGE",
      "target_ref": "AIGMOS_CORE_CANONICAL_CHANGE_BOUNDARY_CONTRACT",
      "purpose": "Editor writes cross explicit change boundary."
    }
  ],
  "prose": {
    "summary": "Define the shared editor substrate used by Expose editors for identity resolution, schema-driven fields, validation, change staging, authorization, apply/reload and error reporting.",
