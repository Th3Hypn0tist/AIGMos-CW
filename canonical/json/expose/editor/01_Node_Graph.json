        "name": "Define node",
        "inputs": [
          "node content ref",
          "typed ports"
        ],
        "outputs": [
          "node"
        ],
        "errors": [
          "invalid port definition"
        ],
        "side_effects": [
          "node graph updated"
        ]
      },
      {
        "id": "OP_EDGE_CONNECT",
        "name": "Connect typed ports",
        "inputs": [
          "source port",
          "target port",
          "edge semantics"
        ],
        "outputs": [
          "validated edge"
        ],
        "errors": [
          "type mismatch",
          "port unresolved"
        ],
        "side_effects": [
          "node graph updated"
        ]
      },
      {
        "id": "OP_NODE_PROJECT",
        "name": "Project semantic content into node graph",
        "inputs": [
          "canonical refs",
          "graph projection rules"
        ],
        "outputs": [
          "node graph view"
        ],
        "errors": [
          "source unresolved"
        ],
        "side_effects": []
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "engine_owns": [
      "nodes",
      "ports",
      "edges"
    ],
    "port_rule": "Each node may expose any number of typed inputs/outputs.",
    "connection_rule": "Connections are validated against explicit port types and edge semantics.",
    "content_api_rule": "Node content references semantic content definitions; initial content kinds include comment and example.",
    "projection_rule": "Graph position is presentation only and does not create canonical relation/causality.",
    "semantic_rule": "Canonical structural/causal meaning comes from the referenced semantics, not SVG edge styling.",
    "extension_rule": "New node content types require explicit content semantics, not renderer-specific conventions."
  },
