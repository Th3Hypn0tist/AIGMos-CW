  "semantics": {
    "role": "generic graph projection/editor",
    "node_rule": "Each graph node references an exact canonical semantic identity or declared content-only node type.",
    "port_rule": "Nodes may expose any number of typed input/output ports.",
    "edge_rule": "Connections are explicit edges and validate source/target port compatibility before apply.",
    "semantic_rule": "Graph adjacency/position does not create semantic relation without explicit edge identity/type.",
    "scope_rule": "Graph may project relations, schemas, Events, Triggers, Commands, runners and other Meta wiring according to supported node types.",
    "layout_rule": "Node coordinates, zoom and visual clustering are presentation state only.",
    "authority_rule": "Graph edit applies through normal canonical operations and AC checks."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EDITOR_NONAUTHORITY",
        "rule": "Editor surfaces project and mutate canonical semantics only through explicit validated operations; editor layout or widget state never becomes semantic or runtime authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "visual proximity creates semantic edge",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "port type mismatch accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "graph node identity inferred only from label",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "graph position changes canonical semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "graph edit bypasses normal operation/authority path",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_FOUND",
      "target_ref": "AIGMOS_EXPOSE_EDITOR_FOUNDATION_CONTRACT",
      "purpose": "Node Graph uses shared apply/validation pipeline."
    },
    {
      "id": "REF_REL",
      "target_ref": "AIGMOS_RELATION_CONTRACT",
      "purpose": "Semantic edges use canonical relation semantics where applicable."
    }
  ],
  "prose": {
    "summary": "Define the generic node graph editor for canonical relations, schemas, Events, Triggers, Commands, runners and Meta wiring using typed ports and explicit validated edges.",
