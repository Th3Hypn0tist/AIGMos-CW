  },
  "identity": {
    "id": "AIGMOS_EXPOSE_EDITOR_VALIDATE_APPLY_CONTRACT",
    "name": "Editor Validate and Apply Boundary",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the common validate→diff→authorize→apply→reload/activate flow for all Expose editors so UI edits never directly mutate authoritative semantics before checks complete.",
  "scope": {
    "owns": [
      "Editor Validate and Apply Boundary semantics"
    ],
    "does_not_own": [
      "domain semantics",
      "runtime authority",
      "unrelated persistence semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_EDITOR_VALIDATE_APPLY",
      "name": "Editor Validate and Apply Boundary",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the common validate→diff→authorize→apply→reload/activate flow for all Expose editors so UI edits never directly mutate authoritative semantics before checks complete.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "flow": [
      "resolve exact target",
      "stage candidate",
      "validate schema/relations/constraints",
      "compute semantic diff",
      "evaluate AccessCore authority",
      "apply canonical change",
      "reload/activate if required",
      "report resulting state"
    ],
    "atomicity_rule": "Apply is atomic or leaves a deterministic recoverable pre-apply state according to the owning subsystem.",
    "diff_rule": "User may inspect semantic diff before apply where the editor exposes preview.",
    "reload_rule": "Subsystem reload/activation is explicit and occurs only after successful canonical change.",
    "failure_rule": "Validation or authorization failure causes no hidden partial mutation.",
    "evidence_rule": "Applied change retains actor/target/diff/result provenance.",
    "self_host_rule": "Editor self-edits use the same validate/apply boundary with safe candidate/recovery semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EDITOR_NONAUTHORITY",
        "rule": "Editor surfaces project and mutate canonical semantics only through explicit validated operations; editor layout or widget state never becomes semantic or runtime authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "UI mutates authoritative semantics before validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "authorization checked only after mutation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed apply leaves ambiguous partial state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reload occurs before canonical change succeeds",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "applied edit lacks actor/diff provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "self-hosted Editor bypasses common boundary",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_FOUND",
      "target_ref": "AIGMOS_EXPOSE_EDITOR_FOUNDATION_CONTRACT",
      "purpose": "All editors use the common boundary."
    },
    {
      "id": "REF_DIFF",
      "target_ref": "AIGMOS_SEMANTIC_DIFF_CONTRACT",
      "purpose": "Candidate changes can be previewed as semantic diff."
    },
    {
      "id": "REF_RELOAD",
      "target_ref": "AIGMOS_INSTANCE_RELOAD_CONTRACT",
      "purpose": "Activation/reload follows successful apply."
    }
  ],
  "prose": {
    "summary": "Define the common validate→diff→authorize→apply→reload/activate flow for all Expose editors so UI edits never directly mutate authoritative semantics before checks complete.",
    "notes": [
      "Unlocked pending reconciliation against existing Expose/editor contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
