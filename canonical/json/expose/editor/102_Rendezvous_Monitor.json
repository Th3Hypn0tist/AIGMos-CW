    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for rendezvous services, registrations, signaling transactions, reachability and cleanup state.",
  "scope": {
    "owns": [
      "Rendezvous and Signaling Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "application operation semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_RENDEZVOUS_MONITOR",
      "name": "Rendezvous and Signaling Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for rendezvous services, registrations, signaling transactions, reachability and cleanup state.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "service/provider registry",
      "peer registrations",
      "registration expiry",
      "signaling transaction state",
      "network candidates metadata",
      "peer reachability",
      "cleanup/expiry"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Rendezvous service, registration, signaling transaction, peer and connection identities remain distinct.",
    "action_rule": "register/unregister/refresh/clear-signaling operations invoke separate workflows.",
    "authority_rule": "Viewing reachability grants no peer/application authority.",
    "redaction_rule": "Sensitive transport/security material is excluded.",
    "failure_rule": "stale/expired/failed state remains explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor shows reachable as trusted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "registration and peer identity conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "viewing grants rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "candidate secrets leaked",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cleanup hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REACH",
      "target_ref": "AIGMOS_PEER_REACHABILITY_STATE_CONTRACT",
      "purpose": "Monitor projects transient reachability evidence."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for rendezvous services, registrations, signaling transactions, reachability and cleanup state.",
    "notes": [
