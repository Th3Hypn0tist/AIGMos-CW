        "condition": "route and operation identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "payload secrets shown",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "rate-limited shown denied-by-AccessCore incorrectly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "protocol success shown as operation success without result",
        "result": "hard_fail"
      }
    ]
