  "semantics": {
    "views": [
      "crypto/profile registry",
      "connection/session refs",
      "peer-proof metadata",
      "handshake result",
      "rekey state",
      "integrity/authentication failures",
      "remote authorization result",
      "network audit history"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Peer, connection, session, handshake, key ref, authorization decision and audit identities remain distinct.",
    "secret_rule": "Raw private/session key material is structurally excluded.",
    "action_rule": "close-session/revoke-peer-binding/rotate-key/change-profile operations invoke separate authorized workflows.",
    "authority_rule": "Viewing security state grants no network/admin authority.",
    "failure_rule": "downgrade/replay/integrity/unknown states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor displays private key",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "handshake shown as AccessCore allow",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "viewing grants admin",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "peer identity inferred from IP",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "security failure hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_FAIL",
      "target_ref": "AIGMOS_TRANSPORT_INTEGRITY_FAILURE_CONTRACT",
      "purpose": "Monitor surfaces fail-closed network security failures."
    }
  ],
