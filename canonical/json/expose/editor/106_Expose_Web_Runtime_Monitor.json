  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only monitor for web instances, HTTP listeners, routes, page bindings, assets, delivery/cache state and recovery readiness.",
  "scope": {
    "owns": [
      "Expose Web Runtime Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "runtime execution authority",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_WEB_RUNTIME_MONITOR",
      "name": "Expose Web Runtime Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only monitor for web instances, HTTP listeners, routes, page bindings, assets, delivery/cache state and recovery readiness.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "web instance registry",
      "HTTP listener/binding",
      "runtime state",
      "route→page bindings",
      "asset registry/revisions",
      "delivery/cache evidence",
      "recovery/bootstrap state"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Web instance, listener, route, page, asset and runtime identities remain distinct.",
    "action_rule": "start/stop/rebind/reload/recover operations invoke separate authorized workflows.",
    "authority_rule": "Viewing web runtime state grants no lifecycle authority.",
    "failure_rule": "stopped/degraded/broken-route/missing-asset states remain explicit.",
    "graph_rule": "Route/page/asset edges correspond only to explicit refs."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor starts web by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "port shown as instance identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "page and route conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants lifecycle authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "missing asset silently substituted",
        "result": "hard_fail"
      }
    ]
  },
