      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_Q_EDITOR_READ",
        "name": "Read q backend/config",
        "inputs": [
          "q configuration ref"
        ],
        "outputs": [
          "q edit model"
        ],
        "errors": [
          "config unresolved"
        ],
        "side_effects": []
      },
      {
        "id": "OP_Q_EDITOR_BIND_BACKEND",
        "name": "Bind q logical backend",
        "inputs": [
          "q surface",
          "backend alias"
        ],
        "outputs": [
          "updated backend binding"
        ],
        "errors": [
          "alias unresolved",
          "authority denied"
        ],
        "side_effects": [
          "q configuration updated"
        ]
      },
      {
        "id": "OP_Q_EDITOR_TEST",
        "name": "Test q configuration",
        "inputs": [
          "candidate q config",
          "bounded test input"
        ],
        "outputs": [
          "test result"
        ],
        "errors": [
          "backend unavailable",
          "timeout"
        ],
        "side_effects": [
          "bounded backend interaction only"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "initial_backends": [
      "dummyLLM",
      "doubleword",
      "nvidia"
    ],
    "alias_rule": "q Editor binds q surfaces to stable logical backend aliases.",
    "provider_rule": "Provider/model binding belongs to backend configuration, not UI control identity.",
    "queue_rule": "q/qc/qt queue semantics remain Runtime Queue Profile semantics.",
    "test_rule": "Configuration tests are bounded explicit backend calls and do not become permanent authority/config unless saved.",
    "authority_rule": "Backend configuration changes are explicitly authorized.",
    "response_rule": "Backend test response is inert and cannot modify configuration by itself."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPOSE_COMPONENT_EXPLICIT",
        "rule": "Expose components reuse canonical semantics and remain non-privileged projection/composition surfaces."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "UI display name used as backend semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "backend test response mutates config automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "q Editor redefines q/qc/qt queue semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "provider endpoint hard-coded as caller semantic identity where alias is required",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "backend configuration changed without authorization",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
