  "scope": {
    "owns": [
      "Expose q Editor semantics"
    ],
    "does_not_own": [
      "runtime execution authority",
      "unrelated domain semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_Q_EDITOR",
      "name": "q Editor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define q Editor as the configuration/editor surface for q-family AI backends and aliases, using explicit backend identities and bounded tests without embedding provider-specific semantics into the UI.",
