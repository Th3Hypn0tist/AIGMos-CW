  "semantics": {
    "routine_rule": "Routine edits create candidate Routine definition/revision.",
    "q_rule": "q backend/model/target bindings are explicit candidate config.",
    "backend_rule": "Backends such as dummyLLM, doubleword and nvidia are exact backend identities/bindings.",
    "target_rule": "q/qc target selection is explicit and never hidden UI focus.",
    "execution_rule": "Saving/editing never invokes the Routine or q family.",
    "validation_rule": "Candidate config validates before apply.",
    "authority_rule": "Editor access does not grant q/Routine execution authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "saving Routine executes it",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "selected editor pane becomes qc target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "backend chosen by nearest label",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "editing q grants model execution rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "candidate config mutates live backend immediately",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ROUTINE",
      "target_ref": "AIGMOS_ROUTINE_IDENTITY_CONTRACT",
      "purpose": "Routine Editor edits exact Routine definitions."
    },
    {
      "id": "REF_Q",
      "target_ref": "AIGMOS_Q_FAMILY_CONTRACT",
      "purpose": "q Editor configures q-family bindings only."
    }
  ],
  "prose": {
    "summary": "Define Routine and q backend/target editing as candidate definitions with exact refs, separate from invoking `&`, `q`, `qc` or `qt`.",
