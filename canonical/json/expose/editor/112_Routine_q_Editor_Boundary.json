  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define Routine and q backend/target editing as candidate definitions with exact refs, separate from invoking `&`, `q`, `qc` or `qt`.",
  "scope": {
    "owns": [
      "Routine and q Editor Boundary semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "runtime execution authority",
      "AccessCore policy ownership"
    ]
  },
