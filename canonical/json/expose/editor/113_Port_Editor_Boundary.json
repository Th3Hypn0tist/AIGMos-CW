    "listener_rule": "Port Editor references exact named listener identities.",
    "binding_rule": "Port/address/transport edits are candidate configuration.",
    "protocol_rule": "HTTP/REST/OSC/WebSocket/etc. are explicit listener/protocol types.",
    "conflict_rule": "Binding conflicts validate before apply.",
    "lifecycle_rule": "Apply/rebind and start/stop are distinct operations.",
    "authority_rule": "Editing listener config grants no listener lifecycle authority.",
    "ownership_rule": "Port Editor owns no protocol semantics."
