        "id": "GATE_2",
        "condition": "port number becomes listener identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "Port Editor owns REST semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "conflict resolved by last edit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "editing grants start rights",
