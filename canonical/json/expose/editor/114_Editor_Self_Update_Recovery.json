  "semantics": {
    "candidate_rule": "Self-edit produces a new candidate Editor MetaModule/site/config revision.",
    "validation_rule": "Candidate validates before activation.",
    "activation_rule": "Activation targets exact candidate revision.",
    "health_rule": "New Editor health/readiness is checked explicitly.",
    "rollback_rule": "Prior known-good revision remains recoverable.",
    "failure_rule": "Failed self-update does not destroy the previous usable Editor.",
    "authority_rule": "Self-update requires explicit Editor/config/site administration authority.",
    "history_rule": "Self-update revisions remain traceable."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "active Editor overwritten before validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "failed self-update leaves no recovery path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "self-edit bypasses AC",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "new revision selected by newest file",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "rollback history deleted",
        "result": "hard_fail"
      }
    ]
  },
