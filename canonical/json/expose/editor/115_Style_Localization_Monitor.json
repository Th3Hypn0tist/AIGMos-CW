  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only/candidate-edit Expose monitor for site style, brand tokens, assets, UI labels, translations and fallback/completeness state.",
  "scope": {
    "owns": [
      "Style, Assets and Localization Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "runtime execution authority",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_STYLE_LOCALIZATION_MONITOR",
      "name": "Style, Assets and Localization Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only/candidate-edit Expose monitor for site style, brand tokens, assets, UI labels, translations and fallback/completeness state.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "style identity/revision",
      "design tokens",
      "brand palette",
      "asset registry/revisions",
      "UI label registry/context",
      "translation coverage",
      "fallback paths",
      "validation conflicts"
    ],
    "readonly_rule": "Default monitor is read-only; edits create candidates.",
    "identity_rule": "Style, asset, label, translation and internal resource identities remain distinct.",
    "action_rule": "edit-style/register-asset/edit-label/edit-translation/apply operations use separate authorized workflows.",
    "authority_rule": "Viewing/editing presentation candidates grants no domain authority.",
    "failure_rule": "missing asset/translation/conflicting token states remain explicit.",
    "internal_rule": "Localized UI never mutates internal command identifiers."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "style edit mutates domain semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "asset/label identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "translation changes command name",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants asset rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "fallback conflict hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TRANS",
      "target_ref": "AIGMOS_TRANSLATION_SET_CONTRACT",
      "purpose": "Monitor exposes exact translation coverage."
    }
  ],
  "prose": {
    "summary": "Define a read-only/candidate-edit Expose monitor for site style, brand tokens, assets, UI labels, translations and fallback/completeness state.",
