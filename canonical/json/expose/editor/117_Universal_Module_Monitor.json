  "semantics": {
    "views": [
      "module registry",
      "primitive/type registry",
      "public contract surface",
      "instances",
      "dependencies/closure",
      "compatibility findings",
      "lifecycle state"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Module, primitive, instance, dependency and runtime identities remain distinct.",
    "action_rule": "create-instance/rebind/enable/disable operations invoke separate authorized workflows.",
    "authority_rule": "Viewing module structure grants no instance/data authority.",
    "graph_rule": "Dependency/composition edges correspond only to explicit refs.",
    "failure_rule": "missing/incompatible/cyclic dependency states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMPOSITION_NONOWNERSHIP",
        "rule": "Composition never silently transfers semantic ownership: universal modules own their primitives, domains own their composition semantics, and composed members retain their own identities and contracts."
      },
      {
        "id": "EXPLICIT_STRUCTURE",
        "rule": "Containment, relation, dependency, composition and projection edges exist only through explicit typed references; naming, file hierarchy, UI adjacency or shared values never create semantic structure."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor enables module by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "module and instance conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "visual adjacency creates dependency",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "primitive label used as identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "missing dependency hidden",
        "result": "hard_fail"
      }
    ]
  },
