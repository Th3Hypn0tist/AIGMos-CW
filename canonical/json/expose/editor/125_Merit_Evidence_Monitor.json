  "identity": {
    "id": "AIGMOS_EXPOSE_MERIT_EVIDENCE_MONITOR_CONTRACT",
    "name": "Merit Evidence and Calculation Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for raw merit evidence, backend provenance, Project links, point calculation and negative-review state.",
  "scope": {
    "owns": [
      "Merit Evidence and Calculation Monitor semantics"
    ],
    "does_not_own": [
      "IAM authentication/session semantics",
      "AccessCore authorization policy",
      "Project semantic ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_MERIT_EVIDENCE_MONITOR",
      "name": "Merit Evidence and Calculation Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for raw merit evidence, backend provenance, Project links, point calculation and negative-review state.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "merit evidence registry",
      "subject/Project refs",
      "writer/source",
      "week/hour atom",
      "accepted/review/revoked state",
      "point calculation profile/result",
      "negative-feedback review"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "IdentityCore, Project, merit evidence, point evaluation and review identities remain distinct.",
    "authority_rule": "Viewing MeritCore grants no award/review authority.",
    "action_rule": "submit-evidence/review/revoke/recalculate operations use separate authorized workflows.",
    "failure_rule": "pending/revoked/conflicting evidence remains explicit.",
    "privacy_rule": "Private merit evidence obeys governance."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor awards points by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Project/evidence identity conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "review result hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants merit-admin rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "private evidence leaked",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CALC",
      "target_ref": "AIGMOS_MERIT_POINTS_CALCULATION_CONTRACT",
      "purpose": "Monitor projects exact derived calculations."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for raw merit evidence, backend provenance, Project links, point calculation and negative-review state.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
