  "identity": {
    "id": "AIGMOS_EXPOSE_TIER_TRUST_MONITOR_CONTRACT",
    "name": "Tier, Recommendation and Trust Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for Tier thresholds/evaluations, recommendations, trust evidence, recency rules and review/reduction history.",
  "scope": {
    "owns": [
      "Tier, Recommendation and Trust Monitor semantics"
    ],
    "does_not_own": [
      "IAM authentication/session semantics",
      "AccessCore authorization policy",
      "Project semantic ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_TIER_TRUST_MONITOR",
      "name": "Tier, Recommendation and Trust Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for Tier thresholds/evaluations, recommendations, trust evidence, recency rules and review/reduction history.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "Tier evaluations",
      "qualifying Project count",
      "qualifying recommendation count",
      "recommendation provenance",
      "trust evaluation",
      "recency-specific criteria",
      "negative review/Tier decision"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Tier evaluation, recommendation, trust evaluation, Project and review identities remain distinct.",
    "authority_rule": "Viewing Tier/trust grants no system/merit administration authority.",
    "action_rule": "recommend/revoke/review/recalculate operations use separate authorized workflows.",
    "failure_rule": "insufficient/disputed/revoked/stale-by-specific-criterion states remain explicit.",
    "privacy_rule": "Private recommendation/review evidence is governed."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor treats Tier as role",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "trust score grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "same Project counted twice invisibly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "generic decay displayed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "review provenance hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TIER",
      "target_ref": "AIGMOS_MERIT_TIER_CONTRACT",
      "purpose": "Monitor projects exact Tier qualification evidence."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for Tier thresholds/evaluations, recommendations, trust evidence, recency rules and review/reduction history.",
