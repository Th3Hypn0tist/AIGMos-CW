  "semantics": {
    "views": [
      "registration anchor",
      "weekly intervals",
      "hour atoms",
      "Project contribution refs",
      "aggregate calculations",
      "duplicate/conservation findings",
      "identity timeline boundary"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Identity, weekly interval, hour atom, Project, merit evidence and aggregate evaluation identities remain distinct.",
    "authority_rule": "Viewing timeline grants no merit-edit authority.",
    "action_rule": "recalculate/review-duplicate operations use separate workflows.",
    "failure_rule": "duplicate/overlap/unanchored/mismatched-identity evidence remains explicit.",
    "graph_rule": "Time/Project contribution edges correspond only to explicit refs."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "timeline reanchors by Project",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "viewing recalculates live",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "same hour shown under two identities",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "duplicate hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "aggregate presented as raw evidence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CONS",
