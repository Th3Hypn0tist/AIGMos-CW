  },
  "identity": {
    "id": "AIGMOS_EXPOSE_COMPETENCE_PROFILE_MONITOR_CONTRACT",
    "name": "Competence Profile and Living CV Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only/candidate-disclosure Expose view for verified competence profile, public Merit projection, living CV and Broker-facing evidence scope.",
  "scope": {
    "owns": [
      "Competence Profile and Living CV Monitor semantics"
    ],
    "does_not_own": [
      "IAM authentication/session semantics",
      "AccessCore authorization policy",
      "Project semantic ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_COMPETENCE_PROFILE_MONITOR",
      "name": "Competence Profile and Living CV Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only/candidate-disclosure Expose view for verified competence profile, public Merit projection, living CV and Broker-facing evidence scope.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "identity summary",
      "portfolio evidence",
      "Project history",
      "merit/points/Tier",
      "recommendations",
      "trust",
      "time distribution",
      "public/private disclosure",
      "Broker-visible fields"
    ],
    "readonly_rule": "Default is read-only; disclosure edits are candidate policy changes.",
    "identity_rule": "Identity, portfolio item, Project, merit evidence, Tier evaluation and projection identities remain distinct.",
    "authority_rule": "Viewing profile grants no employment/Project/system authority.",
    "action_rule": "change-visibility/publish/unpublish operations use separate authorized workflows.",
    "privacy_rule": "Private/restricted evidence is excluded from unauthorized views.",
    "failure_rule": "unverified/revoked/private/stale projection states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor edits MeritCore via profile",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "self-claim shown verified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "private evidence leaked",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants hiring rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "projection identity conflated with IdentityCore",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CV",
      "target_ref": "AIGMOS_LIVING_CV_PROJECTION_CONTRACT",
      "purpose": "Monitor projects living verified competence history."
    }
  ],
  "prose": {
    "summary": "Define a read-only/candidate-disclosure Expose view for verified competence profile, public Merit projection, living CV and Broker-facing evidence scope.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
