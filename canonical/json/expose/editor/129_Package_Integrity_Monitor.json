  },
  "identity": {
    "id": "AIGMOS_EXPOSE_PACKAGE_INTEGRITY_MONITOR_CONTRACT",
    "name": "Package and Integrity Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for package identities, manifests, member hashes, provenance and integrity verification state.",
  "scope": {
    "owns": [
      "Package and Integrity Monitor semantics"
    ],
    "does_not_own": [
      "runtime execution authority",
      "AccessCore policy ownership",
      "domain semantic ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_PACKAGE_INTEGRITY_MONITOR",
      "name": "Package and Integrity Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for package identities, manifests, member hashes, provenance and integrity verification state.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "package registry",
      "manifest members",
      "artifact hashes",
      "dependency refs",
      "publisher/source provenance",
      "integrity result",
      "missing/extra members"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Package, member artifact, hash evidence, publisher and installed artifact identities remain distinct.",
    "action_rule": "verify/import/install operations use separate authorized workflows.",
    "authority_rule": "Viewing/verifying package grants no install authority.",
    "failure_rule": "invalid/incomplete/hash-mismatch states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor installs by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "hash shown as certification",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "package and installed artifact conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "integrity mismatch hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "publisher shown as trusted authority automatically",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_VERIFY",
      "target_ref": "AIGMOS_PACKAGE_INTEGRITY_VERIFICATION_CONTRACT",
      "purpose": "Monitor projects exact integrity evidence."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for package identities, manifests, member hashes, provenance and integrity verification state.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
