  "identity": {
    "id": "AIGMOS_EXPOSE_VERSION_EVOLUTION_MONITOR_CONTRACT",
    "name": "Versioning and Evolution Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for semantic identities, versions, additive/breaking changes, dependency compatibility and deprecation/supersession.",
  "scope": {
    "owns": [
      "Versioning and Evolution Monitor semantics"
    ],
    "does_not_own": [
      "runtime execution authority",
      "AccessCore policy ownership",
      "domain semantic ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_VERSION_EVOLUTION_MONITOR",
      "name": "Versioning and Evolution Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for semantic identities, versions, additive/breaking changes, dependency compatibility and deprecation/supersession.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "identity/version history",
      "additive changes",
      "breaking/new identity links",
      "dependency constraints",
      "compatibility findings",
      "deprecated/superseded state",
      "migration refs"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Semantic identity, version/revision, dependency constraint and replacement identity remain distinct.",
    "action_rule": "deprecate/supersede/migrate operations use separate authorized workflows.",
    "authority_rule": "Viewing version state grants no upgrade/runtime authority.",
    "failure_rule": "incompatible/unresolved/deprecated states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor auto-upgrades by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "newer shown as compatible automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "old/new identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "deprecation hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "migration inferred",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DEP",
      "target_ref": "AIGMOS_DEPENDENCY_VERSION_COMPATIBILITY_CONTRACT",
      "purpose": "Monitor projects exact dependency compatibility."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for semantic identities, versions, additive/breaking changes, dependency compatibility and deprecation/supersession.",
    "notes": [
