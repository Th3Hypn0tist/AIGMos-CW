  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for purposes, minimization profiles, classifications, purpose-gate results and privacy-preserving derivations.",
  "scope": {
    "owns": [
      "Privacy, Purpose and Minimization Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "runtime execution authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_PRIVACY_PURPOSE_MONITOR",
      "name": "Privacy, Purpose and Minimization Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for purposes, minimization profiles, classifications, purpose-gate results and privacy-preserving derivations.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "purpose registry",
      "data/category classifications",
      "minimization profiles",
      "purpose compatibility decisions",
      "derived privacy transforms",
      "lineage/classification propagation",
      "findings"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Purpose, data resource, classification, minimization profile, transform and decision identities remain distinct.",
    "action_rule": "edit-purpose/edit-minimization/reclassify operations use separate authorized workflows.",
    "authority_rule": "Viewing privacy metadata grants no source access.",
    "failure_rule": "unknown-purpose/overcollection/classification-loss states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor declassifies by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "purpose and authorization conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "masked output shown public automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "classification inferred visually",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "overcollection hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_GATE",
      "target_ref": "AIGMOS_PURPOSE_LIMITATION_GATE_CONTRACT",
      "purpose": "Monitor projects exact purpose decisions."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for purposes, minimization profiles, classifications, purpose-gate results and privacy-preserving derivations.",
    "notes": [
