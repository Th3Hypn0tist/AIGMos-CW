    "id": "AIGMOS_EXPOSE_CONSENT_DISCLOSURE_MONITOR_CONTRACT",
    "name": "Consent and Disclosure Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only/candidate-action Expose monitor for consent state, withdrawals, disclosure requests/decisions and subject data-access projections.",
  "scope": {
    "owns": [
      "Consent and Disclosure Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "runtime execution authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_CONSENT_DISCLOSURE_MONITOR",
      "name": "Consent and Disclosure Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only/candidate-action Expose monitor for consent state, withdrawals, disclosure requests/decisions and subject data-access projections.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "consent registry",
      "purpose/data/recipient scopes",
      "withdrawal/expiry state",
      "disclosure requests",
      "allow/deny/partial decisions",
      "subject-access projections",
      "audit refs"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Subject, consent, disclosure request, decision, recipient and projection identities remain distinct.",
    "action_rule": "grant/withdraw/request-disclosure/correct-data operations use separate workflows.",
    "authority_rule": "Viewing consent grants no disclosure authority.",
    "failure_rule": "withdrawn/expired/partial/unknown states remain explicit.",
    "privacy_rule": "Third-party protected content is minimized."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor discloses by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "withdrawn consent shown active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "recipient and subject conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "partial decision hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "third-party data leaked",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DEC",
      "target_ref": "AIGMOS_DISCLOSURE_DECISION_EVIDENCE_CONTRACT",
      "purpose": "Monitor projects exact disclosure decisions."
    }
  ],
  "prose": {
    "summary": "Define a read-only/candidate-action Expose monitor for consent state, withdrawals, disclosure requests/decisions and subject data-access projections.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
