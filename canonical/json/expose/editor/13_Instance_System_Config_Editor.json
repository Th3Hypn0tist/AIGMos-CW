  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the Editor surface for instance/system configuration as a schema-driven authorized projection over instance-config and canonical lifecycle operations, including separate IAM parent and AC parent controls.",
  "scope": {
    "owns": [
      "Instance and System Config Editor semantics"
    ],
    "does_not_own": [
      "runtime implementation internals",
      "unrelated domain semantics",
      "presentation semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_INSTANCE_CONFIG_EDITOR",
      "name": "Instance and System Config Editor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the Editor surface for instance/system configuration as a schema-driven authorized projection over instance-config and canonical lifecycle operations, including separate IAM parent and AC parent controls.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
