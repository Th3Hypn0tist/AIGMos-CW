  "semantics": {
    "targets": [
      "instance name",
      "instance-config fields",
      "IAM parent",
      "AC parent",
      "boot/profile config refs",
      "service/listener config refs"
    ],
    "schema_rule": "Editor fields derive from explicit configuration schema.",
    "parent_rule": "IAM parent and AC parent are separate controls/relations.",
    "write_rule": "Edits write through canonical configuration operations and change-control semantics.",
    "authority_rule": "Editor has no privileged configuration bypass.",
    "preview_rule": "Candidate changes may be previewed/validated before apply.",
    "runtime_rule": "Runtime state indicators are shown separately from declared config.",
    "self_hosting_rule": "Editing configuration that affects Expose/Editor still follows normal validation/recovery boundaries."
  },
  "constraints": {
    "invariants": [
      {
        "id": "INSTANCE_CONFIG_EXPLICIT",
        "rule": "Instance identity, configuration parents, activation state and reload behavior remain explicit and do not derive authority from UI or runtime state."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "IAM parent and AC parent collapsed into one UI field",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Editor writes config outside canonical change operations",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "UI visibility grants configuration authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "declared config and current runtime state shown/treated as same field",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "invalid candidate applied without validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "Editor bypasses AccessCore for instance/system config",
        "result": "hard_fail"
      }
    ]
  },
