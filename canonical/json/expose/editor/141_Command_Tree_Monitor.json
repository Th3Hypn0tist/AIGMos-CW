    "format_version": "1.6"
  },
  "identity": {
    "id": "AIGMOS_EXPOSE_COMMAND_TREE_MONITOR_CONTRACT",
    "name": "Command Tree and Help Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose projection of recursive command families, executable commands, help metadata, aliases and operation bindings.",
  "scope": {
    "owns": [
      "Command Tree and Help Monitor semantics"
    ],
    "does_not_own": [
      "AccessCore policy ownership",
      "domain semantic ownership",
      "implementation-specific process scheduling"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_COMMAND_TREE_MONITOR",
      "name": "Command Tree and Help Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose projection of recursive command families, executable commands, help metadata, aliases and operation bindings.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "command-family tree",
      "concrete commands",
      "short/long help",
      "aliases",
      "argument schemas",
      "operation/Routine/q bindings",
      "validation conflicts"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Family, command node, alias, operation and invocation identities remain distinct.",
    "action_rule": "edit-command/edit-help/apply operations use separate authorized workflows.",
    "authority_rule": "Viewing command tree grants no invocation authority.",
    "graph_rule": "Tree edges correspond only to explicit parent refs.",
    "failure_rule": "duplicate/ambiguous/non-executable/invalid-binding states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "clicking command executes it",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "family and command conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "help edit changes live operation binding silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "visual nesting invents command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "alias conflict hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_HELP",
      "target_ref": "AIGMOS_COMMAND_HELP_METADATA_CONTRACT",
      "purpose": "Monitor renders exact recursive help metadata."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose projection of recursive command families, executable commands, help metadata, aliases and operation bindings.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
