  "semantics": {
    "views": [
      "base/candidate revisions",
      "semantic diff",
      "patch actions",
      "ownership/reference impact",
      "rebase conflicts",
      "reconciliation decisions",
      "validation gates",
      "accepted commit result"
    ],
    "readonly_rule": "Monitor is read-only by default; reconciliation edits remain candidate decisions.",
    "identity_rule": "Patch, diff, conflict, reconciliation, source revision and accepted graph identities remain distinct.",
    "action_rule": "rebase/reconcile/validate/accept operations use separate authorized workflows.",
    "authority_rule": "Viewing/approving UI state does not bypass canonical administration authorization.",
    "failure_rule": "conflict/invalid/stale-base/partial-commit states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "BOOTSTRAP_AUTHORITY_EXPLICIT",
        "rule": "Contract Format bootstrap authority, canonical contract sources, generated projections, historical artifacts and runtime state remain separate identities/roles; no file becomes authoritative merely by name, path order, timestamp or discovery order."
      },
      {
        "id": "VALIDATE_BEFORE_ACCEPT",
        "rule": "Candidate canonical changes remain inert until exact format validation, identity/reference resolution, semantic diff, applicable governance/authorization and repository acceptance succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor applies patch by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "text diff shown semantic truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "conflict auto-resolved visually",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "accepted/candidate conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "failed commit hidden",
        "result": "hard_fail"
      }
    ]
  },
