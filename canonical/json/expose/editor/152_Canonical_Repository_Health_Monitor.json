    "views": [
      "bootstrap status",
      "source-set snapshot",
      "repository build",
      "validation reports",
      "registry health",
      "conformance runs",
      "projection consistency",
      "lock/readiness state",
      "CI gate result"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Repository/source snapshot, build, validation report, conformance run, projection and CI-gate identities remain distinct.",
    "action_rule": "rebuild/revalidate/run-conformance/regenerate-projections operations use separate authorized workflows.",
    "authority_rule": "Healthy repository state grants no runtime/deploy authority.",
    "failure_rule": "bootstrap-failed/invalid/dangling/stale-projection/not-ready/CI-failed states remain explicit."
  },
