      {
        "id": "GATE_1",
        "condition": "monitor merges/deploys by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "healthy means runtime active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "projection shown authoritative",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "failed CI hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "build/source identities conflated",
        "result": "hard_fail"
      }
    ]
  },
