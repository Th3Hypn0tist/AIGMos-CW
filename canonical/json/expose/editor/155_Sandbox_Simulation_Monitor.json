  "semantics": {
    "views": [
      "sandbox registry",
      "production-source snapshot refs",
      "network/data/secret isolation",
      "dry-run operation profile",
      "mock/stub bindings",
      "fault injection state",
      "simulation results"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Sandbox, production target, test double, fault profile, simulation run and real execution identities remain distinct.",
    "action_rule": "create-sandbox/run-dry-run/inject-fault/reset operations use separate authorized workflows.",
    "authority_rule": "Viewing sandbox state grants no production authority.",
    "failure_rule": "isolation-breach/fault-stuck/mock-drift/simulated-only states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor injects fault by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "sandbox shown as prod",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "simulated result displayed real",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "production secret rendered",
        "result": "hard_fail"
      },
