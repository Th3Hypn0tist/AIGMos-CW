  "semantics": {
    "views": [
      "regression baseline",
      "candidate comparison",
      "intended changes",
      "compatibility matrix",
      "migration pre/post checks",
      "rollback evidence",
      "performance budgets/results"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Baseline, candidate revision, compatibility profile, migration, performance profile and test result identities remain distinct.",
    "action_rule": "set-baseline/run-regression/run-compatibility/run-migration-test operations use separate workflows.",
    "authority_rule": "Viewing/passing verification grants no deployment authority.",
    "failure_rule": "regression/incompatible/loss/unverified-rollback/performance-fail states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor updates baseline automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "migration test invokes prod",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "unknown compatibility shown pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "performance failure hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "baseline and source identity conflated",
        "result": "hard_fail"
      }
    ]
  },
