  "semantics": {
    "views": [
      "security test registry",
      "target boundary",
      "negative authorization cases",
      "secret leakage surfaces",
      "parser/adversarial cases",
      "AI/tool boundary cases",
      "isolation escape cases",
      "findings"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Test, security finding, target resource, auth decision and production incident identities remain distinct.",
    "action_rule": "run-security-suite/create-incident operations use separate workflows.",
    "authority_rule": "Viewing security tests grants no admin/incident authority.",
    "failure_rule": "boundary-bypass/leakage/unexpected-allow/crash states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor exploits target by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "failed security test grants responder rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "finding auto-closes",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "test incident conflated with real incident",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "secret marker shown as real secret",
        "result": "hard_fail"
      }
    ]
  },
