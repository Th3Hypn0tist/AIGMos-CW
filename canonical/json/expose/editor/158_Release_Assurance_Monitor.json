    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Release candidate, test result, conformance run, certification, deviation, accepted release and deployment identities remain distinct.",
    "action_rule": "evaluate-release/approve-deviation/accept-release operations use separate authorized workflows.",
    "authority_rule": "Viewing/passing evidence grants no release/deployment authority.",
    "failure_rule": "blocked/rejected/conditional/missing-evidence states remain explicit."
