        "condition": "RC and deployment identity conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "known deviation hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "missing test shown pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "viewing grants release approval",
        "result": "hard_fail"
      }
    ]
