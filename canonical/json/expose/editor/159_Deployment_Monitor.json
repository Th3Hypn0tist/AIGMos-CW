  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for environments, plans, preflight, deployment executions, per-target state and post-verification.",
  "scope": {
    "owns": [
      "Deployment Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "canonical documentation ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_DEPLOYMENT_MONITOR",
      "name": "Deployment Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for environments, plans, preflight, deployment executions, per-target state and post-verification.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "environment registry",
      "deployment plans",
      "accepted release refs",
      "targets",
      "preflight checks",
      "execution state",
      "per-target progress",
      "post-verification",
      "failures"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Environment, plan, execution, release, target runtime and verification identities remain distinct.",
    "action_rule": "deploy/cancel/retry/rollback operations use separate authorized workflows.",
    "authority_rule": "Viewing an accepted plan grants no deployment authority.",
    "failure_rule": "blocked/partial/failed/stale-preflight states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor deploys by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "release and runtime identity conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "partial hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "target inferred visually",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "viewing grants prod authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EXEC",
      "target_ref": "AIGMOS_DEPLOYMENT_EXECUTION_CONTRACT",
      "purpose": "Monitor projects exact deployment executions."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for environments, plans, preflight, deployment executions, per-target state and post-verification.",
