  "semantics": {
    "views": [
      "change registry",
      "target/risk",
      "maintenance window",
      "freeze state",
      "approval decisions",
      "planned rollback",
      "emergency justification",
      "execution refs"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Change, approval, window, freeze, deployment and incident identities remain distinct.",
    "action_rule": "approve/reject/schedule/execute/emergency-change operations use separate authorized workflows.",
    "authority_rule": "Viewing approved change grants no execution authority.",
    "failure_rule": "expired-approval/frozen/outside-window/conditional/unknown states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor executes approved change by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "freeze hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "approval and execution conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "emergency shown unrestricted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "viewing grants change-admin",
        "result": "hard_fail"
      }
    ]
  },
