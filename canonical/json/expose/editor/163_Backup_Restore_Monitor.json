  "semantics": {
    "views": [
      "backup registry",
      "source revision/scope",
      "consistency profile",
      "integrity/encryption metadata",
      "verification",
      "restore plans",
      "target/mode",
      "execution/post-verification"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Source resource, backup, verification, restore plan and restore execution identities remain distinct.",
    "action_rule": "create-backup/verify/restore operations use separate authorized workflows.",
    "authority_rule": "Viewing backup grants no restore/data authority.",
    "failure_rule": "partial/invalid/unverified/failed restore states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor restores by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "backup shown as live source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "invalid hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "plan/execution conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "viewing grants backup export rights",
        "result": "hard_fail"
      }
    ]
  },
