  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for backups, consistency/integrity, verification, restore plans and restore executions.",
  "scope": {
    "owns": [
      "Backup and Restore Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
