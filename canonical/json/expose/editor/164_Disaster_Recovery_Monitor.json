    "id": "AIGMOS_EXPOSE_DISASTER_RECOVERY_MONITOR_CONTRACT",
    "name": "Disaster Recovery Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for recovery objectives, sites, replication readiness, failover/failback plans and executions.",
  "scope": {
    "owns": [
      "Disaster Recovery Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "canonical documentation ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_DISASTER_RECOVERY_MONITOR",
      "name": "Disaster Recovery Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for recovery objectives, sites, replication readiness, failover/failback plans and executions.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "RPO/RTO profiles",
      "primary/recovery sites",
      "capacity",
      "data replication/lag",
      "fencing state",
      "failover plan/execution",
      "traffic state",
      "failback/reconciliation"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Primary site, recovery site, failover plan/execution and traffic/data states remain distinct.",
    "action_rule": "failover/failback/test-dr operations use separate authorized workflows.",
    "authority_rule": "Viewing outage/recovery state grants no failover authority.",
    "failure_rule": "split-brain-risk/stale-data/partial/fencing-failed states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor triggers failover by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "RPO shown guaranteed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "split-brain hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "site identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "viewing grants DR admin",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_FAILOVER",
      "target_ref": "AIGMOS_FAILOVER_EXECUTION_CONTRACT",
      "purpose": "Monitor projects exact failover state."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for recovery objectives, sites, replication readiness, failover/failback plans and executions.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
