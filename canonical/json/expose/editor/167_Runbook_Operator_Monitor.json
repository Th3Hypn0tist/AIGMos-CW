  "semantics": {
    "views": [
      "runbook registry/revision",
      "execution sessions",
      "step state",
      "manual intervention requests",
      "break-glass grants/lifetime",
      "operator/session/authorization attribution",
      "audit refs"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Runbook, session, operator, break-glass grant, operation request and execution identities remain distinct.",
    "action_rule": "start-runbook/request-break-glass/revoke-break-glass operations use separate authorized workflows.",
    "authority_rule": "Viewing a runbook/grant grants no operational authority.",
    "failure_rule": "expired-grant/unattributed-action/skipped-step/failed-step states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor grants break-glass by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "shared admin shown attributable",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "runbook/session conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "expired elevation hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "viewing grants operator rights",
        "result": "hard_fail"
      }
    ]
  },
