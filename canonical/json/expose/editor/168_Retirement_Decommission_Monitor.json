    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Service, dependency, dataset, endpoint, credential, retirement plan and completion identities remain distinct.",
    "action_rule": "drain/decommission/purge/complete-retirement operations use separate authorized workflows.",
    "authority_rule": "Viewing retirement plan grants no destructive authority.",
    "failure_rule": "blocked-dependency/data-hold/live-credential/incomplete states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
