  },
  "identity": {
    "id": "AIGMOS_EXPOSE_DWH_POLICY_MONITOR_CONTRACT",
    "name": "DWH Policy Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for remote scopes, EXT bindings, remote authorization decisions and DWH data-release outcomes, linked to lineage evidence.",
  "scope": {
    "owns": [
      "DWH Policy Monitor semantics"
    ],
    "does_not_own": [
      "domain payload semantics",
      "transport implementation",
      "presentation semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_DWH_POLICY_MONITOR",
      "name": "DWH Policy Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for remote scopes, EXT bindings, remote authorization decisions and DWH data-release outcomes, linked to lineage evidence.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "remote scope state",
      "EXT registry/binding status",
      "remote authorization decisions",
      "release allow/deny/transformed decisions",
      "lineage/taint evidence links"
    ],
    "readonly_rule": "Monitor is observability only.",
    "authority_rule": "Viewing policy state grants no mutation/release authority.",
    "redaction_rule": "Restricted identities/data are redacted according to applicable policy.",
    "trace_rule": "Displayed decisions retain exact policy/evidence/lineage refs.",
    "action_rule": "Any configuration/remediation action invokes a separate authorized canonical editor/operation.",
    "layout_rule": "Visual grouping does not create policy relationships."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_POLICY_EXPLICIT",
        "rule": "DWH scope, release, remote access and policy decisions remain explicit, provenance-preserving and separate from transport reachability."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor mutates policy directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "viewing decision grants release authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "restricted data leaked through monitor",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "decision displayed without evidence refs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "visual grouping interpreted as policy relation",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_RELEASE",
      "target_ref": "AIGMOS_DWH_DATA_RELEASE_POLICY_CONTRACT",
      "purpose": "Monitor observes release decisions."
    },
    {
      "id": "REF_LINEAGE",
      "target_ref": "AIGMOS_DWH_LINEAGE_QUERY_CONTRACT",
      "purpose": "Monitor links release decisions to lineage."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for remote scopes, EXT bindings, remote authorization decisions and DWH data-release outcomes, linked to lineage evidence.",
    "notes": [
      "Unlocked pending reconciliation against DWH local/remote, AC/IAM and lineage contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
