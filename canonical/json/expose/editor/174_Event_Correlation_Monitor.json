  "semantics": {
    "views": [
      "Event type registry",
      "Event occurrences",
      "producer/subject",
      "causal refs",
      "correlation groups",
      "subscriptions",
      "delivery state",
      "notifications"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Event type, occurrence, correlation, subscription, notification and operation identities remain distinct.",
    "action_rule": "subscribe/unsubscribe/replay-request operations use separate workflows.",
    "authority_rule": "Viewing Events grants no emission/operation authority.",
    "failure_rule": "invalid-payload/stale-subscription/delivery-fail/unknown-cause states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_MEANING",
        "rule": "Machine-significant identity, type, relation, state and meaning are explicit and never inferred solely from display text, path, layout, file order, timestamp or implementation accident."
      },
      {
        "id": "DERIVED_NONAUTHORITY",
        "rule": "Resolved, projected, indexed, cached, formatted or derived representations never become source-of-truth or authority merely because they are convenient or available."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor emits Event by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "correlation shown as cause",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "notification shown as source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants subscribe rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "failed delivery hidden",
        "result": "hard_fail"
      }
    ]
  },
