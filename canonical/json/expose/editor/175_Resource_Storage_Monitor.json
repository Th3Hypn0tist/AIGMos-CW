    "name": "Logical Resource and Storage Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for logical resources, file artifacts, storage bindings, revisions and atomic replacement state.",
  "scope": {
    "owns": [
      "Logical Resource and Storage Monitor semantics"
    ],
    "does_not_own": [
      "runtime execution authority",
      "AccessCore policy ownership",
      "domain-specific semantic ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_RESOURCE_STORAGE_MONITOR",
      "name": "Logical Resource and Storage Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for logical resources, file artifacts, storage bindings, revisions and atomic replacement state.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "resource registry",
      "artifact type",
      "storage bindings/replicas",
      "content revisions",
      "hashes",
      "concurrency/conflicts",
      "candidate/committed state"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Logical resource, file artifact, path, storage location and content revision identities remain distinct.",
    "action_rule": "move/copy/replace operations use separate authorized workflows.",
    "authority_rule": "Viewing storage metadata grants no data authority.",
    "failure_rule": "missing-replica/conflict/partial-write/hash-mismatch states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_MEANING",
        "rule": "Machine-significant identity, type, relation, state and meaning are explicit and never inferred solely from display text, path, layout, file order, timestamp or implementation accident."
      },
      {
        "id": "DERIVED_NONAUTHORITY",
        "rule": "Resolved, projected, indexed, cached, formatted or derived representations never become source-of-truth or authority merely because they are convenient or available."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor replaces file by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "path shown identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "latest mtime shown canonical",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants write rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "replica conflict hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define a read-only Expose monitor for logical resources, file artifacts, storage bindings, revisions and atomic replacement state.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
