    "name": "Reconciliation Inventory Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define read-only Expose monitor for tree inventory, source classification, active/history audit, orphan findings and reconciliation snapshot.",
  "scope": {
    "owns": [
      "Reconciliation Inventory Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "runtime execution authority",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_RECONCILIATION_INVENTORY_MONITOR",
      "name": "Reconciliation Inventory Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define read-only Expose monitor for tree inventory, source classification, active/history audit, orphan findings and reconciliation snapshot.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "repository inventory",
      "file hashes/types",
      "source roles",
      "active/history split",
      "orphan files",
      "bootstrap source",
      "snapshot identity"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "File, canonical identity, inventory run and reconciliation snapshot remain distinct.",
    "action_rule": "classify/archive/delete candidates use separate authorized workflows.",
    "authority_rule": "Viewing orphan/source findings grants no cleanup authority.",
    "failure_rule": "unclassified/competing-source/orphan/bootstrap-conflict states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor deletes orphan by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "history shown active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "snapshot shown accepted source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants repo admin",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "conflict hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define read-only Expose monitor for tree inventory, source classification, active/history audit, orphan findings and reconciliation snapshot.",
    "notes": [
      "Unlocked pending application to the final merged review tree.",
      "This contract defines reconciliation semantics; it does not claim that repository-wide reconciliation has already passed."
    ]
  },
