  "semantics": {
    "views": [
      "collision findings",
      "claimants",
      "alias conflicts",
      "duplicate semantic candidates",
      "rename/migration plans",
      "remaining blockers"
    ],
    "readonly_rule": "Default is read-only; proposed resolutions remain candidates.",
    "identity_rule": "Canonical identity, alias, collision finding and migration proposal remain distinct.",
    "action_rule": "propose-rename/deprecate-alias/accept-resolution operations use separate workflows.",
    "authority_rule": "Viewing collision does not grant canonical-edit authority.",
    "failure_rule": "unresolved/ambiguous/breaking-impact states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor auto-renames",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "similar contracts auto-merge",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "viewing grants edit rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "ambiguous alias hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "breaking change marked cosmetic",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define read-only/candidate-resolution Expose monitor for identity collisions, aliases, duplicate semantics and migration proposals.",
    "notes": [
      "Unlocked pending application to the final merged review tree.",
      "This contract defines reconciliation semantics; it does not claim that repository-wide reconciliation has already passed."
    ]
  },
