    "views": [
      "readiness profile",
      "required results",
      "blocker registry",
      "bounded exceptions",
      "closure readiness",
      "whole-tree result",
      "lock batch plan"
    ],
    "readonly_rule": "Default is read-only.",
    "identity_rule": "Finding, blocker, exception, readiness result, contract status and lock plan remain distinct.",
    "action_rule": "accept-exception/propose-lock-batch/lock operations use separate authorized workflows.",
    "authority_rule": "Viewing readiness grants no canonical/runtime authority.",
    "failure_rule": "blocked/conditional/expired-exception/stale-result states remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor locks by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "exception hides blocker",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "ready shown deployed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants repo admin",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "stale result treated current",
        "result": "hard_fail"
      }
    ]
  },
