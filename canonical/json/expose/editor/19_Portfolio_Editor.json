    "role": "Expose MetaModule",
    "views": [
      "portfolio entries",
      "Project links",
      "external references",
      "evidence verification state",
      "profile/CV projection"
    ],
    "edit_rule": "Create/update/remove operations target exact PortfolioCore identities.",
    "verification_rule": "Editor cannot mark evidence verified without the explicit verification operation/evidence required by policy.",
    "merit_rule": "Editor cannot directly edit MeritCore points/Tier/trust/recommendations.",
    "authority_rule": "Editor has no AC bypass and uses normal AccessCore authorization.",
    "self_rule": "UI layout/navigation remains nanoCMS/MetaModule composition rather than PortfolioCore semantics."
  },
