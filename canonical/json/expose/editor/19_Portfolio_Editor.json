    "invariants": [
      {
        "id": "PORTFOLIO_EVIDENCE_EXPLICIT",
        "rule": "PortfolioCore represents explicit identity-linked references and evidence metadata; it never manufactures competence, merit, trust or authorization from presentation content."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Portfolio Editor directly edits MeritCore values",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "UI marks evidence verified without verification operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "Editor bypasses AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "UI layout becomes PortfolioCore semantic ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "mutation targets fuzzy display label",
        "result": "hard_fail"
      }
    ]
  },
