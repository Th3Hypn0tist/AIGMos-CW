    "views": [
      "root bootstrap",
      "hash/version",
      "tool compatibility",
      "cache hit/miss",
      "bootstrap errors",
      "execution identity"
    ],
    "readonly_rule": "Read-only by default.",
    "authority_rule": "Viewing/valid bootstrap grants no repo-edit authority.",
    "failure_rule": "fatal bootstrap states remain explicit.",
    "identity_rule": "Bootstrap source, context, cache entry and execution identities remain distinct."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor repairs bootstrap by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "cache shown source truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "viewing grants edit rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "fatal error hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "multiple roots auto-selected",
        "result": "hard_fail"
      }
    ]
  },
