    "views": [
      "pipeline stages",
      "stage status",
      "findings by severity/category",
      "source/json paths",
      "rule refs",
      "blocking status"
    ],
    "readonly_rule": "Default read-only.",
    "action_rule": "rerun/validate operations separate.",
    "authority_rule": "Viewing clean pipeline grants no lock/apply authority.",
    "failure_rule": "fatal/blocked/stale-run states explicit."
  },
