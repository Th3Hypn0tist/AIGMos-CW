    "views": [
      "run identity/snapshot",
      "stage status",
      "blocking findings",
      "candidate resolutions",
      "stale status",
      "result summary"
    ],
    "readonly_rule": "Default read-only.",
    "action_rule": "rerun/propose-fix separate workflows.",
    "authority_rule": "Viewing reconciliation grants no canonical write/lock authority.",
    "failure_rule": "blocked/partial/stale/unknown explicit."
  },
