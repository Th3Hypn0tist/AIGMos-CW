      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "role": "Expose MetaModule/function",
    "views": [
      "merit evidence",
      "weekly/hour atoms",
      "points calculation trace",
      "Tier qualification evidence",
      "recommendations/trust",
      "review state"
    ],
    "analysis_rule": "Analysis reads accepted MeritCore semantics and may compute non-authoritative explanatory projections.",
    "qc_rule": "QC may be used as a selected local/external analysis backend where configured, but QC output does not directly mutate MeritCore.",
    "target_rule": "Analysis target is an exact identity/Project/evidence ref.",
    "mutation_rule": "Any accepted MeritCore change uses separate explicit MeritCore operation/review workflow.",
    "authority_rule": "Expose function has no AccessCore bypass.",
    "trace_rule": "Displayed derived values retain source/rule refs."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MERIT_EVIDENCE_BOUND",
        "rule": "MeritCore-derived points, Tier, recommendations and trust remain bound to one identity and explicit Project/evidence history; they cannot be manufactured by presentation, identity merging or time-splitting."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Merit Analyze directly changes points/Tier",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "QC output automatically becomes MeritCore truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "analysis target chosen fuzzily",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "analysis UI becomes scoring authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "function bypasses AccessCore",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_QC",
      "target_ref": "AIGMOS_QC_LOCAL_EXTERNAL_EXECUTION_CONTRACT",
      "purpose": "QC may provide configured analysis."
    },
    {
      "id": "REF_POINTS",
      "target_ref": "AIGMOS_MERIT_POINTS_CALCULATION_CONTRACT",
      "purpose": "Analysis can expose point calculation trace."
    }
  ],
  "prose": {
    "summary": "Define Merit Analyze as an Expose function that projects MeritCore evidence, points, Tier qualification, recommendations and temporal distribution for inspection without becoming a scoring authority.",
