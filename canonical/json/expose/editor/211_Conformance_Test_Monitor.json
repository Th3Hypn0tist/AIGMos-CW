        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "failed fixture hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "stale run treated current",
        "result": "hard_fail"
      }
    ]
