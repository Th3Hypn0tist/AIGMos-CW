    "views": [
      "recursive command tree",
      "short/long help",
      "argument schemas",
      "read-only/effectful classification",
      "recent run ids/status"
    ],
    "readonly_rule": "Viewing help/status does not invoke commands.",
    "authority_rule": "Command visibility grants no execution/repo authority.",
    "identity_rule": "Command definition/invocation/toolchain run identities distinct.",
    "failure_rule": "unknown/non-executable family paths explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "clicking help executes command",
        "result": "hard_fail"
      },
