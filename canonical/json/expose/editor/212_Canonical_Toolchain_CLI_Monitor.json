        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "fuzzy path accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "command/run identity conflated",
        "result": "hard_fail"
      }
    ]
