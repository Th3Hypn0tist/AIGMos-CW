  "semantics": {
    "views": [
      "published Projects",
      "candidate/project matches",
      "Broker relevance explanation",
      "assignment/participation state",
      "public Project ranking"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "trace_rule": "Displayed match/ranking items retain Project, identity, evidence and policy refs.",
    "action_rule": "Publish/unpublish/assign/accept controls invoke separate explicit canonical operations.",
    "authority_rule": "Viewing or ranking a candidate does not grant assignment authority.",
    "merit_rule": "Monitor cannot directly modify MeritCore points/Tier/trust.",
    "layout_rule": "Visual ordering/grouping does not create market or Project semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "FREEMARKET_DERIVED_MATCHING",
        "rule": "FreeMarket/Broker matching and ranking operate over explicit Project, identity, PortfolioCore and MeritCore semantics without creating duplicate work, identity or merit authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor directly assigns candidate without explicit operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "monitor edits MeritCore values",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "ranking display grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "displayed result loses evidence/policy refs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "UI order becomes semantic ranking without policy",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
