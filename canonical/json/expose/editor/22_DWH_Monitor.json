  },
  "semantics": {
    "views": [
      "local instance data bindings",
      "remote bindings",
      "EXT registry",
      "origin/scope metadata",
      "remote dereference trace",
      "transport/session status"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "action_rule": "Endpoint/configuration/lifecycle changes invoke explicit canonical operations.",
    "authority_rule": "Monitor does not grant or bypass local/remote AccessCore authorization.",
    "redaction_rule": "Restricted payload/content/security metadata is redacted according to policy.",
    "identity_rule": "UI labels never replace canonical instance/endpoint/data identities.",
    "transport_rule": "Connection status is displayed separately from data availability/authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_BOUNDARY_EXPLICIT",
        "rule": "DWH data movement preserves explicit origin identity, schema, scope and remote authority boundaries; transport connectivity never becomes data authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor directly mutates governed DWH data without explicit operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "monitor bypasses remote AC",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "connection status treated as authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "restricted payload leaked",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "UI label used as endpoint/data identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
