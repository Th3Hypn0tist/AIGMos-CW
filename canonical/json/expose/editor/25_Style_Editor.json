  },
  "semantics": {
    "targets": [
      "canonical style tokens",
      "site-wide style configuration",
      "asset references",
      "managed images/assets"
    ],
    "single_source_rule": "Editor writes the one canonical style definition for its target scope.",
    "preview_rule": "Preview is a derived projection and does not become active style until explicit apply.",
    "asset_rule": "Asset management uses the Asset Registry rather than arbitrary path strings.",
    "validation_rule": "Candidate style validates token schema, required assets and references before activation.",
    "authority_rule": "Editor obeys normal AccessCore authorization.",
    "rollback_rule": "Previous accepted style version/state remains recoverable according to change policy."
  },
  "constraints": {
    "invariants": [
      {
        "id": "WEB_PRESENTATION_BOUNDARY",
        "rule": "Web Base, style, assets and responsive layout define reusable presentation primitives only; they do not become semantic or runtime authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Style Editor writes private parallel style model",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "preview silently becomes active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "asset selected by fuzzy path only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Editor bypasses AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "invalid style activated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "previous style state unrecoverable where rollback is required",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_STYLE",
      "target_ref": "AIGMOS_CANONICAL_STYLE_CONTRACT",
