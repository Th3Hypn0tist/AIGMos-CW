      "listener identity",
      "protocol/type",
      "listen address",
      "port",
      "transport",
      "enabled state",
      "lifecycle operation"
    ],
    "scope_rule": "Port Editor owns listener/binding configuration across protocols, not protocol route/address business semantics.",
    "name_rule": "Named listener identity is edited separately from port binding.",
    "validation_rule": "Candidate binding/conflict/protocol compatibility validates before apply/start.",
    "state_rule": "Declared config and current runtime listener state are displayed separately.",
    "action_rule": "Start/stop/reload invoke explicit canonical lifecycle operations.",
    "authority_rule": "Editor obeys normal AccessCore authorization and has no privileged bypass.",
    "protocol_rule": "Protocol-specific route/address/channel configuration remains owned by protocol binding editors/contracts."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LISTENER_IDENTITY_BINDING_SEPARATION",
        "rule": "Listener/service identity is stable and separate from mutable listen binding, protocol configuration and runtime process/session state."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Port Editor duplicates protocol route semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "port used as listener identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "Editor changes running socket before validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "config/runtime state conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Editor bypasses AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "conflict validator bypassed",
        "result": "hard_fail"
      }
    ]
  },
