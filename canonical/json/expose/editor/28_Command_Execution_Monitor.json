  "semantics": {
    "views": [
      "command identity",
      "caller/context",
      "argument validation state",
      "capability resolution",
      "authorization/assurance result",
      "dispatch lifecycle",
      "result/error class",
      "duration/cleanup"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "redaction_rule": "Secrets/restricted arguments/results are redacted according to policy.",
    "identity_rule": "Display preserves exact command/caller/target refs.",
    "authority_rule": "Viewing execution trace does not grant re-run/cancel/write authority.",
    "action_rule": "Re-run/cancel controls, if exposed, invoke separate authorized canonical operations.",
    "trace_rule": "Each execution retains stable runtime execution identity and provenance to command definition."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMMAND_EXECUTION_EXPLICIT",
        "rule": "Executable commands resolve by exact canonical identity and schema, cross one governed dispatcher boundary, and never infer authority from capability presence or parser success."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor exposes secrets",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "viewing trace grants re-run authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "command identified only by display label",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "monitor mutates execution directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "execution trace loses command definition ref",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
