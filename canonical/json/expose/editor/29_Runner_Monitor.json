      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "Routine identity/version",
      "runner identity/state",
      "current/completed steps",
      "per-step dispatch result",
      "timeouts/retries",
      "Event/Trigger origin",
      "cleanup/result"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Routine definition identity and runner execution identity are shown separately.",
    "action_rule": "Start/go/cancel/retry controls, if exposed, invoke separate authorized commands.",
    "authority_rule": "Viewing runner does not grant execution/control authority.",
    "redaction_rule": "Restricted arguments/results are redacted according to policy.",
    "trace_rule": "Displayed steps retain exact command/dispatch refs.",
    "layout_rule": "Visual ordering follows explicit step sequence and does not invent execution semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ROUTINE_RUNNER_EXPLICIT",
        "rule": "Routine definitions and runner executions are separate canonical identities; runners execute explicit ordered routine content through the normal governed dispatch boundary."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor conflates Routine with runner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "monitor directly mutates runner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "viewing grants control authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "step trace loses dispatch refs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "restricted arguments leak",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
