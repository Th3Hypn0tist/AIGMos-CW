  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for UserModule registry, type, schema/domain bindings, dependencies, instances and lifecycle/reload state.",
  "scope": {
    "owns": [
      "UserModule Monitor semantics"
    ],
