  "semantics": {
    "views": [
      "module registry",
      "module type",
      "definition/version",
      "schema/domain refs",
      "dependencies",
      "instances",
      "lifecycle state",
      "load/reload errors"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Definition and runtime instance identities are shown separately.",
    "state_rule": "Installed/registered/enabled/running states remain separately visible.",
    "action_rule": "Enable/disable/start/stop/reload/edit controls invoke separate explicit canonical operations.",
    "authority_rule": "Viewing a module does not grant lifecycle/edit authority.",
    "redaction_rule": "Restricted config/secret values are redacted according to policy.",
    "trace_rule": "Load/reload failures link exact module, dependency and validation refs."
  },
  "constraints": {
    "invariants": [
      {
        "id": "USERMODULE_TYPE_LIFECYCLE_EXPLICIT",
        "rule": "UserModule identity, primary type, schema, instance identity and lifecycle state are explicit and never inferred from filesystem location or implementation behavior."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor conflates definition and instance identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "installed shown as running",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "monitor directly mutates lifecycle",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants reload/start authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "error loses exact dependency/module refs",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_LIFE",
      "target_ref": "AIGMOS_RUNTIME_USERMODULE_LIFECYCLE_CONTRACT",
