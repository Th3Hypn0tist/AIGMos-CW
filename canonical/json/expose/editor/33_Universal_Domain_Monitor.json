  "identity": {
    "id": "AIGMOS_EXPOSE_UNIVERSAL_DOMAIN_MONITOR_CONTRACT",
    "name": "Universal Module and Domain Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for Universal Module substrates, Domain compositions, bindings, ownership and closure findings.",
  "scope": {
    "owns": [
      "Universal Module and Domain Monitor semantics"
    ],
    "does_not_own": [
      "component semantics owned elsewhere",
      "presentation-only grouping",
      "runtime authorization"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_UNIVERSAL_DOMAIN_MONITOR",
      "name": "Universal Module and Domain Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for Universal Module substrates, Domain compositions, bindings, ownership and closure findings.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "Universal Module registry",
      "substrate semantic surfaces",
      "Domain registry",
      "Domain composition graph",
      "bindings",
      "owner provenance",
      "closure/duplication findings"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Module, Domain, binding and semantic-owner identities remain exact/separate.",
    "graph_rule": "Visual composition graph is projection only; edges correspond to explicit composition/binding refs.",
    "action_rule": "Create/edit binding/domain/module operations invoke separate authorized canonical editors/operations.",
    "authority_rule": "Viewing composition does not grant runtime/edit authority.",
    "trace_rule": "Displayed resolved Domain semantics retain substrate owner/source refs.",
    "redaction_rule": "Restricted configuration/details are redacted according to policy."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UNIVERSAL_DOMAIN_COMPOSITION",
        "rule": "Universal Modules are reusable substrates and Domains are explicit compositions of those substrates plus domain-specific deltas; composition never duplicates substrate ownership."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor graph invents composition edge",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "module/domain identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "monitor directly changes composition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants edit authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "resolved semantic loses substrate owner trace",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CLOSE",
      "target_ref": "AIGMOS_UNIVERSAL_DOMAIN_CLOSURE_VALIDATION_CONTRACT",
      "purpose": "Monitor exposes closure findings."
    },
    {
      "id": "REF_DOMAIN",
      "target_ref": "AIGMOS_DOMAIN_REGISTRY_CONTRACT",
      "purpose": "Monitor projects Domain composition."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for Universal Module substrates, Domain compositions, bindings, ownership and closure findings.",
    "notes": [
      "Unlocked pending reconciliation against existing universal_module/domain contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
