    "id": "AIGMOS_EXPOSE_STUDIO_MONITOR_CONTRACT",
    "name": "Studio Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for Studio compositions, Lens definitions, source bindings, presets and analysis executions/results.",
  "scope": {
    "owns": [
      "Studio Monitor semantics"
    ],
    "does_not_own": [
      "source domain semantics",
      "runtime authorization",
      "projection source ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_STUDIO_MONITOR",
      "name": "Studio Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for Studio compositions, Lens definitions, source bindings, presets and analysis executions/results.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "Studio sections",
      "Lens registry",
      "source bindings",
      "Lens presets",
      "analysis backend/source provenance",
      "analysis result history/status"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Studio, Lens, preset, source and analysis-run identities remain distinct.",
    "action_rule": "Create/edit/run/save-preset operations invoke separate authorized canonical operations.",
    "authority_rule": "Viewing or running a Lens does not grant new source authority.",
    "result_rule": "Monitor distinguishes derived analysis results from accepted/persisted canonical data.",
    "trace_rule": "Displayed result retains exact source/Lens/preset/backend refs.",
    "layout_rule": "Visual grouping does not create Topic/source relations."
  },
  "constraints": {
    "invariants": [
      {
        "id": "STUDIO_PROJECTION_NONAUTHORITY",
        "rule": "Studio and Lens compose and project existing canonical semantics; analysis, presets and visualizations never silently become source semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor conflates Lens with source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "monitor directly persists analysis as canonical source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "viewing grants source authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "result loses provenance refs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "visual grouping creates semantic relation",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_LENS",
      "target_ref": "AIGMOS_STUDIO_LENS_CONTRACT",
      "purpose": "Monitor projects Lens definitions/results."
    },
    {
      "id": "REF_BIND",
      "target_ref": "AIGMOS_STUDIO_ANALYSIS_SOURCE_BINDING_CONTRACT",
      "purpose": "Monitor shows exact analysis provenance."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for Studio compositions, Lens definitions, source bindings, presets and analysis executions/results.",
    "notes": [
      "Unlocked pending reconciliation against existing Studio/Strategy/Lens contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
