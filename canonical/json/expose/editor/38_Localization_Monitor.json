  },
  "identity": {
    "id": "AIGMOS_EXPOSE_LOCALIZATION_MONITOR_CONTRACT",
    "name": "Localization Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for label extraction, translation coverage, fallback resolution and accidental identifier localization.",
  "scope": {
    "owns": [
      "Localization Monitor semantics"
    ],
    "does_not_own": [
      "canonical command identifiers",
      "domain semantic identities",
      "runtime authorization"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_LOCALIZATION_MONITOR",
      "name": "Localization Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for label extraction, translation coverage, fallback resolution and accidental identifier localization.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "registered/extracted labels",
      "coverage by language",
      "missing translations",
      "fallback resolution",
      "orphaned labels",
      "unregistered literals",
      "identifier-localization violations"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Label key, target identity, context and translated values remain distinct.",
    "action_rule": "Edit/fix actions invoke separate authorized Localization Editor operations.",
    "authority_rule": "Viewing localization data grants no edit/target authority.",
    "trace_rule": "Findings retain exact source/MetaModule/target refs.",
    "redaction_rule": "User-generated/private content is not exposed merely for localization monitoring."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LABELS_PRESENTATION_ONLY",
        "rule": "Localized labels are context-bearing presentation resources mapped to stable canonical identities; translation never changes command names, internal identifiers or semantic identity."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor directly edits translations",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "label/target identity conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "finding loses source ref",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants edit authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "private user content exposed as translation inventory",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_VALID",
      "target_ref": "AIGMOS_LOCALIZATION_EXTRACTION_VALIDATION_CONTRACT",
      "purpose": "Monitor projects extraction/coverage findings."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for label extraction, translation coverage, fallback resolution and accidental identifier localization.",
    "notes": [
      "Unlocked pending reconciliation against existing localization/Expose contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
