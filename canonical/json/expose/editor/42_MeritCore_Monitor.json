  "identity": {
    "id": "AIGMOS_EXPOSE_MERITCORE_MONITOR_CONTRACT",
    "name": "MeritCore Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for identity-bound merit timelines, points, Tier evidence, recommendations/trust and weekly reporting periods.",
  "scope": {
    "owns": [
      "MeritCore Monitor semantics"
    ],
    "does_not_own": [
      "Project work identity",
      "FreeMarket broker relevance policy",
      "IdentityCore person/organization identity"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_MERITCORE_MONITOR",
      "name": "MeritCore Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for identity-bound merit timelines, points, Tier evidence, recommendations/trust and weekly reporting periods.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "identity Merit timeline",
      "Project evidence",
      "points/evidence provenance",
      "Tier qualification",
      "recommendations/trust",
      "weekly registration-anchored periods",
      "review state"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Identity, Project, merit evidence, recommendation, point result and Tier identities/results remain distinct.",
    "action_rule": "Review/accept/reject/recommend operations invoke separate authorized canonical operations.",
    "authority_rule": "Viewing MeritCore history grants no mutation/recommendation authority.",
    "trace_rule": "Every derived point/Tier/reporting view retains exact evidence/policy refs.",
    "privacy_rule": "Merit visibility follows applicable IAM/privacy policy.",
    "projection_rule": "CV/portfolio-style presentation is derived and never becomes the source Merit record."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MERIT_EVIDENCE_BOUND",
        "rule": "MeritCore derives human competence/trust history from explicit identity-bound Project evidence; identities, evidence, recommendations, points, Tier and broker relevance remain separate semantic dimensions."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor directly edits points/Tier",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "identity histories merged visually as one semantic record",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "derived CV becomes source record",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants recommendation authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Tier result loses evidence refs",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TIER",
      "target_ref": "AIGMOS_MERITCORE_TIER_QUALIFICATION_CONTRACT",
      "purpose": "Monitor projects Tier evidence."
    },
    {
      "id": "REF_WEEK",
      "target_ref": "AIGMOS_MERITCORE_WEEKLY_REPORTING_CONTRACT",
      "purpose": "Monitor projects registration-anchored reporting."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for identity-bound merit timelines, points, Tier evidence, recommendations/trust and weekly reporting periods.",
    "notes": [
      "Unlocked pending reconciliation against existing IAM/MeritCore/Project/FreeMarket contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
