    {
      "id": "TOPIC_EXPOSE_SOURCE_RESOLUTION_MONITOR",
      "name": "Source Resolution Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for Contract Format bootstrap source, active canonical source tree, source roles, same-identity conflicts, selected authority and local/package equivalence findings.",
