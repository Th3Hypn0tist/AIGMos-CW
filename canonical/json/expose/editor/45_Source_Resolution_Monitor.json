  "semantics": {
    "views": [
      "bootstrap artifact",
      "canonical source root",
      "source registry",
      "source roles",
      "same-identity conflicts",
      "selected/rejected authority",
      "candidate versus accepted sources",
      "local/package equivalence"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Source artifact identity, canonical semantic identity and physical path remain distinct.",
    "authority_rule": "Viewing source authority does not grant mutation/reconciliation authority.",
    "action_rule": "Reconcile/migrate/accept/replace actions invoke separate authorized canonical workflows.",
    "trace_rule": "Every selected/rejected source displays exact role/provenance/reason refs.",
    "bootstrap_rule": "Monitor displays bootstrap artifact separately from canonical/json source tree.",
    "layout_rule": "Visual ordering never implies source precedence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SOURCE_RESOLUTION_DETERMINISTIC",
        "rule": "Canonical source resolution is deterministic, exact-identity based and provenance-preserving; filesystem location, transport or freshness never silently changes semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor treats path as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "visual order implies authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "monitor directly reconciles sources without explicit operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "bootstrap and canonical tree shown as same source layer",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "selected source lacks precedence/provenance explanation",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_VALID",
      "target_ref": "AIGMOS_SOURCE_RESOLUTION_VALIDATION_CONTRACT",
      "purpose": "Monitor projects source-resolution findings."
