    "name": "Repository Acceptance Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for candidate/accepted snapshots, acceptance gates, lock eligibility, replacement history and rollback targets.",
  "scope": {
    "owns": [
      "Repository Acceptance Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic content",
      "runtime business authority",
      "commercial licensing"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_REPOSITORY_ACCEPTANCE_MONITOR",
      "name": "Repository Acceptance Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for candidate/accepted snapshots, acceptance gates, lock eligibility, replacement history and rollback targets.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "current accepted snapshot",
      "candidate review trees",
      "acceptance gate matrix",
      "hard fails/warnings",
      "lock eligibility",
      "replacement history",
      "rollback targets",
      "bootstrap/source-resolution status"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Candidate, accepted snapshot, contract identity and runtime state remain separate.",
    "action_rule": "Accept/replace/lock/rollback/revalidate actions invoke separate authorized canonical workflows.",
    "authority_rule": "Viewing validation or eligibility grants no acceptance/replacement authority.",
    "trace_rule": "Every acceptance/replacement result links exact snapshot and validation evidence refs.",
    "runtime_rule": "Monitor shows repository acceptance separately from runtime activation/reload.",
    "layout_rule": "Visual pass/fail ordering never changes gate precedence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCEPTANCE_EXPLICIT",
        "rule": "Candidate canonical trees become accepted/locked only through explicit reproducible validation and clean replacement; review state, acceptance state and runtime activation remain distinct."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor directly replaces accepted tree",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "candidate and accepted snapshot conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "viewing eligibility grants lock authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "runtime active state used as repository acceptance proof",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "acceptance result lacks exact validation/snapshot refs",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_GATES",
      "target_ref": "AIGMOS_REPOSITORY_ACCEPTANCE_GATES_CONTRACT",
      "purpose": "Monitor projects acceptance gates."
    },
    {
      "id": "REF_ROLL",
      "target_ref": "AIGMOS_ACCEPTED_SNAPSHOT_ROLLBACK_CONTRACT",
      "purpose": "Monitor exposes exact rollback targets."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for candidate/accepted snapshots, acceptance gates, lock eligibility, replacement history and rollback targets.",
    "notes": [
      "Unlocked pending end-to-end repository acceptance validation under Contract Format 1.4."
    ]
  },
