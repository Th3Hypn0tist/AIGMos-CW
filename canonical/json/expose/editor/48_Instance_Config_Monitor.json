    "id": "AIGMOS_EXPOSE_INSTANCE_CONFIG_MONITOR_CONTRACT",
    "name": "Instance Configuration Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for instance identity, IAM parent, AccessCore parent, boot profile, referenced listener/UserModule config and reload status.",
  "scope": {
    "owns": [
      "Instance Configuration Monitor semantics"
    ],
    "does_not_own": [
      "IdentityCore identity semantics",
      "AccessCore policy semantics",
      "runtime business-domain semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_INSTANCE_CONFIG_MONITOR",
      "name": "Instance Configuration Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for instance identity, IAM parent, AccessCore parent, boot profile, referenced listener/UserModule config and reload status.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "instance identity/name",
      "active snapshot ref",
      "IAM parent",
      "AccessCore parent",
      "boot/use profile",
      "listener refs",
      "UserModule refs",
      "candidate/current config diff",
      "reload status"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Instance, IAM parent, AC parent, active snapshot and listener/module identities remain distinct.",
    "action_rule": "Edit/reload/change-parent operations invoke separate authorized canonical editors/operations.",
    "authority_rule": "Viewing instance configuration grants no IAM/AC/runtime lifecycle authority.",
    "secret_rule": "Credential secrets and restricted config values are never displayed.",
    "trace_rule": "Reload/change findings retain exact old/new owner refs.",
    "layout_rule": "UI nesting does not imply parent/ownership semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "INSTANCE_CONFIG_SEPARATION",
        "rule": "AIGMos instance identity, configuration, IAM parent, AccessCore parent and runtime state remain explicit separate dimensions; configuration never silently changes semantic ownership or authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor conflates IAM and AC parent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "active snapshot shown as instance identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "monitor directly rewrites config",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants reload authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "secret config leaked",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "UI nesting creates parent relation",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_IAM",
      "target_ref": "AIGMOS_INSTANCE_IAM_PARENT_BINDING_CONTRACT",
      "purpose": "Monitor displays explicit IAM parent."
    },
    {
      "id": "REF_AC",
      "target_ref": "AIGMOS_INSTANCE_ACCESSCORE_PARENT_BINDING_CONTRACT",
      "purpose": "Monitor displays explicit AC parent."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for instance identity, IAM parent, AccessCore parent, boot profile, referenced listener/UserModule config and reload status.",
    "notes": [
