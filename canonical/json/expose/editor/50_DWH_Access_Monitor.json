  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for origin input policy, output schema policy, EXT registration, governed `>` addressing, remote read-only boundaries and AccessCore decisions.",
  "scope": {
    "owns": [
      "DWH Access Monitor semantics"
    ],
    "does_not_own": [
      "AccessCore policy ownership",
      "IAM identity semantics",
      "transport cryptography semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_DWH_ACCESS_MONITOR",
      "name": "DWH Access Monitor",
      "type": "topic",
