  "semantics": {
    "views": [
      "origin input scope",
      "output schema projection",
      "EXT registry",
      "remote > resolution",
      "read-only/writable capability",
      "origin identity/assurance",
      "target AccessCore decision",
      "remote trace"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "separation_rule": "EXT registration, DWH address resolution, DWH boundary policy and AccessCore authorization remain visibly distinct.",
    "action_rule": "EXT edit, policy edit and remote mutation invoke separate authorized operations.",
    "authority_rule": "Viewing remote resources grants no read/write authority beyond already authorized monitor data.",
    "trace_rule": "Each remote access view retains origin, target, schema, policy and authorization refs.",
    "failure_rule": "Denied/unresolved paths are displayed explicitly rather than hidden as successful empty results.",
    "secret_rule": "Transport/session secrets are never displayed."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_ORIGIN_TARGET_GOVERNANCE",
        "rule": "DWH applies data-boundary policy at the origin and target independently; remote addressing, transport reachability and external registration never substitute for AccessCore authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor conflates EXT registration with authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "monitor directly mutates remote data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "denied path displayed as successful",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "origin/target policy provenance lost",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "viewing grants remote write authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_IN",
      "target_ref": "AIGMOS_DWH_ORIGIN_INPUT_GOVERNANCE_CONTRACT",
      "purpose": "Monitor projects origin boundary."
