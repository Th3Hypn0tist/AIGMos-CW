  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "Event identity/type/source",
      "Trigger registry",
      "match results",
      "Event→Trigger→Runner graph",
      "resulting Events",
      "loop/reentry bounds",
      "provenance trace",
      "failures/limits"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Event, Trigger, runner, operation and resulting Event identities remain distinct.",
    "graph_rule": "Visual graph edges correspond only to explicit causality edges.",
    "action_rule": "Enable/disable/edit/fire-test actions invoke separate authorized canonical operations.",
    "authority_rule": "Viewing Events/Triggers grants no execution authority.",
    "payload_rule": "Sensitive Event payload fields are redacted according to policy.",
    "trace_rule": "Displayed causality retains exact source/target/rule refs.",
    "failure_rule": "Loop-limit/failed activations are shown explicitly."
  },
  "constraints": {
    "invariants": [
      {
        "id": "CAUSALITY_EXPLICIT",
        "rule": "Event, Trigger, Runner and resulting Event are separate explicit identities connected only by declared causality edges; matching or adjacency never implies execution."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor invents causal edge",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "monitor directly executes trigger target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "viewing grants execution authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "event/trigger identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "loop-limit failure hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EDGE",
      "target_ref": "AIGMOS_EVENT_CAUSALITY_EDGE_CONTRACT",
      "purpose": "Monitor projects explicit causal graph."
    },
    {
      "id": "REF_LOOP",
      "target_ref": "AIGMOS_CAUSALITY_LOOP_BOUNDS_CONTRACT",
      "purpose": "Monitor exposes automation bounds."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for Event streams, Trigger definitions/matches, causal graph edges, runner handoff, loop bounds and provenance traces.",
