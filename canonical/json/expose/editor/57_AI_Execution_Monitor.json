    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "q command, backend/model, target, model-output record and dispatched operation identities remain distinct.",
    "output_rule": "Model output is visibly distinguished from accepted canonical/runtime effects.",
    "action_rule": "rerun/change-backend/approve-or-dispatch operations invoke separate authorized canonical operations where supported.",
    "authority_rule": "Viewing model output grants no execution authority.",
    "redaction_rule": "Sensitive prompts/context/results are redacted according to policy.",
