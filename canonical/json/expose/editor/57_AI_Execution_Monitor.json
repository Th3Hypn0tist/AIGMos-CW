      {
        "id": "MODEL_OUTPUT_NONAUTHORITY",
        "rule": "q/qc/qt model execution produces inert candidate data; models may request or propose operations but only AIGMos canonical validation, authorization and dispatch can create effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor presents model output as executed truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "backend/model and q identity conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "monitor directly executes output text",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants dispatch authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "effect trace loses originating request ref",
        "result": "hard_fail"
      }
    ]
  },
