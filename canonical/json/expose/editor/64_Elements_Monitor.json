{
  "format": {
    "contract_format": "CANONICAL_CONTRACT",
    "format_version": "1.6"
  },
  "identity": {
    "id": "AIGMOS_EXPOSE_ELEMENTS_MONITOR_CONTRACT",
    "name": "Expose Elements Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for Element definitions/instances, resource/operation bindings, schema/localization/style refs and validation findings.",
  "scope": {
    "owns": [
      "Expose Elements Monitor semantics"
    ],
    "does_not_own": [
      "domain business semantics",
      "AccessCore policy ownership",
      "canonical style ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_ELEMENTS_MONITOR",
      "name": "Expose Elements Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for Element definitions/instances, resource/operation bindings, schema/localization/style refs and validation findings.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "Element registry/types",
      "rendered instance refs",
      "resource/value bindings",
      "operation bindings",
      "schema field/parameter refs",
      "localization label refs",
      "style/token refs",
      "validation findings"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Element definition, rendered instance, represented resource, operation, route and style/label identities remain distinct.",
    "binding_rule": "Visual graph/list shows only explicit bindings.",
    "action_rule": "Edit/rebind/style/localize operations invoke separate authorized editors/operations.",
    "authority_rule": "Viewing Elements grants no resource mutation or invocation authority.",
    "validation_rule": "Monitor surfaces unresolved bindings, hard-coded UI strings, schema mismatches and effectful navigation violations.",
    "layout_rule": "DOM/layout adjacency never appears as a semantic binding unless explicitly declared."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ELEMENT_PRESENTATION_NONAUTHORITY",
        "rule": "Expose Elements are reusable human-interface primitives that project or invoke explicitly bound semantics; visual form, nesting, focus, color, position or enabled-looking state never creates ownership, authority or domain meaning."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor invents binding from DOM adjacency",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "element/resource identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "monitor directly invokes control operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "hard-coded untranslated label accepted silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "effectful navigation violation hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EL",
      "target_ref": "AIGMOS_EXPOSE_ELEMENT_IDENTITY_CONTRACT",
      "purpose": "Monitor projects explicit Elements."
    },
    {
      "id": "REF_NAV",
      "target_ref": "AIGMOS_EXPOSE_NAVIGATION_ACTION_SEPARATION_CONTRACT",
      "purpose": "Monitor validates navigation/action boundary."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for Element definitions/instances, resource/operation bindings, schema/localization/style refs and validation findings.",
    "notes": [
      "Unlocked pending reconciliation against Web Base, Form/GUI Editor, localization and canonical style contracts."
    ]
  },
