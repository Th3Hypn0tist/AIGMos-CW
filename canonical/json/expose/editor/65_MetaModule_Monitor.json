  "constraints": {
    "invariants": [
      {
        "id": "METAMODULE_COMPOSITION_NONOWNERSHIP",
        "rule": "A MetaModule is an explicit composition of existing semantic capabilities; composition, placement or runtime activation never silently transfers ownership, identity or authority from constituent modules/resources."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor conflates placement and MetaModule identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "visual adjacency invents constituent relation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "monitor directly activates without explicit operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "ownership provenance hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "inactive placement shown as active capability",
        "result": "hard_fail"
      }
    ]
  },
