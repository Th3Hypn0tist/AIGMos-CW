  },
  "identity": {
    "id": "AIGMOS_EXPOSE_DWH_QUERY_MONITOR_CONTRACT",
    "name": "DWH Query Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor/editor projection for query definitions, resolved sources, filters, projections, joins, aggregations, ordering/pagination, result provenance and governance findings.",
  "scope": {
    "owns": [
      "DWH Query Monitor semantics"
    ],
    "does_not_own": [
      "source schema ownership",
      "AccessCore policy ownership",
      "materialized destination ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_DWH_QUERY_MONITOR",
      "name": "DWH Query Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor/editor projection for query definitions, resolved sources, filters, projections, joins, aggregations, ordering/pagination, result provenance and governance findings.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "query identity",
      "source/schema/instance refs",
      "parameters",
      "filters/projections",
      "join graph",
      "aggregation/grouping",
      "order/limit/pagination",
      "result-set identity",
      "lineage/classification",
      "authorization/validation findings"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Query definition, query execution, source record, result set and result-field identities remain distinct.",
    "graph_rule": "Visual join edges correspond only to explicit declared relation/key joins.",
    "action_rule": "edit/save/run/materialize operations invoke separate authorized canonical workflows.",
    "authority_rule": "Viewing query definition/result metadata grants no source data authority.",
    "derived_rule": "Aggregated/projected values are visibly marked derived with provenance.",
    "failure_rule": "Ambiguous fields, unauthorized sources, invalid joins and unstable pagination are surfaced explicitly."
  },
  "constraints": {
    "invariants": [
      {
        "id": "QUERY_EXPLICIT_AND_NONOWNING",
        "rule": "A DWH query is an explicit read/projection definition over exact resolved schema/instance/relation identities; querying, filtering, joining, aggregating, ordering or paginating never silently changes source ownership, identity or authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor invents join from visual adjacency",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "query definition/result identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "monitor materializes by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "derived aggregate shown as source truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "unstable pagination hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_QUERY",
      "target_ref": "AIGMOS_DWH_QUERY_IDENTITY_CONTRACT",
      "purpose": "Monitor projects exact query definitions/executions."
    },
    {
      "id": "REF_JOIN",
      "target_ref": "AIGMOS_DWH_QUERY_JOIN_CONTRACT",
      "purpose": "Monitor shows explicit join graph."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor/editor projection for query definitions, resolved sources, filters, projections, joins, aggregations, ordering/pagination, result provenance and governance findings.",
    "notes": [
      "Unlocked pending reconciliation against DWH schema binding, lineage/classification and output-governance contracts."
    ]
  },
