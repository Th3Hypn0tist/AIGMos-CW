  "constraints": {
    "invariants": [
      {
        "id": "REPLICA_NONOWNERSHIP",
        "rule": "Replica/sync state, transport position or local copy never replaces the semantic identity or ownership of the authoritative source data; propagation is explicit, provenance-bearing and conflict-aware."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor treats newest replica as authoritative by timestamp",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "cursor and record identity conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "monitor auto-replays queue",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants write authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "unresolved conflict hidden as current",
        "result": "hard_fail"
      }
    ]
