  "identity": {
    "id": "AIGMOS_EXPOSE_DWH_REMOTE_SHARING_MONITOR_CONTRACT",
    "name": "DWH Remote Sharing Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for remote sharing scopes, `all/ext/id` input modes, projected fields, peer bindings, delegated writes and local-vs-remote governance decisions.",
  "scope": {
    "owns": [
      "DWH Remote Sharing Monitor semantics"
    ],
    "does_not_own": [
      "source domain ownership",
      "AccessCore policy ownership",
      "transport cryptography"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_DWH_REMOTE_SHARING_MONITOR",
      "name": "DWH Remote Sharing Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for remote sharing scopes, `all/ext/id` input modes, projected fields, peer bindings, delegated writes and local-vs-remote governance decisions.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "remote sharing profiles",
      "source instance/schema/resource refs",
      "peer/identity bindings",
      "input scope all/ext/id",
      "output field projections/redaction",
      "local vs remote policy",
      "delegated write targets/lifetime",
      "authorization/denial evidence"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Source resource, sharing scope, peer, endpoint, projection and write-delegation identities remain distinct.",
    "authority_rule": "Viewing remote scope/delegation grants no read/write authority.",
    "action_rule": "create/edit/revoke-share/delegate-write/revoke-write operations invoke separate authorized canonical workflows.",
    "graph_rule": "Visual source→scope→peer→projection/delegation edges correspond only to explicit refs.",
    "derived_rule": "Effective access is displayed as a derived governance result, not as semantic ownership.",
    "failure_rule": "Missing scope, denied field, revoked delegation and target-side rejection are surfaced explicitly."
  },
  "constraints": {
    "invariants": [
      {
        "id": "REMOTE_SHARING_NONEXPANSION",
        "rule": "Remote DWH sharing exposes only explicitly scoped and schema-governed data; transport reachability, endpoint registration, local authorization or broader local ownership never silently expands delegated remote rights."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor conflates peer and endpoint identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "monitor grants write by toggling UI without explicit operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "local access displayed as remote delegation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "visual adjacency invents share",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "revoked delegation hidden as active",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SCOPE",
      "target_ref": "AIGMOS_DWH_REMOTE_SHARING_SCOPE_CONTRACT",
      "purpose": "Monitor projects explicit remote scopes."
    },
    {
      "id": "REF_WRITE",
      "target_ref": "AIGMOS_DWH_REMOTE_WRITE_DELEGATION_CONTRACT",
      "purpose": "Monitor exposes delegated mutation boundary."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for remote sharing scopes, `all/ext/id` input modes, projected fields, peer bindings, delegated writes and local-vs-remote governance decisions.",
    "notes": [
      "Unlocked pending reconciliation against DWH access governance, EXT addressing, AccessCore and remote transport contracts."
    ]
  },
