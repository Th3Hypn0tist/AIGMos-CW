  "identity": {
    "id": "AIGMOS_EXPOSE_DWH_INGEST_MAPPING_MONITOR_CONTRACT",
    "name": "DWH Ingest and Mapping Monitor",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor/editor projection for source profiles, field mappings, transformations, validation gates, compatibility and ingest execution results.",
  "scope": {
    "owns": [
      "DWH Ingest and Mapping Monitor semantics"
    ],
    "does_not_own": [
      "source domain ownership",
      "destination schema ownership",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_DWH_INGEST_MAPPING_MONITOR",
      "name": "DWH Ingest and Mapping Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor/editor projection for source profiles, field mappings, transformations, validation gates, compatibility and ingest execution results.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "source profile/origin/format",
      "adapter/transport binding",
      "source→destination field mappings",
      "transformation chain",
      "lossy conversions",
      "schema/quality validation",
      "input scope/governance",
      "mapping compatibility",
      "ingest candidate/result",
      "lineage/quarantine/errors"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Source profile, adapter, mapping, transformation, destination schema/field, ingest execution and accepted record identities remain distinct.",
    "graph_rule": "Visual mapping/transformation edges correspond only to explicit refs.",
    "action_rule": "edit mapping/revalidate/test-ingest/apply-ingest/migrate-mapping operations invoke separate authorized canonical workflows.",
    "authority_rule": "Viewing or testing mapping grants no destination write authority.",
    "candidate_rule": "Preview/test ingest result is visibly candidate-only until acceptance boundary succeeds.",
    "failure_rule": "Unmapped fields, stale mappings, lossy transforms and rejected/quarantined records are surfaced explicitly."
  },
  "constraints": {
    "invariants": [
      {
        "id": "INGEST_MAPPING_EXPLICIT",
        "rule": "External/input data enters DWH only through explicit source profiles, exact field/schema mappings and validated transformations; mapping never transfers ownership, fabricates missing semantics or bypasses origin governance."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor invents field mapping from visual adjacency",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "test ingest commits data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "mapping and destination field identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "viewing grants write authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "stale mapping warning hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_MAP",
      "target_ref": "AIGMOS_DWH_FIELD_MAPPING_CONTRACT",
      "purpose": "Monitor projects exact mappings."
    },
    {
      "id": "REF_ACCEPT",
      "target_ref": "AIGMOS_DWH_INGEST_VALIDATION_ACCEPTANCE_CONTRACT",
      "purpose": "Monitor exposes candidate→accepted boundary."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor/editor projection for source profiles, field mappings, transformations, validation gates, compatibility and ingest execution results.",
    "notes": [
      "Unlocked pending reconciliation against DWH origin governance, schema binding, transformation provenance and adapter contracts."
    ]
  },
