  "semantics": {
    "views": [
      "request/idempotency scope",
      "retry policy",
      "attempt chain",
      "error/retry eligibility",
      "duplicate/conflict decision",
      "accepted effect/result",
      "ambiguous/partial state"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Request, key, policy, attempt, execution, result and duplicate-decision identities remain distinct.",
    "action_rule": "retry/reconcile/cancel operations invoke separate authorized workflows.",
    "authority_rule": "Viewing retry state grants no retry authority.",
    "failure_rule": "ambiguous/partial/conflict states are explicit.",
    "graph_rule": "Attempt/retry/dedupe edges correspond only to explicit refs."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_EXECUTION_BOUNDARY",
        "rule": "Definitions, requests, validation evidence, authorization decisions and concrete executions remain separate identities; only an explicit validated and authorized dispatcher path may create effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor retries by viewing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "idempotency key displayed as execution identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "ambiguous result hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "visual order invents attempt causality",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "duplicate conflict auto-resolved",
        "result": "hard_fail"
      }
    ]
  },
