    {
      "id": "TOPIC_EXPOSE_EXECUTION_CONTEXT_MONITOR",
      "name": "Execution Context and Deadline Monitor",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a read-only Expose monitor for execution context, requester/auth refs, deadlines, propagation and detached/background jobs.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "views": [
      "request/execution context",
      "requester/actor refs",
      "IAM assurance metadata",
      "AccessCore decision ref",
      "deadline/remaining budget",
      "parent/child context propagation",
      "background job ownership/state",
      "timeout/cancellation evidence"
    ],
    "readonly_rule": "Monitor is read-only by default.",
    "identity_rule": "Context, requester, auth evidence, request, execution and background-job identities remain distinct.",
    "redaction_rule": "Secrets and sensitive auth material are never rendered.",
    "action_rule": "cancel/revoke/recheck-auth operations invoke separate authorized workflows.",
    "authority_rule": "Viewing context grants no operation authority.",
    "failure_rule": "expired/unknown auth, missing context and deadline-exceeded remain explicit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_EXECUTION_BOUNDARY",
        "rule": "Definitions, requests, validation evidence, authorization decisions and concrete executions remain separate identities; only an explicit validated and authorized dispatcher path may create effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "monitor exposes credentials",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "context and requester identity conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "viewing grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "expired auth shown valid",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "background job appears parentless without provenance",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CTX",
      "target_ref": "AIGMOS_EXECUTION_CONTEXT_CONTRACT",
      "purpose": "Monitor projects exact execution context snapshots."
    }
  ],
  "prose": {
    "summary": "Define a read-only Expose monitor for execution context, requester/auth refs, deadlines, propagation and detached/background jobs.",
