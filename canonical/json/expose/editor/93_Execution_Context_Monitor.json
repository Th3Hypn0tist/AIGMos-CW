  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a read-only Expose monitor for execution context, requester/auth refs, deadlines, propagation and detached/background jobs.",
  "scope": {
    "owns": [
      "Execution Context and Deadline Monitor semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership"
    ]
  },
