  "semantics": {
    "identity_rule": "Every machine-significant Element definition/type has an explicit identity.",
    "instance_rule": "Rendered Element instance identity is separate from Element type/definition identity.",
    "binding_rule": "Represented resource/value/operation refs are explicit bindings.",
    "layout_rule": "Placement/nesting is presentation structure and never semantic ownership by itself.",
    "style_rule": "Visual style is resolved through canonical style/token semantics rather than duplicated domain definitions.",
    "label_rule": "Human-facing labels resolve through localization identities/context.",
    "authority_rule": "Element existence, visibility, focus or apparent enabled state never grants access or execution authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ELEMENT_PRESENTATION_NONAUTHORITY",
        "rule": "Expose Elements are reusable human-interface primitives that project or invoke explicitly bound semantics; visual form, nesting, focus, color, position or enabled-looking state never creates ownership, authority or domain meaning."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "element id replaces represented resource identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "DOM/layout nesting creates semantic ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "visible element grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "hard-coded duplicated domain semantics embedded into primitive",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "style token becomes business meaning",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_WEB",
      "target_ref": "AIGMOS_WEB_BASE_PRIMITIVES_CONTRACT",
      "purpose": "Elements build on shared Web Base primitives."
    },
    {
      "id": "REF_STYLE",
      "target_ref": "AIGMOS_CANONICAL_STYLE_CONTRACT",
      "purpose": "Element presentation uses canonical style."
    }
  ],
  "prose": {
    "summary": "Define reusable Expose Elements as explicit UI primitive definitions/instances whose identity remains separate from represented domain resources, operations and layout placement.",
    "notes": [
      "Unlocked pending reconciliation against Web Base, Form/GUI Editor, localization and canonical style contracts."
    ]
  },
