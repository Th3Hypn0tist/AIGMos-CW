    "identity_rule": "Each machine-significant element instance has an explicit identity within its composition.",
    "type_rule": "Element type is explicit.",
    "binding_rule": "Data/operation/resource bindings are explicit refs.",
    "resource_rule": "Element identity never replaces represented resource identity.",
    "layout_rule": "Position/size/style are presentation metadata.",
    "authority_rule": "Element visibility/focus/selection grants no authority.",
    "state_rule": "UI local state is separate from canonical resource state."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "button id used as operation identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "selected element becomes target automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "layout position creates relation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "element state becomes canonical state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "visible element grants rights",
        "result": "hard_fail"
      }
    ]
  },
