    "id": "AIGMOS_EXPOSE_DATA_DISPLAY_ELEMENT_CONTRACT",
    "name": "Data Display Element",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define shared read-only display primitives for scalar values, text, badges/status, tables/lists and structured projections while preserving exact source/value provenance.",
  "scope": {
    "owns": [
      "Data Display Element semantics"
    ],
    "does_not_own": [
      "domain business semantics",
      "AccessCore policy ownership",
      "canonical style ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_DATA_DISPLAY_ELEMENT",
      "name": "Data Display Element",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define shared read-only display primitives for scalar values, text, badges/status, tables/lists and structured projections while preserving exact source/value provenance.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "display_types": [
      "text",
      "scalar",
      "status",
      "badge",
      "list",
      "table",
      "structured record",
      "code/preformatted"
    ],
    "source_rule": "Displayed value resolves exact source/resource/field refs where machine-significant.",
    "readonly_rule": "Display element has no mutation semantics.",
    "format_rule": "Formatting/unit/localization is presentation and never changes canonical stored value.",
    "status_rule": "Color/icon/badge may visualize an explicit state but never invent state from appearance alone.",
    "empty_rule": "missing, null, unavailable, denied and empty are distinguishable when semantically relevant.",
    "provenance_rule": "Derived values may expose their derivation/source refs.",
    "authority_rule": "Displaying a value does not grant access to hidden source fields or mutators."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ELEMENT_PRESENTATION_NONAUTHORITY",
        "rule": "Expose Elements are reusable human-interface primitives that project or invoke explicitly bound semantics; visual form, nesting, focus, color, position or enabled-looking state never creates ownership, authority or domain meaning."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "formatted value written back as canonical source implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "missing and denied conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "color alone defines runtime state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "table row order creates semantic priority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "display grants source mutation authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EL",
      "target_ref": "AIGMOS_EXPOSE_ELEMENT_IDENTITY_CONTRACT",
      "purpose": "Display primitives retain explicit element/resource identities."
    }
  ],
  "prose": {
    "summary": "Define shared read-only display primitives for scalar values, text, badges/status, tables/lists and structured projections while preserving exact source/value provenance.",
    "notes": [
      "Unlocked pending reconciliation against Web Base, Form/GUI Editor, localization and canonical style contracts."
    ]
  },
