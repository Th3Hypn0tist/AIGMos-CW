  "semantics": {
    "target_rule": "Form fields bind exact destination resource/schema/field identities.",
    "candidate_rule": "Typing/editing changes candidate state only.",
    "parse_rule": "UI text/input parses into typed candidate values.",
    "validation_rule": "Schema/form validation occurs before apply.",
    "diff_rule": "Candidate semantic diff is explicit.",
    "write_rule": "Apply creates exact Operation Request/DWH mutation through normal governance.",
    "cancel_rule": "Cancel discards candidate without mutating source.",
    "authority_rule": "Editing candidate grants no write authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "typing writes live data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "label used as field identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "cancel leaves partial write",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "valid form auto-saves without explicit operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "candidate grants write rights",
        "result": "hard_fail"
      }
    ]
  },
