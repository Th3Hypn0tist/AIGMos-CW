  "semantics": {
    "control_rule": "Control binds exact operation identity.",
    "target_rule": "Target is explicit and not inferred from focus/selection unless selection itself is an explicit typed binding.",
    "argument_rule": "Control state maps explicitly to operation arguments.",
    "request_rule": "Activation creates inert Operation Request.",
    "confirmation_rule": "Optional destructive/sensitive confirmation is UI evidence only; canonical gates still apply.",
    "feedback_rule": "UI completion state derives from exact execution/result evidence.",
    "authority_rule": "Enabled control does not mean caller is authorized."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "button calls backend implementation directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "focused row becomes hidden target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "enabled means authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "confirmation replaces destructive gate",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "optimistic UI shown success without result",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CTRL",
      "target_ref": "AIGMOS_EXPOSE_OPERATIONAL_CONTROL_ELEMENT_CONTRACT",
      "purpose": "Operational Elements create requests only."
    },
    {
      "id": "REF_REQ",
      "target_ref": "AIGMOS_OPERATION_REQUEST_CONTRACT",
      "purpose": "Effects cross canonical request boundary."
    }
  ],
  "prose": {
    "summary": "Define buttons, toggles, sliders and other operational controls as request producers over exact operations/targets rather than direct implementation calls.",
