  "identity": {
    "id": "AIGMOS_EXPOSE_NAVIGATION_ACTION_SEPARATION_CONTRACT",
    "name": "Navigation and Action Separation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define navigation links/routes separately from state-changing actions so route changes never implicitly execute commands and action controls never masquerade as ordinary navigation.",
  "scope": {
    "owns": [
      "Navigation and Action Separation semantics"
    ],
    "does_not_own": [
      "domain business semantics",
      "AccessCore policy ownership",
      "canonical style ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_NAVIGATION_ACTION_SEPARATION",
      "name": "Navigation and Action Separation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define navigation links/routes separately from state-changing actions so route changes never implicitly execute commands and action controls never masquerade as ordinary navigation.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "navigation_rule": "Navigation changes human-facing location/view using exact nanoCMS route/resource bindings.",
    "action_rule": "State-changing actions invoke explicit canonical operations.",
    "link_rule": "Ordinary links are non-mutating by default.",
    "method_rule": "Mutation semantics are never hidden in an apparently read-only route/navigation transition.",
    "route_rule": "Route identity and represented resource identity remain distinct.",
    "history_rule": "Browser history/back/forward does not repeat state-changing operations merely by navigation replay.",
    "confirmation_rule": "Any confirmation requirement belongs to the operation/profile, not to visual link styling.",
    "authority_rule": "Route accessibility and operation authorization remain separately evaluated."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ELEMENT_PRESENTATION_NONAUTHORITY",
        "rule": "Expose Elements are reusable human-interface primitives that project or invoke explicitly bound semantics; visual form, nesting, focus, color, position or enabled-looking state never creates ownership, authority or domain meaning."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "GET/navigation route performs hidden mutation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "browser back repeats payment/delete operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "link styling determines mutation semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "route identity replaces resource identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "route visibility grants operation authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_NANO",
      "target_ref": "AIGMOS_NANOCMS_ROUTE_BINDING_CONTRACT",
      "purpose": "Navigation uses explicit nanoCMS routes."
    },
    {
      "id": "REF_CTRL",
      "target_ref": "AIGMOS_EXPOSE_OPERATIONAL_CONTROL_ELEMENT_CONTRACT",
      "purpose": "Mutations use explicit operational controls."
    }
  ],
  "prose": {
    "summary": "Define navigation links/routes separately from state-changing actions so route changes never implicitly execute commands and action controls never masquerade as ordinary navigation.",
    "notes": [
      "Unlocked pending reconciliation against Web Base, Form/GUI Editor, localization and canonical style contracts."
    ]
  },
