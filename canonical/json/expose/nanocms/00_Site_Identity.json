  "semantics": {
    "identity_rule": "Each site has an explicit stable identity.",
    "ownership_rule": "Site owns web structure/navigation/placement metadata, not domain or MetaModule internal semantics.",
    "root_rule": "Site root/page tree is explicit.",
    "route_rule": "Site route namespace/profile is explicit.",
    "instance_rule": "Site→web instance binding is explicit.",
    "authority_rule": "Site ownership does not grant underlying MetaModule/domain authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "site owns MetaModule semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "folder tree used as site identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "site grants domain rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "route namespace inferred",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "web instance and site identity conflated",
        "result": "hard_fail"
      }
    ]
  },
