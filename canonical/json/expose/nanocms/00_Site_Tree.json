    "node_types": [
      "site",
      "section",
      "page"
    ],
    "identity_rule": "Every site-tree node has an explicit stable identity.",
    "recursive_rule": "Site-tree nodes may contain child structural nodes recursively.",
    "path_rule": "Route/path is a binding of a node, not its semantic identity.",
    "module_rule": "Placed MetaModules are referenced/bound to nodes and retain their own semantic ownership.",
    "order_rule": "Navigation/display order is explicit presentation metadata where used.",
    "cycle_rule": "Illegal containment cycles hard-fail."
  },
  "constraints": {
    "invariants": [
      {
        "id": "NANOCMS_STRUCTURE_ONLY",
        "rule": "nanoCMS owns canonical web/site structure, routes, navigation and MetaModule placement/bindings; it never becomes owner of the placed MetaModule's semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "site/page identity inferred solely from URL/path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "MetaModule semantics copied into nanoCMS ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "containment cycle accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "filesystem hierarchy treated as canonical site tree",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "display order inferred from JSON order only",
        "result": "hard_fail"
      }
    ]
  },
