        "id": "OP_NANOCMS_DEFINE_SITE",
        "name": "Define nanoCMS site structure",
        "inputs": [
          "site identity",
          "page/route/nav tree"
        ],
        "outputs": [
          "#WEB canonical structure"
        ],
        "errors": [
          "route collision",
          "invalid tree"
        ],
        "side_effects": [
          "#WEB structure updated"
        ]
      },
      {
        "id": "OP_NANOCMS_BIND_METAMODULE",
        "name": "Bind MetaModule to site structure",
        "inputs": [
          "MetaModule ref",
          "site/page binding"
        ],
        "outputs": [
          "placement binding"
        ],
