    "symbol_root": "#WEB",
    "owns": [
      "site hierarchy",
      "pages",
      "routes",
      "navigation metadata",
      "MetaModule placement/bindings"
    ],
    "does_not_own": [
      "MetaModule semantics",
      "runtime execution",
      "domain data semantics"
    ],
    "tree_rule": "Site/page structure is explicit and recursively readable.",
    "route_rule": "Routes are explicit and collision-validated.",
    "placement_rule": "MetaModule placement references existing MetaModule identity.",
    "projection_rule": "Breadcrumbs, nav, sitemap and routes are derived from canonical #WEB structure.",
    "editor_rule": "Editor layout/navigation may itself be represented by the same nanoCMS structure."
  },
