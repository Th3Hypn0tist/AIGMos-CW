        "condition": "route inferred only from filesystem path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "MetaModule placement lacks explicit module identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Editor layout hard-coded outside nanoCMS despite being modeled as canonical site structure",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "navigation projection becomes separate authority",
