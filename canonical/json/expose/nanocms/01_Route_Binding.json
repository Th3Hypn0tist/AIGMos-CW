  "semantics": {
    "route_rule": "Route maps an explicit route pattern/path to an exact target identity.",
    "identity_rule": "Changing a route does not change target semantic identity.",
    "uniqueness_rule": "Conflicting active route bindings in the same listener/site scope hard-fail unless explicit routing precedence exists.",
    "parameter_rule": "Route parameters are explicit binding inputs.",
    "redirect_rule": "Redirect/alias semantics are explicit and do not duplicate target identity.",
    "listener_rule": "Route is evaluated within an explicit named web/nanoCMS listener instance.",
    "authority_rule": "Route reachability does not grant AccessCore authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "NANOCMS_STRUCTURE_ONLY",
        "rule": "nanoCMS owns canonical web/site structure, routes, navigation and MetaModule placement/bindings; it never becomes owner of the placed MetaModule's semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "URL used as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "route conflict silently resolved by file order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "redirect creates duplicate content identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "route reachability bypasses authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "listener scope omitted where ambiguous",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
