  "identity": {
    "id": "AIGMOS_NANOCMS_NAVIGATION_PROJECTION_CONTRACT",
    "name": "Navigation, Breadcrumb and Sitemap Projection",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define navigation, breadcrumbs and sitemap as deterministic projections of canonical nanoCMS structure and metadata rather than separately maintained duplicate trees.",
  "scope": {
    "owns": [
      "Navigation, Breadcrumb and Sitemap Projection semantics"
    ],
    "does_not_own": [
      "MetaModule business semantics",
      "runtime authority",
      "domain data semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_NANOCMS_NAVIGATION_PROJECTION",
      "name": "Navigation, Breadcrumb and Sitemap Projection",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define navigation, breadcrumbs and sitemap as deterministic projections of canonical nanoCMS structure and metadata rather than separately maintained duplicate trees.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "projections": [
      "navigation",
      "breadcrumbs",
      "sitemap",
      "route listing"
    ],
    "source_rule": "Projections derive from the canonical site tree plus explicit visibility/order metadata.",
    "duplicate_rule": "No independent semantic navigation tree is required.",
    "breadcrumb_rule": "Breadcrumb ancestry follows declared structural/navigation relations.",
    "visibility_rule": "Hidden/non-navigation nodes may remain routable according to explicit metadata.",
    "order_rule": "Navigation order is explicit metadata and does not imply execution/domain order.",
    "localization_rule": "Displayed labels resolve through canonical UI label/localization semantics.",
    "authority_rule": "Omission from navigation is not an authorization mechanism."
  },
  "constraints": {
    "invariants": [
      {
        "id": "NANOCMS_STRUCTURE_ONLY",
        "rule": "nanoCMS owns canonical web/site structure, routes, navigation and MetaModule placement/bindings; it never becomes owner of the placed MetaModule's semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "navigation maintained as unrelated duplicate semantic tree",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "breadcrumb ancestry guessed from URL string only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "hidden nav state treated as access control",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "navigation order changes domain semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "localized label replaces node identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TREE",
      "target_ref": "AIGMOS_NANOCMS_SITE_TREE_CONTRACT",
      "purpose": "All projections derive from canonical structure."
    },
    {
      "id": "REF_LOC",
      "target_ref": "AIGMOS_CANONICAL_UI_LABEL_CONTRACT",
      "purpose": "Navigation labels are localizable presentation."
    }
  ],
  "prose": {
    "summary": "Define navigation, breadcrumbs and sitemap as deterministic projections of canonical nanoCMS structure and metadata rather than separately maintained duplicate trees.",
    "notes": [
      "Unlocked pending reconciliation against existing Expose/nanoCMS contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
