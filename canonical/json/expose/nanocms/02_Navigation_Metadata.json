  "semantics": {
    "page_rule": "Navigation metadata binds exact page identities.",
    "label_rule": "Human-facing labels use localization/context refs.",
    "order_rule": "Menu order is presentation metadata only.",
    "breadcrumb_rule": "Breadcrumbs derive from explicit page containment/navigation refs.",
    "visibility_rule": "Navigation-hidden does not imply inaccessible and navigation-visible does not imply authorized.",
    "group_rule": "Menu grouping creates no semantic resource hierarchy.",
    "authority_rule": "Navigation metadata has no operation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "menu order treated semantic priority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "visible menu grants access",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "hidden menu removes AccessCore protection",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "label becomes internal id",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "menu grouping creates ownership",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_PAGE",
      "target_ref": "AIGMOS_NANOCMS_PAGE_TREE_CONTRACT",
      "purpose": "Navigation projects exact page structure."
