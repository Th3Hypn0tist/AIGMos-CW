    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define named nanoCMS web instances with stable logical identity separate from listen binding/runtime state, including canonical default instance `public` with reserved default port 80.",
  "scope": {
    "owns": [
      "Named nanoCMS Web Instance semantics"
    ],
    "does_not_own": [
      "MetaModule business semantics",
      "runtime authority",
      "domain data semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_NANOCMS_NAMED_WEB_INSTANCE",
      "name": "Named nanoCMS Web Instance",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define named nanoCMS web instances with stable logical identity separate from listen binding/runtime state, including canonical default instance `public` with reserved default port 80.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "identity_rule": "Each web/nanoCMS instance has an explicit stable logical name/identity.",
    "binding_rule": "Port/listen address is configuration binding, not instance identity.",
    "runtime_rule": "Declared instance identity/configuration exists independently from running/stopped state.",
    "multi_rule": "Multiple named nanoCMS instances may run concurrently on distinct valid bindings.",
    "public_rule": "Named instance `public` exists canonically.",
    "port_rule": "`public` has port 80 as its default/reserved listen binding even when not currently running/enabled.",
    "lifecycle_rule": "Start/stop/reload changes runtime state without changing logical instance identity.",
    "route_rule": "Each instance hosts its own applicable site/route bindings."
  },
  "constraints": {
    "invariants": [
      {
        "id": "NANOCMS_STRUCTURE_ONLY",
        "rule": "nanoCMS owns canonical web/site structure, routes, navigation and MetaModule placement/bindings; it never becomes owner of the placed MetaModule's semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "port number used as web-instance identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "stopping instance deletes canonical declaration",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "two active listeners conflict on same binding without validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "public instance absent from canonical configuration",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "port 80 default for public lost merely because instance is stopped",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_PORT",
      "target_ref": "AIGMOS_PORT_EDITOR_CONTRACT",
      "purpose": "Port Editor manages named listener bindings."
    },
    {
      "id": "REF_ROUTE",
      "target_ref": "AIGMOS_NANOCMS_ROUTE_BINDING_CONTRACT",
      "purpose": "Routes are scoped to named web instances."
    }
  ],
  "prose": {
    "summary": "Define named nanoCMS web instances with stable logical identity separate from listen binding/runtime state, including canonical default instance `public` with reserved default port 80.",
    "notes": [
      "Unlocked pending reconciliation against existing Expose/nanoCMS contracts and whole-tree Contract Format 1.4 validation."
    ]
