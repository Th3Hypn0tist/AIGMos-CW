{
  "format": {
    "contract_format": "CANONICAL_CONTRACT",
    "format_version": "1.6"
  },
  "identity": {
    "id": "AIGMOS_EXPOSE_NANOCMS_INSTANCE_CONTRACT",
    "name": "nanoCMS Named Instances",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define nanoCMS web services as stable named instances whose semantic identity is independent from listen port and runtime running state.",
  "scope": {
    "owns": [
      "nanoCMS Named Instances semantics"
    ],
    "does_not_own": [
      "runtime execution authority",
      "unrelated domain semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_WEB_INSTANCES",
      "name": "nanoCMS Instances",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define nanoCMS web services as stable named instances whose semantic identity is independent from listen port and runtime running state.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_WEB_INSTANCE_DEFINE",
        "name": "Define nanoCMS instance",
        "inputs": [
          "logical name",
          "site ref",
          "listen binding"
        ],
        "outputs": [
          "named web instance"
        ],
        "errors": [
          "name collision",
          "binding invalid"
        ],
        "side_effects": [
          "web instance config updated"
        ]
      },
      {
        "id": "OP_WEB_INSTANCE_START",
        "name": "Start nanoCMS instance",
        "inputs": [
          "instance identity"
        ],
        "outputs": [
          "running instance"
        ],
        "errors": [
          "binding conflict",
          "start failure"
        ],
        "side_effects": [
          "runtime listener state created"
        ]
      },
      {
        "id": "OP_WEB_INSTANCE_STOP",
        "name": "Stop nanoCMS instance",
        "inputs": [
          "instance identity"
        ],
        "outputs": [
          "stopped instance"
        ],
        "errors": [
          "stop failure"
        ],
        "side_effects": [
          "runtime listener state removed"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "identity_rule": "Every nanoCMS service instance has an explicit logical name.",
    "binding_rule": "Port/listen address is mutable binding, not instance identity.",
    "lifecycle_rule": "Declared instance existence is separate from running/stopped runtime state.",
    "multiplicity_rule": "Multiple named nanoCMS instances may run concurrently when bindings do not conflict.",
    "public_rule": "A named instance public always exists canonically.",
    "public_default_port": 80,
    "public_state_rule": "The public instance and its default port-80 binding exist canonically even when the instance is not running.",
    "site_rule": "Each instance explicitly binds to nanoCMS/#WEB site semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPOSE_RUNTIME_BINDING_EXPLICIT",
        "rule": "Web instances, protocol bindings and exposed surfaces retain explicit stable identity, binding, lifecycle and authority boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "port used as nanoCMS instance identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "stopping service deletes canonical instance definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "public instance disappears when stopped",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "two active instances collide on incompatible listener binding",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "instance site binding inferred only from URL/path",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_NANOCMS",
      "target_ref": "AIGMOS_NANOCMS_STRUCTURE_CONTRACT",
      "purpose": "Web instance serves explicit nanoCMS site structure."
    },
    {
      "id": "REF_SERVICE",
      "target_ref": "AIGMOS_RUNTIME_NAMED_SERVICE_INSTANCE_CONTRACT",
      "purpose": "Web service follows named-instance model."
    }
  ],
  "prose": {
    "summary": "Define nanoCMS web services as stable named instances whose semantic identity is independent from listen port and runtime running state.",
    "notes": [
      "Unlocked until reconciled against existing Expose/runtime contracts and repository-wide Contract Format 1.4 validation."
    ]
  },
