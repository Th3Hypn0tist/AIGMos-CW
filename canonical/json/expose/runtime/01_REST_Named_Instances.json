    "events": [],
    "flows": []
  },
  "semantics": {
    "identity_rule": "REST instance has stable logical name independent of port.",
    "port_rule": "REST port is configurable; no universal default REST port is defined here.",
    "lifecycle_rule": "Declared REST configuration is separate from running state.",
    "exposure_rule": "REST exposes canonical operations/data surfaces and does not create new domain semantics.",
    "authority_rule": "REST reachability does not grant operation/data authority.",
    "multiplicity_rule": "Multiple named REST instances may coexist subject to valid bindings."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPOSE_RUNTIME_BINDING_EXPLICIT",
        "rule": "Web instances, protocol bindings and exposed surfaces retain explicit stable identity, binding, lifecycle and authority boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "REST port treated as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "default REST port invented without canonical definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "REST endpoint creates hidden domain semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "network reachability grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "stopping REST deletes declared instance",
        "result": "hard_fail"
      }
    ]
  },
