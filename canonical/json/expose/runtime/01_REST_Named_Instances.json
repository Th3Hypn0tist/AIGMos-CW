        "name": "Define REST instance",
        "inputs": [
          "logical name",
          "binding",
          "exposure config"
        ],
        "outputs": [
          "named REST instance"
        ],
        "errors": [
          "name collision",
          "binding invalid"
        ],
        "side_effects": [
          "REST config updated"
        ]
      },
      {
        "id": "OP_REST_INSTANCE_LIFECYCLE",
        "name": "Invoke REST lifecycle",
        "inputs": [
          "instance",
          "start/stop/reload"
        ],
        "outputs": [
          "runtime result"
        ],
        "errors": [
