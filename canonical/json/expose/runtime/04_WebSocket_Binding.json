  "semantics": {
    "protocol": "WebSocket",
    "optional_rule": "WebSocket is explicit optional protocol capability.",
    "session_rule": "Connection/session handle is transient runtime state.",
    "identity_rule": "WebSocket session is not user/service semantic identity.",
    "authority_rule": "Handshake/session establishment does not grant canonical operation authority.",
    "event_rule": "Published/subscribed event/value identities are explicit canonical refs.",
    "cleanup_rule": "Disconnect/error releases session/subscription runtime state.",
    "semantic_rule": "WebSocket framing does not own domain/event semantics."
  },
