        "condition": "successful handshake grants operation authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "subscription uses unresolved/fuzzy event identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "disconnect leaves unbounded session/subscription state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "WebSocket protocol redefines canonical event semantics",
        "result": "hard_fail"
      }
