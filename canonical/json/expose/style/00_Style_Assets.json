  "scope": {
    "owns": [
      "Expose Style and Assets semantics"
    ],
    "does_not_own": [
      "runtime execution authority unless explicitly referenced",
      "unrelated domain semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_EXPOSE_STYLE",
      "name": "Style and Assets",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define one canonical site-wide style and explicit web asset registry as presentation semantics under Expose, separate from domain/runtime authority.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_STYLE_DEFINE",
        "name": "Define canonical site style",
        "inputs": [
          "site style tokens/rules"
        ],
        "outputs": [
          "canonical style definition"
        ],
        "errors": [
          "style invalid"
        ],
        "side_effects": [
          "style definition updated"
        ]
      },
      {
        "id": "OP_ASSET_REGISTER",
        "name": "Register web asset",
        "inputs": [
          "asset identity",
          "asset metadata/reference"
        ],
        "outputs": [
          "registered asset"
        ],
        "errors": [
          "asset collision",
          "asset invalid"
        ],
        "side_effects": [
          "asset registry updated"
        ]
      },
      {
        "id": "OP_STYLE_PROJECT",
        "name": "Project style/assets to site",
        "inputs": [
          "canonical style",
          "assets",
          "site context"
        ],
        "outputs": [
          "renderable style/asset surface"
        ],
        "errors": [
          "asset unresolved"
        ],
        "side_effects": []
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "style_rule": "One canonical site-wide style definition may be overridden only through explicit style semantics/configuration.",
    "asset_rule": "Images/assets have explicit identities and references.",
    "brand_defaults": [
      "blue",
      "red",
      "silver",
      "gold"
    ],
    "presentation_rule": "Style affects presentation only and cannot create semantic structure, authority or execution behavior.",
    "editor_rule": "Style Editor edits canonical style/assets through authorized operations.",
    "projection_rule": "Rendered CSS/layout is derived from canonical style; renderer-specific output is not semantic authority.",
    "localization_rule": "Style is separate from UI label/localization semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPOSE_BOUNDARY_EXPLICIT",
        "rule": "Expose, nanoCMS, MetaModules and Editor remain projections/compositions over canonical semantics and never create hidden runtime authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "CSS/layout creates canonical structural semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "style choice grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "asset identity inferred only from filename/path where explicit identity is required",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "renderer output treated as source of truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Style Editor bypasses canonical operation/authorization",
        "result": "hard_fail"
      }
    ]
  },
