    "route_rule": "Each routable path binds an explicit route identity.",
    "page_rule": "Route resolves to one exact page/view composition according to nanoCMS structure.",
    "metamodule_rule": "Placed MetaModule identity is separate from page identity.",
    "resource_rule": "Underlying domain/resource identity is never inferred from URL path alone.",
    "navigation_rule": "Navigating to a page causes no mutation by default.",
    "history_rule": "Browser history navigation cannot replay hidden mutations.",
    "authority_rule": "Route/page visibility does not grant resource authority."
  },
