  "semantics": {
    "identity_rule": "Each managed web asset has an explicit identity.",
    "type_rule": "Asset type/media profile is explicit.",
    "storage_rule": "Filename/path/URL is a binding only.",
    "hash_rule": "Integrity/hash evidence may identify a content revision but does not replace logical asset identity unless explicitly content-addressed.",
    "usage_rule": "Page/style/MetaModule usage references exact asset identity.",
    "version_rule": "Asset revisions are explicit where needed.",
    "authority_rule": "Asset visibility grants no edit/delete authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "filename used as semantic asset identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "URL change creates unrelated asset accidentally",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "asset display grants edit authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "page infers asset by nearest filename",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "hash/version ambiguity ignored",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define images, CSS, fonts, icons and other web assets as explicit logical asset identities separate from filenames, URLs and storage locations.",
