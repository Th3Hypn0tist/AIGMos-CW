  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "browser cache becomes source of truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "static path bypasses AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "mime sniffing changes semantic type silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "delivered copy becomes owner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cached restricted resource served broadly",
        "result": "hard_fail"
      }
    ]
  },
