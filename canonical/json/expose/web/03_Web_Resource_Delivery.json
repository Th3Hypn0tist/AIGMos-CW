  "semantics": {
    "resource_rule": "Delivered resource resolves an exact logical source/asset/page/projection identity.",
    "mime_rule": "Response type/encoding is explicit.",
    "classification_rule": "Delivery obeys applicable source classification and AccessCore/DWH governance.",
    "cache_rule": "HTTP/browser/proxy cache is a delivery optimization only.",
    "etag_rule": "ETag/revision evidence is explicit where used.",
    "source_rule": "Delivered copy is not the canonical source merely because it is cached.",
    "authority_rule": "Successful delivery grants no mutation authority."
