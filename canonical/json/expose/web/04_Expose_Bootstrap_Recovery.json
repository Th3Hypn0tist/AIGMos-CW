  "semantics": {
    "bootstrap_rule": "Recovery surface is explicitly identified and minimal.",
    "authority_rule": "Recovery path still obeys applicable local IAM/AccessCore/bootstrap authority semantics.",
    "self_host_rule": "Editor self-hosting may recover from a known-good definition/copy without mutating the only active definition in place.",
    "asset_rule": "Recovery may use minimal embedded/static assets without creating parallel canonical ownership.",
    "failure_rule": "Broken primary Editor/site does not imply unrestricted recovery access.",
    "activation_rule": "Recovered candidate still validates before activation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "recovery bypasses all AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "broken editor grants open admin",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "recovery definition becomes separate authority model",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "candidate recovery auto-activates unvalidated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "active editor overwritten in place",
        "result": "hard_fail"
      }
    ]
  },
