    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the minimal reusable HTML/CSS-oriented primitive set shared by Expose MetaModules and pages, avoiding duplicated component foundations across modules.",
  "scope": {
    "owns": [
      "Web Base Primitives semantics"
    ],
    "does_not_own": [
      "domain semantics",
      "runtime authority",
      "module-specific business logic"
    ]
  },
  "members": [
    {
      "id": "TOPIC_WEB_BASE_PRIMITIVES",
      "name": "Web Base Primitives",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the minimal reusable HTML/CSS-oriented primitive set shared by Expose MetaModules and pages, avoiding duplicated component foundations across modules.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "role": "shared presentation substrate",
    "primitive_classes": [
      "layout",
      "text",
      "form",
      "control",
      "navigation",
      "status",
      "panel",
      "table",
      "media",
      "feedback"
    ],
    "reuse_rule": "Expose modules reuse Web Base primitives before defining module-specific presentation primitives.",
    "semantic_rule": "Primitive names/types describe presentation behavior, not domain business semantics.",
    "js_rule": "JavaScript is optional at the primitive layer and should not be required where HTML/CSS semantics suffice.",
    "accessibility_rule": "Primitive contracts carry machine-readable accessibility requirements where relevant.",
    "composition_rule": "Higher UI components compose primitives rather than fork private foundations.",
    "authority_rule": "Web Base primitive presence does not grant operation/data authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "WEB_PRESENTATION_BOUNDARY",
        "rule": "Web Base, style, assets and responsive layout define reusable presentation primitives only; they do not become semantic or runtime authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "module duplicates shared primitive without need",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "presentation primitive owns business semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "primitive requires JS without declared need",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "UI primitive grants operation authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "accessibility requirement omitted where primitive requires it",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_META",
      "target_ref": "AIGMOS_METAMODULE_COMPOSITION_CONTRACT",
      "purpose": "MetaModules compose shared Web Base primitives."
    }
  ],
  "prose": {
    "summary": "Define the minimal reusable HTML/CSS-oriented primitive set shared by Expose MetaModules and pages, avoiding duplicated component foundations across modules.",
    "notes": [
      "Unlocked pending reconciliation against existing Expose/Web Base/style contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
