    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define reusable responsive layout primitives for Expose surfaces so desktop/mobile adaptation is driven by declared layout semantics rather than duplicated page-specific CSS structures.",
  "scope": {
    "owns": [
      "Responsive Layout Primitives semantics"
    ],
    "does_not_own": [
      "domain semantics",
      "runtime authority",
      "module-specific business logic"
    ]
  },
  "members": [
    {
      "id": "TOPIC_RESPONSIVE_LAYOUT_PRIMITIVES",
      "name": "Responsive Layout Primitives",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define reusable responsive layout primitives for Expose surfaces so desktop/mobile adaptation is driven by declared layout semantics rather than duplicated page-specific CSS structures.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "primitives": [
      "stack",
      "row",
      "grid",
      "panel",
      "split",
      "overlay",
      "scroll_region",
      "responsive_visibility"
    ],
    "responsive_rule": "Layout behavior across viewport/container sizes is explicit.",
    "container_rule": "Components may respond to parent/container constraints where supported.",
    "order_rule": "Visual rearrangement does not alter semantic or execution order unless the owning semantic explicitly declares it.",
    "accessibility_rule": "Responsive changes preserve meaningful reading/focus order.",
    "composition_rule": "Pages/MetaModules compose layout primitives with content primitives.",
    "style_rule": "Dimensions/gaps/breakpoints reference canonical style/config tokens where shared."
  },
  "constraints": {
    "invariants": [
      {
        "id": "WEB_PRESENTATION_BOUNDARY",
        "rule": "Web Base, style, assets and responsive layout define reusable presentation primitives only; they do not become semantic or runtime authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "visual order changes semantic execution order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "responsive layout breaks reading/focus semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "module implements private duplicate layout foundation without reason",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "breakpoint meaning inferred from DOM position only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "layout primitive owns domain semantics",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_WEB",
      "target_ref": "AIGMOS_WEB_BASE_PRIMITIVES_CONTRACT",
