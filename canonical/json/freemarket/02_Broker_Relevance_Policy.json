  "semantics": {
    "policy_rule": "Relevance criteria/weights/filters are explicit Broker policy.",
    "context_rule": "Relevance may vary by Project, role, competence criterion or market query context.",
    "merit_rule": "Broker relevance never rewrites stored global MeritCore points/Tier/trust.",
    "recency_rule": "Recency may be used only when the relevant competence/Project policy explicitly requires it; there is no generic hidden decay.",
    "version_rule": "Policy identity/version is explicit and included in match provenance.",
    "explain_rule": "Machine-significant ranking factors are traceable enough to explain the evidence basis for a result.",
    "no_global_rule": "No universal global weighting is implied merely because Broker ranks candidates."
  },
  "constraints": {
    "invariants": [
      {
        "id": "FREEMARKET_DERIVED_MATCHING",
        "rule": "FreeMarket/Broker matching and ranking operate over explicit Project, identity, PortfolioCore and MeritCore semantics without creating duplicate work, identity or merit authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Broker policy silently mutates MeritCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "generic time decay introduced through matching",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "ranking factors hidden where policy claims explainability",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "policy version omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "one contextual relevance policy treated as universal global merit weighting",
        "result": "hard_fail"
      }
    ]
  },
