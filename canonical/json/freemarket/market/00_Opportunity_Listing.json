  "identity": {
    "id": "AIGMOS_FREEMARKET_LISTING_CONTRACT",
    "name": "FreeMarket Opportunity Listing",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "locked",
  "source_role": "definition",
  "purpose": "Define marketplace opportunity listings as discovery metadata that may lead to Project creation but do not themselves become Project work, merit evidence or authorization.",
  "scope": {
    "owns": [
      "FreeMarket Opportunity Listing semantics"
    ],
    "does_not_own": [
      "presentation semantics",
      "transport implementation",
      "unrelated IAM/AC policy"
    ]
  },
