    {
      "id": "TOPIC_FREEMARKET_LISTING",
      "name": "Opportunity Listing",
      "purpose": "Define marketplace opportunity listings as discovery metadata that may lead to Project creation but do not themselves become Project work, merit evidence or authorization.",
      "parent_topic_refs": [
        "TOPIC_PROJECT"
      ],
      "composed_topic_refs": [
        "TOPIC_IDENTITYCORE",
        "TOPIC_CORE_PROJECTION"
      ],
      "member_refs": [
        "AIGMOS_FREEMARKET_LISTING_CONTRACT",
        "MARKET_SEMANTICS_EXPLICIT",
        "GATE_1",
        "GATE_2",
