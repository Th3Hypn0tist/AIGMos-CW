  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_OPPORTUNITY_ACCEPT",
        "name": "Accept opportunity",
        "inputs": [
          "listing/opportunity",
          "parties",
          "agreed scope"
        ],
        "outputs": [
          "accepted opportunity intent"
        ],
        "errors": [
          "party unresolved",
          "scope invalid"
        ],
        "side_effects": []
      },
      {
        "id": "OP_OPPORTUNITY_CREATE_PROJECT",
        "name": "Create Project from accepted opportunity",
        "inputs": [
          "accepted intent"
        ],
        "outputs": [
          "explicit Project"
        ],
        "errors": [
          "Project creation failure"
        ],
        "side_effects": [
          "Project registry updated"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "transition_rule": "Accepted opportunity creates or binds to an explicit Project.",
    "identity_rule": "Resulting Project has its own stable Project identity.",
    "provenance_rule": "Project may retain source listing/opportunity refs.",
    "scope_rule": "Agreed work scope is Project semantics after creation.",
    "listing_rule": "Listing may close/remain historical after Project creation.",
    "causality_rule": "Listing -> acceptance -> Project creation is explicit mechanism causality, not inferred from relation proximity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MARKET_SEMANTICS_EXPLICIT",
        "rule": "Marketplace discovery, matching, participation, feedback and visibility semantics remain explicit and do not override Project/Merit/IAM ownership."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "accepted listing used as Project identity directly without explicit Project definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Project creation provenance to opportunity lost",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "work begins without explicit Project where Project model applies",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "listing and Project semantics duplicated inconsistently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "transition causality inferred rather than explicit",
        "result": "hard_fail"
      }
    ]
  },
