    "id": "AIGMOS_PROJECT_MERIT_EVIDENCE_CONTRACT",
    "name": "Project to Merit Evidence",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the explicit evidence bridge from completed Project work to MeritCore without embedding MeritCore scoring semantics inside Project.",
  "scope": {
    "owns": [
      "Project to Merit Evidence semantics"
    ],
    "does_not_own": [
      "presentation semantics",
      "transport implementation",
      "unrelated identity semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_PROJECT_MERIT",
      "name": "Project Merit Evidence",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the explicit evidence bridge from completed Project work to MeritCore without embedding MeritCore scoring semantics inside Project.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_PROJECT_BUILD_MERIT_EVIDENCE",
        "name": "Build Project merit evidence",
        "inputs": [
          "Project outcome",
          "participants",
          "time atoms",
          "recommendations/feedback",
          "linked evidence"
        ],
        "outputs": [
          "MeritCore-consumable evidence package"
        ],
        "errors": [
          "participant mismatch",
          "evidence incomplete"
        ],
        "side_effects": []
      },
      {
        "id": "OP_PROJECT_SUBMIT_MERIT_EVIDENCE",
        "name": "Submit Project evidence to MeritCore",
        "inputs": [
          "evidence package",
          "identity refs"
        ],
        "outputs": [
          "MeritCore evidence acceptance/result"
        ],
        "errors": [
          "identity mismatch",
          "evidence rejected"
        ],
        "side_effects": [
          "MeritCore may record evidence"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "ownership_rule": "Project owns Project/work outcomes and evidence refs; MeritCore owns merits, points, Tier, recommendations and trust calculations.",
    "bridge_rule": "Project produces evidence package; MeritCore evaluates/records eligible merit semantics.",
    "identity_rule": "Evidence maps explicitly to participant identities.",
    "time_rule": "Evidence carries relevant Project time atoms/time provenance.",
    "feedback_rule": "Project feedback/recommendation context may be referenced but MeritCore owns recommendation/trust interpretation.",
    "no_score_rule": "Project does not calculate MeritCore points/Tier itself."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PROJECT_MODEL_EXPLICIT",
        "rule": "Project/task, execution, evidence and merit semantics are explicit and non-duplicated."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Project calculates MeritCore Tier/points directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Merit evidence lacks explicit participant identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "Project evidence loses time provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Project feedback silently becomes trust without MeritCore policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "same underlying work submitted as duplicated merit evidence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_PROJECT",
      "target_ref": "AIGMOS_UNIVERSAL_PROJECT_CONTRACT",
      "purpose": "Evidence originates from explicit Projects."
    },
    {
      "id": "REF_MERIT",
      "target_ref": "AIGMOS_MERITCORE_CONTRACT",
      "purpose": "MeritCore owns scoring/Tier/trust interpretation."
    }
  ],
  "prose": {
    "summary": "Define the explicit evidence bridge from completed Project work to MeritCore without embedding MeritCore scoring semantics inside Project.",
    "notes": [
      "Unlocked until reconciled against existing FreeMarket/Project/Merit contracts and repository-wide Contract Format 1.4 validation."
    ]
  },
