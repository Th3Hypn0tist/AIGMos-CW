  "semantics": {
    "universal_rule": "Every task-like work unit is represented as a Project.",
    "recursive_rule": "A Project may contain child Projects recursively.",
    "no_task_entity_rule": "There is no separate canonical Task entity duplicating Project semantics.",
    "meaning_rule": "Labels such as task, subtask, phase, milestone or work package are role/view semantics over Project where needed.",
    "identity_rule": "Each Project has explicit stable identity.",
    "composition_rule": "Higher-level work is composed from child Projects rather than duplicated into parallel work primitives."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PROJECT_MODEL_EXPLICIT",
        "rule": "Project/task, execution, evidence and merit semantics are explicit and non-duplicated."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "separate Task entity duplicates Project semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "subtask/phase/milestone modeled as incompatible primitive without irreducible semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "Project identity inferred from display label/path only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Project hierarchy inferred solely from filesystem/UI nesting",
        "result": "hard_fail"
      }
    ]
  },
