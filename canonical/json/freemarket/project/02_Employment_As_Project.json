  "semantics": {
    "representation_rule": "Employment contract is a Project because it establishes continuing recurring work.",
    "parent_rule": "The employment Project represents the continuing relationship/work scope.",
    "recurrence_rule": "Recurring periods such as week-by-week work may be child Projects.",
    "task_rule": "Concrete assignments remain Projects/leaf Projects, not a separate employment-task primitive.",
    "evidence_rule": "Merit/evidence links to the actual relevant Project periods/work units.",
    "legal_boundary_rule": "Project representation models canonical work structure; it does not by itself replace external legal requirements or terms."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PROJECT_MODEL_EXPLICIT",
        "rule": "Project/task, execution, evidence and merit semantics are explicit and non-duplicated."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "separate employment-work primitive duplicates Project semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "recurring work stored outside Project tree without explicit reason",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "all employment merits collapsed to relationship root without underlying work evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Project representation claimed to override external legal requirements",
        "result": "hard_fail"
      }
    ]
  },
