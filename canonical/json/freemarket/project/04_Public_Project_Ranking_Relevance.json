  "semantics": {
    "ranking_rule": "Public Projects may be ranked using AIGM 1337 / explicit ranking policy based on Merit outcomes and Project evidence.",
    "no_leaderboard_primitive_rule": "There is no separate canonical leaderboard primitive solely for ranking display.",
    "relevance_rule": "Broker relevance is explicit contextual policy, not a global universal weighting baked into MeritCore.",
    "projection_rule": "Rankings are derived projections and do not mutate underlying Project/Merit semantics.",
    "public_rule": "Only explicitly public/eligible Project data participates in public ranking.",
    "policy_provenance_rule": "Ranking/relevance results retain policy and source provenance."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PROJECT_MODEL_EXPLICIT",
        "rule": "Project/task, execution, evidence and merit semantics are explicit and non-duplicated."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "ranking projection becomes new source of truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "private/ineligible Project data enters public ranking without explicit permission",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "global relevance weighting silently embedded into MeritCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "separate leaderboard primitive duplicates ranking projection semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "ranking loses source/policy provenance",
        "result": "hard_fail"
      }
    ]
  },
