  "semantics": {
    "activation_modes": [
      "off",
      "on"
    ],
    "off_rule": "When AC is off, AC restrictions do not apply.",
    "on_rule": "When AC is on, governed resources/operations require explicit authorization.",
    "group_rule": "system-group has rw by explicit policy; other groups require explicit r/w or operation rights.",
    "command_rule": "Command rights are explicit and separate from data/resource rights.",
    "assurance_rule": "AC policy may additionally require minimum IAM assurance.",
    "ownership_rule": "Semantic ownership does not automatically grant AC authorization.",
    "ui_rule": "Terminal and web/editor surfaces are governed by the same canonical authorization semantics; UI visibility does not bypass AC."
