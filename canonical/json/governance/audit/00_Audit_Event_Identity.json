    "id": "AIGMOS_AUDIT_EVENT_IDENTITY_CONTRACT",
    "name": "Audit Event Identity",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define each auditable security, governance, data, configuration, policy or administrative action as explicit append-only evidence linked to exact actor, operation, target and result identities.",
  "scope": {
    "owns": [
      "Audit Event Identity semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "runtime execution authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_AUDIT_EVENT_IDENTITY",
      "name": "Audit Event Identity",
      "type": "topic",
      "status": "unlocked",
