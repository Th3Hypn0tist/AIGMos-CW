    "events": [],
    "flows": []
  },
  "semantics": {
    "identity_rule": "Each machine-significant audit event has an explicit evidence identity.",
    "actor_rule": "Actor/requester/service identity is explicit.",
    "operation_rule": "Requested/executed operation identity is explicit where applicable.",
    "target_rule": "Target resource/data/policy/config identity is exact.",
    "decision_rule": "Relevant authorization/governance decision refs are exact.",
    "result_rule": "Accepted/denied/failed/partial/cancelled states remain distinct.",
    "time_rule": "Timestamp is evidence metadata, never authority or causal proof by itself.",
    "authority_rule": "Audit evidence grants no remediation or access authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "audit event inferred from log text only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "actor omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "timestamp used as causal authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "audit record grants admin rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "failed action shown accepted",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_AUTH",
      "target_ref": "AIGMOS_AUTHORIZATION_DECISION_CONTRACT",
      "purpose": "Audit events may reference exact authorization decisions."
    }
  ],
  "prose": {
    "summary": "Define each auditable security, governance, data, configuration, policy or administrative action as explicit append-only evidence linked to exact actor, operation, target and result identities.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
