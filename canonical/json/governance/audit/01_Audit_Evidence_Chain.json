  "semantics": {
    "chain_rule": "Audit records may link explicit predecessor/segment identities.",
    "hash_rule": "Integrity hash/profile is explicit where used.",
    "order_rule": "Canonical evidence order derives from explicit chain/sequence semantics, not timestamps alone.",
    "append_rule": "Audit history is append-only under the active audit profile.",
    "gap_rule": "Detected chain gaps/corruption remain explicit findings.",
    "segment_rule": "Segment/archive boundaries preserve continuity evidence.",
    "authority_rule": "Valid chain proves evidence integrity only, not action legitimacy."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "timestamp alone defines chain",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "corrupted segment ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "valid chain means action authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "record inserted silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "segment archive breaks provenance",
        "result": "hard_fail"
      }
    ]
  },
