    "id": "AIGMOS_MUTATION_ADMIN_AUDIT_CONTRACT",
    "name": "Mutation and Administrative Action Audit",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define exact audit evidence for writes, deletes, purge, restore, migration, policy changes, secret rotation, listener lifecycle and equivalent privileged actions.",
  "scope": {
    "owns": [
      "Mutation and Administrative Action Audit semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "runtime execution authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_MUTATION_ADMIN_AUDIT",
      "name": "Mutation and Administrative Action Audit",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define exact audit evidence for writes, deletes, purge, restore, migration, policy changes, secret rotation, listener lifecycle and equivalent privileged actions.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "event_types": [
      "write",
      "delete",
      "purge",
      "restore",
      "migration",
      "policy_change",
      "secret_rotation",
      "listener_change",
      "config_apply",
      "license_change",
      "other declared admin action"
    ],
    "execution_rule": "Audit references exact operation/execution/transaction identity.",
    "target_rule": "Exact target identity/revision is explicit.",
    "before_after_rule": "Before/after revision refs or semantic diff refs are explicit where applicable.",
    "authorization_rule": "Authorization/sensitive-gate decision refs are explicit.",
    "destructive_rule": "Destructive scope/cascade evidence is explicit.",
    "result_rule": "Partial/failed/rolled-back actions remain distinct.",
    "authority_rule": "Audit event never becomes rollback/repair authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "admin action logged without target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "before/after omitted for policy change",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed purge shown completed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "audit event itself permits rollback",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "secret value logged",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DEST",
      "target_ref": "AIGMOS_DESTRUCTIVE_ACTION_GATE_CONTRACT",
      "purpose": "Destructive actions carry exact gate evidence."
    }
  ],
  "prose": {
    "summary": "Define exact audit evidence for writes, deletes, purge, restore, migration, policy changes, secret rotation, listener lifecycle and equivalent privileged actions.",
