  "semantics": {
    "retention_rule": "Audit retention policy is explicit and separate from source-data retention.",
    "source_purge_rule": "Purging source data does not silently purge required audit evidence.",
    "payload_rule": "Audit evidence must not preserve unnecessary source payload beyond allowed audit purpose.",
    "hash_rule": "Integrity/hash/chain evidence remains verifiable across archive/retention.",
    "hold_rule": "Applicable legal/compliance holds may block audit purge explicitly.",
    "expiry_rule": "Expired audit evidence follows explicit archive/purge policy.",
    "authority_rule": "Retention status grants no access authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "source purge deletes required audit trail",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "audit stores full source forever automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "audit retention inferred from disk space",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "hold ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "archive breaks hash chain",
        "result": "hard_fail"
      }
    ]
  },
