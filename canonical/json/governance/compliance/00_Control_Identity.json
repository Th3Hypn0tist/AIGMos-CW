  "semantics": {
    "identity_rule": "Each control has an explicit stable identity.",
    "scope_rule": "Applicable systems/resources/contracts are exact.",
    "requirement_rule": "Required condition/evidence is explicit.",
    "evaluation_rule": "Automated/manual/hybrid evaluation mode is explicit.",
    "frequency_rule": "Evaluation cadence/event trigger is explicit where applicable.",
    "owner_rule": "Control owner/reviewer is explicit.",
    "authority_rule": "Control definition does not grant system authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "control inferred from checklist text only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "scope omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "control owner becomes resource owner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "passing control grants AccessCore rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "evaluation cadence guessed",
        "result": "hard_fail"
      }
    ]
  },
