  "semantics": {
    "identity_rule": "Each evaluation has an explicit identity.",
    "control_rule": "Exact control identity/revision is referenced.",
    "target_rule": "Evaluated system/resource/package scope is exact.",
    "evaluator_rule": "Automated tool/manual reviewer identity is explicit.",
    "result_states": [
      "pass",
      "fail",
      "partial",
      "not_applicable",
      "not_evaluated",
      "unknown"
    ],
    "evidence_rule": "Input evidence refs are exact.",
    "unknown_rule": "not_evaluated/unknown never silently equals pass.",
    "authority_rule": "Pass result grants no runtime authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "log presence alone means pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "not evaluated shown pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "target omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "evaluator unknown",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "pass grants admin",
        "result": "hard_fail"
      }
    ]
  },
