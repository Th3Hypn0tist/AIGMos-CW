  "semantics": {
    "identity_rule": "Each evidence set has explicit identity.",
    "member_rule": "Members are exact evidence/artifact refs.",
    "snapshot_rule": "Evidence set binds exact revisions/times where relevant.",
    "integrity_rule": "Integrity/hash refs are explicit where required.",
    "privacy_rule": "Evidence set minimizes/redacts protected data.",
    "source_rule": "Copied evidence does not become new source-of-truth.",
    "authority_rule": "Evidence possession grants no underlying resource authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "screenshots treated as sole truth without provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "evidence set copies secrets",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "latest file selected automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "evidence grants source access",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "member revisions omitted",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EVAL",
      "target_ref": "AIGMOS_COMPLIANCE_CONTROL_EVALUATION_CONTRACT",
      "purpose": "Control evaluations consume exact evidence sets."
    }
  ],
  "prose": {
    "summary": "Define bounded collections of exact audit, config, certification, test, policy, package, runtime and manual evidence used by a control evaluation.",
