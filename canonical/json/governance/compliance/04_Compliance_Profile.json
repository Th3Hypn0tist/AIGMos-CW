  "semantics": {
    "identity_rule": "Each compliance profile has explicit identity/version.",
    "control_rule": "Included controls are exact refs.",
    "threshold_rule": "Required pass/partial/not-applicable semantics are explicit.",
    "scope_rule": "Applicable system/package/domain/deployment scope is exact.",
    "cadence_rule": "Evaluation frequency/trigger is explicit.",
    "result_rule": "Profile-level status is derived from exact control evaluations.",
    "unknown_rule": "Missing required control evaluation cannot silently yield compliant.",
    "authority_rule": "Compliant status does not grant runtime authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "profile pass inferred from majority only without rule",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "missing control ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "compliant means authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "scope inferred by folder",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "old evaluations reused forever",
        "result": "hard_fail"
      }
    ]
  },
