    "identity_rule": "Each disclosure request has an explicit identity.",
    "requester_rule": "Requester identity is exact.",
    "recipient_rule": "Recipient identity/category is exact.",
    "purpose_rule": "Disclosure purpose is explicit.",
    "data_rule": "Requested fields/resources are exact.",
    "consent_rule": "Applicable consent refs are explicit where consent is a required basis.",
    "governance_rule": "Disclosure crosses purpose, classification, AccessCore and recipient-scope gates.",
    "inert_rule": "Request is inert until accepted."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "export button immediately discloses",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "recipient inferred from email text only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "purpose omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "consent alone bypasses AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "all fields disclosed by default",
        "result": "hard_fail"
      }
    ]
  },
