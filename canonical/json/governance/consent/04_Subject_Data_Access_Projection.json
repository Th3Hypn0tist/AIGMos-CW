  "semantics": {
    "subject_rule": "Projection targets exact subject identity.",
    "source_rule": "Included source domains/resources are explicit.",
    "governance_rule": "Projection applies applicable visibility/classification/third-party privacy rules.",
    "third_party_rule": "Other people's protected data may be redacted/minimized.",
    "readonly_rule": "Projection is read-only unless separate correction/request operations are explicitly invoked.",
    "source_truth_rule": "Projection/cache is not source-of-truth.",
    "authority_rule": "Subject access to own data does not imply access to other protected resources."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "own-data view exposes other users",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "view edits canonical source directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "subject identity inferred from browser cookie only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "projection becomes source truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "read right implies admin",
        "result": "hard_fail"
      }
    ]
  },
