  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define privacy, purpose, retention, disclosure, classification and other governance decisions as explicit evidence separate from AccessCore authorization decisions.",
  "scope": {
    "owns": [
      "Governance Decision Identity semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "runtime execution authority"
    ]
  },
