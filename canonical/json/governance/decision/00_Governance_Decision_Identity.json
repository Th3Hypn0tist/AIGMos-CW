    "events": [],
    "flows": []
  },
  "semantics": {
    "identity_rule": "Each material governance decision has explicit identity.",
    "decision_types": [
      "purpose",
      "classification",
      "retention",
      "disclosure",
      "minimization",
      "privacy",
      "consent",
      "compliance",
      "other declared governance decision"
    ],
    "request_rule": "Decision references exact request/resource/subject/purpose context.",
    "policy_rule": "Exact governance policy/profile revision is referenced.",
    "result_rule": "Allow/deny/partial/challenge/unknown semantics are explicit per decision type.",
    "access_rule": "Governance decision is orthogonal to AccessCore authorization; both may gate the same operation.",
    "authority_rule": "Decision applies only to exact scoped request/evidence context."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "governance allow reused as AccessCore allow",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "decision reused for another purpose",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "policy revision omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unknown means allow",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "decision becomes resource identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_AC",
      "target_ref": "AIGMOS_AUTHORIZATION_DECISION_CONTRACT",
      "purpose": "Governance and AccessCore decisions remain orthogonal."
    }
  ],
  "prose": {
    "summary": "Define privacy, purpose, retention, disclosure, classification and other governance decisions as explicit evidence separate from AccessCore authorization decisions.",
