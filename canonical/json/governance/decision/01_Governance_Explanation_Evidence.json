    "decision_rule": "Explanation references exact governance decision identity.",
    "policy_rule": "Material policy/profile refs are exact.",
    "condition_rule": "Relevant evaluated conditions and non-sensitive values/categories are explicit.",
    "denial_rule": "Explanation for denial avoids leaking protected denied data or secret policy internals where unsafe.",
    "derived_rule": "Explanation is evidence/projection and does not replace the decision.",
    "model_rule": "AI-generated narrative may summarize explanation but cannot invent policy causes.",
    "authority_rule": "Explanation grants no new rights."
  },
