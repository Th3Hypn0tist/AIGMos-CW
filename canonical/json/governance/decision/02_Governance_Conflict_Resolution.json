    "applicability_rule": "All material applicable governance policies are explicit.",
    "conflict_rule": "Conflict/precedence/intersection semantics are declared per policy family.",
    "protective_rule": "Where unresolved protected-data conflict remains, fail closed/preserve data as appropriate.",
    "hold_rule": "Retention hold/destructive conflict resolves conservatively unless explicit higher-order rule says otherwise.",
    "order_rule": "File load order, insertion order and timestamps do not resolve governance conflict.",
    "evidence_rule": "Resolution references all material inputs.",
    "authority_rule": "Resolution does not replace AccessCore."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "latest policy wins",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "file order resolves privacy conflict",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "hold ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unresolved conflict allows export",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "conflict evidence omitted",
        "result": "hard_fail"
      }
    ]
  },
