    "identity_rule": "Each review/appeal case has explicit identity.",
    "decision_rule": "Case references exact disputed governance decision.",
    "requester_rule": "Requester/subject/authorized representative is exact.",
    "reviewer_rule": "Reviewer/authority identity is explicit.",
    "evidence_rule": "New and original evidence refs are exact.",
    "result_states": [
      "uphold",
      "modify",
      "reverse",
      "insufficient_evidence",
      "withdrawn"
    ],
    "history_rule": "Original decision remains immutable history; new decision supersedes only through explicit relation.",
    "authority_rule": "Submitting appeal grants no protected-resource access."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "appeal overwrites original decision",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "requester inferred",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "reviewer omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "filing appeal grants temporary access",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "new evidence not linked",
        "result": "hard_fail"
      }
    ]
  },
