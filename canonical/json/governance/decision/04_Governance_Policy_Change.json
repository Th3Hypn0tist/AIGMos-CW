  "semantics": {
    "candidate_rule": "Policy edits create inert candidate revisions.",
    "base_rule": "Candidate references exact accepted base revision.",
    "diff_rule": "Semantic impact diff identifies changed data/purpose/retention/disclosure scopes.",
    "validation_rule": "Cross-policy conflicts/invalid gaps are validated before apply.",
    "authorization_rule": "Governance policy administration requires explicit authority.",
    "activation_rule": "Accepted policy revision and active evaluator snapshot remain distinct.",
    "failure_rule": "Activation failure never disables governance silently.",
    "audit_rule": "Policy changes create exact audit evidence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "editing UI changes live privacy policy instantly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "invalid candidate activates",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "policy apply bypasses admin authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "activation failure falls open",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "semantic impact hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_AUDIT",
      "target_ref": "AIGMOS_MUTATION_ADMIN_AUDIT_CONTRACT",
      "purpose": "Governance policy changes are audited exactly."
    }
  ],
  "prose": {
    "summary": "Define candidate→semantic diff→validation→authorization→accepted revision→activation lifecycle for privacy, retention, consent, purpose and classification policies.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
