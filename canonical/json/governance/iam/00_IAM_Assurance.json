      "id": "REF_STATE",
      "target_ref": "AIGMOS_RUNTIME_DEFINITION_STATE_SEPARATION_CONTRACT",
      "purpose": "Assurance/session state is runtime state."
    }
  ],
  "prose": {
    "summary": "Define IAM assurance levels and authentication semantics separately from authorization so identity proof strength never implicitly creates resource rights.",
