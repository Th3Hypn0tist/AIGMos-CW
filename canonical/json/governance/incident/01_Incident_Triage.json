  "semantics": {
    "incident_rule": "Triage references exact incident identity.",
    "evidence_rule": "Assessment uses exact alert/audit/error/runtime/data evidence refs.",
    "severity_rule": "Incident severity/priority is explicit triage output.",
    "scope_rule": "Affected scope is evidence-backed and revisable.",
    "model_rule": "AI/tool triage suggestions remain candidate evidence.",
    "assignment_rule": "Responder assignment is explicit.",
    "authority_rule": "Triage assignment does not automatically grant resource access; needed rights are separately authorized."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "model declares breach automatically without evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "alert severity copied as final incident severity always",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "responder assignment grants admin",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "scope guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "triage overwrites original evidence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_INC",
      "target_ref": "AIGMOS_INCIDENT_IDENTITY_CONTRACT",
      "purpose": "Triage updates exact incident case evidence."
    }
  ],
  "prose": {
    "summary": "Define evidence-based classification, scope assessment, priority and responder assignment without treating alert severity or model output as conclusive incident truth.",
