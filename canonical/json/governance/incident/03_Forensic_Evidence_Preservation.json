  "semantics": {
    "identity_rule": "Each forensic evidence item/snapshot has explicit identity.",
    "source_rule": "Source identity/revision/time is exact.",
    "hash_rule": "Integrity/hash/profile is explicit where applicable.",
    "custody_rule": "Collection/transfer/access history is explicit.",
    "classification_rule": "Evidence preserves applicable classification/privacy controls.",
    "copy_rule": "Forensic copy is evidence, not new canonical source-of-truth.",
    "retention_rule": "Incident/legal hold may govern retention.",
    "authority_rule": "Possessing forensic evidence grants no source mutation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "forensic copy becomes source truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "evidence copied without hash/provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "classification dropped",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "custody missing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "investigator can modify source because they have copy",
        "result": "hard_fail"
      }
    ]
  },
