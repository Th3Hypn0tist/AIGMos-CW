    "name": "Incident Recovery and Postmortem",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define explicit recovery validation, closure evidence, root-cause findings, corrective-action candidates and postmortem publication without rewriting historical incident evidence.",
  "scope": {
    "owns": [
      "Incident Recovery and Postmortem semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "runtime execution authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_INCIDENT_RECOVERY_POSTMORTEM",
      "name": "Incident Recovery and Postmortem",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define explicit recovery validation, closure evidence, root-cause findings, corrective-action candidates and postmortem publication without rewriting historical incident evidence.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "recovery_rule": "Recovery requires explicit service/data/security validation evidence.",
    "closure_rule": "Incident closure references exact recovery criteria/evidence.",
    "root_cause_rule": "Root-cause finding is evidence-backed and separate from mere temporal correlation.",
    "action_rule": "Corrective actions are candidate operations/projects until separately accepted.",
    "history_rule": "Postmortem never deletes or rewrites original incident evidence.",
    "publication_rule": "Public/internal disclosure level is explicit.",
    "reopen_rule": "New evidence may reopen incident explicitly.",
    "authority_rule": "Postmortem recommendations grant no execution authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "service elapsed time means recovered",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "root cause inferred from nearest log",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "postmortem edits incident history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "recommendation auto-executes",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "closed incident cannot reopen",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_INC",
      "target_ref": "AIGMOS_INCIDENT_IDENTITY_CONTRACT",
      "purpose": "Recovery/postmortem closes exact incident identity."
    }
  ],
  "prose": {
    "summary": "Define explicit recovery validation, closure evidence, root-cause findings, corrective-action candidates and postmortem publication without rewriting historical incident evidence.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
