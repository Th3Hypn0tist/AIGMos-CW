  "semantics": {
    "identity_rule": "Each processing purpose has an explicit stable identity.",
    "scope_rule": "Purpose scope/data categories/operations are explicit.",
    "owner_rule": "Purpose owner/controller/business owner is explicit where applicable.",
    "compatibility_rule": "Purpose compatibility rules are explicit.",
    "retention_rule": "Purpose may reference exact retention profile.",
    "authority_rule": "Purpose declaration does not itself authorize processing.",
    "label_rule": "Human purpose text is descriptive and not the sole identity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "free-text purpose only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "purpose grants AccessCore rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "new purpose inferred from UI screen",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "same label merges purposes",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "retention guessed",
        "result": "hard_fail"
      }
    ]
  },
