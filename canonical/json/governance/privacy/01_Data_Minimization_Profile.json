    "identity_rule": "Each reusable minimization profile has explicit identity.",
    "purpose_rule": "Profile binds exact processing purpose.",
    "field_rule": "Allowed/required field sets are explicit.",
    "scope_rule": "Row/resource/identity scopes may be explicit.",
    "derivation_rule": "Derived data remains subject to minimization.",
    "collection_rule": "Input collection should reject/omit unnecessary fields according to profile.",
    "projection_rule": "Outputs expose only required permitted fields.",
    "authority_rule": "Minimization does not grant access."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "collect all then decide later by default",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unused fields retained automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "derived field escapes minimization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "profile inferred from form layout",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "allowed field means authorized",
        "result": "hard_fail"
      }
    ]
  },
