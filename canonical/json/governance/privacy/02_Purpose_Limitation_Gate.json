    "request_rule": "Gate evaluates exact requester/operation/resource/purpose combination.",
    "purpose_rule": "Requested purpose identity is explicit.",
    "source_rule": "Source data allowed-purpose metadata/policy is explicit.",
    "compatibility_rule": "Compatibility decision uses exact policy/profile.",
    "unknown_rule": "Unknown purpose or compatibility fails closed.",
    "authorization_rule": "Purpose gate complements, never replaces, AccessCore authorization.",
    "derived_rule": "Derived/result use is evaluated for its own purpose when materially different."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "missing purpose allowed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "purpose gate replaces AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "same user means compatible purpose",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "derived export skips purpose check",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "purpose inferred from route name",
        "result": "hard_fail"
      }
    ]
  },
