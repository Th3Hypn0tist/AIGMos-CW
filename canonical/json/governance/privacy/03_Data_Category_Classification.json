  "semantics": {
    "category_rule": "Each data category/classification has explicit identity.",
    "target_rule": "Classification binds exact resource/field/dataset scope.",
    "source_rule": "Owning source/policy evidence is explicit.",
    "inherit_rule": "Derived/joined data classification follows explicit propagation rules.",
    "name_rule": "Field name alone never determines classification.",
    "downgrade_rule": "Reclassification/declassification requires explicit governed operation/evidence.",
    "authority_rule": "Classification is governance metadata, not authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "GOVERNANCE_EVIDENCE_SEPARATION",
        "rule": "Policy, decision, evidence, audit record, consent, incident and compliance result remain separate machine-significant identities; no evidence artifact silently becomes source data, authorization or runtime authority."
      },
      {
        "id": "FAIL_CLOSED_PROTECTED_DATA",
        "rule": "Ambiguous or unresolved governance for protected data fails closed; UI visibility, transport reachability, cache presence, role title, prior access or audit-log presence never substitute for an explicit valid policy decision."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "email field automatically classified solely by name",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "derived join loses classification",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "masking declassifies source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "classification grants rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "UI color defines sensitivity",
        "result": "hard_fail"
      }
    ]
  },
