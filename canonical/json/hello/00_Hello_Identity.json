  "semantics": {
    "name": "Hello",
    "role": "peer/service discovery and rendezvous",
    "identity_rule": "Hello service identity is explicit and separate from the identity of peers it helps discover.",
    "bootstrap_rule": "Hello exchanges only bootstrap/discovery metadata required to establish the next transport/session step.",
    "payload_rule": "Application payload is not semantically owned by Hello.",
    "peer_rule": "A discovered peer retains its own IdentityCore/external identity.",
    "authority_rule": "Discovery success never grants application/data authority.",
    "transport_rule": "Hello does not replace WebRTC or other negotiated peer transport."
  },
  "constraints": {
    "invariants": [
      {
        "id": "HELLO_BOOTSTRAP_ONLY",
        "rule": "Hello/Rendezvous performs peer discovery/bootstrap only; it never becomes application-payload owner, semantic peer identity, or authorization authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Hello becomes application payload relay by default",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Hello service identity used as peer identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "successful discovery grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "peer identity inferred only from rendezvous session id",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Hello replaces peer transport semantics",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REND",
      "target_ref": "AIGMOS_RENDEZVOUS_SIGNALING_CONTRACT",
