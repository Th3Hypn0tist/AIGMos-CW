  "semantics": {
    "record_rule": "Each rendezvous record has a transient runtime/bootstrap identity.",
    "peer_rule": "Record references exact peer/service identities or discovery handles.",
    "metadata_rule": "Only metadata required for discovery/signaling/session establishment is stored.",
    "ttl_rule": "Record lifetime/TTL is explicit and finite.",
    "cleanup_rule": "Record is removed/expired after successful peer establishment, cancellation or timeout according to policy.",
    "payload_rule": "User/application message payload is not stored in the rendezvous record.",
    "identity_rule": "Rendezvous record identity is not a semantic user/device/service identity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "HELLO_BOOTSTRAP_ONLY",
        "rule": "Hello/Rendezvous performs peer discovery/bootstrap only; it never becomes application-payload owner, semantic peer identity, or authorization authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "rendezvous record persists indefinitely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "record stores application message payload by default",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "record id becomes semantic peer identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "TTL absent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cleanup omitted after establishment/cancel",
        "result": "hard_fail"
      }
    ]
  },
