    "id": "AIGMOS_IAM_COMPOSITION_CONTRACT",
    "name": "IAM Composition",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define IAM as the composition boundary joining stable IdentityCore identity, authentication/assurance, PortfolioCore evidence references and MeritCore competence history without collapsing those domains into one model.",
  "scope": {
    "owns": [
      "IAM Composition semantics"
    ],
    "does_not_own": [
      "component-core semantics owned elsewhere",
      "AccessCore authorization policy",
      "runtime business-domain semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_IAM_COMPOSITION",
      "name": "IAM Composition",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define IAM as the composition boundary joining stable IdentityCore identity, authentication/assurance, PortfolioCore evidence references and MeritCore competence history without collapsing those domains into one model.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "components": [
      "IdentityCore",
      "authentication credentials/methods",
      "assurance state",
      "PortfolioCore",
      "MeritCore"
    ],
    "identity_rule": "IdentityCore identity is the stable cross-component anchor.",
    "portfolio_rule": "PortfolioCore remains owner of references/evidence metadata.",
    "merit_rule": "MeritCore remains owner of merit, points, Tier, recommendations and trust.",
    "auth_rule": "Authentication/assurance proves the current caller/session context but does not redefine identity.",
    "access_rule": "AccessCore consumes IAM identity/assurance context but remains the authorization owner.",
    "composition_rule": "IAM references component semantics rather than duplicating them.",
    "projection_rule": "Combined IAM/profile views are projections over component-owned semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IAM_COMPOSITION_BOUNDARY",
        "rule": "IAM composes identity, authentication/assurance, PortfolioCore and MeritCore references while preserving each component's ownership; AccessCore authorization remains orthogonal."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "IAM duplicates component-core semantics as new ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "MeritCore collapsed into PortfolioCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "authentication credential becomes semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "IAM itself becomes AccessCore authorization owner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "combined profile projection becomes source of truth",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ID",
      "target_ref": "AIGMOS_IDENTITYCORE_IDENTITY_CONTRACT",
      "purpose": "IdentityCore is IAM's stable identity anchor."
    },
    {
      "id": "REF_PORT",
      "target_ref": "AIGMOS_PORTFOLIO_REGISTRY_CONTRACT",
      "purpose": "PortfolioCore remains evidence/reference owner."
    },
    {
      "id": "REF_MERIT",
      "target_ref": "AIGMOS_MERITCORE_IDENTITY_TIMELINE_CONTRACT",
      "purpose": "MeritCore remains merit-history owner."
    }
  ],
  "prose": {
    "summary": "Define IAM as the composition boundary joining stable IdentityCore identity, authentication/assurance, PortfolioCore evidence references and MeritCore competence history without collapsing those domains into one model.",
