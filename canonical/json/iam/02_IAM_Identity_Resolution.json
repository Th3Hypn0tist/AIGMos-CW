        "condition": "multiple candidate identities accepted ambiguously",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "session id used as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unresolved caller silently gets new identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "resolved identity treated as authorized",
        "result": "hard_fail"
      }
    ]
