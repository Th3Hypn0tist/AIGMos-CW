  "semantics": {
    "inputs": [
      "credential binding",
      "authenticated session binding",
      "explicit external identity mapping",
      "exact IdentityCore ref"
    ],
    "resolution_rule": "Successful resolution returns one exact IdentityCore identity.",
    "ambiguity_rule": "Multiple possible identities hard-fail unless an explicit disambiguation mapping exists.",
    "profile_rule": "Display name/email/title similarity may assist discovery but never acts as canonical identity proof by itself.",
    "session_rule": "Session identity binds to but never replaces IdentityCore identity.",
    "external_rule": "External identity mappings are explicit and provenance-bearing.",
    "failure_rule": "Unresolved identity remains unresolved; runtime does not synthesize a new identity implicitly.",
    "authority_rule": "Successful identity resolution does not itself authorize an operation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IAM_COMPOSITION_BOUNDARY",
        "rule": "IAM composes identity, authentication/assurance, PortfolioCore and MeritCore references while preserving each component's ownership; AccessCore authorization remains orthogonal."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "identity resolved solely by display-name similarity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "multiple candidate identities accepted ambiguously",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "session id used as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unresolved caller silently gets new identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "resolved identity treated as authorized",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SESSION",
      "target_ref": "AIGMOS_SESSION_IDENTITY_PROPAGATION_CONTRACT",
      "purpose": "Sessions carry exact identity context."
    },
    {
      "id": "REF_ID",
      "target_ref": "AIGMOS_IDENTITYCORE_IDENTITY_CONTRACT",
      "purpose": "Resolution targets stable IdentityCore identity."
    }
  ],
  "prose": {
    "summary": "Define deterministic resolution from authentication/session/external identity context to one exact IdentityCore identity without using profile names, transport endpoints or similarity as identity authority.",
