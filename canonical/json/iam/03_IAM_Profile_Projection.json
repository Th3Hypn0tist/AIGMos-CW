    "contract_format": "CANONICAL_CONTRACT",
    "format_version": "1.6"
  },
  "identity": {
    "id": "AIGMOS_IAM_PROFILE_PROJECTION_CONTRACT",
    "name": "IAM Profile Projection",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define a combined human/machine profile projection over IdentityCore, PortfolioCore and MeritCore while preserving which values are descriptive, evidenced, verified or derived.",
  "scope": {
    "owns": [
      "IAM Profile Projection semantics"
    ],
    "does_not_own": [
      "component-core semantics owned elsewhere",
      "AccessCore authorization policy",
      "runtime business-domain semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_IAM_PROFILE_PROJECTION",
      "name": "IAM Profile Projection",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define a combined human/machine profile projection over IdentityCore, PortfolioCore and MeritCore while preserving which values are descriptive, evidenced, verified or derived.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "layers": [
      "IdentityCore profile/relations",
      "PortfolioCore evidence/history",
      "MeritCore merits/points/Tier/recommendations/trust"
    ],
    "separation_rule": "Every projected field/value retains its semantic owner/source class.",
    "evidence_rule": "Authored/descriptive values and verified evidence are distinguishable.",
    "derived_rule": "MeritCore-derived values are marked as derived from MeritCore rather than copied as profile facts.",
    "cv_rule": "A living CV-like profile may be generated from these layers without becoming the canonical source record.",
    "privacy_rule": "Projection obeys each component's visibility/privacy policy.",
    "localization_rule": "Human-facing labels may be localized while underlying identities/values remain unchanged.",
    "mutation_rule": "Editing the projection routes changes to the owning component operation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IAM_COMPOSITION_BOUNDARY",
        "rule": "IAM composes identity, authentication/assurance, PortfolioCore and MeritCore references while preserving each component's ownership; AccessCore authorization remains orthogonal."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "combined profile loses semantic owner provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "derived Tier copied as editable profile field",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "CV projection becomes canonical source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "private Portfolio/Merit data leaks through profile",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "profile edit writes to wrong IAM core",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SEP",
      "target_ref": "AIGMOS_IDENTITY_PROFILE_AUTH_SEPARATION_CONTRACT",
      "purpose": "Projection preserves layer separation."
    },
    {
      "id": "REF_PORTPROJ",
      "target_ref": "AIGMOS_PORTFOLIO_PROJECTION_CONTRACT",
      "purpose": "Portfolio projection remains source-aware."
    }
  ],
  "prose": {
    "summary": "Define a combined human/machine profile projection over IdentityCore, PortfolioCore and MeritCore while preserving which values are descriptive, evidenced, verified or derived.",
    "notes": [
      "Unlocked pending reconciliation against existing IAM/IdentityCore/PortfolioCore/MeritCore/AccessCore contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
