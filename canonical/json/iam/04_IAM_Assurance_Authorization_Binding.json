    "name": "IAM Assurance to AccessCore Binding",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the exact boundary where resolved IAM identity and current assurance context are supplied to AccessCore as authorization inputs without allowing IAM to decide governed rights.",
  "scope": {
    "owns": [
      "IAM Assurance to AccessCore Binding semantics"
    ],
    "does_not_own": [
      "component-core semantics owned elsewhere",
      "AccessCore authorization policy",
      "runtime business-domain semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_IAM_ASSURANCE_AUTHORIZATION_BINDING",
      "name": "IAM Assurance to AccessCore Binding",
      "type": "topic",
