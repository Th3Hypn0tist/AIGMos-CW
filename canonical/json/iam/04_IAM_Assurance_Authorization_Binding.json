  "semantics": {
    "inputs_to_accesscore": [
      "identity_ref",
      "group/membership refs where policy permits",
      "current assurance level",
      "session/reauth context"
    ],
    "identity_rule": "IAM supplies exact resolved identity.",
    "assurance_rule": "IAM supplies current assurance state and applicable reauthentication evidence.",
    "authorization_rule": "AccessCore alone evaluates governed allow/deny/reauth-required policy.",
    "nonexpansion_rule": "High assurance cannot expand rights absent AccessCore permission.",
    "group_rule": "IAM/IdentityCore organization relations do not automatically become AccessCore groups.",
    "remote_rule": "Origin IAM identity/assurance context may propagate to remote target, which evaluates its own AccessCore policy.",
    "trace_rule": "Authorization decision can trace which IAM identity/assurance context was evaluated."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IAM_COMPOSITION_BOUNDARY",
        "rule": "IAM composes identity, authentication/assurance, PortfolioCore and MeritCore references while preserving each component's ownership; AccessCore authorization remains orthogonal."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "IAM grants governed rights directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "strong assurance grants implicit rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "organization membership silently becomes AccessCore group",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "remote origin rights copied as remote rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "authorization decision cannot trace IAM context",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EVAL",
      "target_ref": "AIGMOS_ACCESSCORE_RIGHTS_EVALUATION_CONTRACT",
      "purpose": "AccessCore consumes IAM inputs."
    },
    {
      "id": "REF_ASSURE",
      "target_ref": "AIGMOS_IAM_ASSURANCE_LIFECYCLE_CONTRACT",
      "purpose": "Assurance remains explicit current state."
    }
  ],
  "prose": {
    "summary": "Define the exact boundary where resolved IAM identity and current assurance context are supplied to AccessCore as authorization inputs without allowing IAM to decide governed rights.",
