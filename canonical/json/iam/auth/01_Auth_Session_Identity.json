  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define authenticated sessions as explicit bounded identities tied to an IAM identity and assurance evidence, separate from AccessCore permissions.",
  "scope": {
    "owns": [
      "IAM Authentication Session Identity semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "runtime operation implementation"
    ]
  },
