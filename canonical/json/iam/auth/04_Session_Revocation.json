  "semantics": {
    "target_rule": "Revocation targets exact session identity/set/subject scope.",
    "authority_rule": "Revocation requires explicit IAM/session-management authority.",
    "effect_rule": "Revocation prevents future protected use of targeted sessions.",
    "history_rule": "Historical authentication/session evidence remains auditable.",
    "token_rule": "Revocation invalidates associated active session credentials according to provider/runtime profile.",
    "propagation_rule": "Distributed revocation propagation semantics are explicit.",
    "failure_rule": "Partially propagated revocation remains explicit and may fail closed for protected paths."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_AUTHORITY_SEPARATION",
        "rule": "Identity, authentication assurance, authorization policy, authorization decision, delegation and runtime execution remain separate machine-significant identities/evidence; no one layer silently substitutes for another."
