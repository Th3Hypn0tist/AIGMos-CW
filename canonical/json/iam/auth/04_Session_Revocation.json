      {
        "id": "FAIL_CLOSED_AUTHORITY",
        "rule": "Ambiguous, missing, stale or unverifiable authority for a protected effect fails closed rather than inheriting trust from locality, transport reachability, process ownership, UI visibility or previous success."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "revocation deletes history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "session revoked by display name match",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "partial revocation shown complete",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "revocation authority inferred from same user",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "revoked token accepted until restart",
        "result": "hard_fail"
      }
    ]
  },
