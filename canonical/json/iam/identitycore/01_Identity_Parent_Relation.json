  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define explicit parent relations for IdentityCore subjects so IAM/identity hierarchy is represented canonically rather than inferred from organization names, accounts or filesystem/runtime placement.",
  "scope": {
    "owns": [
      "Identity Parent Relation semantics"
    ],
    "does_not_own": [
      "IAM credential semantics",
      "MeritCore scoring",
      "PortfolioCore evidence presentation",
      "AccessCore authorization"
    ]
  },
  "members": [
    {
      "id": "TOPIC_IDENTITYCORE_PARENT_RELATION",
      "name": "Identity Parent Relation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define explicit parent relations for IdentityCore subjects so IAM/identity hierarchy is represented canonically rather than inferred from organization names, accounts or filesystem/runtime placement.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "relation_rule": "Parent relation is an explicit canonical relation between exact IdentityCore identities.",
    "multi_rule": "Whether an identity may have one or multiple parent relations is explicit per owning policy/context.",
    "organization_rule": "Organization hierarchy may use parent relations without changing child identity.",
    "person_rule": "A person's organization/employment relation is not automatically an IdentityCore parent unless explicitly modeled as such.",
    "authority_rule": "Identity parenthood does not automatically grant AccessCore authority over the child.",
    "inheritance_rule": "No credential, MeritCore, PortfolioCore or authorization state is inherited merely from parenthood.",
    "cycle_rule": "Illegal parent ancestry cycles hard-fail."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITYCORE_STABLE_IDENTITY",
        "rule": "IdentityCore owns stable person/organization identity and explicit identity relations; credentials, profiles, merits and authorization remain separate semantic layers."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "parent inferred from account path/name",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "parent relation grants authority automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "merit/profile history inherited from parent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "organization membership silently treated as parent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "identity ancestry cycle accepted",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REL",
      "target_ref": "AIGMOS_RELATION_IDENTITY_CONTRACT",
      "purpose": "Identity parenthood uses explicit canonical relations."
    }
  ],
  "prose": {
    "summary": "Define explicit parent relations for IdentityCore subjects so IAM/identity hierarchy is represented canonically rather than inferred from organization names, accounts or filesystem/runtime placement.",
    "notes": [
      "Unlocked pending reconciliation against existing IAM/IdentityCore/PortfolioCore/MeritCore contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
