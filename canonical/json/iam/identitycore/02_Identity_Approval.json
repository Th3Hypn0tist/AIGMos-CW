    "states": [
      "unapproved",
      "pending",
      "approved",
      "rejected",
      "revoked"
    ],
    "approval_rule": "Approval state is explicit and tied to exact identity and approving authority/evidence.",
    "evidence_rule": "Approval retains provenance and applicable verification evidence.",
    "assurance_rule": "Identity approval is distinct from current IAM authentication assurance.",
    "certification_rule": "Identity approval is distinct from package/system certification.",
    "authorization_rule": "Approved identity does not automatically receive AccessCore rights.",
    "revocation_rule": "Revocation preserves historical approval evidence/state transitions.",
    "scope_rule": "Approval scope/type is explicit where multiple identity-verification contexts exist."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITYCORE_STABLE_IDENTITY",
        "rule": "IdentityCore owns stable person/organization identity and explicit identity relations; credentials, profiles, merits and authorization remain separate semantic layers."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "approved identity automatically gets rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "approval treated as current login assurance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "approval conflated with certification",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "revocation deletes history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "approval has no approving authority/evidence",
        "result": "hard_fail"
      }
    ]
  },
