  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the hard separation between stable identity, descriptive profile, authentication methods/session assurance, PortfolioCore evidence and MeritCore competence history.",
  "scope": {
    "owns": [
      "Identity Profile and Authentication Separation semantics"
    ],
    "does_not_own": [
      "IAM credential semantics",
      "MeritCore scoring",
      "PortfolioCore evidence presentation",
      "AccessCore authorization"
    ]
  },
