  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define an independent MeritCore history per identity, preventing merit histories from being merged across separately created identities.",
  "scope": {
    "owns": [
      "MeritCore Identity Timeline semantics"
    ],
    "does_not_own": [
      "Project work identity",
      "FreeMarket broker relevance policy",
      "IdentityCore person/organization identity"
    ]
  },
