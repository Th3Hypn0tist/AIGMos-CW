    "flows": []
  },
  "semantics": {
    "identity_rule": "MeritCore timeline belongs to one exact IAM/IdentityCore identity reference.",
    "isolation_rule": "Merit histories from separate identities cannot be merged or combined.",
    "reset_rule": "Creating a new identity starts a new independent MeritCore history and does not transfer prior merits.",
    "history_rule": "Merit evidence/history remains traceable over time.",
    "project_rule": "Evidence references exact Project identities rather than free-form CV claims.",
    "ownership_rule": "MeritCore owns merit-history semantics but not the underlying Project identity.",
    "presentation_rule": "A CV-like projection may be derived from MeritCore history without becoming the source record."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MERIT_EVIDENCE_BOUND",
        "rule": "MeritCore derives human competence/trust history from explicit identity-bound Project evidence; identities, evidence, recommendations, points, Tier and broker relevance remain separate semantic dimensions."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "merits merged across identities",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "new identity inherits old merit history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "free-form CV claim treated as verified merit evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Project identity copied into MeritCore as new owner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "timeline history overwritten",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_PROJECT",
      "target_ref": "AIGMOS_PROJECT_IDENTITY_CONTRACT",
      "purpose": "Merit evidence references exact Projects."
    }
  ],
  "prose": {
    "summary": "Define an independent MeritCore history per identity, preventing merit histories from being merged across separately created identities.",
    "notes": [
      "Unlocked pending reconciliation against existing IAM/MeritCore/Project/FreeMarket contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
