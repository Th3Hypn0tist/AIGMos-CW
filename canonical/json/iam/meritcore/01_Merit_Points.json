  "semantics": {
    "calculation_rule": "MeritCore calculates points from accepted merit evidence according to explicit policy.",
    "backend_rule": "Backend/domain operations may write merit evidence; MeritCore owns point calculation.",
    "evidence_rule": "Every calculated point result traces to accepted evidence and exact identity.",
    "time_rule": "Evidence may retain Project-linked week/hour atoms.",
    "nonmultiplication_rule": "Splitting Projects or time atoms cannot multiply the same underlying merit evidence.",
    "broker_rule": "FreeMarket/broker relevance weighting is not a global MeritCore point-weighting rule.",
    "recompute_rule": "Policy/version changes require explicit recomputation/version provenance rather than silent history rewrite."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MERIT_EVIDENCE_BOUND",
        "rule": "MeritCore derives human competence/trust history from explicit identity-bound Project evidence; identities, evidence, recommendations, points, Tier and broker relevance remain separate semantic dimensions."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Project calculates MeritCore points",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "same evidence counted repeatedly through Project splitting",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "broker relevance silently changes global Merit points",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "point result lacks evidence refs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "policy change silently rewrites history",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TIME",
      "target_ref": "AIGMOS_PROJECT_TIME_ATOM_CONTRACT",
      "purpose": "Points may consume Project-linked time evidence."
    }
  ],
  "prose": {
    "summary": "Define MeritCore as the authority that calculates points from accepted merit evidence while preserving evidence provenance and preventing Project decomposition from multiplying points.",
    "notes": [
      "Unlocked pending reconciliation against existing IAM/MeritCore/Project/FreeMarket contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
