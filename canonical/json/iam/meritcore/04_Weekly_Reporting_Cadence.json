  "semantics": {
    "anchor_rule": "Weekly reporting cadence is anchored to the user's registration date, not Project start date.",
    "period_rule": "Reporting intervals recur in one-week periods from that identity-specific anchor.",
    "hour_rule": "Sub-week work evidence may be represented at hour-atom granularity within the weekly interval.",
    "project_rule": "Project work crossing intervals is distributed to the applicable user-anchored reporting periods.",
    "identity_rule": "Different identities may therefore have different weekly interval boundaries.",
    "nonmultiplication_rule": "Distribution across reporting intervals cannot duplicate the same hour/evidence.",
    "presentation_rule": "Calendar-week views may be derived separately but do not replace canonical registration-anchored cadence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MERIT_EVIDENCE_BOUND",
        "rule": "MeritCore derives human competence/trust history from explicit identity-bound Project evidence; identities, evidence, recommendations, points, Tier and broker relevance remain separate semantic dimensions."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "weekly cadence anchored to Project start",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "all users forced to calendar-week semantic anchor",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "same hour counted in multiple reporting periods",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "hour evidence loses Project ref",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "calendar presentation silently changes canonical cadence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TIME",
      "target_ref": "AIGMOS_PROJECT_TIME_ATOM_CONTRACT",
      "purpose": "Project time atoms feed user-anchored Merit reporting."
    }
  ],
  "prose": {
    "summary": "Define weekly MeritCore reporting intervals anchored to each user's registration date, with hour-level evidence distribution inside each recurring week.",
    "notes": [
      "Unlocked pending reconciliation against existing IAM/MeritCore/Project/FreeMarket contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
