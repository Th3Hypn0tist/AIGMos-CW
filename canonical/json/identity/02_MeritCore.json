  "identity": {
    "id": "AIGMOS_MERITCORE_CONTRACT",
    "name": "MeritCore",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define MeritCore as the canonical owner of merits, points, Tier, recommendations and trust derived from human-interaction evidence linked to explicit identities and Projects.",
  "scope": {
    "owns": [
      "MeritCore semantics"
    ],
    "does_not_own": [
      "presentation semantics",
      "transport implementation"
    ]
  },
  "members": [
    {
      "id": "TOPIC_MERITCORE",
      "name": "MeritCore",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define MeritCore as the canonical owner of merits, points, Tier, recommendations and trust derived from human-interaction evidence linked to explicit identities and Projects.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_MERIT_RECORD",
        "name": "Record merit evidence",
        "inputs": [
          "identity",
          "Project/evidence refs",
          "merit outcome"
        ],
        "outputs": [
          "merit record"
        ],
        "errors": [
          "evidence invalid",
          "identity mismatch"
        ],
        "side_effects": [
          "MeritCore history updated"
        ]
      },
      {
        "id": "OP_MERIT_CALCULATE_POINTS",
        "name": "Calculate merit points",
        "inputs": [
          "eligible merit records",
          "time atoms"
        ],
        "outputs": [
          "points"
        ],
        "errors": [
          "atom invalid"
        ],
        "side_effects": []
      },
      {
        "id": "OP_MERIT_EVALUATE_TIER",
        "name": "Evaluate Tier",
        "inputs": [
          "Project evidence",
          "recommendations",
          "Tier criteria"
        ],
        "outputs": [
          "Tier state"
        ],
        "errors": [
          "criteria unresolved"
        ],
        "side_effects": [
          "Tier state updated"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "owns": [
      "merits",
      "points",
      "Tier",
      "recommendations",
      "trust"
    ],
    "backend_rule": "Authorized backend/evidence-producing mechanisms write merit evidence; MeritCore calculates points/Tier semantics.",
    "tier_rule": "Tier requires at least 3 qualifying recommendations and 3 qualifying Projects at that Tier, subject to the owning Tier criteria.",
    "negative_feedback_rule": "Negative feedback enters review; applicable higher-Tier peer review may reduce Tier according to explicit policy.",
    "decay_rule": "No generic time decay; recency applies only where competence criteria explicitly require it.",
    "identity_isolation_rule": "Merit histories from separate identities cannot be merged.",
    "project_rule": "Merit evidence links to explicit Project evidence rather than self-authored claims."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_BOUNDARY_EXPLICIT",
        "rule": "Identity, portfolio evidence and merit semantics have explicit owners and cannot silently substitute for one another."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "PortfolioCore or presentation layer calculates merit/Tier",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "separate identity merit histories merged",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "generic time decay applied without explicit competence criterion",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Tier granted without required qualifying evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "self-authored claim treated as merit evidence without owning evidence semantics",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_IDENTITY",
      "target_ref": "AIGMOS_IDENTITYCORE_CONTRACT",
      "purpose": "Merit history is identity-scoped."
    },
    {
      "id": "REF_PORTFOLIO",
      "target_ref": "AIGMOS_PORTFOLIOCORE_CONTRACT",
      "purpose": "Portfolio may reference evidence but does not own merit calculation."
    }
  ],
  "prose": {
    "summary": "Define MeritCore as the canonical owner of merits, points, Tier, recommendations and trust derived from human-interaction evidence linked to explicit identities and Projects.",
    "notes": [
      "Unlocked until reconciled against existing IAM/PortfolioCore/MeritCore contracts and repository-wide Contract Format 1.4 validation."
