      "id": "TOPIC_MERIT_TIME",
      "name": "Merit Time",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define weekly MeritCore reporting intervals anchored to each identity's registration-date cadence, with subdivision to hour atoms that cannot multiply Tier evidence.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_MERIT_BUCKET_WEEK",
        "name": "Bucket merit evidence into reporting week",
        "inputs": [
          "identity registration date",
          "evidence timestamp"
        ],
        "outputs": [
          "weekly reporting interval"
        ],
        "errors": [
          "timestamp invalid"
        ],
        "side_effects": []
      },
      {
        "id": "OP_MERIT_SPLIT_ATOM",
        "name": "Split Project time atom",
        "inputs": [
          "week atom",
          "worked duration"
        ],
        "outputs": [
          "hour-granularity atoms"
        ],
        "errors": [
          "duration invalid"
        ],
        "side_effects": []
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "base_atom": "one week",
    "anchor": "identity registration date",
    "subdivision": "hour atom",
    "reporting_rule": "Merit evidence is bucketed into recurring one-week intervals based on the identity registration-date cadence.",
    "anti_multiplication_rule": "Splitting a Project/week into hour atoms cannot multiply qualifying Tier evidence beyond the actual underlying work/evidence.",
    "temporal_rule": "Points/evidence retain time distribution instead of collapsing into one timeless total."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_BOUNDARY_EXPLICIT",
        "rule": "Identity, portfolio evidence and merit semantics have explicit owners and cannot silently substitute for one another."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "weekly cadence anchored to Project start instead of identity registration",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "sub-hour atom used as canonical merit atom",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "splitting atoms multiplies Tier evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "temporal distribution discarded",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_MERIT",
      "target_ref": "AIGMOS_MERITCORE_CONTRACT",
      "purpose": "Time atoms constrain MeritCore evidence/points."
    }
  ],
  "prose": {
    "summary": "Define weekly MeritCore reporting intervals anchored to each identity's registration-date cadence, with subdivision to hour atoms that cannot multiply Tier evidence.",
