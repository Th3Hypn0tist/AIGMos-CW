    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define weekly MeritCore reporting intervals anchored to each identity's registration-date cadence, with subdivision to hour atoms that cannot multiply Tier evidence.",
