  "semantics": {
    "projection_only": true,
    "sources": [
      "IdentityCore",
      "PortfolioCore",
      "MeritCore",
      "Project evidence"
    ],
    "may_present": [
      "identity",
      "references",
      "verified evidence links",
      "merits",
      "points",
      "Tier",
      "recommendations",
      "trust",
      "time distribution"
    ],
    "authority_rule": "The projection owns no source facts and cannot write merit/identity/portfolio semantics directly.",
    "self_authored_rule": "Free-form narrative may accompany the projection but is not equivalent to verified evidence.",
    "freshness_rule": "Projection reflects current source state and preserves evidence timestamps/provenance."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_BOUNDARY_EXPLICIT",
        "rule": "Identity, portfolio evidence and merit semantics have explicit owners and cannot silently substitute for one another."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "CV/projection becomes separate source of truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "projection directly mutates MeritCore/PortfolioCore/IdentityCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "self-authored narrative represented as verified evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "source provenance/timestamps discarded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "projection duplicates source semantic identities",
        "result": "hard_fail"
      }
    ]
  },
