  "semantics": {
    "identity_rule": "Registration creates a new explicit stable identity.",
    "type_rule": "Identity kind such as person or organization is explicit.",
    "approval_rule": "Required identity approvals are explicit state/evidence.",
    "credential_rule": "Registration may create initial authentication credentials according to IAM policy, but credentials are not the semantic identity.",
    "merit_rule": "New identity starts with an independent MeritCore history and cannot inherit/merge merits from another identity by default.",
    "authorization_rule": "Registration does not grant unrelated AccessCore rights.",
    "timestamp_rule": "Registration date is explicit and may anchor downstream temporal semantics such as MeritCore weekly cadence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_LIFECYCLE_EXPLICIT",
        "rule": "Identity lifecycle, authentication assurance, credential state and session state remain explicit and cannot be inferred from authorization, transport or profile data."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "registration inherits prior identity merits automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "credential value used as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "registration grants unrelated authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "identity kind/approval state implicit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "registration date unavailable where required downstream",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ID",
      "target_ref": "AIGMOS_IDENTITYCORE_CONTRACT",
      "purpose": "Registration creates IdentityCore identity."
    },
    {
      "id": "REF_MERIT",
      "target_ref": "AIGMOS_MERITCORE_CONTRACT",
      "purpose": "Merit histories remain identity-isolated."
    }
  ],
  "prose": {
    "summary": "Define creation of a new IdentityCore identity and its initial IAM relationship without conflating registration with trust, merit, recommendation or authorization.",
    "notes": [
