    "id": "AIGMOS_IAM_ASSURANCE_LIFECYCLE_CONTRACT",
    "name": "IAM Assurance Lifecycle",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define assurance level transitions (`none`, `light`, `medium`, `strong`) as explicit authentication state changes governed by allowed methods and expiry/revalidation rules.",
  "scope": {
    "owns": [
      "IAM Assurance Lifecycle semantics"
    ],
    "does_not_own": [
      "AccessCore authorization",
      "PortfolioCore evidence",
      "MeritCore scoring"
    ]
  },
  "members": [
    {
      "id": "TOPIC_IAM_ASSURANCE_LIFECYCLE",
      "name": "IAM Assurance Lifecycle",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define assurance level transitions (`none`, `light`, `medium`, `strong`) as explicit authentication state changes governed by allowed methods and expiry/revalidation rules.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "levels": [
      "none",
      "light",
      "medium",
      "strong"
    ],
    "ordering": "none < light < medium < strong",
    "light_example": "username + password",
    "medium_example": "username + password + 2FA",
    "strong_example": "shell-only or otherwise explicitly stronger authenticated context",
    "transition_rule": "Assurance level changes only after an explicit successful authentication/reauthentication event.",
    "downgrade_rule": "Assurance may expire/downgrade according to explicit session/resource policy.",
    "authorization_rule": "Higher assurance does not itself grant additional AccessCore rights.",
    "resource_rule": "A resource/operation may require a minimum assurance level independently from authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_LIFECYCLE_EXPLICIT",
        "rule": "Identity lifecycle, authentication assurance, credential state and session state remain explicit and cannot be inferred from authorization, transport or profile data."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "assurance inferred from authorization rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "higher assurance grants rights automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "assurance upgraded without authentication event",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "expired assurance remains active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "resource minimum assurance omitted where required",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_IAM",
      "target_ref": "AIGMOS_IAM_ASSURANCE_CONTRACT",
      "purpose": "Lifecycle applies to IAM assurance semantics."
    }
  ],
  "prose": {
    "summary": "Define assurance level transitions (`none`, `light`, `medium`, `strong`) as explicit authentication state changes governed by allowed methods and expiry/revalidation rules.",
    "notes": [
      "Unlocked pending reconciliation against existing IAM/IdentityCore contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
