  "semantics": {
    "identity_rule": "Credential rotation preserves semantic identity.",
    "rotation_rule": "New credential/key is activated only through explicit authenticated/authorized rotation operation.",
    "revocation_rule": "Superseded/revoked credential becomes invalid according to explicit state.",
    "resource_rule": "Resource-specific reauthentication may rotate keys/credentials according to its owning policy.",
    "session_rule": "Existing sessions may remain, downgrade or terminate according to explicit session policy; no silent assumption.",
    "provenance_rule": "Rotation event records identity, credential class, authority and time without exposing secret material.",
    "secret_rule": "Secret values are not emitted into ordinary logs/provenance."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IDENTITY_LIFECYCLE_EXPLICIT",
        "rule": "Identity lifecycle, authentication assurance, credential state and session state remain explicit and cannot be inferred from authorization, transport or profile data."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "credential rotation creates new semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "revoked credential remains valid",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "secret material written to ordinary logs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "session behavior after rotation implicit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "rotation occurs without explicit authority/authentication",
        "result": "hard_fail"
      }
    ]
  },
