  "semantics": {
    "identity_rule": "Approval evidence has its own explicit identity.",
    "target_rule": "Approval targets exact IdentityCore identity and claim/attribute.",
    "issuer_rule": "Approver/issuer identity is explicit.",
    "result_states": [
      "approved",
      "rejected",
      "pending",
      "revoked",
      "expired",
      "unknown"
    ],
    "claim_rule": "Unapproved claim remains distinct from verified attribute.",
    "history_rule": "Approval/revocation history is append/history governed.",
    "authority_rule": "Approval evidence does not automatically grant AccessCore authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "self-authored claim treated verified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "approval issuer omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "revoked evidence shown active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "approval grants system rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "approval history overwritten",
        "result": "hard_fail"
      }
    ]
  },
