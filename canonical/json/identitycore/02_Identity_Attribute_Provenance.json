  "semantics": {
    "attribute_rule": "Every verified machine-significant identity attribute references source/provenance evidence.",
    "source_rule": "Source may be self-asserted, imported, administrator-entered or third-party verified and is explicit.",
    "verification_rule": "Provenance source and verification status are separate dimensions.",
    "update_rule": "Attribute update creates new revision/evidence rather than erasing history.",
    "privacy_rule": "Private attributes have explicit visibility/governance.",
    "label_rule": "Display/localized labels never replace canonical attribute identities.",
    "authority_rule": "Attribute content does not grant rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "attribute source unknown",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "self-asserted means verified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "old value erased without history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "private attribute exposed via profile automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "display name becomes identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_APPROVAL",
      "target_ref": "AIGMOS_IDENTITYCORE_APPROVAL_EVIDENCE_CONTRACT",
      "purpose": "Verification state uses explicit approval evidence."
    }
  ],
  "prose": {
    "summary": "Define provenance for identity attributes such as names, organization links, contact references and verification state.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
