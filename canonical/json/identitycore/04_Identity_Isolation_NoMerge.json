  "semantics": {
    "history_rule": "Each identity owns an independent MeritCore history.",
    "merge_rule": "Merit, Tier, recommendation and trust evidence from two identities cannot be combined by ordinary identity editing.",
    "reset_rule": "Creating a new identity starts a new independent history.",
    "forfeit_rule": "Identity reset/new identity does not inherit prior identity merits by implication.",
    "portfolio_rule": "Portfolio references may point to shared external artifacts only through explicit independent evidence.",
    "dedupe_rule": "Similarity of names/contact data never merges identities.",
    "authority_rule": "No-merge semantics are evidence-integrity rules, not AccessCore policy."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "new account inherits old Tier automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "same email merges identities",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "portfolio similarity merges merit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "multiple identities combine Project counts",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "identity reset preserves merit invisibly",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ID",
      "target_ref": "AIGMOS_IDENTITYCORE_IDENTITY_CONTRACT",
      "purpose": "Isolation applies to exact canonical identities."
    }
  ],
  "prose": {
    "summary": "Define non-mergeability of merit, Tier, recommendation and trust histories across distinct IdentityCore identities.",
