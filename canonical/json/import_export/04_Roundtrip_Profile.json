  "semantics": {
    "profile_rule": "Each format pair explicitly declares `lossless_semantic_roundtrip`, `lossy_projection` or `unsupported_roundtrip`.",
    "lossless_rule": "Lossless roundtrip must preserve canonical identity, refs, meaningful order, value distinctions and ownership-relevant semantics.",
    "lossy_rule": "Lossy profile declares dropped/unrepresentable semantic dimensions.",
    "byte_rule": "Semantic roundtrip does not require byte-identical serialization unless a separate byte-preservation profile says so.",
    "test_rule": "Lossless profiles must pass golden roundtrip fixtures.",
    "version_rule": "Roundtrip claim is tied to exact import/export profile/version.",
    "failure_rule": "A lossy profile cannot be used as authoritative canonical backup without explicit acceptance of the loss."
  },
  "constraints": {
    "invariants": [
      {
        "id": "IMPORT_EXPORT_EXPLICIT",
        "rule": "Import/export families resolve exact source/target identities and explicit serialization profiles; conversion never silently changes semantic ownership, identity or authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "lossy format claims lossless roundtrip",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "byte equality required for all semantic roundtrip",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "roundtrip claim lacks profile/version",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "identity/ref loss ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "lossless profile untested",
        "result": "hard_fail"
      }
    ]
  },
