    "root": "cs",
    "ordering": "explicit numeric install order",
    "baseline_sequence": [
      "user modules",
      "schema",
      "EXP/REST surfaces where applicable"
    ],
    "order_rule": "Install stages use declared numeric/order metadata.",
    "semantic_rule": "Install order is lifecycle sequencing, not ownership/authority precedence.",
    "validation_rule": "Each stage validates prerequisites before applying.",
    "failure_rule": "Failure stops or rolls back according to explicit installer transaction policy; later stages do not silently proceed.",
    "activation_rule": "Installed does not automatically mean enabled/running unless lifecycle contract explicitly says so."
  },
  "constraints": {
    "invariants": [
      {
        "id": "BOOT_EXPLICIT",
        "rule": "Boot selection, pruning, dependency validation and activation are explicit; the runtime never silently enables missing dependencies."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "filesystem enumeration order used as install order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "install order treated as semantic authority precedence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "later stage proceeds after failed required prerequisite",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "installed state conflated with enabled/running",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "numeric order omitted where deterministic order is required",
        "result": "hard_fail"
      }
    ]
  },
