  "semantics": {
    "root": "cs",
    "order_rule": "Install sequence follows explicit numeric/order metadata where the installation profile defines it.",
    "example_sequence": [
      "UserModules",
      "schemas",
      "Expose/EXP bindings",
      "REST/protocol exposure"
    ],
    "dependency_rule": "Declared dependencies must be satisfied before dependent installation steps.",
    "semantic_rule": "Install order does not create ownership, authority or semantic parenthood.",
    "atomic_rule": "Each install unit has explicit success/failure state and rollback/recovery semantics where required.",
    "runtime_rule": "Installation does not automatically start/activate installed runtime components.",
    "trace_rule": "Install result records exact package/module/version/order/dependency evidence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LIBRARY_INSTALL_EXPLICIT",
        "rule": "Library discovery and installation are explicit source/package lifecycle semantics; filesystem presence, discovery order or installation never silently changes canonical identity, enables dependencies or activates runtime effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "filesystem order used as install sequence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "install order creates semantic ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "installation auto-starts module",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "dependency installed after dependent silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "partial failure represented as success",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
