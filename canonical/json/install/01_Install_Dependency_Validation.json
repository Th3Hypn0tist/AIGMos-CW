    "name": "Install Dependency Validation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define install-time dependency validation using explicit declared dependency identities and compatibility constraints, with hard failure rather than silent auto-enablement or invention.",
  "scope": {
    "owns": [
      "Install Dependency Validation semantics"
    ],
    "does_not_own": [
      "module semantic identity",
      "AccessCore policy ownership",
      "runtime business semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_INSTALL_DEPENDENCY_VALIDATION",
      "name": "Install Dependency Validation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define install-time dependency validation using explicit declared dependency identities and compatibility constraints, with hard failure rather than silent auto-enablement or invention.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "dependency_rule": "Each required dependency resolves exact canonical/package identity and compatible version/profile.",
    "availability_rule": "Installed/discovered/available/enabled/running are distinct dependency states.",
    "auto_rule": "Missing dependency is never silently auto-enabled or invented.",
    "install_rule": "Installer may install an explicitly requested dependency only under an explicit install plan/operation.",
    "prune_rule": "Explicit pruning/negative selection may remove optional components only if closure remains valid.",
    "failure_rule": "Missing/incompatible required dependency hard-fails the affected install plan.",
    "remediation_rule": "Failure emits one concise deterministic remediation line where possible.",
    "trace_rule": "Validation records exact missing/incompatible dependency refs."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LIBRARY_INSTALL_EXPLICIT",
        "rule": "Library discovery and installation are explicit source/package lifecycle semantics; filesystem presence, discovery order or installation never silently changes canonical identity, enables dependencies or activates runtime effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "dependency silently auto-enabled",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "missing dependency invented",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "optional prune breaks required closure silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "incompatible version accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "failure lacks exact dependency ref",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_BOOT",
      "target_ref": "AIGMOS_BOOT_PROFILE_ACTIVATION_CONTRACT",
      "purpose": "Install dependency rules align with no-auto-enable boot semantics."
    }
  ],
  "prose": {
    "summary": "Define install-time dependency validation using explicit declared dependency identities and compatibility constraints, with hard failure rather than silent auto-enablement or invention.",
    "notes": [
      "Unlocked pending reconciliation against UserModule, boot profile, repository and distribution contracts."
    ]
  },
