  "semantics": {
    "identity_rule": "Each AIGMos instance has an explicit stable canonical/logical identity.",
    "name_rule": "Human-facing instance name is editable descriptive metadata and does not replace instance identity.",
    "path_rule": "Install path/config path is implementation binding, not semantic identity.",
    "host_rule": "Hostname/IP/device identity does not automatically become AIGMos instance identity.",
    "snapshot_rule": "Runtime active snapshot is a separate binding from instance identity.",
    "listener_rule": "Named network listeners belong to the instance but ports/endpoints do not define the instance.",
    "authority_rule": "Instance existence/ownership metadata does not itself grant AccessCore rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "INSTANCE_CONFIG_SEPARATION",
        "rule": "AIGMos instance identity, configuration, IAM parent, AccessCore parent and runtime state remain explicit separate dimensions; configuration never silently changes semantic ownership or authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "instance identity inferred solely from hostname/path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "instance rename changes semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "active snapshot used as instance identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "port/listener used as instance identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "instance metadata grants AccessCore authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ACTIVE",
      "target_ref": "AIGMOS_RUNTIME_ACTIVE_SNAPSHOT_CONTRACT",
      "purpose": "Instance identity remains separate from active snapshot."
    }
  ],
  "prose": {
    "summary": "Define each AIGMos runtime installation/instance as an explicit stable logical identity independent from hostname, filesystem path, active snapshot and listener bindings.",
    "notes": [
      "Unlocked pending reconciliation against existing instance-config/IAM/AccessCore/runtime contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
