  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define each AIGMos runtime installation/instance as an explicit stable logical identity independent from hostname, filesystem path, active snapshot and listener bindings.",
  "scope": {
    "owns": [
      "AIGMos Instance Identity semantics"
    ],
    "does_not_own": [
      "IdentityCore identity semantics",
      "AccessCore policy semantics",
      "runtime business-domain semantics"
    ]
  },
  "members": [
