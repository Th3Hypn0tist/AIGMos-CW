        "condition": "unknown config fields silently create capability",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "configured state conflated with current runtime state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "config value grants unrelated authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "instance config mutated outside canonical change boundary",
        "result": "hard_fail"
      }
    ]
  },
