    "target_rule": "Reload targets an exact AIGMos instance identity.",
    "candidate_rule": "Candidate instance config is parsed/validated before affecting runtime.",
    "owner_rule": "Reload applies instance-owned fields and invokes referenced owner-specific reconciliation where required.",
    "iam_rule": "IAM parent changes route through explicit IAM binding semantics.",
    "ac_rule": "AccessCore activation/reload follows explicit AC lifecycle semantics; when AC is active it cannot be disabled through an unauthorized runtime mutation.",
    "listener_rule": "Listener binding changes use listener lifecycle/conflict validation.",
    "module_rule": "UserModule changes use UserModule lifecycle/reload semantics.",
    "failure_rule": "Failed reconciliation leaves a deterministic previous or safe stopped state.",
    "trace_rule": "Reload records old/new config refs, subsystem actions and result."
  },
  "constraints": {
    "invariants": [
      {
        "id": "INSTANCE_CONFIG_SEPARATION",
        "rule": "AIGMos instance identity, configuration, IAM parent, AccessCore parent and runtime state remain explicit separate dimensions; configuration never silently changes semantic ownership or authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "reload overwrites unrelated semantic data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "reload directly rewrites AccessCore policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "listener binding changed without conflict validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "UserModule state replaced outside lifecycle",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "failed reload leaves mixed ambiguous config",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "reload disables active AC without governed operation",
        "result": "hard_fail"
      }
    ]
  },
