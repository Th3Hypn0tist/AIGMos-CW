      "emit explicit format/version",
      "emit stable identity",
      "declare source_role/status/purpose",
      "emit Topic membership or outsider state",
      "preserve structural dimensions",
      "emit behavior/constraints explicitly",
      "write exact refs",
      "preserve semantic null/empty/missing distinctions"
    ],
    "identity_rule": "Writer never synthesizes canonical identity solely from filename/path unless an owning migration/bootstrap rule explicitly permits generation.",
    "reference_rule": "Writer emits exact canonical refs and never fuzzy names as machine-significant links.",
    "topic_rule": "Writer assigns all applicable Topics and does not force one preferred Topic.",
    "ownership_rule": "Writer references existing owned semantics instead of duplicating them.",
    "validation_rule": "Generated output must pass format validation before being considered a valid canonical artifact.",
