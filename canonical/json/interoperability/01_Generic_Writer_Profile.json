        "id": "INTEROPERABILITY_SEMANTIC_PRESERVATION",
        "rule": "Reading, writing, normalization, diffing, reconciliation and patching preserve canonical identity, ownership, Topic context and machine-significant semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "writer emits machine-significant node without identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "writer emits fuzzy reference",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "writer drops multi-Topic membership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "writer duplicates referenced semantics as new ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "writer output claims 1.4 but fails required format validation",
        "result": "hard_fail"
      }
    ]
  },
