        "condition": "conflicting owners silently combined",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "same identity conflict disappears without reconciliation evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Topic memberships unnecessarily collapsed to one",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "reconciliation loses superseded-source provenance",
        "result": "hard_fail"
      }
    ]
  },
