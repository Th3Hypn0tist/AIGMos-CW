    "source_role": "reconciliation",
    "merge_rule": "Merge is identity- and ownership-aware rather than text/line-based only.",
    "same_identity_rule": "Artifacts claiming the same canonical identity are compared semantically before reconciliation.",
    "conflict_rule": "Conflicting semantic ownership or machine-significant values remain explicit conflicts until resolved by an authorized reconciliation decision.",
