    "id": "AIGMOS_LIBRARY_ROOTS_CONTRACT",
    "name": "Library Roots",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the user and system library roots used for discovery of UserModules, MCP, tools and web resources without making physical location the semantic identity of discovered artifacts.",
  "scope": {
    "owns": [
      "Library Roots semantics"
    ],
    "does_not_own": [
      "module semantic identity",
      "AccessCore policy ownership",
      "runtime business semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_LIBRARY_ROOTS",
      "name": "Library Roots",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the user and system library roots used for discovery of UserModules, MCP, tools and web resources without making physical location the semantic identity of discovered artifacts.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "roots": {
      "user": "./library",
      "system": "./system/library/"
    },
    "user_subroots": [
      "UM",
      "MCP",
      "TOOLS",
      "WEB"
    ],
    "system_rule": "System library follows the same explicit discovery/source-role principles as user library.",
    "identity_rule": "Library path is a physical/discovery binding and never the canonical semantic identity.",
    "precedence_rule": "User/system precedence or override behavior must be explicit and never inferred solely from path order.",
    "availability_rule": "Artifact presence in a library does not imply enabled/running runtime state.",
    "authority_rule": "Library visibility does not grant install/load/execute authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LIBRARY_INSTALL_EXPLICIT",
        "rule": "Library discovery and installation are explicit source/package lifecycle semantics; filesystem presence, discovery order or installation never silently changes canonical identity, enables dependencies or activates runtime effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "library path used as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "user/system conflict resolved only by path order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "file presence treated as enabled/running",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "library visibility grants execution authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "subroot semantics inferred inconsistently",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SOURCE",
      "target_ref": "AIGMOS_CANONICAL_SOURCE_REGISTRY_CONTRACT",
      "purpose": "Library artifacts are explicit source/package records."
    }
  ],
  "prose": {
    "summary": "Define the user and system library roots used for discovery of UserModules, MCP, tools and web resources without making physical location the semantic identity of discovered artifacts.",
    "notes": [
      "Unlocked pending reconciliation against UserModule, boot profile, repository and distribution contracts."
    ]
  },
