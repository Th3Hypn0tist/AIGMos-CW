  "identity": {
    "id": "AIGMOS_LIBRARY_DISCOVERY_CONTRACT",
    "name": "Library Discovery",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define deterministic discovery of installable/runtime artifacts from declared library roots using explicit manifests/types rather than arbitrary filename heuristics.",
  "scope": {
    "owns": [
      "Library Discovery semantics"
    ],
    "does_not_own": [
      "module semantic identity",
      "AccessCore policy ownership",
      "runtime business semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_LIBRARY_DISCOVERY",
      "name": "Library Discovery",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define deterministic discovery of installable/runtime artifacts from declared library roots using explicit manifests/types rather than arbitrary filename heuristics.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "discovery_rule": "Discovery scans only declared roots/subroots according to explicit artifact profiles.",
    "manifest_rule": "Machine-significant installable artifacts expose explicit identity/type/version/dependency metadata.",
    "type_rule": "UM, MCP, tool and web resources remain distinguishable artifact classes.",
    "order_rule": "Filesystem enumeration/alphabetical order never establishes semantic precedence.",
    "duplicate_rule": "Same-identity duplicates enter explicit source/authority resolution.",
    "inert_rule": "Discovery is read-only and never imports/loads/executes discovered code.",
    "failure_rule": "Malformed/unknown artifact remains undiscovered/invalid with explicit finding rather than guessed classification."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LIBRARY_INSTALL_EXPLICIT",
        "rule": "Library discovery and installation are explicit source/package lifecycle semantics; filesystem presence, discovery order or installation never silently changes canonical identity, enables dependencies or activates runtime effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "discovery executes artifact",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "filename heuristic determines semantic type",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "directory order determines authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "same identity silently shadows",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "malformed package guessed as valid",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ROOTS",
      "target_ref": "AIGMOS_LIBRARY_ROOTS_CONTRACT",
      "purpose": "Discovery operates over declared roots."
    },
    {
      "id": "REF_PREC",
      "target_ref": "AIGMOS_SOURCE_AUTHORITY_PRECEDENCE_CONTRACT",
      "purpose": "Duplicate artifacts use explicit authority resolution."
    }
  ],
  "prose": {
    "summary": "Define deterministic discovery of installable/runtime artifacts from declared library roots using explicit manifests/types rather than arbitrary filename heuristics.",
    "notes": [
      "Unlocked pending reconciliation against UserModule, boot profile, repository and distribution contracts."
    ]
  },
