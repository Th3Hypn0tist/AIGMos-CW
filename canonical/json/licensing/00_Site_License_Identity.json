  "semantics": {
    "identity_rule": "Each licensed site/organization has an explicit stable license entitlement identity.",
    "site_rule": "License scope is site/organization according to the commercial contract.",
    "iam_rule": "Standard site fee may economically correspond to maintaining the licensed organization's IAM relationship/account, but IAM semantic identity remains separate.",
    "runtime_rule": "License identity does not replace AIGMos instance identity.",
    "cert_rule": "License identity/status is separate from certification identity/status.",
    "authority_rule": "Holding a license does not grant AccessCore rights inside a runtime instance.",
    "history_rule": "Renewal, expiry, upgrade and downgrade preserve entitlement history."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LICENSE_ENTITLEMENT_SEPARATION",
        "rule": "Commercial license entitlement is explicit and separate from technical certification, semantic identity and runtime authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "license id used as IdentityCore identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "license grants AccessCore rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "license status treated as certification",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "runtime instance identity conflated with licensed-site identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "license history overwritten",
        "result": "hard_fail"
      }
    ]
  },
