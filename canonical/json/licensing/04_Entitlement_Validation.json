        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "expired entitlement accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unverifiable treated as entitled",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "requested right not checked against exact tier/agreement",
        "result": "hard_fail"
      }
