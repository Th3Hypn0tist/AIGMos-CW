  "identity": {
    "id": "AIGMOS_LICENSE_CERTIFICATION_SEPARATION_CONTRACT",
    "name": "License and Certification Separation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the hard semantic separation between commercial licensing and technical certification: either may exist without the other unless a specific policy explicitly requires both.",
  "scope": {
    "owns": [
      "License and Certification Separation semantics"
    ],
    "does_not_own": [
      "certification semantics",
      "runtime authorization",
      "customer domain semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_LICENSE_CERT_SEPARATION",
      "name": "License and Certification Separation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the hard semantic separation between commercial licensing and technical certification: either may exist without the other unless a specific policy explicitly requires both.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "orthogonality_rule": "License entitlement and certification status are separate facts.",
    "policy_rule": "A deployment/repository/customer policy may require certification in addition to licensing, but the requirement is explicit.",
    "certification_price_rule": "Certification commercial offering starts from €5,000 where applicable; commercial price is not certification evidence.",
    "evidence_rule": "Certification validity is anchored to certification/package evidence, not payment/license state.",
    "license_rule": "License validity is determined by license entitlement, not package certification hash.",
    "runtime_rule": "Neither license nor certification replaces IAM/AccessCore/runtime authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LICENSE_SEPARATION",
        "rule": "Commercial license entitlement, certification, identity, service availability and runtime authorization remain separate semantic dimensions."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "license automatically implies certification",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "certification automatically implies license",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "certification price/payment treated as technical evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "package hash treated as license entitlement",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "license/certification bypasses runtime authorization",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_LICENSE",
      "target_ref": "AIGMOS_LICENSE_IDENTITY_CONTRACT",
      "purpose": "Commercial entitlement side."
    },
    {
      "id": "REF_CERT",
      "target_ref": "AIGMOS_CERTIFICATION_PACKAGE_CONTRACT",
      "purpose": "Technical certification side."
    }
  ],
  "prose": {
    "summary": "Define the hard semantic separation between commercial licensing and technical certification: either may exist without the other unless a specific policy explicitly requires both.",
    "notes": [
      "Unlocked pending reconciliation with commercial/licensing documentation and whole-tree Contract Format 1.4 validation."
    ]
  },
