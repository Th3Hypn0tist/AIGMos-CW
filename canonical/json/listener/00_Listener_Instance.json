  "semantics": {
    "identity_rule": "Each listener instance has an explicit stable logical name/identity.",
    "protocol_rule": "Listener declares protocol/service type explicitly.",
    "binding_rule": "Listen address, port and transport are mutable bindings rather than semantic identity.",
    "state_rule": "Declared, enabled, starting, running, stopped and failed states remain separate.",
    "multi_rule": "Multiple instances of the same protocol type may exist concurrently if bindings are valid/non-conflicting.",
    "owner_rule": "Listener owns binding/lifecycle semantics, not higher-level protocol/domain semantics.",
    "authority_rule": "Listener existence/running state does not grant operation/data authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LISTENER_IDENTITY_BINDING_SEPARATION",
        "rule": "Listener/service identity is stable and separate from mutable listen binding, protocol configuration and runtime process/session state."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "listener identity inferred solely from port",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "protocol type implicit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "running state treated as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "listener owns protocol business semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "listener existence grants authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_INSTANCE",
