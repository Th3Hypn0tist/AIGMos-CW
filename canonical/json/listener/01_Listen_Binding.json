    "port_rule": "Port is an integer binding within valid platform/protocol limits.",
    "address_rule": "Listen address/interface is explicit where machine-significant.",
    "transport_rule": "TCP/UDP or other transport is explicit where the protocol allows alternatives.",
    "identity_rule": "Changing binding does not change listener semantic identity.",
