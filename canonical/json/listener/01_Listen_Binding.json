        "id": "GATE_1",
        "condition": "port outside valid range accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "transport omitted where ambiguous",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "binding change creates new listener identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reserved binding lost without explicit change",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "invalid binding activated",
        "result": "hard_fail"
      }
    ]
