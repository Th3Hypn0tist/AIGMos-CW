    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "stopping deletes listener definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "failed bind silently chooses another port",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "reload activates invalid binding",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "resource leak after stop/failure",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "enabled conflated with running",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "lifecycle operation bypasses authority",
        "result": "hard_fail"
      }
    ]
