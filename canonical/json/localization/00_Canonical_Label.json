    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define every human-facing UI label as an explicit managed label identity with source text, context metadata and target-language translations, without changing canonical machine identities.",
  "scope": {
    "owns": [
      "Canonical UI Label semantics"
    ],
    "does_not_own": [
      "command identities",
      "internal canonical identifiers",
      "domain semantics outside label presentation"
    ]
  },
  "members": [
    {
      "id": "TOPIC_CANONICAL_UI_LABEL",
      "name": "Canonical UI Label",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define every human-facing UI label as an explicit managed label identity with source text, context metadata and target-language translations, without changing canonical machine identities.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "label_rule": "Each managed UI label has an explicit stable label identity.",
    "source_rule": "Source-language label text is explicit data.",
    "context_rule": "Label includes context metadata sufficient to disambiguate meaning where needed.",
    "machine_rule": "Canonical IDs, command names, namespace roots and internal identifiers are never translated.",
    "presentation_rule": "Localized text is presentation only.",
    "reuse_rule": "One label identity may be reused across compatible UI surfaces when meaning/context is identical.",
    "split_rule": "Same source text with different meaning/context uses distinct label identities."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LOCALIZATION_PRESENTATION_ONLY",
        "rule": "Localization changes human-facing labels and explanatory text only; canonical identities, commands and machine semantics remain language-independent."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "translated text used as canonical ID",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "same source text reused across incompatible contexts",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "label lacks context where ambiguity is machine-significant",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "command/internal identifier translated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "UI label text becomes semantic authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_EXPOSE",
      "target_ref": "AIGMOS_EXPOSE_BOUNDARY_CONTRACT",
      "purpose": "Labels belong to human-facing Expose surfaces."
    }
  ],
  "prose": {
    "summary": "Define every human-facing UI label as an explicit managed label identity with source text, context metadata and target-language translations, without changing canonical machine identities.",
    "notes": [
      "Unlocked pending reconciliation against Expose/UI label contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
