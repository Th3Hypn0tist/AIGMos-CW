  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define one managed registry of translatable human-facing labels mapped to exact canonical semantic/UI targets.",
  "scope": {
    "owns": [
      "Localization Label Registry semantics"
    ],
    "does_not_own": [
      "canonical command identifiers",
      "domain semantic identities",
      "runtime authorization"
    ]
  },
  "members": [
    {
      "id": "TOPIC_LOCALIZATION_LABEL_REGISTRY",
      "name": "Localization Label Registry",
      "type": "topic",
