  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "registry_rule": "Every managed translatable label has an explicit stable label key/identity.",
    "target_rule": "Label maps to an exact canonical semantic or UI target/context.",
    "source_rule": "One canonical source-language value is explicit per label entry.",
    "translation_rule": "Translations are values of the same label identity, not new semantic identities.",
    "command_rule": "Commands/internal identifiers remain English-only and are not translated.",
    "extraction_rule": "Human-facing labels are extracted into the managed registry rather than duplicated as uncontrolled literals.",
    "authority_rule": "Label visibility/translation grants no target authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LABELS_PRESENTATION_ONLY",
        "rule": "Localized labels are context-bearing presentation resources mapped to stable canonical identities; translation never changes command names, internal identifiers or semantic identity."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "translated command identifier introduced",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "label identity inferred only from source text",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "same uncontrolled literal duplicated across UI",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "translation creates new semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "label visibility grants authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define one managed registry of translatable human-facing labels mapped to exact canonical semantic/UI targets.",
    "notes": [
      "Unlocked pending reconciliation against existing localization/Expose contracts and whole-tree Contract Format 1.4 validation."
