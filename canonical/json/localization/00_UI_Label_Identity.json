  "semantics": {
    "identity_rule": "Each managed label has an explicit stable label identity.",
    "context_rule": "Usage context/component/domain meaning is explicit.",
    "source_rule": "Canonical source language/value is explicit by localization profile.",
    "internal_rule": "Internal commands/identifiers remain English/ASCII and are not replaced by localized labels.",
    "reuse_rule": "Same visible text may correspond to multiple label identities in different contexts.",
    "authority_rule": "Label text never defines resource authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UI_NONAUTHORITY",
        "rule": "UI visibility, navigation, placement, styling, selection, focus and visual adjacency never create semantic ownership, resource identity or execution authority."
      },
      {
        "id": "UI_EFFECT_BOUNDARY",
        "rule": "Effect-capable UI actions create explicit candidate/request data and must cross canonical validation, authorization and dispatcher boundaries before effects occur."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "display text used as command id",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "same word merged across contexts automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "translated label changes internal resource id",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "label visibility grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "special characters introduced into command identifiers",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define every managed human-facing UI label as an explicit identity with context metadata, separate from internal command/resource identifiers.",
