      {
        "id": "GATE_1",
        "condition": "missing translation changes command id",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "fallback chosen by file order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "translation merged by visible text only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "translated label becomes schema field identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "language inferred from browser without profile",
        "result": "hard_fail"
      }
    ]
