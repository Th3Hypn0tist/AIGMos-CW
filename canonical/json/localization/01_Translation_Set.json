    "label_rule": "Translation binds exact UI label identity.",
    "language_rule": "Language/locale code is explicit.",
    "fallback_rule": "Fallback chain is explicit and deterministic.",
    "missing_rule": "Missing translation remains explicit or uses declared fallback; it never changes internal identifier.",
