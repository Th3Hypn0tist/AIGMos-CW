  },
  "semantics": {
    "initial_languages": [
      "fi",
      "en",
      "ja",
      "vi",
      "ko",
      "fr"
    ],
    "language_rule": "UI language is explicit per applicable user/session/site context.",
    "fallback_rule": "Fallback chain is explicit and deterministic.",
    "identifier_rule": "Canonical/internal identifiers and command names remain language-invariant English/ASCII according to their owning contracts.",
    "coverage_rule": "Translation coverage can be measured per language/profile.",
    "missing_rule": "Missing translation uses fallback rather than inventing localized semantics.",
    "format_rule": "Locale-sensitive display formatting is presentation only unless a data schema explicitly defines locale semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LABELS_PRESENTATION_ONLY",
        "rule": "Localized labels are context-bearing presentation resources mapped to stable canonical identities; translation never changes command names, internal identifiers or semantic identity."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "command names translated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "missing label invents semantic value",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "fallback chain nondeterministic",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "locale display formatting mutates canonical stored value",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "unsupported language silently treated as fully translated",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REG",
      "target_ref": "AIGMOS_LOCALIZATION_LABEL_REGISTRY_CONTRACT",
      "purpose": "Language profiles resolve registry values."
    }
  ],
  "prose": {
    "summary": "Define supported UI language profiles and deterministic fallback behavior while keeping commands and internal identifiers language-invariant.",
    "notes": [
      "Unlocked pending reconciliation against existing localization/Expose contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
