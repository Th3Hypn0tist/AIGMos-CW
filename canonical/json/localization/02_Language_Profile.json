  "source_role": "definition",
  "purpose": "Define supported UI language profiles and deterministic fallback behavior while keeping commands and internal identifiers language-invariant.",
  "scope": {
    "owns": [
      "Localization Language Profile semantics"
    ],
    "does_not_own": [
      "canonical command identifiers",
      "domain semantic identities",
      "runtime authorization"
