        "condition": "physical file becomes active solely by existence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "one active identity maps to conflicting active sources",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "manifest redefines semantic ownership",
        "result": "hard_fail"
      }
    ]
