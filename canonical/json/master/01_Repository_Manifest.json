  "semantics": {
    "role": "physical-source inventory",
    "required_fields": [
      "canonical_identity",
      "source_artifact",
      "source_role",
      "active_state"
    ],
    "identity_rule": "Manifest maps identity to file/source; file/source does not define identity.",
    "active_rule": "Every active canonical definition has an explicit manifest/source mapping.",
    "orphan_rule": "Unreferenced physical files may exist but are not active solely by presence.",
    "duplicate_rule": "One active identity cannot silently map to conflicting active source artifacts.",
    "package_rule": "Review ZIPs may include PATCH_MANIFEST files, but repository manifest is the assembled-tree inventory.",
    "trace_rule": "Manifest supports source provenance without becoming semantic owner."
  },
  "constraints": {
    "invariants": [
