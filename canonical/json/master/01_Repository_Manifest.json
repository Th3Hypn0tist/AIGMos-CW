        "id": "OP_REPO_MANIFEST_BUILD",
        "name": "Build canonical repository manifest",
        "inputs": [
          "active canonical graph",
          "file/source mapping"
        ],
        "outputs": [
          "repository manifest"
        ],
        "errors": [
          "source unresolved",
          "duplicate active source"
        ],
        "side_effects": []
      },
      {
        "id": "OP_REPO_MANIFEST_VALIDATE",
        "name": "Validate repository manifest",
        "inputs": [
          "manifest",
          "Master",
          "active identity graph"
        ],
        "outputs": [
          "manifest validation result"
        ],
        "errors": [
          "orphan active source",
