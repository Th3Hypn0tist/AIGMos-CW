  "semantics": {
    "symbol_root": "#MCP",
    "registry_rule": "MCP registry contains explicit configured MCP server identities and metadata.",
    "identity_rule": "MCP server identity is canonical/logical identity, not socket/session/process id.",
    "tool_rule": "Advertised MCP tools may be projected into Runtime Tool Registry only after explicit validation/binding.",
    "resource_rule": "Advertised MCP resources remain external resource descriptors until explicitly bound.",
    "connectivity_rule": "Connected/discovered state does not grant capability or authority.",
    "config_rule": "Registry configuration is declarative and inert until normal connect/load lifecycle."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MCP_BOUNDARY_EXPLICIT",
        "rule": "MCP server identity, transport, tool schema, lifecycle and authority remain explicit and do not inherit trust from connectivity or advertised metadata."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "MCP connection automatically creates trusted runtime tool",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "server session id used as semantic MCP identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "advertised tool metadata grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "MCP registry conflated with Runtime Tool Registry",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "MCP config executes on read",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TOOL",
      "target_ref": "AIGMOS_RUNTIME_TOOL_REGISTRY_CONTRACT",
      "purpose": "Validated MCP tools may bind into runtime tool registry."
    },
    {
      "id": "REF_EXTERNAL",
      "target_ref": "AIGMOS_CORE_EXTERNAL_REFERENCE_BOUNDARY_CONTRACT",
      "purpose": "MCP servers/resources are explicit external boundaries."
    }
  ],
  "prose": {
    "summary": "Define MCP as an explicit registry of configured external tool/resource servers and their declared surfaces, separate from the runtime Tool Registry and from transport/session state.",
