  "identity": {
    "id": "AIGMOS_MCP_TRANSPORT_LIFECYCLE_CONTRACT",
    "name": "MCP Transport and Lifecycle",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define MCP server connect/start/handshake/ready/error/stop lifecycle as tracked runtime state with bounded startup, request and cleanup behavior.",
  "scope": {
    "owns": [
      "MCP Transport and Lifecycle semantics"
    ],
    "does_not_own": [
      "remote server internal semantics",
      "unrelated runtime authority",
      "presentation semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_MCP_LIFECYCLE",
      "name": "MCP Transport and Lifecycle",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define MCP server connect/start/handshake/ready/error/stop lifecycle as tracked runtime state with bounded startup, request and cleanup behavior.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "states": [
      "configured",
      "starting",
      "handshaking",
      "ready",
      "error",
      "stopping",
      "stopped"
    ],
    "start_rule": "Configured server does not become ready until transport/handshake validation succeeds.",
    "request_rule": "Requests are bounded by timeout/concurrency/resource policy.",
    "cleanup_rule": "Error/timeout/cancel/stop release process/session/transport resources.",
    "state_rule": "Lifecycle state is runtime state, not server semantic identity.",
    "restart_rule": "Restart preserves configured semantic identity unless configuration explicitly changes it.",
    "failure_rule": "Unavailable server/tool is visible; runtime does not silently substitute another MCP server."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MCP_BOUNDARY_EXPLICIT",
        "rule": "MCP server identity, transport, tool schema, lifecycle and authority remain explicit and do not inherit trust from connectivity or advertised metadata."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "configured MCP server treated as ready before handshake",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "request lifecycle unbounded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failure leaves transport/process resources active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "restart changes semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "server failure silently falls back to unrelated MCP server",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "runtime state written as canonical server identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CANCEL",
      "target_ref": "AIGMOS_RUNTIME_CANCELLATION_CLEANUP_CONTRACT",
      "purpose": "MCP transport resources clean up on terminal paths."
    },
    {
      "id": "REF_BOUNDS",
      "target_ref": "AIGMOS_CORE_BOUNDED_OPERATION_CONTRACT",
      "purpose": "MCP startup and requests are bounded."
    }
  ],
  "prose": {
    "summary": "Define MCP server connect/start/handshake/ready/error/stop lifecycle as tracked runtime state with bounded startup, request and cleanup behavior.",
