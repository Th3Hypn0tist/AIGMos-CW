  "semantics": {
    "root": "#MEM",
    "registry_rule": "Every machine-significant memory record is explicitly registered/addressable.",
    "record_rule": "Registry entries point to explicit Memory Record identities.",
    "store_rule": "Physical backing store is binding/implementation detail and does not define record identity.",
    "model_rule": "LLM/model hidden state and transient prompt context are not automatically canonical memory.",
    "cache_rule": "Runtime caches remain transient unless explicitly promoted through a memory write operation.",
    "authority_rule": "Registry membership does not grant read/write authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MEMORY_EXPLICIT_DATA",
        "rule": "Machine-significant memory is explicit addressable provenance-bearing data; retrieval and storage never create hidden authority or implicit execution."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "hidden model state treated as canonical memory",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "physical store key/path used as sole memory identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "runtime cache silently promoted to canonical memory",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "registry membership grants read/write authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ROOT",
      "target_ref": "AIGMOS_MEM_MEMORY_ROOT_CONTRACT",
      "purpose": "#MEM root owns explicit memory semantics."
    }
  ],
  "prose": {
    "summary": "Define `#MEM` as the explicit registry of canonical memory records and memory-store interfaces, separating memory definition/data from model context and transient runtime caches.",
