  "semantics": {
    "scope_examples": [
      "identity",
      "Project",
      "UserModule instance",
      "AIGMos instance",
      "system",
      "explicit shared scope"
    ],
    "scope_rule": "Every record has an explicit scope owner/boundary.",
    "visibility_rule": "Retrieval candidates are filtered by applicable scope and authorization before relevance ranking.",
    "lifetime_rule": "Retention may be persistent, bounded-duration, event-bounded or explicit-until-removed.",
    "expiry_rule": "Expired memory is unavailable to normal retrieval and remains historical only where explicit retention/audit policy says so.",
    "shared_rule": "Cross-scope sharing requires explicit relation/policy.",
    "inheritance_rule": "No scope inheritance is assumed unless explicitly declared."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MEMORY_EXPLICIT_DATA",
        "rule": "Machine-significant memory is explicit addressable provenance-bearing data; retrieval and storage never create hidden authority or implicit execution."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "memory retrieved across scope without explicit policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "relevance ranking occurs before scope/authorization filtering",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "expired memory used as active memory",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "shared scope inferred from similarity/context",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "scope inheritance guessed",
        "result": "hard_fail"
      }
    ]
  },
