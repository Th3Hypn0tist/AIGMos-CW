  },
  "identity": {
    "id": "AIGMOS_MEMORY_RETRIEVAL_CONTEXT_PROJECTION_CONTRACT",
    "name": "Memory Retrieval and Context Projection",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define retrieval as a bounded read-only projection from authorized `#MEM` records into the context of q/qc/qt, tools or other consumers, preserving source refs and never converting retrieved content into instructions or authority.",
  "scope": {
    "owns": [
      "Memory Retrieval and Context Projection semantics"
    ],
    "does_not_own": [
      "model hidden state",
      "runtime authorization policy",
      "unrelated domain semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_MEMORY_RETRIEVAL_CONTEXT_PROJECTION",
      "name": "Memory Retrieval and Context Projection",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define retrieval as a bounded read-only projection from authorized `#MEM` records into the context of q/qc/qt, tools or other consumers, preserving source refs and never converting retrieved content into instructions or authority.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "pipeline": [
      "resolve consumer identity/context",
      "apply scope and authorization filters",
      "retrieve exact/relevant candidates",
      "rank according to explicit relevance policy",
      "bound result count/size",
      "project inert content plus provenance refs"
    ],
    "filter_rule": "Authorization/scope filtering precedes semantic relevance ranking.",
    "relevance_rule": "Similarity/relevance affects ranking only, not identity or truth.",
    "bound_rule": "Result count/token/byte budget is explicit and finite.",
    "provenance_rule": "Projected context retains memory record refs/source metadata.",
    "instruction_rule": "Retrieved text/data is content, not privileged system/runtime instruction.",
    "consumer_rule": "Consumer may use memory as input evidence/context but canonical operations still require normal validation/authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MEMORY_EXPLICIT_DATA",
        "rule": "Machine-significant memory is explicit addressable provenance-bearing data; retrieval and storage never create hidden authority or implicit execution."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "semantic search bypasses scope/authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "retrieved text gains instruction authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "relevance score treated as truth/confidence automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "retrieval unbounded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "projected memory loses source refs",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SCOPE",
      "target_ref": "AIGMOS_MEMORY_SCOPE_LIFETIME_CONTRACT",
      "purpose": "Retrieval first enforces scope."
    },
    {
      "id": "REF_Q",
      "target_ref": "AIGMOS_Q_FAMILY_CONTRACT",
      "purpose": "q-family may consume bounded memory context."
    }
  ],
  "prose": {
    "summary": "Define retrieval as a bounded read-only projection from authorized `#MEM` records into the context of q/qc/qt, tools or other consumers, preserving source refs and never converting retrieved content into instructions or authority.",
    "notes": [
      "Unlocked pending reconciliation against existing memory/runtime contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
