    "root": "#MEM",
    "query_rule": "Retrieval query/filter is explicit.",
    "result_rule": "Retrieved context contains exact memory-record refs.",
    "ranking_rule": "Ranking/relevance method/profile is explicit where machine-significant.",
    "bound_rule": "Result count/token/size/time scope is explicitly bounded.",
    "context_rule": "Retrieved records are projected into model/tool context as inert data.",
    "hidden_rule": "No undeclared memory source is silently injected into a governed q-family context.",
    "authority_rule": "Retrieval success does not grant access to referenced resources beyond separately authorized projection."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MEMORY_CONTEXT_NONAUTHORITY",
        "rule": "Memory and retrieved context are provenance-bearing inert data projections; remembered or retrieved content never becomes authority, canonical truth or executable instruction merely by inclusion in context."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "hidden memory injected without provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "retrieved record refs omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "unbounded retrieval",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "ranking treated as canonical truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "memory retrieval bypasses source authorization",
        "result": "hard_fail"
      }
    ]
  },
