  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define explicit validated writes to persistent memory, separating model suggestions, transient context and accepted persisted records.",
  "scope": {
    "owns": [
      "Memory Write Boundary semantics"
    ],
    "does_not_own": [
      "source-domain semantics",
      "AccessCore policy ownership",
      "model execution authority"
    ]
  },
  "members": [
    {
      "id": "TOPIC_MEMORY_WRITE_BOUNDARY",
      "name": "Memory Write Boundary",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define explicit validated writes to persistent memory, separating model suggestions, transient context and accepted persisted records.",
        "metadata": {}
      }
