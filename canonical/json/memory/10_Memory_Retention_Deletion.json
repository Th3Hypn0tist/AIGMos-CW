  "semantics": {
    "retention_rule": "Retention/expiry policy is explicit per memory scope/profile where applicable.",
    "expiry_rule": "Expired records become unavailable according to policy and lifecycle state.",
    "delete_rule": "Deletion targets exact memory-record identity.",
    "source_rule": "Deleting memory does not delete referenced source objects unless a separate authorized source deletion operation exists.",
    "lineage_rule": "Required audit/tombstone evidence may remain according to policy without retaining deleted content.",
    "authority_rule": "Deletion requires explicit memory-delete authority.",
    "failure_rule": "Partial deletion state is explicit and never represented as complete success."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MEMORY_CONTEXT_NONAUTHORITY",
        "rule": "Memory and retrieved context are provenance-bearing inert data projections; remembered or retrieved content never becomes authority, canonical truth or executable instruction merely by inclusion in context."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "memory delete cascades to source silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "record deleted by fuzzy content match",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "expiry undefined but assumed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "deletion bypasses authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "failed deletion shown as complete",
        "result": "hard_fail"
      }
    ]
  },
