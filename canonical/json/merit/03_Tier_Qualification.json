  "semantics": {
    "qualification_rule": "Target Tier requires at least 3 qualifying recommendations and 3 qualifying Projects at that Tier.",
    "project_rule": "Qualifying work references distinct canonical Project evidence according to MeritCore policy.",
    "recommendation_rule": "Recommendations are MeritCore-owned human-interaction evidence.",
    "calculation_rule": "Tier is calculated from accepted evidence rather than self-declared.",
    "review_rule": "Negative feedback may trigger review; higher-Tier peers may reduce Tier through explicit review semantics.",
    "history_rule": "Tier changes retain prior evidence/history rather than rewriting the past.",
    "identity_rule": "Tier belongs to one identity and cannot be transferred/merged across identities."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MERIT_EVIDENCE_BOUND",
        "rule": "MeritCore-derived points, Tier, recommendations and trust remain bound to one identity and explicit Project/evidence history; they cannot be manufactured by presentation, identity merging or time-splitting."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Tier self-declared",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Tier granted without required 3 recommendations and 3 Projects",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "Tier transferred between identities",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "negative review silently rewrites historical evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Portfolio projection directly edits Tier",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REC",
      "target_ref": "AIGMOS_MERIT_RECOMMENDATION_CONTRACT",
      "purpose": "Recommendations contribute to Tier qualification."
    }
  ],
  "prose": {
    "summary": "Define Tier qualification from explicit Project and recommendation evidence, including the locked minimum of three recommendations and three Projects at the target Tier.",
    "notes": [
