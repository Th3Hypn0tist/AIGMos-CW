    "identity_rule": "Each merit evidence record has an explicit identity.",
    "subject_rule": "Beneficiary IdentityCore identity is exact.",
    "project_rule": "Source Project identity/evidence is exact where Project-based.",
    "interaction_rule": "MeritCore covers human-interaction/competence signals rather than arbitrary machine telemetry.",
    "source_rule": "Backend/source writer identity and provenance are explicit.",
    "time_rule": "Merit evidence binds exact registration-anchored week/hour atom.",
    "state_rule": "Accepted/review/pending/revoked states are explicit.",
    "authority_rule": "Merit evidence grants no AccessCore rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "machine telemetry converted to merit silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Project guessed by name",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "merit beneficiary inferred from login",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "evidence without provenance accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "merit grants system authority",
        "result": "hard_fail"
      }
    ]
  },
