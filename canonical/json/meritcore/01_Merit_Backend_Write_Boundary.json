  "semantics": {
    "writer_rule": "Backend writer/source identity is explicit.",
    "input_rule": "Writes target exact subject, Project, evidence type and time atom.",
    "validation_rule": "Evidence validates against MeritCore schema/rules before acceptance.",
    "authorization_rule": "Only authorized backend/workflow may write merit evidence.",
    "calculation_rule": "Backend writes merit evidence; MeritCore computes points/Tier according to canonical rules.",
    "model_rule": "AI/model output cannot directly persist merit.",
    "history_rule": "Corrections/revocations preserve evidence history."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "model directly awards merit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "backend writes final Tier arbitrarily",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "evidence bypasses validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "writer identity omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "correction overwrites history",
        "result": "hard_fail"
      }
    ]
  },
