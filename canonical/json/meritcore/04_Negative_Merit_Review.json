  "semantics": {
    "feedback_rule": "Negative feedback record has explicit identity/source/subject/Project refs.",
    "review_rule": "Applicable negative feedback enters explicit review workflow.",
    "automatic_rule": "Negative feedback does not silently reduce Tier without review semantics.",
    "peer_rule": "Higher-Tier peer review may reduce Tier according to explicit MeritCore policy.",
    "evidence_rule": "Review decision references exact evidence and reviewers.",
    "appeal_rule": "Correction/appeal/re-review semantics may be explicit.",
    "history_rule": "Prior Tier/evidence history remains traceable."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "one negative comment instantly deletes Tier",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "reviewer identity omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "lower-tier peer reduces Tier without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "review decision overwrites evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "anonymous feedback treated verified automatically",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TIER",
      "target_ref": "AIGMOS_MERIT_TIER_CONTRACT",
      "purpose": "Reviewed negative evidence may affect Tier."
    }
  ],
  "prose": {
    "summary": "Define negative feedback as review-triggering evidence rather than automatic hidden point/Tier destruction.",
