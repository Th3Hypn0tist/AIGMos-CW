    "source_rule": "Trust consumes explicit qualifying MeritCore evidence.",
    "profile_rule": "Trust evaluation profile/version is explicit.",
    "derived_rule": "Trust output is derived evidence, not a universal hidden social score.",
    "context_rule": "Context/domain/project relevance may be explicit.",
    "privacy_rule": "Private source evidence remains protected.",
    "explain_rule": "Material evidence/profile refs are traceable.",
    "authority_rule": "Trust evidence does not grant AccessCore rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "opaque hidden trust score",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "trust based on unrelated telemetry",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "trust grants system privileges",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "private source leaked",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "ranking position used as trust truth",
        "result": "hard_fail"
      }
    ]
  },
