    "default_rule": "MeritCore evidence has no generic time-decay.",
    "profile_rule": "A specific competence criterion may explicitly require recent evidence.",
    "window_rule": "Recency window/anchor is explicit.",
    "scope_rule": "Recency applies only to the competence/Tier criterion that declares it.",
