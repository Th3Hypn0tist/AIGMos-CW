    {
      "id": "TOPIC_MERIT_EVIDENCE_CONSERVATION",
      "name": "Merit Evidence Conservation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define conservation rules preventing one underlying work/evidence unit from multiplying Merit/Tier qualification through arbitrary splitting, duplication or recursive Project structure.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "source_rule": "Merit evidence retains exact underlying Project/work/time provenance.",
    "duplicate_rule": "Same underlying evidence unit cannot count repeatedly for the same criterion unless policy explicitly allows distinct dimensions.",
    "time_rule": "Splitting week→hours conserves total represented work time.",
    "project_rule": "Recursive Project parent/child structure cannot multiply one leaf work event into multiple qualifying Project outcomes by projection alone.",
    "recommendation_rule": "Same recommendation cannot be duplicated through copies/aliases.",
    "recompute_rule": "Recalculation deduplicates by exact evidence identity/provenance.",
    "authority_rule": "Conservation affects Merit evaluation only."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "same leaf Project counted through every ancestor",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "copied recommendation counts twice",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "hour split multiplies points",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "same artifact imported twice becomes two merits",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "alias creates new evidence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_HOUR",
      "target_ref": "AIGMOS_MERIT_HOUR_ATOM_CONTRACT",
      "purpose": "Time subdivision preserves evidence conservation."
    }
  ],
  "prose": {
    "summary": "Define conservation rules preventing one underlying work/evidence unit from multiplying Merit/Tier qualification through arbitrary splitting, duplication or recursive Project structure.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
