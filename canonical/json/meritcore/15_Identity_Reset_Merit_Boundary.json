  "semantics": {
    "new_identity_rule": "New canonical identity has a new independent merit timeline.",
    "merge_rule": "Prior merits/points/Tier/recommendations/trust do not transfer by default.",
    "negative_rule": "Negative evidence cannot be escaped while retaining positive history through identity merge.",
    "positive_rule": "Reset forfeits previous positive MeritCore history unless a future explicit identity-continuity contract is created.",
    "portfolio_rule": "Shared external work may be re-referenced only through new explicit evidence, never history merge.",
    "audit_rule": "Identity lifecycle remains traceable according to privacy/governance.",
    "authority_rule": "Reset semantics are MeritCore integrity, not AccessCore."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "new identity keeps points but drops negatives",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "identities merged selectively",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "portfolio import copies Tier",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "same email reconnects Merit history automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "reset rewrites old history",
        "result": "hard_fail"
      }
    ]
  },
