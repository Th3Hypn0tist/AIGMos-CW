  "semantics": {
    "source_rule": "Projection reads exact accepted MeritCore evidence/evaluations.",
    "privacy_rule": "Only public/permitted fields/evidence are exposed.",
    "tier_rule": "Displayed Tier references exact current evaluation.",
    "recommendation_rule": "Recommendation visibility follows recommender/subject policy.",
    "trust_rule": "Trust projection remains derived evidence and includes profile/version metadata where useful.",
    "project_rule": "Public Project refs are exact.",
    "source_truth_rule": "Projection/cache is not canonical MeritCore source."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "private merit shown publicly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "projection recalculates hidden Tier differently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "trust shown without provenance/profile",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "public cache becomes source truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "recommendation exposed against policy",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TIER",
      "target_ref": "AIGMOS_MERIT_TIER_CONTRACT",
      "purpose": "Public projection references exact Tier evaluation."
    }
  ],
