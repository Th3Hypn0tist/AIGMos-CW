    "verified_rule": "Verified evidence and self-authored narrative are clearly separated.",
    "time_rule": "Temporal distribution remains visible rather than collapsing all evidence into one undated claim.",
    "project_rule": "Project evidence remains linked to exact Projects where public.",
    "update_rule": "Projection updates from accepted underlying evidence rather than manual overwrite.",
    "privacy_rule": "Only permitted evidence appears.",
    "authority_rule": "Living CV is presentation/evidence projection, not employment/authorization authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "self-written claim shown verified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "manual edit overwrites Merit history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "all merits collapsed without time provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "private Projects exposed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "CV rank grants offer authority",
        "result": "hard_fail"
      }
    ]
  },
