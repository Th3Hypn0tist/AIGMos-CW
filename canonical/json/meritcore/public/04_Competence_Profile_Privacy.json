    "visibility_rule": "Each exposed evidence dimension follows exact visibility/disclosure policy.",
    "subject_rule": "Subject identity and applicable consent/visibility state are explicit where required.",
    "recommendation_rule": "Recommendation disclosure may depend on both subject and recommender policy.",
    "project_rule": "Private Project evidence is not made public by derived competence projection.",
    "aggregate_rule": "Aggregates cannot reveal restricted source values beyond policy.",
    "revocation_rule": "Visibility revocation removes future projection exposure while preserving governed internal history.",
    "authority_rule": "Public disclosure grants no source mutation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
