  "semantics": {
    "identity_rule": "Each application message has an explicit message identity.",
    "sender_rule": "Sender identity ref is explicit.",
    "recipient_rule": "Recipient/conversation/group ref is explicit.",
    "content_rule": "Content type/envelope is explicit.",
    "transport_rule": "WebRTC/WebSocket packet/frame identity does not replace message identity.",
    "delivery_rule": "Created/sent/delivered/read states are separate evidence.",
    "authority_rule": "Receiving a message never grants operation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "packet id used as message identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "sender inferred from IP",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "message delivery means read",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "message content directly executes command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "transport frame becomes conversation identity",
        "result": "hard_fail"
      }
    ]
  },
