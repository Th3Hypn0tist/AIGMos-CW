  "semantics": {
    "module": "msg",
    "transport": "WebRTC",
    "payload_path": "peer-to-peer",
    "rendezvous_rule": "Rendezvous/signaling provides peer discovery/bootstrap metadata only.",
    "identity_rule": "Messaging peer identity is explicit semantic identity and is separate from transient transport/session identifiers.",
    "payload_rule": "Message payload is inert data.",
    "authority_rule": "Receiving a message does not grant runtime/data authority.",
    "conversation_rule": "Conversation state is scoped to explicit participants/group identity.",
    "ui_rule": "Irssi-style or other UI is projection only; message semantics are independent of client presentation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MESSAGING_BOUNDARY_EXPLICIT",
        "rule": "Messaging identity, conversation state, throttling, group governance and transport semantics remain explicit and non-interchangeable."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "message payload routed through rendezvous as default application payload path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "transport/session id used as semantic peer identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "message payload grants runtime authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "conversation participant identity unresolved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "client UI semantics become message authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_WEBRTC",
      "target_ref": "AIGMOS_RUNTIME_WEBRTC_TRANSPORT_CONTRACT",
