  "semantics": {
    "join_rule": "Group membership is invite-only unless a future explicit compatible policy says otherwise.",
    "owner_rule": "Group owner identity is immutable for the lifetime of that group identity.",
    "delegation_rule": "Two delegated authority levels are supported below owner.",
    "invite_rule": "Group may explicitly allow all members to invite, otherwise invitation follows delegated authority policy.",
    "membership_rule": "Member/delegation changes are explicit governed operations.",
    "transport_rule": "Group governance survives peer transport session changes.",
    "authority_rule": "Transport connectivity or message receipt does not grant group governance authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MESSAGING_PEER_GOVERNED",
        "rule": "Messaging is explicit peer/group communication over governed peer transport; rendezvous, transport, conversation policy and message payload remain separate semantic layers."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "group owner silently transferred",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "uninvited peer joins",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "transport connectivity grants membership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "delegation levels ambiguous/merged",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "all-members-invite enabled implicitly",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CONV",
      "target_ref": "AIGMOS_MSG_CONVERSATION_IDENTITY_CONTRACT",
