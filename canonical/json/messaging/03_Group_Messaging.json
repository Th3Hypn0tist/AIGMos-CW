  "semantics": {
    "group_rule": "Group has explicit stable semantic identity.",
    "membership_rule": "Membership is invite-only by default.",
    "owner_rule": "Group owner identity is immutable for the lifetime of the group under the current model.",
    "transport_rule": "Group messaging may use peer-to-peer transport arrangements but transport topology does not redefine group identity.",
    "payload_rule": "Group messages are inert payloads scoped to the group conversation.",
    "membership_visibility_rule": "Current participant membership is explicitly readable by authorized group participants.",
    "ui_rule": "Commands such as /msg users are client projections over canonical/current group membership state."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MESSAGING_BOUNDARY_EXPLICIT",
        "rule": "Messaging identity, conversation state, throttling, group governance and transport semantics remain explicit and non-interchangeable."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "group has no stable semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "owner identity changes silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "membership inferred from transport topology only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "non-member receives group payload without explicit policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "UI participant list becomes membership authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
