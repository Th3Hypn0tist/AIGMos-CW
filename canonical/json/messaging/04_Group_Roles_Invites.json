  "semantics": {
    "owner": "immutable group owner",
    "delegated_levels": 2,
    "role_rule": "Delegated levels are explicit group-governance permissions and do not alter IdentityCore identity.",
    "invite_rule": "Invites require an explicitly permitted group role or policy.",
    "all_may_invite_rule": "A group may explicitly enable all-members-may-invite.",
    "default_rule": "All-members-may-invite is not assumed unless enabled.",
    "membership_rule": "Invite acceptance creates explicit group membership.",
    "authority_rule": "Group role authority applies only to group-governance operations and does not grant unrelated AccessCore rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MESSAGING_BOUNDARY_EXPLICIT",
        "rule": "Messaging identity, conversation state, throttling, group governance and transport semantics remain explicit and non-interchangeable."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "group role changes canonical identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "all-members-may-invite assumed without explicit setting",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "invite accepted without explicit membership transition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "group role grants unrelated AccessCore authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "owner role transferred silently",
        "result": "hard_fail"
      }
    ]
  },
