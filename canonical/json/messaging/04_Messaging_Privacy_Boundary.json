  "semantics": {
    "layers": [
      "discovery metadata",
      "transport/session metadata",
      "conversation governance",
      "message envelope",
      "message payload"
    ],
    "minimum_rule": "Each layer exposes only metadata required for its own responsibility.",
    "hello_rule": "Hello service can observe only permitted bootstrap/discovery metadata, not normal message payload.",
    "peer_rule": "Conversation peers receive payload according to conversation membership and messaging policy.",
    "monitor_rule": "Operational monitors redact payload/content unless explicitly authorized for that surface.",
    "identity_rule": "Identity references may be pseudonymous/limited according to owning IAM/privacy policy without breaking exact internal refs.",
    "retention_rule": "Retention of message payload/history is explicit and separate from rendezvous-record TTL.",
    "authority_rule": "Metadata visibility at one layer does not grant visibility at another."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MESSAGING_PEER_GOVERNED",
        "rule": "Messaging is explicit peer/group communication over governed peer transport; rendezvous, transport, conversation policy and message payload remain separate semantic layers."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Hello gains normal payload visibility",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "rendezvous TTL used as message retention policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "transport metadata visibility grants payload access",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "monitor exposes payload without authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "layer boundaries undocumented/implicit",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_HELLO",
      "target_ref": "AIGMOS_HELLO_IDENTITY_CONTRACT",
      "purpose": "Discovery metadata is isolated from payload."
    }
  ],
  "prose": {
    "summary": "Define the separation of discovery metadata, peer transport metadata, conversation membership and message payload exposure across Hello and messaging surfaces.",
