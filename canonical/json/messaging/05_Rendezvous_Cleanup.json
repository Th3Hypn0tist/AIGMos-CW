    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define cleanup of messaging rendezvous/bootstrap metadata after peers establish direct communication or bootstrap metadata expires, minimizing unnecessary retained coordination state.",
  "scope": {
    "owns": [
      "Messaging Rendezvous Cleanup semantics"
    ],
    "does_not_own": [
      "transport identity",
      "AccessCore authorization",
      "unrelated MeritCore semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_MESSAGING_RENDEZVOUS_CLEANUP",
      "name": "Messaging Rendezvous Cleanup",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define cleanup of messaging rendezvous/bootstrap metadata after peers establish direct communication or bootstrap metadata expires, minimizing unnecessary retained coordination state.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
