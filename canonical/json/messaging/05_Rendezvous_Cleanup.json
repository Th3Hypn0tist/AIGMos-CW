    "events": [],
    "flows": []
  },
  "semantics": {
    "cleanup_trigger": [
      "peer-to-peer session established",
      "bootstrap metadata expired",
      "explicit cancellation"
    ],
    "retention_rule": "Rendezvous metadata has explicit bounded lifetime.",
    "payload_rule": "Application messages are not retained as rendezvous metadata.",
    "state_rule": "Rendezvous records are coordination runtime/service state, not messaging semantic identity.",
    "failure_rule": "Cleanup failure is visible and retryable according to service policy.",
    "privacy_rule": "Only metadata required for peer establishment is retained.",
    "identity_rule": "Removing rendezvous metadata does not remove peer/group semantic identities."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MESSAGING_BOUNDARY_EXPLICIT",
        "rule": "Messaging identity, conversation state, throttling, group governance and transport semantics remain explicit and non-interchangeable."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "bootstrap metadata retained indefinitely without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "application message payload retained as rendezvous coordination data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "rendezvous cleanup deletes peer/group semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "cleanup failure hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "excess identity/content data retained beyond bootstrap need",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_RENDEZVOUS",
      "target_ref": "AIGMOS_RUNTIME_RENDEZVOUS_SIGNALING_CONTRACT",
      "purpose": "Messaging cleanup applies to bootstrap metadata."
    }
  ],
  "prose": {
    "summary": "Define cleanup of messaging rendezvous/bootstrap metadata after peers establish direct communication or bootstrap metadata expires, minimizing unnecessary retained coordination state.",
    "notes": [
      "Unlocked pending reconciliation against existing msg/WebRTC/rendezvous contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
