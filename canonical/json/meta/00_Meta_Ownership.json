      "id": "TOPIC_META",
      "name": "Meta",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define Meta as the semantic ownership layer for module/domain models, schemas, relations and constraints, independent from whether those semantics are exposed through Expose.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_META_DEFINE",
        "name": "Define Meta semantic owner",
        "inputs": [
          "Meta identity",
          "schema",
          "owned relations/constraints/operations"
        ],
        "outputs": [
          "Meta definition"
        ],
        "errors": [
          "identity collision",
          "ownership conflict"
        ],
        "side_effects": [
          "Meta registry updated"
        ]
      },
      {
        "id": "OP_META_RESOLVE_SCHEMA",
        "name": "Resolve Meta-owned schema",
        "inputs": [
          "Meta ref"
        ],
        "outputs": [
          "owned schema"
        ],
        "errors": [
          "schema unresolved"
        ],
        "side_effects": []
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "role": "semantic ownership/model layer",
    "owns": [
      "owned schema",
      "owned relation declarations",
      "owned constraints",
      "owned operations where applicable"
    ],
    "expose_rule": "Meta is not under Expose unless a MetaModule/view exposes a human-facing surface.",
    "schema_rule": "Schemas belong to their explicit Meta/semantic owner.",
    "relation_rule": "Relations are declared by explicit semantic owners and may be referenced by instances/domains.",
    "runtime_rule": "Meta definition is declarative semantics, not runtime authority.",
    "projection_rule": "Editor/Expose projections do not take ownership from Meta."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ARCHITECTURE_COMPOSITION_EXPLICIT",
        "rule": "Universal substrates, domain compositions, Meta ownership and relations remain explicit and non-duplicated."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Meta ownership inferred from Expose placement",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Expose visibility transfers semantic ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "schema owned only by form/UI definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "relation created ad hoc by runtime instance without Meta declaration",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Meta definition treated as runtime authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
