  "semantics": {
    "identity_rule": "Every MetaModule has an explicit stable canonical identity.",
    "composition_rule": "MetaModule identity names the composition/application semantics, not any one constituent module.",
    "constituent_rule": "Constituent UserModules, schemas, resources, operations and views retain their own canonical identities.",
    "placement_rule": "nanoCMS site/page placement is a binding and never MetaModule semantic identity.",
    "runtime_rule": "Concrete runtime activation/instance identity is separate from MetaModule definition identity.",
    "path_rule": "File/directory path is discovery metadata and never canonical MetaModule identity.",
    "authority_rule": "MetaModule existence/visibility does not grant access to constituent capabilities."
  },
  "constraints": {
    "invariants": [
      {
        "id": "METAMODULE_COMPOSITION_NONOWNERSHIP",
        "rule": "A MetaModule is an explicit composition of existing semantic capabilities; composition, placement or runtime activation never silently transfers ownership, identity or authority from constituent modules/resources."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "MetaModule identity inferred from page route",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "MetaModule replaces constituent identities",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "runtime instance reused as definition identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "filesystem path becomes semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "MetaModule visibility grants constituent authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_COMP",
