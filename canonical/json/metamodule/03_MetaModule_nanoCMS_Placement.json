  "semantics": {
    "placement_rule": "Placement references exact MetaModule and exact nanoCMS site/page/location identity.",
    "ownership_rule": "nanoCMS owns site hierarchy/routes/navigation/placement metadata; MetaModule owns application/composition semantics.",
    "multi_rule": "One MetaModule definition may be placed multiple times without semantic duplication.",
    "route_rule": "Route/placement identity never replaces MetaModule identity.",
    "self_host_rule": "Expose Editor may be placed as an ordinary MetaModule under nanoCMS with no privileged class.",
    "removal_rule": "Removing placement removes visibility/binding, not the underlying MetaModule definition.",
    "authority_rule": "Placement does not bypass AccessCore."
  },
  "constraints": {
    "invariants": [
      {
        "id": "METAMODULE_COMPOSITION_NONOWNERSHIP",
        "rule": "A MetaModule is an explicit composition of existing semantic capabilities; composition, placement or runtime activation never silently transfers ownership, identity or authority from constituent modules/resources."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "nanoCMS becomes owner of MetaModule semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "page route replaces MetaModule identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "multiple placements clone semantic definitions",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "removing page deletes MetaModule definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Editor placement gains privileged bypass",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_NANO",
      "target_ref": "AIGMOS_NANOCMS_METAMODULE_PLACEMENT_CONTRACT",
      "purpose": "nanoCMS owns placement/site structure."
    },
    {
      "id": "REF_SELF",
      "target_ref": "AIGMOS_EXPOSE_EDITOR_SELF_HOSTING_CONTRACT",
      "purpose": "Editor is an ordinary self-hosted MetaModule."
    }
  ],
  "prose": {
    "summary": "Define placement of a MetaModule into nanoCMS site/page/route structure as an explicit presentation binding while nanoCMS owns structure and the MetaModule owns its own composition semantics.",
    "notes": [
      "Unlocked pending reconciliation against composition, nanoCMS, UserModule, Editor and runtime activation contracts."
