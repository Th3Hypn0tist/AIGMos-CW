  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define placement of a MetaModule into nanoCMS site/page/route structure as an explicit presentation binding while nanoCMS owns structure and the MetaModule owns its own composition semantics.",
  "scope": {
    "owns": [
      "MetaModule nanoCMS Placement Boundary semantics"
    ],
    "does_not_own": [
      "constituent module domain semantics",
      "nanoCMS site-tree ownership",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_METAMODULE_NANOCMS_PLACEMENT",
      "name": "MetaModule nanoCMS Placement Boundary",
      "type": "topic",
