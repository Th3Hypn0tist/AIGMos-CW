  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "flow": [
      "resolve exact MetaModule definition",
      "resolve dependency closure",
      "validate composition/bindings",
      "authorize activation",
      "bind accepted runtime snapshot",
      "activate runtime availability"
    ],
    "definition_rule": "Editing a MetaModule definition does not mutate an already running activation until explicit apply/reload.",
    "snapshot_rule": "Runtime activation binds to an exact accepted canonical snapshot.",
    "state_values": [
      "defined",
      "validated",
      "available",
      "active",
      "inactive",
      "error"
    ],
    "placement_rule": "UI placement may exist while runtime capability is inactive, and vice versa according to explicit profile.",
    "reload_rule": "Reload/replacement is explicit and preserves prior activation evidence.",
    "failure_rule": "Failed activation leaves prior valid active state or explicit inactive/error state according to policy.",
    "authority_rule": "Activation does not create rights to constituent resources."
  },
  "constraints": {
    "invariants": [
      {
        "id": "METAMODULE_COMPOSITION_NONOWNERSHIP",
        "rule": "A MetaModule is an explicit composition of existing semantic capabilities; composition, placement or runtime activation never silently transfers ownership, identity or authority from constituent modules/resources."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "filesystem edit mutates live MetaModule immediately",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "activation uses unaccepted candidate silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed reload destroys prior state without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "placement implies active runtime",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "activation grants constituent rights",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ACT",
      "target_ref": "AIGMOS_RUNTIME_ACTIVATION_CONTRACT",
      "purpose": "MetaModule activation follows accepted-snapshot runtime semantics."
    },
    {
      "id": "REF_EDIT",
      "target_ref": "AIGMOS_EXPOSE_EDITOR_VALIDATE_APPLY_CONTRACT",
      "purpose": "Definition changes use candidate/validate/apply boundary."
    }
  ],
  "prose": {
    "summary": "Define validation and activation of MetaModule definitions into runtime availability while keeping definition, accepted snapshot, placement and runtime state separate.",
    "notes": [
