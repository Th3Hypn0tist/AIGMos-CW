    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define validation and activation of MetaModule definitions into runtime availability while keeping definition, accepted snapshot, placement and runtime state separate.",
  "scope": {
    "owns": [
      "MetaModule Runtime Activation semantics"
    ],
    "does_not_own": [
      "constituent module domain semantics",
      "nanoCMS site-tree ownership",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_METAMODULE_RUNTIME_ACTIVATION",
      "name": "MetaModule Runtime Activation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define validation and activation of MetaModule definitions into runtime availability while keeping definition, accepted snapshot, placement and runtime state separate.",
        "metadata": {}
      }
    }
