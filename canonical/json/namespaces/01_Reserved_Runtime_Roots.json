      "#CAL",
      "#SHOP"
    ],
    "reservation_rule": "Reserved root identity cannot be redefined by user-installed modules or arbitrary mounts.",
    "owner_rule": "Each root resolves to one explicit semantic owner/family contract.",
    "extension_rule": "New reserved root requires explicit canonical contract and registry update.",
    "shadow_rule": "User/library content cannot shadow a reserved root by name/path coincidence.",
    "lifecycle_rule": "A reserved root may exist canonically even when the corresponding optional subsystem is disabled/unavailable.",
    "authority_rule": "Reserved status is naming/address-space protection, not elevated runtime authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "NAMESPACE_EXPLICIT",
        "rule": "Runtime symbol namespaces, roots, mounts and dynamic families are explicit, collision-free and never inferred solely from filesystem layout or display labels."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "user module shadows reserved root",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "reserved root owner unresolved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "new reserved root appears without registry contract",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "disabled subsystem causes canonical reserved root identity to disappear where root is defined as persistent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "reserved status interpreted as privileged authority",
        "result": "hard_fail"
      }
    ]
  },
