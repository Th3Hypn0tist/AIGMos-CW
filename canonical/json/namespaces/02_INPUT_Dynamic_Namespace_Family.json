  "semantics": {
    "family": "#INPUT:*",
    "child_rule": "Each `#INPUT:<id>` child has an explicit instance/source identity.",
    "owner_rule": "Child namespace is owned by its declared Input module/source instance.",
    "payload_rule": "Input payload written under the child namespace remains inert data.",
    "creation_rule": "Dynamic child creation requires valid family membership and exact non-colliding child identity.",
    "escape_rule": "Dynamic child identity cannot escape into another reserved root or create nested arbitrary top-level namespaces.",
    "lifecycle_rule": "Runtime child availability/state may change without redefining the family contract.",
    "authority_rule": "Writing input data does not imply permission to execute operations."
  },
  "constraints": {
    "invariants": [
      {
        "id": "NAMESPACE_EXPLICIT",
        "rule": "Runtime symbol namespaces, roots, mounts and dynamic families are explicit, collision-free and never inferred solely from filesystem layout or display labels."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "payload creates arbitrary namespace/root",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "dynamic child identity collides with reserved root",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "input payload executes directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "child namespace has no explicit owning Input source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "dynamic child resolved from untrusted payload without validation",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
