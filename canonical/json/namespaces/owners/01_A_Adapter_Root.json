    "root": "#A",
    "role": "adapter semantic family/root",
    "owner_rule": "#A resolves to explicit Adapter definitions/instances.",
    "adapter_rule": "Adapter translates or mounts declared surfaces; it does not become semantic owner of source/target data.",
    "command_rule": "Adapter has no independent hidden command authority.",
    "identity_rule": "Adapter identity is explicit and independent from its mount location.",
    "binding_rule": "Source and target refs are explicit.",
    "authority_rule": "Adapter availability does not grant source/target access authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RESERVED_ROOT_OWNER_EXPLICIT",
        "rule": "Each reserved runtime root resolves to one explicit semantic owner/family; the root itself does not create new authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Adapter becomes semantic owner of translated source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Adapter gains hidden command authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "Adapter identity inferred from mount path only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Adapter source/target resolved fuzzily",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "#A presence grants access authority",
        "result": "hard_fail"
      }
    ]
  },
