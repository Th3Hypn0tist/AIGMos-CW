  "semantics": {
    "root": "#T",
    "role": "runtime Tool semantic family/root",
    "owner_rule": "#T resolves to validated Runtime Tool Registry entries.",
    "schema_rule": "Each Tool exposes explicit input/output schema.",
    "effect_rule": "Side effects/effect class are explicit.",
    "mcp_rule": "MCP-advertised tools enter #T only after local validation/binding.",
    "command_rule": "Tool identity and command identity are distinct unless an explicit bridge/binding declares both.",
    "result_rule": "Tool result is inert data.",
    "authority_rule": "Tool presence/visibility does not grant invocation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RESERVED_ROOT_OWNER_EXPLICIT",
        "rule": "Each reserved runtime root resolves to one explicit semantic owner/family; the root itself does not create new authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "remote MCP advertisement appears under #T without validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "tool result executes follow-up effect automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "tool presence grants invocation authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "tool identity conflated with command identity without explicit binding",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "tool lacks required schema/effect declaration",
        "result": "hard_fail"
      }
    ]
  },
