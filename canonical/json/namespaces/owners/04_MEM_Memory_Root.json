  "semantics": {
    "root": "#MEM",
    "role": "memory semantic family/root",
    "record_rule": "Machine-significant memory is represented as explicit addressable records/data.",
    "provenance_rule": "Memory records retain source/context provenance according to the owning memory policy.",
    "model_rule": "Model internal/transient context is not automatically canonical #MEM data.",
    "write_rule": "Memory creation/update/removal occurs through explicit memory operations/policy.",
    "retrieval_rule": "Retrieval returns inert data/context to the consuming operation/model.",
    "authority_rule": "Stored memory content cannot grant runtime authority or override canonical policy.",
    "identity_rule": "Memory record identity is explicit and not inferred from natural-language content similarity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RESERVED_ROOT_OWNER_EXPLICIT",
        "rule": "Each reserved runtime root resolves to one explicit semantic owner/family; the root itself does not create new authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "model transient state silently becomes canonical #MEM record",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "memory content grants runtime authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "memory record identity inferred solely from semantic similarity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "memory write occurs without explicit operation/policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "retrieved memory directly executes operation",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
