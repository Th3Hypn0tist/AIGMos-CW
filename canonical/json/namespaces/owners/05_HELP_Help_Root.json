  "semantics": {
    "root": "#HELP",
    "role": "help/introspection projection root",
    "source_rule": "#HELP derives help from canonical command, namespace, module and operation metadata.",
    "nonauthority_rule": "#HELP is a projection and does not create executable commands, namespaces or permissions.",
    "recursive_rule": "Help can enumerate recursive command/namespace trees from canonical structure.",
    "short_long_rule": "Where available, concise listings use short help and detailed views use long help.",
    "visibility_rule": "Help/introspection respects applicable metadata visibility policy.",
    "sync_rule": "No independent duplicated help tree is required for semantics already carried by canonical owners."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RESERVED_ROOT_OWNER_EXPLICIT",
        "rule": "Each reserved runtime root resolves to one explicit semantic owner/family; the root itself does not create new authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "#HELP creates command or namespace semantics absent from owner metadata",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "help visibility grants execution authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "duplicated help tree silently diverges from canonical owner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "recursive help requires filesystem heuristic",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "restricted metadata exposed without visibility policy",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
