        "condition": "Routine definition conflated with active Runner state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "read/edit permission grants run authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Routine execution order inferred only from incidental serialization order",
