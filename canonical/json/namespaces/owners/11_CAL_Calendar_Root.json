  "semantics": {
    "root": "#CAL",
    "role": "calendar/scheduling semantic family/root",
    "owner_rule": "#CAL resolves to explicit calendar/scheduling identities and operations.",
    "entry_rule": "Calendar entries/events have explicit identities, time semantics and owning source/context.",
    "time_rule": "Date/time/timezone semantics are explicit where machine-significant.",
    "trigger_rule": "A scheduled time may produce an Event/Trigger condition only through explicit automation binding.",
    "execution_rule": "Calendar occurrence alone does not directly execute arbitrary operation.",
    "projection_rule": "Agenda/day/week/month views are projections of calendar semantics.",
    "authority_rule": "Calendar visibility or event ownership does not automatically grant target-operation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RESERVED_ROOT_OWNER_EXPLICIT",
        "rule": "Each reserved runtime root resolves to one explicit semantic owner/family; the root itself never creates semantic ownership or runtime authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "calendar time directly executes arbitrary operation without explicit Trigger/Runner binding",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "timezone omitted where required for deterministic machine scheduling",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "calendar UI ordering becomes execution order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "calendar entry identity inferred solely from display text",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "#CAL visibility grants unrelated operation authority",
        "result": "hard_fail"
      }
    ]
  },
