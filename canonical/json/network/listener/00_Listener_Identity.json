  "semantics": {
    "identity_rule": "Each listener instance has an explicit stable logical identity.",
    "protocol_rule": "Listener protocol/type is explicit.",
    "binding_rule": "Port/address/interface/transport bindings are configuration attached to listener identity.",
    "runtime_rule": "Runtime socket/process identity is distinct from listener identity.",
    "port_rule": "Port number is never the semantic listener identity.",
    "state_rule": "Configured/enabled/running state is separate from identity.",
    "authority_rule": "Listener existence or reachability grants no application authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "port number used as listener identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "runtime socket reused as canonical identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "listener reachability grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "configured listener assumed running",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "protocol inferred from port number",
        "result": "hard_fail"
      }
    ]
  },
