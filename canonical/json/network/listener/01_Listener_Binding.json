        "condition": "wildcard bind inferred",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "valid binding auto-starts listener",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "bound port implies route",
        "result": "hard_fail"
      },
      {
