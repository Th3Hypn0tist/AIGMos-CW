    "listener_rule": "Binding references one exact listener identity.",
    "address_rule": "Bind address/interface is explicit.",
    "port_rule": "Port is explicit.",
    "transport_rule": "TCP/UDP/other transport is explicit where applicable.",
    "conflict_rule": "Binding conflicts are detected deterministically.",
    "wildcard_rule": "Wildcard interfaces are explicit and never inferred.",
    "activation_rule": "Valid binding makes listener activation-eligible but not running.",
    "authority_rule": "Bound port grants no route or operation authority."
