      "domain semantic ownership",
      "AccessCore policy ownership",
      "application operation semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_NETWORK_LISTENER_LIFECYCLE",
      "name": "Network Listener Lifecycle",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define start, stop, reload and failure states for listener instances without conflating configured binding with active runtime availability.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "states": [
      "configured",
      "disabled",
      "starting",
      "listening",
      "degraded",
      "stopping",
      "stopped",
      "failed",
      "unknown"
    ],
    "start_rule": "Start targets exact listener identity and validated binding.",
    "stop_rule": "Stop targets exact active listener/runtime instance.",
    "reload_rule": "Binding/config changes require explicit rebind/reload semantics.",
    "failure_rule": "Bind/listen failure is explicit.",
    "availability_rule": "Listening means transport acceptance only, not application readiness/authorization.",
    "history_rule": "Lifecycle transitions are evidenced.",
    "authority_rule": "Lifecycle control requires explicit authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "configured means listening",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "listen success means application authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed bind hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "stop by port kills unrelated listener",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "reload silently changes identity",
        "result": "hard_fail"
      }
    ]
  },
