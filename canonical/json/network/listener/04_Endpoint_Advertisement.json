  "semantics": {
    "identity_rule": "Advertisement has explicit source/service refs.",
    "endpoint_rule": "Advertised address/port/protocol is descriptive metadata.",
    "liveness_rule": "Advertisement does not prove listener currently live.",
    "capability_rule": "Advertised features/capabilities require validation before use.",
    "authority_rule": "Advertisement does not authorize caller or target.",
    "expiry_rule": "Advertisement lifetime/freshness is explicit.",
    "conflict_rule": "Conflicting advertisements remain evidence and do not overwrite exact service identity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "advertisement treated as live listener proof",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "advertised capability trusted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "advertisement grants access",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "latest advertisement overwrites identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "endpoint string becomes service identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
