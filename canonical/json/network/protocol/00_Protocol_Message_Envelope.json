  "semantics": {
    "identity_rule": "Each machine-significant envelope/request has an exact message/request identity.",
    "protocol_rule": "Originating protocol instance is explicit.",
    "route_rule": "Resolved route/address/method metadata is explicit.",
    "payload_rule": "Payload type/encoding is explicit.",
    "peer_rule": "Peer/connection refs are explicit where resolved.",
    "correlation_rule": "Correlation/request refs are explicit.",
    "inert_rule": "Envelope is inert until validation/routing/authorization.",
    "authority_rule": "Envelope origin never grants authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "payload interpreted without protocol profile",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "peer inferred from header string only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "envelope directly executes command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "route guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "transport origin grants rights",
        "result": "hard_fail"
      }
    ]
  },
