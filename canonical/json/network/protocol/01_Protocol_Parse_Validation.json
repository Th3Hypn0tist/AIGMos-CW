  "semantics": {
    "flow": [
      "frame/message decode",
      "size/bounds validation",
      "syntax parse",
      "type/schema validation",
      "normalization",
      "route resolution",
      "candidate application request"
    ],
    "size_rule": "Maximum message/frame sizes are explicit.",
    "syntax_rule": "Malformed syntax fails without partial effect.",
    "schema_rule": "Typed payload validates before routing.",
    "normalization_rule": "Normalization cannot broaden semantic scope.",
    "unknown_rule": "Unknown methods/types/routes fail or follow explicit extension semantics.",
    "security_rule": "Parser errors do not leak sensitive internal state."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "malformed packet partially executes",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unknown method falls back to closest command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "oversize payload accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "normalization invents target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "parse error leaks secrets",
        "result": "hard_fail"
      }
    ]
  },
