  "semantics": {
    "scope_rule": "Rate limit binds exact peer/session/route/protocol scope.",
    "rate_rule": "Window/burst/limit semantics are explicit.",
    "malformed_rule": "Repeated malformed traffic may trigger bounded abuse policy.",
    "block_rule": "Temporary block/quarantine state is explicit and expires/revokes according to profile.",
    "identity_rule": "IP address alone is not always semantic peer identity; transport metadata may still be used as a bounded network defense dimension.",
    "authorization_rule": "Passing abuse gate does not grant application authorization.",
    "failure_rule": "Rate-limited requests do not masquerade as accepted application operations."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "rate limit clearance means authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "IP permanently blacklisted as user identity without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "rejected request shown executed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "limits unbounded/implicit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "malformed request reaches dispatcher",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
