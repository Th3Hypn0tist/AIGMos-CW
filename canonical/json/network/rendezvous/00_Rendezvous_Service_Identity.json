  "semantics": {
    "identity_rule": "Each rendezvous/signaling service has an explicit identity.",
    "role_rule": "Service coordinates peer discovery/signaling only according to declared profile.",
    "payload_rule": "Normal application payload remains P2P where protocol requires; rendezvous is not semantic payload owner.",
    "provider_rule": "Official/private provider binding is explicit.",
    "authority_rule": "Rendezvous registration does not grant peer/application authority.",
    "availability_rule": "Service availability is separate from peer reachability."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "rendezvous becomes message server silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "registration grants rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "provider URL used as service semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "signaling service owns peer data semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "availability means peer online",
        "result": "hard_fail"
      }
    ]
  },
