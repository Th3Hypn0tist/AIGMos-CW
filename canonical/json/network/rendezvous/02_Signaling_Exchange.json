  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "SDP/candidate message executes app command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "network candidate becomes peer identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "replayed offer accepted indefinitely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "signaling success grants app rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "signaling payload treated canonical app data",
        "result": "hard_fail"
      }
    ]
  },
