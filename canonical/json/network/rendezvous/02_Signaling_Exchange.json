    "message_rule": "Signaling messages have explicit type/profile.",
    "peer_rule": "Sender/recipient peer refs are exact where authenticated.",
    "payload_rule": "Signaling payload cannot directly invoke application operations.",
    "candidate_rule": "Network candidates are transport metadata only.",
    "lifetime_rule": "Signaling transaction/session lifetime is bounded.",
    "replay_rule": "Replay/stale signaling is rejected or bounded by explicit transaction identity.",
    "authority_rule": "Successful signaling grants no app authority."
