  "semantics": {
    "states": [
      "unknown",
      "signaled",
      "connecting",
      "reachable",
      "degraded",
      "unreachable",
      "disconnected"
    ],
    "identity_rule": "Reachability attaches to exact peer/transport observation context.",
    "presence_rule": "Reachable does not necessarily mean user/application presence.",
    "authority_rule": "Reachable never means authorized.",
    "time_rule": "Observation time/TTL is explicit.",
    "multi_path_rule": "Multiple candidate paths remain separate evidence.",
    "failure_rule": "Unknown/unreachable is not identity revocation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "reachable means authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unreachable means identity invalid",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "last seen timestamp becomes identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "network presence equals user activity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "one failed path marks all peers invalid",
        "result": "hard_fail"
      }
    ]
  },
