  "semantics": {
    "cleanup_rule": "Signaling transaction and transient candidate state expire explicitly.",
    "connected_rule": "After P2P connection establishment, obsolete rendezvous state may be removed according to profile.",
    "history_rule": "Minimal audit/provenance evidence may remain without preserving unnecessary transient payload.",
    "application_rule": "Cleanup never deletes peer identity, IAM identity or application messages.",
    "failure_rule": "Failed connection cleanup is explicit.",
    "privacy_rule": "Transient address metadata retention is bounded."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "rendezvous cleanup deletes peer identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "signaling metadata retained forever",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "cleanup deletes P2P messages",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "connection success leaves stale offers active indefinitely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cleanup inferred from file age only",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SIG",
      "target_ref": "AIGMOS_SIGNALING_EXCHANGE_CONTRACT",
      "purpose": "Cleanup removes bounded signaling transaction state."
    }
  ],
  "prose": {
    "summary": "Define cleanup of rendezvous/signaling state after peer connection establishment, expiry or failure so bootstrap metadata does not become persistent application state.",
