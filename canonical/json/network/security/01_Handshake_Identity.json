    "identity_rule": "Each handshake attempt has an explicit identity.",
    "connection_rule": "Handshake references exact connection/session candidate.",
    "profile_rule": "Negotiated crypto/protocol profile is explicit.",
    "peer_rule": "Peer proof/key refs are explicit where available.",
    "result_states": [
      "succeeded",
      "failed",
      "rejected",
      "timeout",
      "unknown"
    ],
    "legacy_rule": "MD5 handshake usage, where part of historical AIGMos transport compatibility, is explicitly scoped and must never be mistaken for modern cryptographic integrity/authentication strength.",
