    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "handshake success grants AccessCore rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "MD5 treated as sufficient modern authentication",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed handshake creates peer identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "negotiated profile omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "connection identity reused as handshake identity",
        "result": "hard_fail"
      }
    ]
