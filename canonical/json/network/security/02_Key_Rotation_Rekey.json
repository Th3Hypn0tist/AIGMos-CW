      {
        "id": "GATE_1",
        "condition": "rekey changes user identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "old key valid forever",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "raw key logged",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "failed rekey ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "new key grants new permissions",
        "result": "hard_fail"
      }
    ]
