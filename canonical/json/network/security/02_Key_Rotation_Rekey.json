    "session_rule": "Rekey targets exact transport session.",
    "key_rule": "Old/new session-key material versions are explicit metadata refs.",
    "overlap_rule": "Transition overlap/grace is explicit and bounded.",
    "failure_rule": "Failed rekey enters explicit degraded/close/retry policy.",
