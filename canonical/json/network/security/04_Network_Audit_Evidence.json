    "event_types": [
      "listener_started",
      "listener_stopped",
      "connection_opened",
      "connection_closed",
      "peer_bound",
      "handshake_failed",
      "integrity_failed",
      "remote_auth_denied",
      "rate_limited",
      "protocol_request"
    ],
    "identity_rule": "Audit event identity is explicit.",
    "source_rule": "Listener/connection/session/peer/request refs are exact.",
    "time_rule": "Timestamp is evidence, not authority.",
    "payload_rule": "Payload logging is minimized/redacted.",
    "secret_rule": "Secret/key/session material is excluded.",
    "history_rule": "Audit is append/history governed.",
    "authority_rule": "Audit record grants no authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "audit logs private keys",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "IP used as verified identity without binding evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "history overwritten",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "timestamp decides authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "audit entry replays request",
        "result": "hard_fail"
      }
    ]
  },
