  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "identity_rule": "Each connection has a distinct transient connection identity.",
    "listener_rule": "Inbound connection references exact listener identity.",
    "peer_rule": "Observed remote endpoint is transport metadata, not peer semantic identity.",
    "protocol_rule": "Negotiated transport/protocol profile is explicit.",
    "session_rule": "Application/IAM session identity is separate.",
    "lifetime_rule": "Open/close timestamps and state are evidence only.",
    "authority_rule": "Connection existence grants no application authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "remote IP used as peer identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "connection id reused as IAM session",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "connection grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "listener/connection identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "socket fd used as canonical identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define each accepted/outbound network connection as a transient runtime identity separate from peer identity, listener identity and authenticated session identity.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
