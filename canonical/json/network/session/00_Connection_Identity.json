    "id": "AIGMOS_NETWORK_CONNECTION_IDENTITY_CONTRACT",
    "name": "Network Connection Identity",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define each accepted/outbound network connection as a transient runtime identity separate from peer identity, listener identity and authenticated session identity.",
  "scope": {
    "owns": [
      "Network Connection Identity semantics"
    ],
    "does_not_own": [
      "domain semantic ownership",
      "AccessCore policy ownership",
      "application operation semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_NETWORK_CONNECTION_IDENTITY",
      "name": "Network Connection Identity",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define each accepted/outbound network connection as a transient runtime identity separate from peer identity, listener identity and authenticated session identity.",
        "metadata": {}
      }
    }
