  "semantics": {
    "close_rule": "Close reason/state is explicit.",
    "application_rule": "Transport close does not prove application operation failed or had no external effect.",
    "reconnect_rule": "Reconnect creates a new connection identity.",
    "session_rule": "Application/IAM session resumption is separately governed.",
    "inflight_rule": "Inflight request outcome may be success, failed, timeout or ambiguous according to protocol evidence.",
    "cleanup_rule": "Subscriptions/locks/resources follow explicit cleanup policies.",
    "retry_rule": "Automatic retry requires operation retry/idempotency semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_NONAUTHORITY",
        "rule": "Listener, route, endpoint, connection, channel, peer reachability and cryptographic transport evidence never by themselves grant application, data or operation authority."
      },
      {
        "id": "INGRESS_EFFECT_BOUNDARY",
        "rule": "Inbound network data remains inert until explicit protocol parsing, validation, identity/context resolution, authorization and dispatcher routing succeed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "disconnect means operation had no effect",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "reconnect reuses old connection identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "all inflight writes automatically retried",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "application session resumes blindly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "half-open state shown healthy",
        "result": "hard_fail"
      }
    ]
  },
