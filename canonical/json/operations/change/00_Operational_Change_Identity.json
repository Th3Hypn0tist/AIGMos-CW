  "semantics": {
    "identity_rule": "Each operational change has an explicit identity.",
    "type_rule": "Change type/category is explicit.",
    "target_rule": "Target environment/resources are exact.",
    "plan_rule": "Expected operations/steps are explicit.",
    "risk_rule": "Risk/impact classification is explicit.",
    "rollback_rule": "Rollback/recovery plan is explicit where applicable.",
    "schedule_rule": "Change window/timing is explicit where required.",
    "authority_rule": "Change record does not authorize execution by itself."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "ticket text used as target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "approved change executes automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "rollback omitted for destructive change",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "target wildcard unbounded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "change identity equals deployment execution",
        "result": "hard_fail"
      }
    ]
  },
