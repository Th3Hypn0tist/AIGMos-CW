    "identity_rule": "Each maintenance window has explicit identity.",
    "time_rule": "Start/end/timezone are explicit.",
    "scope_rule": "Eligible environments/services/change types are explicit.",
    "availability_rule": "Expected service impact/maintenance mode is explicit.",
    "authorization_rule": "Window eligibility does not replace AccessCore/change approval.",
    "expiry_rule": "Expired window cannot be reused.",
    "emergency_rule": "Emergency exceptions use separate explicit policy."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "maintenance window means admin mode",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "timezone guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "expired window accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "all services included implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "window bypasses approval",
        "result": "hard_fail"
      }
    ]
  },
