    "identity_rule": "Each approval decision has explicit evidence identity.",
    "change_rule": "Exact change identity/revision is referenced.",
    "reviewer_rule": "Approver/reviewer identity is explicit.",
    "decision_states": [
      "approved",
      "rejected",
      "conditional",
      "expired",
      "withdrawn"
    ],
    "condition_rule": "Conditional approval constraints are explicit.",
    "stale_rule": "Material change to plan/target/risk invalidates prior approval as configured.",
