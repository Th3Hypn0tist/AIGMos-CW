    "reason_rule": "Emergency justification/incident/finding ref is explicit.",
    "scope_rule": "Target and intended action are exact.",
    "gate_rule": "Only explicitly waivable process gates may be shortened; AccessCore/destructive/security integrity gates remain enforced.",
    "approval_rule": "Emergency authority/reviewer policy is explicit.",
    "audit_rule": "All actions/results are audited.",
    "review_rule": "Retrospective review/post-change validation is required by profile.",
    "authority_rule": "Emergency status never grants universal administrator authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "emergency bypasses AccessCore",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "critical incident means run arbitrary shell",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "scope omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "retrospective review skipped",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "emergency right remains forever",
        "result": "hard_fail"
      }
    ]
  },
