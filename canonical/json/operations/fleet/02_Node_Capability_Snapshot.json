  "semantics": {
    "identity_rule": "Each snapshot has explicit evidence identity.",
    "node_rule": "Snapshot belongs to exact node.",
    "capability_rule": "Observed capabilities/units are explicit.",
    "software_rule": "OS/runtime/driver/platform versions are explicit where material.",
    "time_rule": "Observation time is evidence and freshness is explicit.",
    "placement_rule": "Snapshot informs eligibility but does not authorize deployment.",
    "stale_rule": "Stale capability evidence may require refresh."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "old GPU inventory used forever",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "capability snapshot grants deployment authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "driver version omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "same node name merges snapshots",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "freshness inferred from file mtime",
        "result": "hard_fail"
      }
    ]
  },
