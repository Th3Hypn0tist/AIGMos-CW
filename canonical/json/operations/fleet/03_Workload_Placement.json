      {
        "id": "GATE_1",
        "condition": "scheduler picks nearest hostname",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "eligible means deployed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "requirements inferred from package size",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unknown capability treated sufficient",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "placement changes AccessCore rights",
        "result": "hard_fail"
      }
    ]
  },
