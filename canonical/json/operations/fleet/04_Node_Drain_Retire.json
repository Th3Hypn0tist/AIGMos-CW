  "semantics": {
    "node_rule": "Drain/retire targets exact node.",
    "admission_rule": "New workload placement is blocked during drain.",
    "service_rule": "Running services are explicitly migrated/stopped according to policy.",
    "data_rule": "Local state/data evacuation/retention is explicit.",
    "secret_rule": "Node-local credentials/secrets are revoked/removed according to policy.",
    "retire_rule": "Retired node remains historical identity evidence.",
    "authority_rule": "Node retirement does not delete domain data by implication."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "node disappears from inventory when powered off",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "drain deletes local data silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "services assumed migrated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "retired node credentials remain active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "same hostname reused as old identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_NODE",
