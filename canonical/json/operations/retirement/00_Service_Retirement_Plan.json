    "identity_rule": "Each retirement plan has explicit identity/revision.",
    "target_rule": "Exact service/module/environment target is explicit.",
    "dependency_rule": "Consumers/dependencies/integrations are explicitly enumerated.",
    "successor_rule": "Replacement/successor identity/migration path is explicit where applicable.",
    "traffic_rule": "Route/listener/endpoint removal plan is explicit.",
    "data_rule": "Data archive/export/migrate/purge obligations are explicit.",
    "secret_rule": "Credential/key revocation is explicit.",
    "inert_rule": "Plan definition performs no retirement."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "service removed before dependency analysis",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "data silently deleted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "successor inferred",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "retirement plan stops service on save",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "keys remain active",
        "result": "hard_fail"
      }
    ]
  },
