  "semantics": {
    "source_rule": "Retiring service identity is exact.",
    "dependency_rule": "Each dependent identity/relation is exact.",
    "migration_rule": "Replacement target/ref is explicit where moved.",
    "traffic_rule": "New dependency admission is blocked when drain begins.",
    "verification_rule": "No required live dependents remain before final shutdown unless explicitly waived.",
    "unknown_rule": "Unknown dependency state blocks final retirement under strict profile.",
    "authority_rule": "Drain does not grant access to dependent resources."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "unknown dependencies ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "route removed but jobs still call service",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "dependency selected by log frequency only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "drain grants downstream admin",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "migration target guessed",
        "result": "hard_fail"
      }
    ]
  },
