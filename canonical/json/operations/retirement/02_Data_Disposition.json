  "semantics": {
    "data_rule": "Each dataset/resource scope is exact.",
    "actions": [
      "retain",
      "archive",
      "export",
      "migrate",
      "anonymize",
      "purge",
      "transfer_ownership",
      "other declared action"
    ],
    "governance_rule": "Retention, hold, privacy, certification and contractual obligations remain enforced.",
    "ownership_rule": "Service retirement does not imply data ownership disappears.",
    "verification_rule": "Disposition result is verified and audited.",
    "destructive_rule": "Purge uses destructive gates and exact scope.",
    "authority_rule": "Retirement plan does not bypass data governance."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "retiring service deletes all data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "legal hold ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "data owner inferred as service process",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "purge wildcard unbounded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "archive considered public automatically",
        "result": "hard_fail"
      }
    ]
  },
