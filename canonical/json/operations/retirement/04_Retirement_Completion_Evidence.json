    "flows": []
  },
  "semantics": {
    "identity_rule": "Each retirement completion evaluation has explicit identity.",
    "plan_rule": "Exact retirement plan is referenced.",
    "checks": [
      "dependencies_drained",
      "traffic_removed",
      "service_stopped",
      "data_disposition_complete",
      "credentials_revoked",
      "registries_updated",
      "required_history_archived",
      "other declared check"
    ],
    "result_states": [
      "complete",
      "incomplete",
      "blocked",
      "partial",
      "unknown"
    ],
    "history_rule": "Retired logical identity remains historical, not deleted.",
    "reuse_rule": "Reusing a human-visible name later does not reuse retired canonical identity automatically.",
    "authority_rule": "Completion evidence grants no right to purge additional data."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "service identity deleted entirely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "same name reuses old id",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "incomplete shown complete",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "credential check skipped",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "retirement completion purges audit automatically",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_PLAN",
      "target_ref": "AIGMOS_SERVICE_RETIREMENT_PLAN_CONTRACT",
      "purpose": "Completion evaluates exact retirement plan."
    }
  ],
  "prose": {
    "summary": "Define completion evidence proving dependencies drained, traffic removed, data disposition complete, credentials revoked, service stopped and historical records preserved.",
