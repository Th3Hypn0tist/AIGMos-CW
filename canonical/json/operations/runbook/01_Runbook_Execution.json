    "identity_rule": "Each runbook execution has distinct identity.",
    "runbook_rule": "Exact runbook revision is referenced.",
    "actor_rule": "Operator/automation identity is explicit.",
    "step_rule": "Completed/skipped/failed step state is explicit.",
    "observation_rule": "Observations/evidence are explicit.",
    "operation_rule": "Effectful step creates exact Operation Request/deployment/change request.",
    "authority_rule": "Runbook session does not inherit author privileges."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "runbook author rights inherited by operator",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "step marked complete from time alone",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "free-form action bypasses dispatcher",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "session identity reused as runbook identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "skipped step hidden",
        "result": "hard_fail"
      }
    ]
  },
