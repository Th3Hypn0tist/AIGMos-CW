  "semantics": {
    "actor_rule": "Exact IdentityCore/IAM/service actor is explicit.",
    "session_rule": "Authentication/session/elevation refs are explicit.",
    "request_rule": "Change/runbook/operation request refs are explicit.",
    "auth_rule": "Authorization/reauth/break-glass decisions are explicit.",
    "execution_rule": "Exact dispatcher/execution/result identity is linked.",
    "shared_rule": "Shared anonymous administrative identities are prohibited for attributable operations unless an explicit legacy exception exists.",
    "audit_rule": "Attribution evidence is append/history governed."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "shared admin account treated attributable to all",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "operator inferred from workstation IP",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "break-glass use lacks actor",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "execution not linked to request",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "attribution overwritten",
        "result": "hard_fail"
      }
    ]
  },
