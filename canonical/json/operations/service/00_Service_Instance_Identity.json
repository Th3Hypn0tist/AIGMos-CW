  "semantics": {
    "identity_rule": "Each running service process/runtime instance has a distinct runtime identity.",
    "logical_rule": "Runtime instance references exact logical module/service instance.",
    "artifact_rule": "Loaded artifact/release revision is explicit.",
    "environment_rule": "Deployment environment identity is exact.",
    "process_rule": "OS process/container/socket identity is implementation metadata, not canonical logical identity.",
    "state_rule": "Running, ready, healthy and serving are distinct states.",
    "authority_rule": "Process ownership does not grant application authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "PID used as stable service identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "running means ready",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "runtime instance becomes module definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "same process user grants app rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "artifact revision omitted",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_RUNTIME",
      "target_ref": "AIGMOS_RUNTIME_ACTIVATION_CONTRACT",
      "purpose": "Activation creates exact runtime instances."
    }
  ],
