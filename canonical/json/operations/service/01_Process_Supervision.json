  "semantics": {
    "service_rule": "Supervisor manages exact logical service/runtime identity.",
    "restart_rule": "Restart policy/count/window/backoff are explicit.",
    "crash_rule": "Crash/failure reason/evidence is explicit.",
    "loop_rule": "Crash loops are bounded and surfaced.",
    "stop_rule": "Requested stop remains distinct from crash.",
    "authority_rule": "Supervisor lifecycle actions require exact operational authority.",
    "safety_rule": "Supervisor cannot silently weaken service security/config to make startup succeed."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_DEPLOYMENT_RUNTIME_SEPARATION",
        "rule": "Release candidate, accepted release, deployment plan, deployment execution, installed artifact, active runtime instance and observed health remain separate identities/states."
      },
      {
        "id": "OPERATIONS_FAIL_SAFE",
        "rule": "Operational convenience, availability pressure, maintenance state, automation, recovery or rollback never silently bypass validation, authorization, integrity, governance or dispatcher boundaries."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "infinite restart loop",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "crash shown manual stop",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "supervisor disables AccessCore on repeated failure",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "restart grants new rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "wrong service selected by process name similarity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SERVICE",
      "target_ref": "AIGMOS_SERVICE_INSTANCE_IDENTITY_CONTRACT",
      "purpose": "Supervision manages exact service identity."
