  "semantics": {
    "identity_rule": "Each Runner execution has a distinct execution identity.",
    "source_rule": "Source invocation/trigger/schedule/command refs are explicit.",
    "definition_rule": "Runner/Routine definition revision is exact.",
    "plan_rule": "Ordered step plan is materialized explicitly for the execution.",
    "context_rule": "Execution context snapshot is exact.",
    "state_rule": "Execution state is separate from definition state.",
    "authority_rule": "Instantiation does not bypass per-step operation authorization."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Runner definition reused as execution identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "plan changes silently mid-run",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "source invocation omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "context mutable globally",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "Runner skips auth",
        "result": "hard_fail"
      }
    ]
  },
