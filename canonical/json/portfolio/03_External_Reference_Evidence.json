        "condition": "unverified evidence displayed as verified machine state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "verification grants MeritCore points automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "issuer/source identity omitted where required",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "verification history overwritten silently",
        "result": "hard_fail"
      }
    ]
