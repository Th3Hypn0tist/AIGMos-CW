        "condition": "portfolio item becomes Project identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "portfolio owner inferred from uploader only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "item automatically grants competence",
        "result": "hard_fail"
      },
      {
