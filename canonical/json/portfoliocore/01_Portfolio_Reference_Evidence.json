    "identity_rule": "Each reference/attestation record has explicit identity.",
    "subject_rule": "Subject IdentityCore identity is exact.",
    "issuer_rule": "Issuer/reference source identity is explicit where known.",
    "project_rule": "Referenced Project/work evidence is exact where applicable.",
    "source_rule": "External URL/document/artifact metadata is explicit.",
    "verification_rule": "Verification/approval status is separate from existence.",
    "history_rule": "Reference corrections/revocations preserve history.",
    "authority_rule": "Reference evidence does not grant rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EVIDENCE_NONFABRICATION",
        "rule": "Identity, portfolio, merit, recommendation, trust and competence states derive only from explicit provenance-bearing evidence; display text, self-authored claims, ranking position or AI inference never become verified evidence by themselves."
      },
      {
        "id": "IDENTITY_ISOLATION",
        "rule": "Distinct canonical identities maintain independent evidence histories; merit, Tier, trust and recommendation histories are not mergeable across identities unless a future explicit canonical identity-merger contract exists."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "external URL means verified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "issuer omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "reference text treated MeritCore merit directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "revoked reference deleted silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "reference grants Project rights",
        "result": "hard_fail"
      }
    ]
  },
