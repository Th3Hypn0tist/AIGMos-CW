        "id": "GATE_1",
        "condition": "portfolio owns linked artifact",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "URL changes create new competence identity automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "link grants artifact access",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "project inferred from filename",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "private artifact exposed by public portfolio entry",
        "result": "hard_fail"
      }
