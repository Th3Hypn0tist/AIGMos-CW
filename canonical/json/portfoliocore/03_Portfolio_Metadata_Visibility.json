    "metadata_rule": "Descriptions/tags/categories are descriptive metadata.",
    "visibility_states": [
      "private",
      "restricted",
      "public"
    ],
    "publication_rule": "Publication state is explicit.",
    "verification_rule": "Public visibility does not imply verified competence.",
    "classification_rule": "Private/restricted metadata obeys source governance.",
    "ranking_rule": "Portfolio ordering/presentation is not competence ranking unless explicit projection says so.",
