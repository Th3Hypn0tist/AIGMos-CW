  "semantics": {
    "source_rule": "Project owns work definition/state/outcome and related evidence refs.",
    "merit_rule": "MeritCore consumes accepted Project evidence through explicit backend operation.",
    "no_calculation_rule": "Project does not calculate points, Tier, recommendations or trust.",
    "no_rewrite_rule": "MeritCore does not rewrite Project definition/history to fit scoring outcomes.",
    "atom_rule": "Time/evidence atoms passed to MeritCore preserve actual work distribution and cannot be multiplied by Project splitting.",
    "identity_rule": "Evidence retains participant identity, Project identity and provenance.",
    "public_rule": "Public Project ranking/projection may derive from Merit outcomes without creating a separate leaderboard primitive."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PROJECT_UNIVERSAL_PRIMITIVE",
        "rule": "Project is the universal recursive work primitive; task-like semantics are represented by Projects rather than parallel task entities."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Project calculates MeritCore points/Tier",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "MeritCore rewrites Project history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "splitting child Projects multiplies identical evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "evidence loses Project/identity provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "separate leaderboard primitive created where derived ranking suffices",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_MERIT",
      "target_ref": "AIGMOS_MERIT_RECORD_CONTRACT",
      "purpose": "MeritCore consumes explicit Project evidence."
    },
    {
      "id": "REF_ATOM",
      "target_ref": "AIGMOS_MERIT_TIME_ATOM_CONTRACT",
      "purpose": "Time evidence cannot multiply through splitting."
    }
  ],
  "prose": {
    "summary": "Define the explicit boundary from Project outcomes/participation evidence into MeritCore so Project itself never calculates merit and MeritCore never rewrites Project history.",
    "notes": [
      "Unlocked pending reconciliation against existing Project/FreeMarket/MeritCore contracts and whole-tree Contract Format 1.4 validation."
