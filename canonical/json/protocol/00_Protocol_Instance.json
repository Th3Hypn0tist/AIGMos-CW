        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "listener/protocol identity conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "runtime session becomes protocol instance identity",
        "result": "hard_fail"
      }
    ]
