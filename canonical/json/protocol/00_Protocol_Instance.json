    "identity_rule": "Each protocol instance has an explicit stable logical identity.",
    "type_rule": "Protocol type such as REST, OSC or WebSocket is explicit.",
    "listener_rule": "Protocol instance references an exact named listener instance.",
    "binding_rule": "Port/address/transport belong to the listener binding, not protocol semantic identity.",
    "route_rule": "Routes/addresses/channels are child protocol bindings and do not replace protocol instance identity.",
    "state_rule": "Configured/enabled/running/session states remain distinct.",
    "authority_rule": "Protocol exposure or reachability grants no domain-operation authority."
