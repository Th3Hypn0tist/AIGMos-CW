    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the hard boundary between model-generated text/structured proposals/tool requests and actual canonical AIGMos operations.",
  "scope": {
    "owns": [
      "Model Output to Operation Boundary semantics"
    ],
    "does_not_own": [
