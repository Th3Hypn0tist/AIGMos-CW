    {
      "id": "TOPIC_MODEL_OUTPUT_OPERATION_BOUNDARY",
      "name": "Model Output to Operation Boundary",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the hard boundary between model-generated text/structured proposals/tool requests and actual canonical AIGMos operations.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "output_rule": "Model output is inert data.",
    "request_rule": "A model may emit a structured candidate operation/tool request only according to an explicit request schema.",
    "resolve_rule": "Requested operation/target resolves exact canonical identities.",
    "validation_rule": "Arguments, schema, capability, bounds and semantic constraints validate before dispatch.",
    "authorization_rule": "Caller/session AccessCore and assurance requirements are evaluated independently from model recommendation.",
    "dispatch_rule": "Only the normal governed runtime dispatcher can produce effects.",
    "failure_rule": "Invalid/unresolved/unauthorized model request remains inert and yields structured failure.",
    "chain_rule": "Model output cannot recursively execute subsequent output without each effect crossing the same boundary."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MODEL_OUTPUT_NONAUTHORITY",
        "rule": "q/qc/qt model execution produces inert candidate data; models may request or propose operations but only AIGMos canonical validation, authorization and dispatch can create effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "model text executed as shell/command directly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "tool request bypasses schema validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "model recommendation grants authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unresolved request guessed to nearest operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "recursive model/tool loop bypasses dispatch boundary",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DISPATCH",
      "target_ref": "AIGMOS_RUNTIME_DISPATCHER_BOUNDARY_CONTRACT",
      "purpose": "All model-requested effects use normal dispatch."
    },
    {
      "id": "REF_AC",
      "target_ref": "AIGMOS_ACCESSCORE_ASSURANCE_GATED_RESOURCE_CONTRACT",
      "purpose": "Model requests obey caller authorization/assurance."
    }
  ],
  "prose": {
    "summary": "Define the hard boundary between model-generated text/structured proposals/tool requests and actual canonical AIGMos operations.",
    "notes": [
      "Unlocked pending reconciliation against q-family, command runtime, memory and Studio/QC contracts."
    ]
  },
