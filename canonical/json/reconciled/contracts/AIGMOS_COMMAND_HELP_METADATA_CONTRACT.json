          "status": "unlocked",
          "value": {
            "authority_rule": "Reconciled source clauses: [1] Help visibility grants no invocation authority. [2] Help metadata describes commands but cannot create capability or authority.",
            "command_rule": "Each concrete subcommand carries its own short and long help.",
            "duplication_rule": "Reconciled source clauses: [1] A separate manually duplicated help command hierarchy is not required. [2] No separately maintained duplicate help hierarchy is required.",
            "enumeration_rule": "Help system recursively enumerates the command tree from canonical command metadata.",
            "family_rule": "Reconciled source clauses: [1] Command-family root may carry master help/metadata while remaining non-executable. [2] Command family roots may carry master help/metadata describing the namespace even when non-executable.",
            "fields": [
              "short",
              "long"
            ],
            "localization_rule": "Internal command names remain English/ASCII; human descriptions may be localized by UI projection.",
            "long_rule": "Reconciled source clauses: [1] Each concrete command carries detailed `long` help. [2] long provides detailed command-specific help.",
            "recursive_rule": "Help listings are generated recursively from the command tree.",
            "short_rule": "Reconciled source clauses: [1] Each concrete command carries concise `short` help. [2] short is suitable for recursive concise listings."
