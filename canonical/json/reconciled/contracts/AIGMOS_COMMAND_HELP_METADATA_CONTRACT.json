  },
  "status": "unlocked",
  "purpose": "Reconciled source purposes: [1] Define recursive help metadata with per-family master help and per-concrete-command short/long descriptions without maintaining a duplicated separate help tree. [2] Define recursive command help metadata so every command family and concrete subcommand can expose machine-readable short and long help without maintaining a separate duplicated help tree.",
  "scope": {
    "does_not_own": [
      "AccessCore policy ownership",
      "domain semantic ownership",
      "implementation-specific process scheduling",
      "backend provider implementation",
      "UI presentation",
      "unrelated runtime authority"
    ],
    "owns": [
      "Command Help Metadata semantics"
    ]
  },
