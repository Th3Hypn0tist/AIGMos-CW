  "semantics": {
    "authority_rule": "Dispatcher evaluates required capability/AccessCore/assurance policy before effects.",
    "binding_rule": "Dispatcher resolves exact operation→implementation binding.",
    "bound_rule": "Timeout/retry/concurrency/resource bounds are attached before execution.",
    "bypass_rule": "Reconciled source clauses: [1] Model/tool/payload/UI cannot directly execute effects around the dispatcher. [2] Tool, Routine, Trigger, Runner, UI, projection or model output may not bypass the dispatcher boundary.",
    "cleanup_rule": "Reconciled source clauses: [1] Success/error/timeout/cancel converge on explicit cleanup. [2] Runtime slots/gates/resources are released on success, error, timeout and cancel.",
    "default_rule": "Definitions and values are inert until explicit dispatch.",
    "effect_rule": "All side effects cross this boundary or another explicitly equivalent canonical execution boundary.",
    "execution_owner": "Core/runtime dispatch helpers",
    "execution_rule": "Concrete execution gets a new execution identity.",
    "failure_rule": "Unresolved implementation/binding hard-fails.",
    "flow": [
      "receive validated request",
      "verify authorization decision",
      "verify current operation/target binding",
      "create execution identity",
      "dispatch to exact implementation/backend",
      "record dispatch evidence"
    ],
    "identity_rule": "Caller/session identity context is explicit.",
    "input_rule": "Dispatcher accepts only a resolved canonical operation/command identity plus validated inputs/context.",
    "model_rule": "Model output cannot directly call implementation code outside the dispatcher path.",
    "recheck_rule": "Critical stale validation/authorization evidence may require re-evaluation before dispatch.",
    "result_rule": "Returned result is inert data unless another explicit operation consumes it.",
    "shell_rule": "Arbitrary shell/string execution is not a baseline dispatcher capability.",
    "single_boundary_rule": "Effect-capable runtime execution crosses this dispatcher boundary.",
    "tool_rule": "Tool/MCP results cannot directly trigger hidden secondary effects.",
    "validation_order": [
      "resolve target",
      "validate inputs",
      "validate capability",
      "validate authority",
      "validate effects",
      "acquire applicable runtime gate/resource",
      "execute bounded operation",
      "cleanup",
      "return structured result"
    ]
  },
