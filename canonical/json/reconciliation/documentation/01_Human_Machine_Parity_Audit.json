        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "summary overrides owner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "human docs ignored completely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "LLM rewrites structured semantics from prose automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "contradiction silently tolerated",
        "result": "hard_fail"
      }
    ]
  },
