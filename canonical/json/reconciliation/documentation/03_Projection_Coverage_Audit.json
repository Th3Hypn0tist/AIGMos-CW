    "source_rule": "Accepted/candidate canonical graph snapshot is exact.",
    "projection_rule": "Required projection profiles are exact.",
    "coverage_rule": "Contracts/topics/relations/ownership/operations expected in each projection are enumerated.",
    "loss_rule": "Projection omissions/truncations are explicit findings.",
    "authority_rule": "Projection incompleteness never changes source semantics.",
    "repair_rule": "Repair regenerates/extends projection, not canonical source from projection."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "missing UML edge changes source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "projection considered authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "loss hidden because visual looks nice",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "generated docs replace JSON",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "coverage inferred by file count only",
        "result": "hard_fail"
      }
    ]
  },
