  "semantics": {
    "identity_rule": "Each finalization plan has explicit identity/revision.",
    "snapshot_rule": "Exact source snapshot/base is referenced.",
    "patch_rule": "Exact accepted candidate reconciliation patches are enumerated.",
    "validation_rule": "Required final validation/conformance profiles are explicit.",
    "projection_rule": "Required generated projection rebuilds are explicit.",
    "lock_rule": "Lock batch plan(s) are explicit.",
    "atomic_rule": "Finalization phases and commit boundaries are explicit.",
    "inert_rule": "Plan creation performs no repository mutation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "plan applies itself",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "source snapshot omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "projection rebuild before source commit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "lock batch inferred",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "validation skipped",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ACCEPT",
      "target_ref": "AIGMOS_CANONICAL_CHANGE_ACCEPTANCE_CONTRACT",
      "purpose": "Finalization uses canonical atomic change acceptance."
    }
  ],
  "prose": {
    "summary": "Define exact inert plan for applying resolved reconciliation changes, running final validation/conformance, rebuilding projections and executing lock batches.",
    "notes": [
      "Unlocked pending application to the final merged review tree.",
      "This contract defines reconciliation semantics; it does not claim that repository-wide reconciliation has already passed."
    ]
  },
