        "id": "GATE_1",
        "condition": "uses pre-reconciliation validation result",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "bootstrap not rerun",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "source changed after pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "partial treated pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "pass deploys runtime",
        "result": "hard_fail"
      }
    ]
  },
