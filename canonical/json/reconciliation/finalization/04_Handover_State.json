  "semantics": {
    "identity_rule": "Each handover state has explicit identity.",
    "source_rule": "Exact accepted repository source snapshot is referenced.",
    "bootstrap_rule": "Root Contract Format identity/hash is explicit.",
    "status_rule": "Locked/unlocked/blocked contract and closure counts/refs are explicit.",
    "exception_rule": "Active bounded exceptions are explicit.",
    "projection_rule": "Generated projection/report refs/hashes are explicit.",
    "next_rule": "Known next work items are explicit without pretending unresolved work is complete.",
    "authority_rule": "Handover document is evidence/projection, not canonical semantic owner."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "handover says complete while blockers exist",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unlocked contracts omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "bootstrap omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "projection becomes source truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "next work hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define machine-readable handover snapshot after finalization containing bootstrap identity, source snapshot, locked/unlocked inventory, blockers/exceptions, projection hashes and next operational/development entry points.",
    "notes": [
      "Unlocked pending application to the final merged review tree.",
      "This contract defines reconciliation semantics; it does not claim that repository-wide reconciliation has already passed."
    ]
  },
