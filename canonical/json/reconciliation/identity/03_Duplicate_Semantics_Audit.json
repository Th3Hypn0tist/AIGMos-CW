  "semantics": {
    "candidate_rule": "Potential duplicates are findings based on exact owned scopes, primitives, operations and prose evidence.",
    "automatic_rule": "Semantic similarity never automatically merges identities.",
    "ownership_rule": "Overlapping ownership is a strong blocking signal.",
    "review_rule": "Reviewer decides consolidate, differentiate, deprecate or retain distinct semantics.",
    "reference_rule": "Consolidation requires explicit reference migration.",
    "history_rule": "Deprecated duplicate identities remain historical."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "LLM similarity merges contracts automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "same name means duplicate",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "different name means distinct automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "duplicate ownership ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "consolidation deletes history",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define detection of different canonical identities that appear to define the same semantic responsibility, requiring explicit consolidation or differentiation review rather than automatic deduplication.",
    "notes": [
      "Unlocked pending application to the final merged review tree.",
      "This contract defines reconciliation semantics; it does not claim that repository-wide reconciliation has already passed."
