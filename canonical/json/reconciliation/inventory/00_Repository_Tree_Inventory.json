  "semantics": {
    "identity_rule": "Each inventory run has explicit identity.",
    "path_rule": "Every discovered file path is recorded exactly.",
    "hash_rule": "Exact byte hash/profile is recorded where feasible.",
    "type_rule": "File media/semantic type classification is explicit.",
    "role_rule": "bootstrap/definition/candidate/history/generated/evidence/runtime/unclassified role is explicit.",
    "participation_rule": "Whether a file participates in active canonical graph is explicit.",
    "unknown_rule": "Unclassified machine-significant files remain findings rather than being guessed.",
    "order_rule": "Filesystem discovery order is non-semantic."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "unknown file silently ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "mtime used as authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "generated file treated definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "duplicate path collision hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "inventory run mutates files",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SOURCE",
      "target_ref": "AIGMOS_ACTIVE_CANONICAL_SOURCE_SET_CONTRACT",
      "purpose": "Inventory feeds exact active source-set construction."
    }
  ],
  "prose": {
    "summary": "Define deterministic inventory of every file/artifact in the reconciliation tree with exact path, hash, media/type, source role and canonical participation state.",
    "notes": [
      "Unlocked pending application to the final merged review tree.",
      "This contract defines reconciliation semantics; it does not claim that repository-wide reconciliation has already passed."
    ]
  },
