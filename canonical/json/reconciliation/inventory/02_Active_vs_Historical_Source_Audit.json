  "semantics": {
    "active_rule": "Every active canonical identity has exact current source definition.",
    "history_rule": "Historical sources are enumerated separately.",
    "superseded_rule": "Superseded/deprecated definitions retain explicit replacement/history metadata.",
    "duplicate_rule": "Same canonical identity in active and history is valid only when history is excluded from active resolution.",
    "projection_rule": "Generated copies carrying canonical-like JSON do not participate unless explicitly definition-role accepted.",
    "finding_rule": "Any competing active source produces hard reconciliation finding."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "historical copy wins by newer mtime",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "generated copy participates",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "superseded source remains active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "history exclusion inferred only from folder color",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "duplicate active source ignored",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define audit that no historical, deprecated, generated or superseded artifact competes with active canonical definitions.",
    "notes": [
