  "semantics": {
    "orphan_rule": "Orphan means a file has no declared canonical role, reference, generator relation or intentional repository purpose.",
    "candidate_rule": "Orphan status is a finding, not automatic deletion.",
    "history_rule": "Historical artifacts may be intentionally retained through explicit classification.",
    "tooling_rule": "Scripts/tools may be retained when their repository role is explicit.",
    "cleanup_rule": "Delete/move/archive action is separately reviewed.",
    "authority_rule": "Orphan detection does not authorize destructive cleanup."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "orphan detector deletes automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unreferenced means useless",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "tool script treated canonical definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "history considered orphan",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cleanup wildcard broad",
        "result": "hard_fail"
      }
    ]
  },
  "references": [],
  "prose": {
    "summary": "Define reconciliation of files that are not referenced, classified, generated by a declared toolchain step or intentionally retained as history/documentation.",
    "notes": [
      "Unlocked pending application to the final merged review tree.",
      "This contract defines reconciliation semantics; it does not claim that repository-wide reconciliation has already passed."
    ]
  },
