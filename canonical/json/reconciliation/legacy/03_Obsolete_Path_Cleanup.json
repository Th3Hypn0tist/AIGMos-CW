  "semantics": {
    "source_rule": "Obsolete path and contained artifacts are enumerated.",
    "target_rule": "New canonical path/layout mapping is explicit.",
    "identity_rule": "Semantic identity remains unchanged when move is purely organizational.",
    "breaking_rule": "If move accompanies semantic change, semantic migration is separately modeled.",
    "reference_rule": "Path-based tooling/config references are explicitly updated.",
    "history_rule": "Original layout may be documented in history/migration evidence."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "path move changes IDs automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "old and new active duplicates coexist",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "tooling path refs forgotten",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "move hides breaking semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cleanup inferred from git status only",
        "result": "hard_fail"
      }
    ]
  },
