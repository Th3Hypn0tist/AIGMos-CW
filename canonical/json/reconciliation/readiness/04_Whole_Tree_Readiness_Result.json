      },
      {
        "id": "GATE_2",
        "condition": "conditional shown ready",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "blockers omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "runtime considered validated by docs only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "snapshot omitted",
        "result": "hard_fail"
      }
    ]
  },
