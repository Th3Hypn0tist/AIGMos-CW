  "semantics": {
    "graph_rule": "Each acyclic containment graph type is explicit.",
    "edge_rule": "Cycle participants/edges are exact.",
    "cycle_rule": "Forbidden cycle blocks closure/readiness.",
    "relation_rule": "General semantic relations are not mistaken for containment.",
    "resolution_rule": "Edge reclassification/removal/reparenting is explicit candidate change.",
    "history_rule": "Resolved cycle evidence remains traceable."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RECONCILIATION_IS_EVIDENCE_DRIVEN",
        "rule": "Whole-tree reconciliation operates only on exact accepted/candidate source snapshots, identities, references and declared semantics; it never repairs ambiguity through filename, path order, timestamp, nearest-name or UI layout heuristics."
      },
      {
        "id": "NO_SILENT_FINALIZATION",
        "rule": "A contract, closure set or repository remains unlocked/not-ready until all required reconciliation findings for its declared readiness profile are explicitly resolved or accepted through an explicit bounded exception."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "cycle broken by arbitrary edge removal",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "relation edge treated containment",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "tree UI hides cycle",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "latest parent wins",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cycle ignored because rendering succeeds",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CONT",
      "target_ref": "AIGMOS_CONTAINMENT_RELATION_SEPARATION_CONTRACT",
      "purpose": "Containment remains distinct from general relations."
    }
  ],
  "prose": {
    "summary": "Define exact detection/resolution of forbidden cycles in page, Project, topic, namespace, ownership or other acyclic containment graphs.",
    "notes": [
      "Unlocked pending application to the final merged review tree.",
      "This contract defines reconciliation semantics; it does not claim that repository-wide reconciliation has already passed."
    ]
  },
