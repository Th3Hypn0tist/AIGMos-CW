    "identity_rule": "Every machine-significant relation has an explicit stable identity.",
    "endpoint_rule": "Source and target endpoints resolve by exact canonical identity.",
    "direction_rule": "Directed/undirected semantics are explicit.",
    "role_rule": "Endpoint roles/names are explicit where machine-significant.",
    "type_rule": "Relation kind/semantics are explicit and separate from containment, ownership, authority and dependency unless the relation specifically represents one of those dimensions.",
