  "semantics": {
    "containment_rule": "Containment uses explicit parent/child semantics.",
    "relation_rule": "General relations remain separate typed edges.",
    "ownership_rule": "Containment does not automatically imply semantic ownership unless declared.",
    "cycle_rule": "Containment cycles are invalid for tree/acyclic profiles.",
    "projection_rule": "UI tree projection uses containment only unless a view explicitly chooses another relation.",
    "authority_rule": "Parent containment does not automatically grant AccessCore rights to child."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMPOSITION_NONOWNERSHIP",
        "rule": "Composition never silently transfers semantic ownership: universal modules own their primitives, domains own their composition semantics, and composed members retain their own identities and contracts."
      },
      {
        "id": "EXPLICIT_STRUCTURE",
        "rule": "Containment, relation, dependency, composition and projection edges exist only through explicit typed references; naming, file hierarchy, UI adjacency or shared values never create semantic structure."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "all relations shown as containment",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "parent automatically owns child",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "tree path grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "relation edge becomes parent by layout",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cycle accepted",
        "result": "hard_fail"
      }
    ]
  },
