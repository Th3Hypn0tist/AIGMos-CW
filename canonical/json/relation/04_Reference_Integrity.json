    "resolve_rule": "Each required ref resolves to one exact accepted identity.",
    "type_rule": "Referenced identity type/kind compatibility is validated.",
    "dangling_rule": "Dangling required refs hard-fail validation.",
    "optional_rule": "Optional refs may be absent only when contract explicitly allows it.",
    "alias_rule": "Aliases resolve through explicit registry semantics.",
    "cycle_rule": "Cycle restrictions are validated where applicable.",
    "order_rule": "Resolution never depends on load order."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMPOSITION_NONOWNERSHIP",
        "rule": "Composition never silently transfers semantic ownership: universal modules own their primitives, domains own their composition semantics, and composed members retain their own identities and contracts."
      },
      {
        "id": "EXPLICIT_STRUCTURE",
        "rule": "Containment, relation, dependency, composition and projection edges exist only through explicit typed references; naming, file hierarchy, UI adjacency or shared values never create semantic structure."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "dangling ref ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "ambiguous alias chooses first",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "wrong identity type accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "load order resolves collision",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "optional status inferred",
        "result": "hard_fail"
      }
    ]
  },
