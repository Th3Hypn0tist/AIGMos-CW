  "semantics": {
    "target_rule": "Rollback target is an exact previously accepted snapshot/release identity.",
    "atomic_rule": "Rollback activates a coherent snapshot according to repository replacement policy.",
    "hybrid_rule": "Rollback must not leave mixed active definitions from incompatible snapshots.",
    "evidence_rule": "Rollback target retains its original validation evidence; environment/runtime compatibility may require fresh activation checks.",
    "audit_rule": "Rollback action records source release, target release/snapshot, authority and reason.",
    "forward_rule": "Subsequent fixes create a new candidate snapshot rather than mutating the rolled-back accepted snapshot."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RELEASE_TRACEABILITY",
        "rule": "Release, replacement, rollback, deprecation and compatibility decisions remain explicit, snapshot-bound and traceable; no lifecycle label silently changes canonical semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "rollback target unresolved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "rollback creates hybrid active tree",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "accepted historical snapshot mutated during rollback",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "rollback lacks audit/authority trace",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "old evidence falsely claimed to validate changed snapshot",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REPLACE",
      "target_ref": "AIGMOS_CANONICAL_CLEAN_TREE_REPLACEMENT_CONTRACT",
      "purpose": "Rollback uses coherent tree replacement semantics."
    }
  ],
  "prose": {
    "summary": "Define rollback as explicit restoration/activation of a previously accepted immutable snapshot, preserving evidence and never synthesizing a hybrid tree from old and new active sources.",
