      "status",
      "format_version",
      "provenance"
    ],
    "identity_rule": "Source artifact identity and canonical semantic identity are distinct.",
    "location_rule": "Filesystem path, archive member or remote locator is a physical binding.",
    "role_rule": "Every machine-significant source artifact declares/resolves an explicit source role.",
    "duplicate_rule": "Multiple physical artifacts may reference the same semantic identity only if source-role/precedence/reconciliation rules make the authoritative interpretation unambiguous.",
    "active_rule": "Active accepted definition sources are distinguishable from candidate, generated, historical and reconciliation sources.",
    "reader_rule": "Generic source readers can build the source set from the registry/manifest rather than filesystem naming heuristics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SOURCE_RESOLUTION_DETERMINISTIC",
        "rule": "Canonical source resolution is deterministic, exact-identity based and provenance-preserving; filesystem location, transport or freshness never silently changes semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "source artifact has no source role",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "physical path used as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "same semantic identity has ambiguous competing active definitions",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "historical/generated source treated as active definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "reader requires undocumented filename heuristic",
        "result": "hard_fail"
      }
    ]
  },
