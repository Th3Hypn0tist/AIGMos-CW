    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define semantic equivalence requirements so reading the same accepted snapshot from a local repository tree or distribution package yields the same normalized canonical graph.",
  "scope": {
    "owns": [
      "Local and Package Source Equivalence semantics"
    ],
    "does_not_own": [
      "Contract Format bootstrap semantics",
      "canonical contract domain semantics",
      "runtime business authority"
    ]
  },
