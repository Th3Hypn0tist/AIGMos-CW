    {
      "id": "TOPIC_LOCAL_PACKAGE_SOURCE_EQUIVALENCE",
      "name": "Local and Package Source Equivalence",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define semantic equivalence requirements so reading the same accepted snapshot from a local repository tree or distribution package yields the same normalized canonical graph.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
