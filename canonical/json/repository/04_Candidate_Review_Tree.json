        "condition": "accepted source mutated in-place during review",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "candidate lacks reproducible source provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "candidate activation occurs before acceptance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "candidate validation performed on incomplete/partial tree without declared partial profile",
        "result": "hard_fail"
      }
