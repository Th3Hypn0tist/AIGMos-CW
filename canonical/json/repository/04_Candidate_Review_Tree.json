    "identity_rule": "Candidate tree/snapshot has an explicit review identity.",
    "source_rule": "Candidate tree is built from explicit source artifacts/patches/reconciliation outcomes.",
    "separation_rule": "Candidate tree is not the accepted canonical source until explicit acceptance.",
    "completeness_rule": "Candidate must be structurally complete enough to run all mandatory repository validations.",
    "mutation_rule": "Source accepted tree is not modified in place while building/reviewing candidate.",
    "manifest_rule": "Candidate carries source/migration/patch provenance sufficient to reproduce it.",
    "runtime_rule": "Candidate existence does not automatically activate runtime configuration."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCEPTANCE_EXPLICIT",
        "rule": "Candidate canonical trees become accepted/locked only through explicit reproducible validation and clean replacement; review state, acceptance state and runtime activation remain distinct."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "candidate tree treated as accepted automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "accepted source mutated in-place during review",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "candidate lacks reproducible source provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "candidate activation occurs before acceptance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "candidate validation performed on incomplete/partial tree without declared partial profile",
        "result": "hard_fail"
      }
    ]
  },
