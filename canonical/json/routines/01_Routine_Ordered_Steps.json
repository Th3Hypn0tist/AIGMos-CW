    "step_rule": "Every step has an explicit step identity within the Routine definition.",
    "target_types": [
      "command",
      "operation",
      "routine",
      "condition",
      "branch",
      "wait",
      "explicit control primitive"
    ],
    "target_rule": "Executable step targets resolve exact canonical identities.",
    "order_rule": "Sequential order is explicit semantic data and never inferred only from JSON array position unless the field contract explicitly defines that array as ordered.",
    "dependency_rule": "Nonlinear step dependencies are explicit.",
    "input_rule": "Step input bindings are explicit.",
    "output_rule": "Named outputs/references available to later steps are explicit.",
    "side_effect_rule": "Side effects belong to the invoked operation, not to Routine text itself."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ROUTINE_DEFINITION_EXPLICIT",
        "rule": "Routine definitions are explicit canonical ordered compositions of exact commands/operations/routines; runtime execution state is never embedded into the reusable definition."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "step target fuzzy/unresolved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "execution order inferred accidentally from serialization order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "implicit dependency exists only in prose",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Routine text itself executes arbitrary payload",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "step output consumed without explicit binding",
        "result": "hard_fail"
      }
    ]
  },
