      {
        "id": "GATE_1",
        "condition": "profile inferred from branch",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "missing rule ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "severity guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unknown rule passes",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "profile grants authority",
        "result": "hard_fail"
      }
    ]
