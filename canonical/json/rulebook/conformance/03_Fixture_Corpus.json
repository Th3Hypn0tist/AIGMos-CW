        "condition": "rule id omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "only happy path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "invalid fixture mutates repo",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "fixture selected newest",
        "result": "hard_fail"
      }
    ]
  },
