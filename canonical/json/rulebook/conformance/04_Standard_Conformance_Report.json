  "semantics": {
    "identity_rule": "Each report exact id.",
    "snapshot_rule": "Exact bootstrap/source snapshot.",
    "profile_rule": "Exact conformance profile.",
    "counts_rule": "Pass/fail/not-applicable/unknown/error counts exact.",
    "finding_rule": "Blocking/advisory refs exact.",
    "coverage_rule": "Executed/skipped rule ids explicit.",
    "result_states": [
      "pass",
      "fail",
      "partial",
      "error"
    ],
    "authority_rule": "Pass does not lock/deploy."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RULE_EVALUATION_EXPLICIT",
        "rule": "Every conformance rule has exact identity, scope, inputs, predicate/evaluation semantics, severity/blocking behavior and finding representation."
      },
      {
        "id": "NO_HEURISTIC_CONFORMANCE",
        "rule": "Conformance rules never rely on newest-wins, mtime, filename similarity, path proximity, UI layout, fuzzy identity matching or undocumented implementation defaults."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "skipped rules omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unknown counted pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "snapshot omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "pass auto-locks",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "blocking findings hidden",
        "result": "hard_fail"
      }
    ]
  },
