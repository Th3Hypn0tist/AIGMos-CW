  "semantics": {
    "input_rule": "Exact target/profile/evidence.",
    "result_states": [
      "pass",
      "fail",
      "not_applicable",
      "unknown",
      "error"
    ],
    "finding_rule": "Fail references invariant/target.",
    "profile_rule": "Blocking impact explicit.",
    "history_rule": "Evaluation evidence immutable.",
    "authority_rule": "Pass does not lock automatically."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RULE_EVALUATION_EXPLICIT",
        "rule": "Every conformance rule has exact identity, scope, inputs, predicate/evaluation semantics, severity/blocking behavior and finding representation."
      },
      {
        "id": "NO_HEURISTIC_CONFORMANCE",
        "rule": "Conformance rules never rely on newest-wins, mtime, filename similarity, path proximity, UI layout, fuzzy identity matching or undocumented implementation defaults."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "invariant failure logged only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "evaluation reused across revision",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "unknown pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "pass locks",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "finding lacks rule id",
        "result": "hard_fail"
      }
    ]
  },
