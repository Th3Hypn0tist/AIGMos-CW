    "exact_rule": "Identity strings validate against active id syntax profile.",
    "ascii_rule": "Internal identifiers remain compatible with declared canonical identifier profile.",
    "path_rule": "Path/filename never substitutes id.",
    "label_rule": "Human name never substitutes id.",
    "normalization_rule": "No hidden case/Unicode normalization unless profile declares it."
  },
