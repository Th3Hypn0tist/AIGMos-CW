  "semantics": {
    "composition_rule": "Composition does not transfer primitive ownership.",
    "domain_rule": "Domain owns composition/domain rules, not substrate semantics.",
    "topic_rule": "Topic never owns members.",
    "placement_rule": "nanoCMS/Editor placement does not own MetaModule semantics.",
    "reference_rule": "Referencing does not own target."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RULE_EVALUATION_EXPLICIT",
        "rule": "Every conformance rule has exact identity, scope, inputs, predicate/evaluation semantics, severity/blocking behavior and finding representation."
      },
      {
        "id": "NO_HEURISTIC_CONFORMANCE",
        "rule": "Conformance rules never rely on newest-wins, mtime, filename similarity, path proximity, UI layout, fuzzy identity matching or undocumented implementation defaults."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "domain steals substrate owner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Topic owns members",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "CMS placement owns module semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reference grants ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "consumer becomes owner",
        "result": "hard_fail"
      }
    ]
  },
