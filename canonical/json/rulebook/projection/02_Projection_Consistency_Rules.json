    "source_rule": "Projection source snapshot exact.",
    "generator_rule": "Generator/profile version exact.",
    "coverage_rule": "Required semantic elements present.",
    "stale_rule": "Mismatch/source change marks stale/divergent.",
    "repair_rule": "Regenerate projection only.",
    "authority_rule": "Projection never source."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RULE_EVALUATION_EXPLICIT",
        "rule": "Every conformance rule has exact identity, scope, inputs, predicate/evaluation semantics, severity/blocking behavior and finding representation."
      },
      {
        "id": "NO_HEURISTIC_CONFORMANCE",
        "rule": "Conformance rules never rely on newest-wins, mtime, filename similarity, path proximity, UI layout, fuzzy identity matching or undocumented implementation defaults."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "source edited to match UML",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "snapshot omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "stale accepted by mtime",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "missing edge ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "projection source truth",
        "result": "hard_fail"
      }
    ]
  },
