      {
        "id": "GATE_1",
        "condition": "all cycles rejected",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "all cycles accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "cycle broken arbitrarily",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "graph kind ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "render success means no cycle",
        "result": "hard_fail"
      }
    ]
  },
