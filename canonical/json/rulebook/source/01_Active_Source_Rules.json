      },
      {
        "id": "NO_HEURISTIC_CONFORMANCE",
        "rule": "Conformance rules never rely on newest-wins, mtime, filename similarity, path proximity, UI layout, fuzzy identity matching or undocumented implementation defaults."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "history active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "generated active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "source role ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "duplicate last-wins",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "bootstrap mixed into active definitions",
        "result": "hard_fail"
      }
    ]
  },
