  "semantics": {
    "identity_rule": "Multiple active definitions claiming same incompatible id block.",
    "path_rule": "Same logical file via symlink/duplicate path handled explicitly.",
    "byte_rule": "Byte-identical duplicates still require explicit source classification to avoid ambiguity.",
    "winner_rule": "No newest/first/path-depth winner.",
    "history_rule": "Properly excluded history not a competing active source."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RULE_EVALUATION_EXPLICIT",
        "rule": "Every conformance rule has exact identity, scope, inputs, predicate/evaluation semantics, severity/blocking behavior and finding representation."
      },
      {
        "id": "NO_HEURISTIC_CONFORMANCE",
        "rule": "Conformance rules never rely on newest-wins, mtime, filename similarity, path proximity, UI layout, fuzzy identity matching or undocumented implementation defaults."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "duplicate newest wins",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "byte-identical duplicate ignored without classification",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "symlink double-load",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "path depth priority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "first loaded wins",
        "result": "hard_fail"
      }
    ]
  },
