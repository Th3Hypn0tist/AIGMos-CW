        "condition": "Topic coverage means semantic completeness",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "root guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "projection edits source",
