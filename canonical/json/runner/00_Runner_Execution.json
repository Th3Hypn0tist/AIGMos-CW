  "semantics": {
    "identity_rule": "Each run has a unique runtime runner/execution identity.",
    "definition_rule": "Runner references the exact Routine definition/version/snapshot being executed.",
    "states": [
      "created",
      "ready",
      "running",
      "waiting",
      "completed",
      "failed",
      "cancelled",
      "timed_out"
    ],
    "step_rule": "Current/completed step state is explicit runtime state.",
    "caller_rule": "Caller/session identity context is retained.",
    "bound_rule": "Runner has finite timeout/resource/concurrency bounds according to policy.",
    "result_rule": "Runner result is inert data plus execution provenance.",
    "cleanup_rule": "All terminal states converge on deterministic cleanup."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ROUTINE_RUNNER_EXPLICIT",
        "rule": "Routine definitions and runner executions are separate canonical identities; runners execute explicit ordered routine content through the normal governed dispatch boundary."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "two runs share ambiguous runtime identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "routine definition mutates implicitly during active run",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "runner lacks caller context",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unbounded runner execution",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "terminal state skips cleanup",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "result auto-executes another action",
        "result": "hard_fail"
      }
    ]
  },
