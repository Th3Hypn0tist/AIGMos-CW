  "semantics": {
    "family": "run",
    "members": [
      "run",
      "run.go",
      "run.status",
      "cycle"
    ],
    "namespace_rule": "Family/member identities follow the recursive command namespace contract.",
    "run_rule": "Concrete run invocation resolves an exact Routine/runner target and creates or advances explicit execution state according to command semantics.",
    "go_rule": "`run.go` advances/starts the explicitly targeted runner according to its state machine.",
    "status_rule": "`run.status` is read-only projection of exact runner identity/state.",
    "cycle_rule": "Cycle behavior is explicit bounded runner policy, not implicit infinite looping.",
    "authority_rule": "Each concrete command is independently authorized.",
    "help_rule": "Family root may carry master help without becoming executable unless explicitly declared."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ROUTINE_RUNNER_EXPLICIT",
        "rule": "Routine definitions and runner executions are separate canonical identities; runners execute explicit ordered routine content through the normal governed dispatch boundary."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "family root executes implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "run.status mutates runner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "cycle defaults to unbounded infinite loop",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "subcommand authority inherited implicitly without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "runner target inferred by last-used hidden state",
        "result": "hard_fail"
      }
    ]
  },
