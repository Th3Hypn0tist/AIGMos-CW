  "semantics": {
    "resolve_rule": "Step resolves exact command/operation identity and argument schema.",
    "dispatch_rule": "Effectful step invokes the normal runtime dispatcher.",
    "authority_rule": "Authorization/assurance is evaluated for the actual step operation; Routine approval does not silently grant all contained rights.",
    "result_rule": "Step result is stored as inert runner data unless an explicit later step consumes a declared value.",
    "failure_rule": "Step failure follows explicit stop/continue/retry policy.",
    "retry_rule": "Retries are bounded and cannot bypass authorization or capability failures.",
    "trace_rule": "Runner trace links each step to dispatch execution identity/result."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ROUTINE_RUNNER_EXPLICIT",
        "rule": "Routine definitions and runner executions are separate canonical identities; runners execute explicit ordered routine content through the normal governed dispatch boundary."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "routine bypasses dispatcher",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "routine-level permission silently grants all step permissions",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "step result executes implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "retry bypasses authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "step trace loses dispatch identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DISPATCH",
      "target_ref": "AIGMOS_RUNTIME_DISPATCHER_BOUNDARY_CONTRACT",
      "purpose": "Routine steps use normal governed execution."
    },
    {
      "id": "REF_ERR",
      "target_ref": "AIGMOS_COMMAND_ERROR_REMEDIATION_CONTRACT",
      "purpose": "Step failures retain structured error semantics."
    }
  ],
  "prose": {
    "summary": "Define how each executable Routine step crosses the normal command/runtime dispatcher boundary, preserving per-step validation, authorization, result and failure semantics.",
