    "operation_rule": "Dispatch resolves an exact canonical operation identity.",
    "target_rule": "Target module/resource/instance identity is explicit.",
    "argument_rule": "Validated argument binding is recorded according to operation schema.",
    "authority_rule": "Applicable AccessCore authorization is evaluated at dispatch and cannot be inherited merely from Event payload.",
    "caller_rule": "Caller/session identity and assurance context propagate explicitly.",
    "result_rule": "Dispatch result references exact operation, target and execution.",
    "event_rule": "Events emitted by dispatch/result carry causality refs back to dispatch.",
    "failure_rule": "Unresolved/unauthorized/invalid dispatch never falls through to guessed operation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RUNNER_EXECUTION_EXPLICIT",
        "rule": "Runner definition, runner execution, individual step execution, operation dispatch and emitted Events are distinct explicit identities connected by traceable execution/causality relations."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "operation guessed by display name",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "event payload supplies authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "target instance ambiguous",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "invalid arguments dispatched anyway",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "dispatch result lacks operation/target refs",
        "result": "hard_fail"
      }
    ]
  },
