      "pending",
      "running",
      "completed",
      "failed",
      "cancelled",
      "skipped",
      "compensating",
      "compensated"
    ],
    "failure_rule": "Hard-failed step stops dependent execution unless explicit recovery policy says otherwise.",
    "retry_rule": "Retry policy is explicit and bounded; each attempt has distinct evidence.",
    "cancel_rule": "Cancellation is explicit and propagates according to dependency policy.",
    "compensation_rule": "Compensation is an explicit operation/step, not deletion of prior effects/evidence.",
    "resume_rule": "Resume identifies exact prior execution/checkpoint and applicable policy.",
    "event_rule": "Failure/retry/cancel/compensation transitions may emit explicit Events.",
    "trace_rule": "Original failure evidence remains immutable/traceable."
  },
