      {
        "id": "RUNNER_EXECUTION_EXPLICIT",
        "rule": "Runner definition, runner execution, individual step execution, operation dispatch and emitted Events are distinct explicit identities connected by traceable execution/causality relations."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "hard failure silently ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "retry unbounded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "compensation deletes prior evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "resume starts from guessed state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cancelled step represented as completed",
        "result": "hard_fail"
      }
    ]
  },
