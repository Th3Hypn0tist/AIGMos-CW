  "semantics": {
    "command": "run.status",
    "projection_rule": "Status is derived from exact Runner execution and step-execution records.",
    "readonly_rule": "Status projection cannot mutate Runner execution.",
    "identity_rule": "Definition status and concrete execution status remain distinct.",
    "current_rule": "Current execution is selected by explicit execution identity/context, not newest timestamp heuristic alone.",
    "history_rule": "Prior attempts/runs remain queryable.",
    "failure_rule": "Unknown/missing execution is explicit rather than synthesized.",
    "authorization_rule": "Status visibility follows applicable AccessCore/read policy."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RUNNER_EXECUTION_EXPLICIT",
        "rule": "Runner definition, runner execution, individual step execution, operation dispatch and emitted Events are distinct explicit identities connected by traceable execution/causality relations."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "run.status mutates execution",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "newest timestamp silently selects ambiguous run",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "definition and execution status conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "missing execution synthesized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "status bypasses read authorization",
        "result": "hard_fail"
      }
    ]
  },
