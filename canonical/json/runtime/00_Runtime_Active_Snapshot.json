        "id": "GATE_2",
        "condition": "candidate loaded without acceptance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "runtime instance identity conflated with snapshot identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "active binding lacks exact snapshot ref",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "activation changes semantic ownership",
        "result": "hard_fail"
      }
    ]
  },
