    "binding_rule": "Each running instance records the exact accepted snapshot identity it has loaded.",
    "separation_rule": "Repository current accepted snapshot and runtime active snapshot may temporarily differ.",
    "candidate_rule": "Candidate/review snapshots cannot become runtime active without acceptance plus explicit activation.",
    "identity_rule": "Runtime instance identity and active snapshot identity are distinct.",
    "evidence_rule": "Active binding retains load/activation timestamp, result and snapshot refs.",
    "authority_rule": "Being active does not alter semantic ownership or AccessCore policy."
