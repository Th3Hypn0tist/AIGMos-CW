  "semantics": {
    "base_rule": "Runtime boot begins from Absolute Base Zero.",
    "additive_rule": "Declared USE/user selections add only explicitly selected capabilities/modules and required explicitly declared structure.",
    "exclusive_rule": "Where `use` or `user` selection semantics apply, only listed capabilities are enabled according to profile rules.",
    "dependency_rule": "Dependencies are validated but never silently auto-enabled.",
    "failure_rule": "Missing required dependency hard-fails unless explicitly pruned/disabled by compatible policy.",
    "negative_rule": "Negative pruning is explicit and cannot silently remove required dependencies.",
    "remediation_rule": "User-facing failure should provide one clear remediation line where applicable.",
    "snapshot_rule": "Boot profile applies to an exact runtime/accepted snapshot context."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCEPTANCE_ACTIVATION_SEPARATION",
        "rule": "Repository acceptance establishes canonical source state; runtime activation/reload is a separate explicit lifecycle operation over an exact accepted snapshot."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "dependency silently auto-enabled",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "undeclared capability enabled",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "missing dependency ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "negative pruning creates invalid graph silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "boot profile detached from runtime snapshot",
        "result": "hard_fail"
      }
    ]
  },
