      "id": "REF_STATE",
      "target_ref": "AIGMOS_RUNTIME_DEFINITION_STATE_SEPARATION_CONTRACT",
      "purpose": "Runner definition and lifecycle state remain separate."
    }
  ],
  "prose": {
    "summary": "Define Runner as the exclusive % tracked runtime execution-lifecycle primitive with deterministic start/status/stop/error-cleanup behavior.",
