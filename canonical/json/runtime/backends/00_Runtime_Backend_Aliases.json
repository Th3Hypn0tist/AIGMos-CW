        "id": "GATE_1",
        "condition": "caller embeds provider/model endpoint instead of logical alias where alias semantics are required",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "silent backend fallback",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "backend response grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "backend response selects arbitrary runtime root or command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "two active aliases collide case-insensitively",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "queue identity derived from transient provider endpoint instead of resolved alias",
        "result": "hard_fail"
      }
