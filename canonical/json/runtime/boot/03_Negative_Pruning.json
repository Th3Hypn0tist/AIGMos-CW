  "semantics": {
    "prune_rule": "Negative selection targets exact component/capability identities.",
    "precedence_rule": "Conflict between positive selection and explicit prune is resolved by a declared deterministic profile rule; never by order of appearance.",
    "required_rule": "A component required by a retained component cannot be pruned while preserving an invalid closure.",
    "optional_rule": "Optional components may be pruned when no retained required dependency is broken.",
    "cascade_rule": "Pruning does not silently cascade-delete dependents; resulting invalid dependents are reported explicitly.",
    "history_rule": "Pruning affects resolved profile availability, not installed-artifact history.",
    "authority_rule": "Pruning availability does not modify permissions."
  },
  "constraints": {
    "invariants": [
      {
        "id": "BOOT_PROFILE_EXPLICIT_SELECTION",
        "rule": "Boot/runtime availability is derived only from explicit profile selection plus validated dependency closure; discovery, installation, dependency presence or historical activation never silently enables a component."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "required dependency pruned silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "negative/positive conflict resolved by list order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "prune removes installed history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "prune silently cascades arbitrary dependents",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "negative selector fuzzy-matched",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_USE",
      "target_ref": "AIGMOS_BOOT_USE_SELECTION_CONTRACT",
      "purpose": "Positive and negative profile selection reconcile explicitly."
    },
    {
      "id": "REF_DEP",
      "target_ref": "AIGMOS_INSTALL_DEPENDENCY_VALIDATION_CONTRACT",
      "purpose": "Pruned closure must remain dependency-valid."
    }
  ],
  "prose": {
    "summary": "Define explicit negative/pruning selections that remove components from a candidate profile while requiring dependency closure to remain valid.",
    "notes": [
      "Unlocked pending reconciliation against runtime activation, install dependency and instance configuration contracts."
    ]
  },
