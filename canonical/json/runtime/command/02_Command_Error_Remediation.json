  "semantics": {
    "error_classes": [
      "parse_error",
      "unknown_command",
      "invalid_argument",
      "target_unresolved",
      "capability_missing",
      "authorization_denied",
      "assurance_required",
      "dependency_failure",
      "runtime_failure",
      "timeout",
      "cancelled"
    ],
    "structure_rule": "Error includes stable class/code plus machine-readable context.",
    "remediation_rule": "When a deterministic corrective action exists, emit one concise remediation line.",
    "no_guess_rule": "If no deterministic remediation is known, do not invent one.",
    "security_rule": "Errors do not leak restricted target/data/secret metadata.",
    "cause_rule": "Nested/internal causes may be retained for authorized diagnostics while user-facing error remains bounded.",
    "authority_rule": "Error handling never retries by bypassing authorization or enabling hidden capability."
  },
  "constraints": {
    "invariants": [
      {
        "id": "COMMAND_EXECUTION_EXPLICIT",
        "rule": "Executable commands resolve by exact canonical identity and schema, cross one governed dispatcher boundary, and never infer authority from capability presence or parser success."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "error only free-form prose with no stable class",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "remediation guessed when unknown",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "error leaks secret/restricted metadata",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "failure auto-enables hidden capability",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "authorization denial retried via bypass",
        "result": "hard_fail"
      }
    ]
  },
