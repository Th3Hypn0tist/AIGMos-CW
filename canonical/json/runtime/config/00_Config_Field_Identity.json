  "semantics": {
    "identity_rule": "Each config field has an explicit stable identity within its owning config schema.",
    "owner_rule": "Owning component/subsystem is explicit.",
    "type_rule": "Field type/schema/default/required semantics are explicit.",
    "path_rule": "JSON path/key spelling is a serialization binding and not the sole semantic identity.",
    "secret_rule": "Secret values use secret refs rather than inline plaintext.",
    "reload_rule": "Whether a field is hot-reloadable/restart-required/immutable is explicit.",
    "authority_rule": "Config visibility does not grant edit authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "json key alone used as semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "config field owner ambiguous",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "secret inline in normal config",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reload behavior guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "visible config grants write authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SECRET",
      "target_ref": "AIGMOS_SECRET_REFERENCE_CONTRACT",
      "purpose": "Secret config fields use opaque refs."
    }
  ],
