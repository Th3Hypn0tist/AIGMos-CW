  "semantics": {
    "flow": [
      "validate candidate",
      "authorize apply",
      "commit accepted configuration revision",
      "determine affected components",
      "perform hot reload/restart/rebind as declared",
      "record runtime result"
    ],
    "accepted_rule": "Apply creates a new accepted config revision/snapshot.",
    "runtime_rule": "Accepted config and live runtime state remain separate until reload/activation succeeds.",
    "field_rule": "Hot-reload/restart-required semantics come from exact config field/component contracts.",
    "partial_rule": "Partial runtime apply is explicit and cannot masquerade as fully active configuration.",
    "failure_rule": "Reload failure preserves accepted/runtime distinction and exposes recovery path.",
    "authority_rule": "Apply/reload require explicit config/lifecycle authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "validated candidate silently becomes live",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "reload semantics guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "partial reload shown fully active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "apply bypasses authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "accepted config overwritten on runtime failure without evidence",
        "result": "hard_fail"
      }
    ]
  },
