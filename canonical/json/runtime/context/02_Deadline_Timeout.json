    "deadline_rule": "Absolute/relative deadline and clock profile are explicit.",
    "timeout_rule": "Local timeout derives from exact execution profile and remaining deadline where applicable.",
    "propagation_rule": "Child call deadline never silently exceeds parent deadline unless explicitly detached.",
    "result_rule": "Deadline exceeded is distinct from operation failure/success.",
    "effect_rule": "Timeout does not prove external effect absence.",
    "cleanup_rule": "Timeout triggers explicit cancellation/cleanup policy.",
    "retry_rule": "Retry policy consumes remaining overall budget.",
    "authority_rule": "Deadline has no authorization semantics."
  },
