  "semantics": {
    "symbol_root": "$EXT",
    "operations": [
      "add",
      "edit",
      "remove",
      "ping"
    ],
    "uniqueness_rule": "External identities are unique and explicitly resolved.",
    "default_access": "read_only",
    "identity_rule": "External semantic identity is separate from transport endpoint/binding.",
    "mutation_rule": "External registry mutation does not automatically grant remote data write authority.",
    "ping_rule": "Reachability probe is informational and does not establish trust/authorization.",
    "ac_boundary_rule": "When governed remote access is required, $EXT is registry metadata and not an alternate bypass channel."
  },
