  "semantics": {
    "remote_marker": ">",
    "governed_path": "DWH remote semantic dereference",
    "ac_on_rule": "When AccessCore governance is active, direct raw $EXT dereference is disallowed as an authorization bypass; governed remote access uses the declared DWH remote path.",
    "authority_rule": "Remote authority is evaluated at the remote target according to remote policy and assurance/authorization rules.",
    "local_owner_rule": "Local ownership does not expand delegated remote rights.",
    "read_only_rule": "Remote surfaces remain read-only by default unless explicit remote write authority exists.",
    "identity_rule": "Origin identity remains the identity established at the origin; remote transport does not invent a new identity.",
    "non_expansion_rule": "Delegated remote access cannot silently expand rights beyond the explicitly delegated remote path."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DWH_BOUNDARY_EXPLICIT",
        "rule": "DWH local/remote, origin, schema, external identity, access path and transport-security semantics remain explicit and non-interchangeable."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "direct raw $EXT dereference bypasses governed remote path while AccessCore is active",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "local ownership grants broader remote rights automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "remote write allowed without explicit remote write authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "transport session creates new trusted identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "delegated remote path expands rights beyond explicit delegation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "remote authorization inferred from Topic membership or network reachability",
        "result": "hard_fail"
      }
    ]
  },
