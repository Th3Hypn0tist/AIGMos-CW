  "semantics": {
    "cause_rule": "Propagated error retains exact originating error/cause refs.",
    "boundary_rule": "Each boundary may wrap/classify an error but never erase original provenance.",
    "runner_rule": "Step failure propagates according to explicit Runner failure policy.",
    "protocol_rule": "Transport/protocol mapping preserves internal error identity while exposing policy-safe external representation.",
    "nested_rule": "Nested Routine failure retains child execution/error refs.",
    "redaction_rule": "Sensitive details may be redacted externally without deleting internal evidence.",
    "success_rule": "Propagated failure never becomes success solely because a boundary handled formatting."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "root cause erased",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "wrapped error loses child execution ref",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "protocol returns success for failed operation without explicit partial semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "redaction deletes internal provenance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "error inferred from timeout only",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REC",
      "target_ref": "AIGMOS_RUNNER_FAILURE_RECOVERY_CONTRACT",
