    "event_types": [
      "operation_failed",
      "runner_failed",
      "dependency_failed",
      "runtime_degraded",
      "recovery_succeeded",
      "other declared failure event"
    ],
    "binding_rule": "Which failures emit Events is explicit.",
    "event_rule": "Emitted Event has its own identity and references exact error/execution/resource.",
    "payload_rule": "Failure Event payload is inert and redaction-governed.",
    "causality_rule": "Automated response still follows Event→Trigger→Runner/operation.",
    "dedupe_rule": "Repeated observation of same unresolved failure does not emit uncontrolled duplicate transition Events.",
    "authority_rule": "Failure Event never grants repair authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "failure directly executes repair",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Event identity replaces error identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "duplicate failure events unbounded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "event payload grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "recovery inferred without evidence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
