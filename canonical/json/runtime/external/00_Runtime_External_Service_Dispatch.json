  "semantics": {
    "identity_rule": "Service instance has stable logical identity separate from port/address/transport binding.",
    "protocol_examples": [
      "REST",
      "OSC",
      "WebSocket",
      "WebRTC",
      "HTTP/nanoCMS",
      "other installed protocol services"
    ],
    "binding_rule": "Transport binding changes do not redefine service semantics when compatible.",
    "call_rule": "External call uses explicit schema, authority and dispatcher validation.",
    "response_rule": "External response is inert and cannot grant authority or select arbitrary command/root.",
    "timeout_rule": "External call has finite timeout/bounds.",
    "port_rule": "Port/binding configuration is configuration state, not semantic identity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RUNTIME_BOUNDARY_EXPLICIT",
        "rule": "Runtime capabilities, dispatch and mutable state remain explicit, bounded and Core-governed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "transport address/port used as sole semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "external response grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "external response selects arbitrary command/root",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "external call bypasses schema/authority validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "external call unbounded/no timeout",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "transport binding change silently redefines service semantics",
        "result": "hard_fail"
      }
