  "semantics": {
    "dependency_rule": "Health evaluation references exact dependency bindings.",
    "required_rule": "Failed required dependency may degrade/fail the dependent according to explicit policy.",
    "optional_rule": "Optional dependency failure follows explicit degraded behavior.",
    "auto_rule": "Health failure never auto-installs/enables a missing dependency.",
    "propagation_rule": "Dependency failure propagation is explicit.",
    "identity_rule": "Dependency health does not merge dependency/dependent identities.",
    "authority_rule": "Healthy dependency grants no additional rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "missing dependency auto-enabled",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "optional failure kills component without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "dependent/dependency identities conflated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "health propagates by name match",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "healthy dependency grants authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DEP",
      "target_ref": "AIGMOS_INSTALL_DEPENDENCY_VALIDATION_CONTRACT",
      "purpose": "Health evaluates exact dependency closure."
