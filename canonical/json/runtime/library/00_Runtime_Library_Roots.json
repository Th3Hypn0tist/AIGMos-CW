  "identity": {
    "id": "AIGMOS_RUNTIME_LIBRARY_ROOT_CONTRACT",
    "name": "Runtime Library Roots",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "locked",
  "source_role": "definition",
  "purpose": "Define explicit user and system library roots and prevent library storage paths from becoming semantic identity, authority or execution behavior.",
  "scope": {
    "owns": [
      "Runtime Library Roots semantics"
    ],
    "does_not_own": [
      "domain semantics",
      "projection semantics"
    ]
  },
  "members": [],
  "structure": {
    "containment": [],
    "relations": [],
