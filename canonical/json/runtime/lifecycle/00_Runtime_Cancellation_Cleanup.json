  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define cancellation, timeout and cleanup as explicit tracked runtime lifecycle semantics across runners, tools, routines, queues and external calls.",
  "scope": {
    "owns": [
      "Runtime Cancellation and Cleanup semantics"
    ],
