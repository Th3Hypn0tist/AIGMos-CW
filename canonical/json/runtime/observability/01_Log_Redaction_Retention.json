  "semantics": {
    "field_rule": "Structured log fields are explicit.",
    "redaction_rule": "Secrets/sensitive values are omitted, masked or redacted according to explicit profiles.",
    "classification_rule": "Logs may inherit classification from source/context.",
    "retention_rule": "Log retention/expiry is explicit.",
    "source_rule": "Deleting a log record never deletes referenced source data.",
    "declassification_rule": "Redaction does not automatically declassify underlying source.",
    "authority_rule": "Log access is separately governed."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "secret logged in clear",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "log delete cascades to source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "redaction silently declassifies source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "retention inferred from disk pressure",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "log access implies source access",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SECRET",
      "target_ref": "AIGMOS_SECRET_REFERENCE_CONTRACT",
      "purpose": "Secret values must not leak into logs."
    }
  ],
