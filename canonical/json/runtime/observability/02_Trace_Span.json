  "semantics": {
    "trace_rule": "Each trace has an explicit trace identity.",
    "span_rule": "Each span has an explicit span identity and exact parent/trace refs.",
    "source_rule": "Span records exact operation/component/execution identity.",
    "time_rule": "Start/end/duration are evidence only.",
    "causality_rule": "Span parentage may reflect execution structure but does not replace canonical causality edges where effect causation matters.",
    "cross_boundary_rule": "Trace context propagation across protocol/tool boundaries is explicit.",
    "authority_rule": "Trace context grants no operation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "trace id becomes user/session identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "span parentage replaces causal Event graph automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "trace header grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "operation ref omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "cross-boundary trace guessed",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
