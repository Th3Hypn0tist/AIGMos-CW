        "condition": "request creation executes operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "model text treated as request without parsing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "missing operation guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "requester identity treated as authorization",
