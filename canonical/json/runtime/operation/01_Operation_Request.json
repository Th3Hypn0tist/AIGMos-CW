    "identity_rule": "Each machine-significant request has a distinct request identity.",
    "operation_rule": "Request references one exact operation identity.",
    "target_rule": "Request target is exact and never inferred from cwd, UI selection or display context.",
    "argument_rule": "Arguments are explicit candidate data until validation succeeds.",
    "context_rule": "Requester/auth/session/context refs are explicit where applicable.",
    "constraint_rule": "Deadline, idempotency key, dry-run, resource budget and other execution constraints are explicit.",
    "inert_rule": "A request has no side effect merely by existing.",
    "authority_rule": "Request origin does not determine authorization outcome."
  },
