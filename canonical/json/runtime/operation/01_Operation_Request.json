    "invariants": [
      {
        "id": "EXPLICIT_EXECUTION_BOUNDARY",
        "rule": "Definitions, requests, validation evidence, authorization decisions and concrete executions remain separate identities; only an explicit validated and authorized dispatcher path may create effects."
