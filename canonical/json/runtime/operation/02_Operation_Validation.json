    "flows": []
  },
  "semantics": {
    "flow": [
      "resolve operation",
      "resolve target",
      "validate input schema",
      "validate target compatibility",
      "validate state preconditions",
      "validate bounds/capabilities",
      "produce validation evidence"
    ],
    "result_states": [
      "valid",
      "invalid",
      "unknown",
      "conflict"
    ],
    "evidence_rule": "Validation result references exact operation/request/target revisions.",
    "state_rule": "State-dependent preconditions bind exact observed revision/state evidence.",
    "unknown_rule": "Unknown required validation fails closed.",
    "semantic_rule": "Validator cannot rewrite request semantics merely to make it valid.",
    "authority_rule": "Validation success does not authorize execution."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_EXECUTION_BOUNDARY",
        "rule": "Definitions, requests, validation evidence, authorization decisions and concrete executions remain separate identities; only an explicit validated and authorized dispatcher path may create effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "validator silently fixes target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unknown treated valid",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "validation result executes request",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "state revision omitted for stateful precondition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "validation success treated as authorization",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REQ",
      "target_ref": "AIGMOS_OPERATION_REQUEST_CONTRACT",
      "purpose": "Validation evaluates exact inert requests."
    }
