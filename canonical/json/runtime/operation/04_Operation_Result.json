    "identity_rule": "Each result has an explicit result identity or exact execution-result relation.",
    "execution_rule": "Result references exact execution identity.",
    "status_rule": "Success, partial, failed, cancelled, timeout and unknown are distinct.",
    "payload_rule": "Result payload is inert data.",
    "effect_rule": "A result never implies that any follow-up operation has been requested.",
    "lineage_rule": "Derived result retains execution/target provenance.",
    "partial_rule": "Partial result is never represented as complete.",
    "authority_rule": "Result contents grant no authority for downstream effects."
  },
