  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define rendezvous/signaling as bootstrap metadata exchange for peer discovery and WebRTC session establishment, explicitly separated from P2P application payload transport.",
  "scope": {
    "owns": [
      "Runtime Rendezvous and Signaling semantics"
    ],
    "does_not_own": [
      "domain semantics",
      "remote authorization policy",
      "presentation semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_RUNTIME_RENDEZVOUS",
      "name": "Rendezvous",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define rendezvous/signaling as bootstrap metadata exchange for peer discovery and WebRTC session establishment, explicitly separated from P2P application payload transport.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_RENDEZVOUS_REGISTER",
        "name": "Register rendezvous metadata",
        "inputs": [
          "local identity reference",
          "bootstrap metadata"
        ],
        "outputs": [
          "rendezvous registration"
        ],
        "errors": [
          "registration denied",
          "metadata invalid"
        ],
        "side_effects": [
          "rendezvous state updated"
        ]
      },
      {
        "id": "OP_RENDEZVOUS_DISCOVER",
        "name": "Discover peer bootstrap metadata",
        "inputs": [
          "peer identity/query"
        ],
        "outputs": [
          "peer bootstrap metadata"
        ],
        "errors": [
          "peer unavailable",
          "lookup denied"
        ],
        "side_effects": []
      },
      {
        "id": "OP_RENDEZVOUS_CLEANUP",
        "name": "Cleanup rendezvous metadata",
        "inputs": [
          "completed/expired rendezvous state"
        ],
        "outputs": [
          "metadata removed"
        ],
        "errors": [],
        "side_effects": [
          "rendezvous state removed"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "role": "bootstrap/signaling only",
    "official_service_rule": "Official rendezvous/signaling may be provided for licensed deployments; private compatible signaling is permitted.",
    "payload_rule": "Application payloads remain peer-to-peer and are not canonical rendezvous content.",
    "metadata_rule": "Rendezvous stores only metadata required for peer discovery/session bootstrap under explicit bounded retention.",
    "cleanup_rule": "Rendezvous metadata is cleaned after peer establishment/expiry according to explicit lifecycle rules.",
    "authority_rule": "Rendezvous discovery does not grant remote DWH/access rights.",
    "identity_rule": "Rendezvous records refer to explicit peer identities; endpoint/transport metadata is not the identity itself."
  },
  "constraints": {
    "invariants": [
      {
        "id": "NETWORK_BOUNDARY_EXPLICIT",
        "rule": "Network identity, transport, remote authority and payload semantics remain explicit and separate."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "rendezvous becomes application payload datastore by default",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "rendezvous lookup grants authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "endpoint address treated as peer semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "bootstrap metadata retained without lifecycle bound",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "private compatible rendezvous prohibited as semantic requirement",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "peer/session metadata selected by fuzzy identity heuristic",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_WEBRTC",
