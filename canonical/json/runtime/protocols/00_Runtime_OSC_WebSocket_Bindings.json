  "semantics": {
    "protocols": [
      "OSC",
      "WebSocket"
    ],
    "optional_removable": true,
    "input_rule": "Inbound protocol messages are inert until mapped to explicit input symbols or canonical operations.",
    "output_rule": "Outbound protocol messages require explicit operation/effect authority.",
    "address_rule": "Protocol addresses map through explicit declared mappings; they do not become arbitrary canonical roots.",
    "osc_boot_rule": "OSC input service boot has explicit boot semantics separate from normal Runner autostart.",
    "websocket_rule": "WebSocket connection identity/state is runtime state, not canonical semantic identity.",
    "authority_rule": "Remote sender data never grants authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SERVICE_BOUNDARY_EXPLICIT",
        "rule": "Network/service identity, binding, lifecycle and authority remain explicit and separate."
