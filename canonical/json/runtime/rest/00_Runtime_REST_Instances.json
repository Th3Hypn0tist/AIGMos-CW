  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_REST_REGISTER_ROUTE",
        "name": "Register REST route",
        "inputs": [
          "named REST instance",
          "route definition",
          "canonical operation ref"
        ],
        "outputs": [
          "registered route"
        ],
        "errors": [
          "route collision",
          "operation unresolved"
        ],
        "side_effects": [
          "REST route registry updated"
        ]
      },
      {
        "id": "OP_REST_HANDLE_REQUEST",
        "name": "Handle REST request",
        "inputs": [
          "request",
          "route",
          "schema",
          "authority context"
        ],
        "outputs": [
          "canonical operation result as response"
        ],
        "errors": [
          "route unresolved",
          "schema invalid",
          "authority denied",
          "operation failure"
        ],
        "side_effects": [
          "only effects of invoked canonical operation"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "instance_model": "named service instance",
    "default_port_locked": false,
    "route_rule": "Each REST route binds to an explicit canonical operation or read projection.",
    "schema_rule": "Request and response shapes are explicit.",
    "authority_rule": "REST exposure does not grant authority; applicable IAM/AC/runtime authorization remains separate.",
    "backend_rule": "REST is a transport/exposure binding, not a separate semantic backend.",
    "instance_identity_rule": "Logical REST instance identity is separate from its port.",
    "error_rule": "Errors are structured and transport-mapped without changing canonical semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SERVICE_BOUNDARY_EXPLICIT",
        "rule": "Network/service identity, binding, lifecycle and authority remain explicit and separate."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "REST route implements private semantic mutation outside canonical operation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "REST exposure grants authority by existence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "route accepts unknown fields without owning schema rule",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "REST instance identity equals port number",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "transport error changes canonical semantic meaning",
        "result": "hard_fail"
      }
    ]
  },
