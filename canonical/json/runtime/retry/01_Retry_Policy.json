  "semantics": {
    "identity_rule": "Each reusable retry policy has an explicit identity.",
    "eligibility_rule": "Retryable failure/error classes are explicit.",
    "attempt_rule": "Maximum attempts is explicit and bounded.",
    "delay_rule": "Delay/backoff/jitter profile is explicit.",
    "budget_rule": "Total duration/resource/deadline interaction is explicit.",
    "idempotency_rule": "Effectful retries require idempotency or explicit safe-retry semantics.",
    "attempt_identity": "Each retry attempt has a distinct execution/attempt identity.",
    "authority_rule": "Retry does not bypass current authorization/validation where recheck is required."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_EXECUTION_BOUNDARY",
        "rule": "Definitions, requests, validation evidence, authorization decisions and concrete executions remain separate identities; only an explicit validated and authorized dispatcher path may create effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "unbounded retries",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "destructive operation retried without idempotency/safe semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "retry attempt reuses same execution identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "authorization never rechecked despite expiry",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "unknown error treated retryable",
        "result": "hard_fail"
      }
    ]
  },
