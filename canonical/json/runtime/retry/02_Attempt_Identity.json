  "semantics": {
    "identity_rule": "Each execution attempt has a distinct attempt identity.",
    "request_rule": "Attempt references exact request identity.",
    "sequence_rule": "Attempt ordinal is explicit evidence, not identity by itself.",
    "prior_rule": "Retry attempts reference prior failure/attempt where applicable.",
    "result_rule": "Each attempt has its own status/result/error evidence.",
    "accepted_rule": "At most the explicitly allowed effect acceptance semantics determine which attempt produced accepted effect.",
    "history_rule": "Failed attempts remain auditable."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_EXECUTION_BOUNDARY",
        "rule": "Definitions, requests, validation evidence, authorization decisions and concrete executions remain separate identities; only an explicit validated and authorized dispatcher path may create effects."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "attempt ordinal alone used globally as identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "failed attempt erased after success",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "same execution identity reused ambiguously",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "accepted effect source attempt unknown",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "attempt inferred from log order",
        "result": "hard_fail"
      }
    ]
  },
