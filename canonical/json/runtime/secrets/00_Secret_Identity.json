  "semantics": {
    "identity_rule": "Each secret has a stable logical secret identity.",
    "value_rule": "Secret value/material is separate from identity/metadata.",
    "types": [
      "password",
      "token",
      "private_key",
      "api_key",
      "shared_secret",
      "other declared secret"
    ],
    "scope_rule": "Owner/resource/application scope is explicit.",
    "storage_rule": "Physical secret-store location is a binding only.",
    "redaction_rule": "Secret values are never included in ordinary canonical JSON, logs or monitors.",
    "authority_rule": "Secret metadata visibility does not grant secret-value access."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "secret value used as identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "secret stored inline in ordinary canonical contract",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "secret printed in logs",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "secret-store path becomes semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "metadata visibility grants value access",
        "result": "hard_fail"
      }
    ]
  },
