  "semantics": {
    "reference_rule": "Configuration uses exact secret identity/ref.",
    "opaque_rule": "Reference does not expose secret material.",
    "resolve_rule": "Runtime resolution is explicit and governed.",
    "env_rule": "Environment-variable names may be bindings only when declared; they are not the secret semantic identity.",
    "file_rule": "Secret files/paths are storage bindings only.",
    "failure_rule": "Unresolved secret ref hard-fails protected operation rather than substituting empty/default material.",
    "authority_rule": "Ability to reference a secret does not imply ability to reveal/export it."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "raw secret embedded in config",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "missing secret replaced with empty string",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "env var name treated as canonical secret identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reference grants reveal authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "path guessed from secret name",
        "result": "hard_fail"
      }
    ]
  },
