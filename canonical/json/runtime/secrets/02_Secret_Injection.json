        "condition": "child processes inherit secret implicitly",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "secret appears in trace",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "injection has unbounded lifetime",
        "result": "hard_fail"
      },
      {
