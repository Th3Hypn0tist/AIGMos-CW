  "semantics": {
    "identity_rule": "Logical secret identity remains stable across value rotations.",
    "version_rule": "Secret material version/revision is explicit.",
    "activation_rule": "New material activation time/state is explicit.",
    "overlap_rule": "Optional old/new overlap period is explicit and bounded.",
    "revocation_rule": "Old material revocation is explicit.",
    "consumer_rule": "Consumers resolve current allowed version through the secret reference/provider profile.",
    "audit_rule": "Rotation evidence records identities/versions, never raw values.",
    "authority_rule": "Rotation requires explicit secret-management authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "EXPLICIT_IDENTITY_AND_BOUNDARY",
        "rule": "Machine-significant definitions, executions, evidence and runtime state use explicit identities and boundaries; visibility, file order, timestamps, transport reachability or UI placement never silently create semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "rotation creates new unrelated logical secret accidentally",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "old value remains valid indefinitely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "raw secret value appears in audit",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "consumer guesses newest by mtime",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "rotation bypasses authority",
        "result": "hard_fail"
      }
    ]
  },
