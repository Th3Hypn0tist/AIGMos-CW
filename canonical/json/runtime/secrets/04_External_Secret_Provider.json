    "provider_rule": "Each external secret provider has an explicit logical provider identity.",
    "binding_rule": "Provider endpoint/process/path is configuration, not provider identity.",
    "secret_rule": "Logical AIGMos secret refs map explicitly to provider secret identities/paths.",
    "availability_rule": "Provider reachability does not imply secret authorization.",
    "fallback_rule": "Provider fallback is explicit and never silently downgrades to plaintext local storage.",
    "rotation_rule": "Provider-side version/rotation metadata maps explicitly.",
    "failure_rule": "Unavailable provider fails protected operations according to policy."
  },
