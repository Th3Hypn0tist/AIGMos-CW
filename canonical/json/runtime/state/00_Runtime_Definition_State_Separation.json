        "id": "RUNTIME_SEMANTICS_EXPLICIT",
        "rule": "Runtime-significant semantics are explicit and do not arise from payload, path, projection or implementation heuristics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "runtime mutation silently rewrites authoritative definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "ephemeral timing/gate/queue state stored as definition semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "definition read causes runtime state mutation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "reload destroys unrelated runtime-owned state without explicit lifecycle rule",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "runtime state becomes persistent canonical semantics merely because it exists",
        "result": "hard_fail"
      }
    ]
  },
