  "semantics": {
    "definition": "Stable declarative semantics/metadata loaded from authoritative sources.",
    "runtime_state": "Mutable operational state produced while resolving/executing definitions.",
    "separation_rule": "Runtime state changes do not silently rewrite authoritative definitions.",
    "timing_state_rule": "Trigger timing, inflight gates, queue state, runner lifecycle and similar operational state belong to runtime state unless explicitly defined otherwise.",
    "reload_rule": "Reload of definitions reconciles source-owned definition state without silently destroying unrelated runtime-owned state.",
    "persistence_rule": "Persistence of runtime state requires an explicit owning contract; persistence is not implied by existence."
  },
  "constraints": {
    "invariants": [
