      ],
      "event_refs": [],
      "flow_refs": [],
      "child_topics": [],
      "metadata": {}
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_TOOL_REGISTER",
        "name": "Register tool",
        "inputs": [
          "tool definition"
        ],
        "outputs": [
          "registered tool"
        ],
        "errors": [
          "duplicate tool",
          "invalid schema"
        ],
        "side_effects": [
          "tool registry updated"
        ]
      },
      {
        "id": "OP_TOOL_RESOLVE",
        "name": "Resolve tool",
        "inputs": [
          "literal tool identity"
        ],
        "outputs": [
          "exact tool definition"
        ],
        "errors": [
          "tool unresolved",
          "tool ambiguous"
        ],
        "side_effects": []
      },
      {
        "id": "OP_TOOL_INVOKE",
        "name": "Invoke tool through Core dispatch",
        "inputs": [
          "resolved tool",
          "validated arguments",
          "authority context"
        ],
        "outputs": [
          "bounded tool result"
        ],
        "errors": [
          "argument invalid",
          "authority denied",
          "tool failure",
          "timeout"
        ],
        "side_effects": [
          "only declared authorized tool effects"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "identity_rule": "Tool identity is explicit and literal.",
    "schema_rule": "Tool inputs and outputs are explicitly declared.",
    "effect_rule": "Tool side effects are declared and validated before invocation.",
    "authority_rule": "Tool output or metadata cannot grant authority.",
    "dynamic_tool_rule": "Payload/model/backend-selected arbitrary tool identities are forbidden unless an owning contract explicitly resolves a bounded declared set.",
    "result_rule": "Tool results are inert data until explicitly interpreted by a following canonical operation.",
    "failure_rule": "Tool failure is structured, visible and bounded."
  },
  "constraints": {
    "invariants": [
      {
        "id": "RUNTIME_BOUNDARY_EXPLICIT",
        "rule": "Runtime capabilities, dispatch and mutable state remain explicit, bounded and Core-governed."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "tool resolved by fuzzy/display-name heuristic",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "tool invocation bypasses Core dispatcher",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "tool output grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "tool has undeclared side effects",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "arbitrary tool name selected from untrusted payload/model output",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "tool execution unbounded",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DISPATCH",
      "target_ref": "AIGMOS_RUNTIME_DISPATCHER_BOUNDARY_CONTRACT",
      "purpose": "Tool invocation crosses Core dispatch."
    },
    {
      "id": "REF_OPERATION",
      "target_ref": "AIGMOS_CORE_CANONICAL_OPERATION_CONTRACT",
      "purpose": "Tool interfaces follow explicit operation semantics."
    }
  ],
  "prose": {
    "summary": "Define tools as registered runtime capabilities with explicit identities, schemas, declared effects and Core-owned invocation boundaries.",
