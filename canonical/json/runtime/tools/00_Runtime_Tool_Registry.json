  "topics": [
    {
      "id": "TOPIC_RUNTIME_TOOL_REGISTRY",
      "name": "Tool Registry",
      "purpose": "Define tools as registered runtime capabilities with explicit identities, schemas, declared effects and Core-owned invocation boundaries.",
      "parent_topic_refs": [
        "TOPIC_CORE_RUNTIME_TOOLS"
      ],
      "composed_topic_refs": [
        "TOPIC_RUNTIME_DISPATCHER",
        "TOPIC_CORE_OPERATIONS",
        "TOPIC_CORE_CAPABILITY_AUTHORITY"
      ],
      "member_refs": [
        "AIGMOS_RUNTIME_TOOL_REGISTRY_CONTRACT",
        "RUNTIME_BOUNDARY_EXPLICIT",
        "GATE_1",
        "GATE_2",
