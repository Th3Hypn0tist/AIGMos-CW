  "semantics": {
    "symbol_root": "#UM",
    "identity_rule": "UserModule identity is explicit and stable; filesystem path is storage, not identity.",
    "registry_rule": "#UM resolves registered UserModule semantic identities and instances.",
    "collision_rule": "Duplicate active logical identities are rejected.",
    "path_rule": "Moving a module source file does not redefine its semantic identity when the declared identity is unchanged.",
    "authority_rule": "Registration does not grant runtime authority beyond the module's declared capabilities and applicable policy.",
    "instance_rule": "Module definition identity and runtime instance identity are separate when multiple instances are permitted."
  },
  "constraints": {
    "invariants": [
      {
        "id": "USERMODULE_SEMANTICS_EXPLICIT",
        "rule": "UserModule identity, type, lifecycle, bindings and visibility are explicit canonical/runtime semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "UserModule identity inferred solely from directory path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "duplicate active UserModule identity accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "module registration grants undeclared authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "runtime instance state overwrites module definition identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "display name used as semantic identity",
        "result": "hard_fail"
      }
    ]
  },
