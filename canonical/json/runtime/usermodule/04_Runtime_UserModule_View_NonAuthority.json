  "semantics": {
    "view_rule": "View is UI-only/read projection by default.",
    "backend_rule": "View owns no private semantic backend.",
    "write_rule": "Any user-initiated mutation resolves to an explicit canonical operation and authoritative write target.",
    "authority_rule": "UI visibility or control presence does not grant runtime authority.",
    "state_rule": "Ephemeral presentation state is view state and does not silently become canonical/runtime semantic state.",
    "projection_rule": "View layout, ordering and nesting are projection semantics only."
  },
  "constraints": {
    "invariants": [
      {
        "id": "USERMODULE_SEMANTICS_EXPLICIT",
        "rule": "UserModule identity, type, lifecycle, bindings and visibility are explicit canonical/runtime semantics."
      }
    ],
