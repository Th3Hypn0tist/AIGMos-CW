        "condition": "visible UI control grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "presentation state silently becomes canonical definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "view ordering/nesting treated as canonical structure",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "write target inferred from UI placement instead of explicit operation/ref",
        "result": "hard_fail"
      }
    ]
  },
