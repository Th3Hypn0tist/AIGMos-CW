      "purpose": "Web uses named service instance model."
    },
    {
      "id": "REF_LISTENER",
      "target_ref": "AIGMOS_RUNTIME_LISTENER_BINDING_CONTRACT",
      "purpose": "Web port 80 is a listener binding."
    }
  ],
  "prose": {
    "summary": "Define nanoCMS web serving as named runtime instances with stable logical identity, explicit listener bindings and canonical #WEB/site structure owned outside the listener runtime.",
