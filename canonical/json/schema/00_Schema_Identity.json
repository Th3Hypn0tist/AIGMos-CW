  "source_role": "definition",
  "purpose": "Define canonical schemas as stable semantic identities describing data shape independently from table/file/class names, storage engines and runtime instance values.",
  "scope": {
    "owns": [
      "Schema Identity semantics"
    ],
    "does_not_own": [
      "instance data values",
