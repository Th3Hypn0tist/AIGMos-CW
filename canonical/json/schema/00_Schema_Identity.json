  "semantics": {
    "identity_rule": "Every schema has an explicit stable canonical identity.",
    "version_rule": "Schema version/evolution is explicit.",
    "storage_rule": "Database table, file, class or serialization name is binding/implementation metadata.",
    "instance_rule": "Schema identity is distinct from any data instance identity.",
    "field_rule": "Fields are explicit child semantic identities.",
    "composition_rule": "Schemas may compose/reference other schemas through explicit relations/definitions.",
    "authority_rule": "Schema presence does not grant access to instance data."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SCHEMA_RELATION_EXPLICIT",
        "rule": "Schema, field and relation identities are explicit and stable; instance data, presentation labels and physical storage never define canonical schema semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "schema identity inferred solely from table/file/class name",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "schema conflated with data instance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "field identity absent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "storage binding treated as semantic owner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "schema visibility grants data authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SCHEMA",
      "target_ref": "AIGMOS_CORE_SCHEMA_SEMANTICS_CONTRACT",
      "purpose": "Schema identity specializes canonical schema semantics."
