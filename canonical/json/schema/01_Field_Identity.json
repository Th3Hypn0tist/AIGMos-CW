    "identity_rule": "Every machine-significant field has an explicit stable identity within its schema scope.",
    "name_rule": "Canonical field name is distinct from localized/display labels.",
    "type_rule": "Field type/schema semantics are explicit.",
    "null_rule": "Required, optional, nullable, empty and missing semantics are explicitly distinguishable where applicable.",
    "default_rule": "Default value semantics are explicit and inert until applied by the owning operation.",
    "storage_rule": "Physical column/key name may bind to the field but is not its semantic identity.",
    "ordering_rule": "Field declaration order is non-semantic unless explicitly declared."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SCHEMA_RELATION_EXPLICIT",
        "rule": "Schema, field and relation identities are explicit and stable; instance data, presentation labels and physical storage never define canonical schema semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "field identity inferred from display label",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "null/empty/missing collapsed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "column name used as sole semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "field order treated as precedence without rule",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "default executes hidden behavior",
        "result": "hard_fail"
      }
    ]
  },
