  "semantics": {
    "additive_rule": "Compatible additive fields/relations may preserve schema identity/version compatibility according to policy.",
    "breaking_rule": "Breaking semantic change requires explicit incompatible version/new identity where owning versioning policy requires.",
    "migration_rule": "Stored/instance data migration is explicit and separate from schema definition change.",
    "field_rule": "Field rename, split, merge, type change or semantic repurpose is explicitly mapped.",
    "relation_rule": "Relation/cardinality/FK changes are explicit compatibility/migration events.",
    "default_rule": "Adding a default does not silently backfill historical data unless migration explicitly does so.",
    "evidence_rule": "Compatibility/migration decision retains semantic diff and provenance."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SCHEMA_RELATION_EXPLICIT",
        "rule": "Schema, field and relation identities are explicit and stable; instance data, presentation labels and physical storage never define canonical schema semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "breaking field semantics published as compatible silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "historical data reinterpreted without migration",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "field rename loses old/new mapping",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "relation change hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "default silently backfills history",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
