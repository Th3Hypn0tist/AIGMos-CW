    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define each `#SHOP` shopping list as an explicit planning identity with stable ownership/scope, lifecycle and item membership separate from any merchant cart or purchase transaction.",
  "scope": {
    "owns": [
      "Shopping List Identity semantics"
    ],
    "does_not_own": [
      "payment execution",
      "merchant catalog truth",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_SHOPPING_LIST_IDENTITY",
      "name": "Shopping List Identity",
      "type": "topic",
      "status": "unlocked",
