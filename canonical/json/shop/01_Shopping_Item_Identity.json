  "identity": {
    "id": "AIGMOS_SHOPPING_ITEM_IDENTITY_CONTRACT",
    "name": "Shopping Item Identity",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define shopping-list items as explicit planning records with desired product/need semantics independent from merchant SKU, recommendation result or purchased item identity.",
  "scope": {
    "owns": [
      "Shopping Item Identity semantics"
    ],
    "does_not_own": [
      "payment execution",
      "merchant catalog truth",
      "AccessCore policy ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_SHOPPING_ITEM_IDENTITY",
      "name": "Shopping Item Identity",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define shopping-list items as explicit planning records with desired product/need semantics independent from merchant SKU, recommendation result or purchased item identity.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "identity_rule": "Each shopping item has its own explicit identity within/global to #SHOP according to owning profile.",
    "need_rule": "Item may represent a generic need/product concept without requiring merchant-specific SKU.",
    "product_rule": "Merchant product/SKU refs are optional external candidate bindings.",
    "state_values": [
      "needed",
      "optional",
      "selected",
      "obtained",
      "removed"
    ],
    "notes_rule": "Human notes/preferences remain descriptive data and not executable procurement instructions.",
    "recommendation_rule": "Recommended candidate products do not replace shopping-item identity.",
    "history_rule": "Changing candidate/product binding does not rewrite prior item history silently."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SHOPPING_NONPURCHASE",
        "rule": "Shopping-list data expresses planning intent only; list/item existence, ranking, recommendation or selection never authorizes purchase, payment or external order execution."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "merchant SKU becomes shopping-item identity automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "recommendation replaces planning identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "descriptive note executes purchase",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "candidate change rewrites history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "obtained state inferred solely from cart placement",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_LIST",
      "target_ref": "AIGMOS_SHOPPING_LIST_IDENTITY_CONTRACT",
      "purpose": "Items belong to explicit shopping lists."
    }
  ],
  "prose": {
    "summary": "Define shopping-list items as explicit planning records with desired product/need semantics independent from merchant SKU, recommendation result or purchased item identity.",
    "notes": [
      "Unlocked pending reconciliation against #SHOP owner, Studio Everyday, units and external procurement/payment contracts."
    ]
  },
