        "id": "OP_OWNERSHIP_RESOLVE",
        "name": "Resolve semantic owner",
        "inputs": [
          "semantic fact/surface"
        ],
        "outputs": [
          "authoritative owner"
        ],
        "errors": [
          "owner missing",
          "conflicting owners"
        ],
        "side_effects": []
      }
    ],
