  "semantics": {
    "dimension": "ownership",
    "single_owner_rule": "A machine-significant semantic fact has one authoritative owner unless explicit reconciliation defines otherwise.",
    "containment_rule": "Containing an identity does not make the container semantic owner.",
    "authority_rule": "Semantic ownership does not automatically grant runtime/AccessCore authority.",
    "projection_rule": "Projection/view does not become owner of projected facts.",
    "composition_rule": "Consumer composition references owner semantics rather than copying them.",
    "trace_rule": "Ownership is preserved in provenance and reverse traces."
  },
  "constraints": {
    "invariants": [
      {
        "id": "STRUCTURAL_DIMENSION_EXPLICIT",
        "rule": "Structural dimensions and registries remain explicit and are never collapsed into generic hierarchy."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "containment silently creates ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "projection becomes owner of source semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "semantic ownership grants runtime authority automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "same active semantic fact has conflicting owners without reconciliation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "consumer duplicates owned semantics instead of referencing owner",
        "result": "hard_fail"
      }
    ]
  },
