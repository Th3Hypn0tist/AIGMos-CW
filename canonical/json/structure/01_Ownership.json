  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_OWNERSHIP_DEFINE",
        "name": "Define semantic ownership",
        "inputs": [
          "owner_ref",
          "owned_ref",
          "owned semantic surface"
        ],
        "outputs": [
          "ownership edge"
        ],
        "errors": [
          "owner unresolved",
          "surface ambiguous"
        ],
        "side_effects": [
          "ownership graph updated"
        ]
