    "preset_rule": "Preset references one exact Lens identity/version and stores explicit parameter values/configuration.",
    "identity_rule": "Each reusable preset has an explicit identity.",
    "source_rule": "Preset does not copy Lens source data or source semantic ownership.",
    "default_rule": "A default preset is explicit metadata, never inferred from most-recent use.",
    "personal_rule": "User-specific presets and shared canonical presets are distinguishable by scope/owner.",
    "compatibility_rule": "Preset validates against Lens parameter schema/version before use.",
    "migration_rule": "Incompatible Lens changes require explicit preset migration/invalid state.",
    "authority_rule": "Preset cannot grant source access beyond Lens/current caller policy."
