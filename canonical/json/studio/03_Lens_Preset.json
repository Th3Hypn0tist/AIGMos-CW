    "invariants": [
      {
        "id": "STUDIO_PROJECTION_NONAUTHORITY",
        "rule": "Studio and Lens compose and project existing canonical semantics; analysis, presets and visualizations never silently become source semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "preset copied as source truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "last-used state silently becomes canonical default",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "preset bypasses Lens/source authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "incompatible preset silently applied",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "user-private preset treated as shared canonical preset",
        "result": "hard_fail"
      }
    ]
  },
