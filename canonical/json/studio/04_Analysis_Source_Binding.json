      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "source_kinds": [
      "local canonical source",
      "governed external source",
      "DWH projection",
      "Project/Portfolio/Merit source",
      "other explicit canonical source"
    ],
    "source_rule": "Analysis source resolves by exact canonical or governed external identity.",
    "backend_rule": "Analysis backend such as QC is explicitly selected/configured and remains separate from the source identity.",
    "local_external_rule": "Local/external mode is explicit and governed by its owning boundary.",
    "read_rule": "Analysis reads source data according to authorization and does not gain mutation authority.",
    "result_rule": "Analysis output is derived projection/evidence unless an explicit accepted-write operation persists it.",
    "provenance_rule": "Output retains source refs, Lens/preset refs and backend/rule provenance.",
    "no_guess_rule": "Analysis never infers source from UI proximity, working directory or filename alone."
  },
  "constraints": {
    "invariants": [
      {
        "id": "STUDIO_PROJECTION_NONAUTHORITY",
        "rule": "Studio and Lens compose and project existing canonical semantics; analysis, presets and visualizations never silently become source semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "analysis engine becomes source owner",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "source inferred from UI/cwd only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "external reachability grants write authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "analysis output automatically mutates canonical source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "output loses source/backend provenance",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_QC",
      "target_ref": "AIGMOS_QC_TARGET_CONTRACT",
      "purpose": "QC target is explicit."
    },
    {
      "id": "REF_QCMODE",
      "target_ref": "AIGMOS_QC_LOCAL_EXTERNAL_MODE_CONTRACT",
      "purpose": "QC locality is explicit."
    }
  ],
  "prose": {
    "summary": "Define exact source binding for Studio/Lens analysis, including local/external source choice and QC/other analysis backend selection without confusing analysis engine with semantic source ownership.",
