  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define exact source binding for Studio/Lens analysis, including local/external source choice and QC/other analysis backend selection without confusing analysis engine with semantic source ownership.",
  "scope": {
    "owns": [
      "Studio Analysis Source Binding semantics"
    ],
    "does_not_own": [
      "source domain semantics",
      "runtime authorization",
      "projection source ownership"
    ]
  },
  "members": [
    {
      "id": "TOPIC_STUDIO_ANALYSIS_SOURCE_BINDING",
      "name": "Studio Analysis Source Binding",
      "type": "topic",
