  "semantics": {
    "input": "repository root",
    "bootstrap_file": "AIGMos_Canonical_Contract_Format_v1.4.0.json",
    "sequence": [
      "resolve exact root",
      "read bytes",
      "parse bootstrap format",
      "validate bootstrap self-profile",
      "publish immutable bootstrap context"
    ],
    "failure_rule": "Any missing/ambiguous/invalid bootstrap blocks downstream canonical loading.",
    "history_rule": "history/bootstrap is never searched as active fallback.",
    "authority_rule": "Loader executes interpretation only; it does not modify source."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "fallback to canonical/json format file",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "select newest format",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "continue after bootstrap validation failure",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "mutate root bootstrap",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "search history as active source",
        "result": "hard_fail"
      }
    ]
  },
