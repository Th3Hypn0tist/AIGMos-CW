        "id": "GATE_2",
        "condition": "array semantic order ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "base omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "candidate applied during diff",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "breaking change hidden",
        "result": "hard_fail"
      }
    ]
