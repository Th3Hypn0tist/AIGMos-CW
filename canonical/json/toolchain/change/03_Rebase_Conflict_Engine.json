  "semantics": {
    "base_rule": "Patch base/current accepted/candidate changes are exact.",
    "overlap_rule": "Overlapping semantic fields/identities produce conflict.",
    "safe_rule": "Only provably non-overlapping/representation-only changes auto-rebase.",
    "resolution_rule": "Conflicts remain explicit candidate decisions.",
    "order_rule": "Arrival time/mtime never resolves.",
    "output_rule": "Rebased patch remains candidate."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "last patch wins",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "mtime conflict resolution",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "semantic overlap auto-merged",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "identity rename hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "rebased patch auto-committed",
        "result": "hard_fail"
      }
    ]
  },
