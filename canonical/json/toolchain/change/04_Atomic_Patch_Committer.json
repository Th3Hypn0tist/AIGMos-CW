    "preconditions": [
      "validated_candidate",
      "resolved_blockers_or_allowed_exceptions",
      "exact_base_match",
      "repository_write_authority"
    ],
    "write_rule": "Only declared patch actions are written.",
    "atomic_rule": "Use atomic replace/transactional strategy where filesystem permits.",
    "failure_rule": "Partial write is detected and recovery/rollback evidence explicit.",
    "history_rule": "Prior accepted revision remains traceable.",
    "projection_rule": "Generated projections rebuild after source commit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "commit before validation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "partial write shown success",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "base mismatch ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "projection written before source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "write authority bypassed",
        "result": "hard_fail"
      }
    ]
  },
