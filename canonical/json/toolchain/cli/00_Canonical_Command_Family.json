    "root_rule": "`canonical` is non-executable family root by default.",
    "children": [
      "scan",
      "validate",
      "reconcile",
      "diff",
      "patch",
      "readiness",
      "lock",
      "project",
      "conformance",
      "report"
    ],
    "help_rule": "Family root carries master help.",
    "execution_rule": "Only explicit concrete descendants execute.",
    "authority_rule": "Command visibility grants no repo rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "canonical root executes magic default",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "child inferred from first directory",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "help command tree duplicated independently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "visibility grants rights",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "fuzzy command execution",
        "result": "hard_fail"
      }
    ]
  },
