    "commands": [
      "canonical.diff",
      "canonical.patch.validate",
      "canonical.patch.rebase",
      "canonical.patch.preview",
      "canonical.patch.commit"
    ],
    "base_rule": "Exact base/candidate refs required.",
    "preview_rule": "Preview/in-memory apply is inert.",
    "commit_rule": "Commit is separate exact command with normal authority.",
    "output_rule": "Semantic diff/conflict/report refs emitted.",
    "safety_rule": "No implicit commit."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "preview commits",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "diff uses text only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "commit target guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "stale base ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "patch open applies changes",
        "result": "hard_fail"
      }
    ]
  },
