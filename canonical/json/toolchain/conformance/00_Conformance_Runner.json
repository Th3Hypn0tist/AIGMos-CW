    "identity_rule": "Each run explicit identity.",
    "snapshot_rule": "Exact source/bootstrap/registry snapshot.",
    "profile_rule": "Exact conformance profile.",
    "checks": [
      "bootstrap",
      "format",
      "structure",
      "semantic",
      "identity",
      "references",
      "ownership",
      "source_roles",
      "readiness",
      "projections",
      "cross_kernel"
    ],
    "result_rule": "Findings/results immutable evidence.",
    "mutation_rule": "Runner read-only."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "runner fixes source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "profile omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed check skipped",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "snapshot changed mid-run",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "pass auto-locks",
        "result": "hard_fail"
      }
    ]
  },
