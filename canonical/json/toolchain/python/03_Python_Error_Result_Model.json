  "semantics": {
    "finding_rule": "Invalid user/repository content produces structured findings/results.",
    "exception_rule": "I/O/programming/environment failures use typed exceptions/errors.",
    "boundary_rule": "Exceptions are caught at stage/CLI boundaries and converted to explicit run error evidence.",
    "trace_rule": "Internal traceback is diagnostic and not canonical finding identity.",
    "exit_rule": "CLI maps result/error classes deterministically to exit status.",
    "secret_rule": "Errors redact protected values."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "all findings thrown as generic exceptions",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "traceback shown as canonical report",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "exception swallowed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "secret in traceback exported",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "exit code random",
        "result": "hard_fail"
      }
    ]
  },
