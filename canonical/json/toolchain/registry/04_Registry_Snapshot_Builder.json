    "identity_rule": "Each combined snapshot has explicit identity.",
    "input_rule": "Exact scan/source/bootstrap snapshot inputs recorded.",
    "members": [
      "identity_registry",
      "reference_graph",
      "alias_registry",
      "ownership_registry",
      "dependency_graph",
      "topology_graph"
    ],
    "immutability_rule": "Snapshot immutable.",
    "cache_rule": "Cache invalidates on any source/profile input change.",
    "projection_rule": "Snapshot derived."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "stale registry mixed with new source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "snapshot mutated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "bootstrap omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "timestamp-only cache",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "snapshot becomes source truth",
        "result": "hard_fail"
      }
    ]
  },
