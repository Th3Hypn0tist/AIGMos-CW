    "identity_rule": "Each report explicit identity.",
    "run_rule": "Exact reconciliation run ref.",
    "snapshot_rule": "Exact source/bootstrap snapshot.",
    "finding_rule": "All blocking/advisory counts/refs exact.",
    "exception_rule": "Active exceptions explicit.",
    "readiness_rule": "Result state exact.",
    "projection_rule": "Report is evidence, not source truth."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "report says pass while blocker exists",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "source snapshot omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "exceptions hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "report becomes canonical source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "old report overwritten",
        "result": "hard_fail"
      }
    ]
  },
