  "semantics": {
    "source_rule": "Exact handover state identity input.",
    "content": [
      "bootstrap hash",
      "source snapshot",
      "locked/unlocked counts",
      "blockers",
      "exceptions",
      "projection refs",
      "next work"
    ],
    "truth_rule": "Unresolved work is never omitted to make status look complete.",
    "format_rule": "JSON is machine-readable projection.",
    "authority_rule": "Handover artifact non-authoritative."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "unlocked omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "blockers hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "handover declares complete falsely",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "projection becomes source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "next work invented without evidence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_HAND",
      "target_ref": "AIGMOS_CANONICAL_HANDOVER_STATE_CONTRACT",
      "purpose": "Builds exact handover projection."
    }
  ],
