  "semantics": {
    "identity_rule": "Each bundle explicit identity.",
    "snapshot_rule": "All member reports must refer to same compatible source/bootstrap snapshot or explicit derivation chain.",
    "member_rule": "Exact report/artifact refs/hashes.",
    "consistency_rule": "Mixed stale/current reports are rejected.",
    "format_rule": "Bundle may be zip/directory manifest projection.",
    "authority_rule": "Bundle does not become canonical source."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "mixed snapshots accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "latest report per type picked by mtime",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "bundle treated source",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "missing report ignored despite required profile",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "hashes omitted",
        "result": "hard_fail"
      }
    ]
  },
