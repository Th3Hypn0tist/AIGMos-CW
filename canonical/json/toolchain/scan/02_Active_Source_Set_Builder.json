        "condition": "duplicate resolved by newest",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "bootstrap included as ordinary canonical definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "source set depends on traversal order",
