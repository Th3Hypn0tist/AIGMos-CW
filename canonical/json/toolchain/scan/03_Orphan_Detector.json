    "input_rule": "Consumes classified inventory plus generator/reference metadata.",
    "finding_rule": "Unclassified/unlinked artifacts produce candidate orphan findings.",
    "delete_rule": "Detector never deletes.",
    "false_positive_rule": "Intentional repository artifacts can be explicitly classified.",
    "report_rule": "Every finding includes path/hash/reason.",
    "authority_rule": "Cleanup remains separate change operation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "orphan auto-deleted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unreferenced equals obsolete universally",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "tool files marked orphan",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "history marked orphan",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "finding lacks path",
        "result": "hard_fail"
      }
    ]
  },
