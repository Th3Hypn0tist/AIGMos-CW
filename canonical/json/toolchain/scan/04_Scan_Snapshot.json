    "identity_rule": "Each scan snapshot has explicit identity.",
    "inventory_rule": "Exact inventory entries and classifications are frozen.",
    "source_set_rule": "Exact active-source membership is frozen.",
    "hash_rule": "Material file hashes are included.",
    "immutability_rule": "Any tree change requires new snapshot.",
    "repro_rule": "Equivalent tree/profile yields semantically equivalent snapshot."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "snapshot updated in place",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "file changes ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "source role missing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "hash omitted for conflicting file",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "snapshot selected by timestamp only",
        "result": "hard_fail"
      }
    ]
  },
