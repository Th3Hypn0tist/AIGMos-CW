    "events": [],
    "flows": []
  },
  "semantics": {
    "identity_rule": "Each finding has explicit stable execution-scoped identity.",
    "fields": [
      "category",
      "severity",
      "rule_ref",
      "source_ref",
      "json_path",
      "target_ref",
      "message",
      "blocking",
      "status"
    ],
    "dedupe_rule": "Equivalent findings may be deduplicated by exact signature/profile.",
    "status_rule": "open/resolved/accepted_exception states explicit.",
    "provenance_rule": "Finding retains producing stage/execution.",
    "authority_rule": "Finding registry is evidence only."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOOLING_NONAUTHORITY",
        "rule": "Toolchain code, scans, indexes, reports and generated artifacts remain implementation/evidence surfaces; they never become canonical semantic authority unless an explicit accepted canonical definition says so."
      },
      {
        "id": "DETERMINISTIC_EXACT_INPUTS",
        "rule": "Every toolchain execution binds exact bootstrap/source/profile/input revisions and must not resolve ambiguity through filesystem order, newest-wins, mtime, fuzzy names or UI layout."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "finding identified by message text only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "resolved without rerun",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "blocking omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "duplicate hidden by nearest match",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "registry edits source",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_BLOCK",
      "target_ref": "AIGMOS_RECONCILIATION_BLOCKER_REGISTRY_CONTRACT",
      "purpose": "Blocking findings feed reconciliation blockers."
    }
  ],
  "prose": {
    "summary": "Define normalized machine registry for parser, validation, reconciliation, readiness and conformance findings.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation.",
      "Implementation contracts operationalize canonical semantics but do not replace canonical source authority."
    ]
  },
