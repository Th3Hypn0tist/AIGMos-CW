  "semantics": {
    "identity_rule": "Each tool has an explicit stable identity.",
    "schema_rule": "Input/output schema is explicit.",
    "capability_rule": "Capabilities are explicit and validated.",
    "effect_rule": "Side-effect class is explicit.",
    "implementation_rule": "Implementation/provider binding is explicit.",
    "availability_rule": "Registered/available/enabled/invocable are separate states.",
    "authority_rule": "Tool registration/availability does not grant invocation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "DEFINITION_INVOCATION_EXECUTION_SEPARATION",
        "rule": "Command, Routine, Trigger, Schedule, Tool and model definitions remain separate from invocations, requests, executions and results; definitions never create effects merely by existing."
      },
      {
        "id": "AUTOMATION_EFFECT_BOUNDARY",
        "rule": "Automated work still resolves exact operation/target/context and must cross validation, authorization and dispatcher boundaries before any effect occurs."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "tool name alone used as identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "schema omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "available means authorized",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "MCP advert auto-registers trusted tool",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "side effects hidden",
        "result": "hard_fail"
