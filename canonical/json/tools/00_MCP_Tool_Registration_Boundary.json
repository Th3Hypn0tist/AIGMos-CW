    "format_version": "1.6"
  },
  "identity": {
    "id": "AIGMOS_MCP_TOOL_REGISTRATION_BOUNDARY_CONTRACT",
    "name": "MCP to Tool Registry Boundary",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the explicit validation/registration boundary by which an MCP-advertised capability may become a runtime tool under `#T`.",
  "scope": {
    "owns": [
      "MCP to Tool Registry Boundary semantics"
    ],
    "does_not_own": [
      "external MCP implementation semantics",
      "AccessCore policy ownership",
      "domain business semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_MCP_TOOL_REGISTRATION_BOUNDARY",
      "name": "MCP to Tool Registry Boundary",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the explicit validation/registration boundary by which an MCP-advertised capability may become a runtime tool under `#T`.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "target_root": "#T",
    "flow": [
      "observe advertisement",
      "normalize",
      "validate schema/capabilities",
      "assign/resolve canonical tool identity",
      "bind endpoint capability",
      "authorize registration",
      "register disabled/available state"
    ],
    "identity_rule": "Canonical #T tool identity is explicit and distinct from MCP advertisement identity.",
    "binding_rule": "Registered tool retains exact endpoint+advertisement provenance.",
    "registration_rule": "Registration is an explicit operation and never a side effect of MCP discovery.",
    "state_rule": "registered, available, enabled and invocable are separate states.",
    "authority_rule": "Registration does not grant callers invocation authority.",
    "replacement_rule": "Capability changes require explicit revalidation/reconciliation."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MCP_TOOL_SEPARATION",
        "rule": "MCP endpoint identity, advertised capability, validated #T tool identity, concrete invocation and returned result are separate identities; advertisement or availability never grants execution authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "MCP discovery auto-registers tool",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "advertisement id reused as canonical tool identity without explicit mapping",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "registration auto-enables tool",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "caller authority derived from registration",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "changed MCP capability silently replaces validated binding",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ADV",
      "target_ref": "AIGMOS_MCP_CAPABILITY_ADVERTISEMENT_CONTRACT",
      "purpose": "Only validated advertisements may cross into #T."
    },
    {
      "id": "REF_TROOT",
      "target_ref": "AIGMOS_T_TOOL_ROOT_CONTRACT",
      "purpose": "#T owns validated runtime tool registry identities."
    }
  ],
  "prose": {
    "summary": "Define the explicit validation/registration boundary by which an MCP-advertised capability may become a runtime tool under `#T`.",
    "notes": [
      "Unlocked pending reconciliation against #MCP, #T, q-family and command-dispatch contracts."
    ]
  },
