      {
        "id": "GATE_1",
        "condition": "tool input schema missing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "endpoint capability mismatch ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "execution unbounded where bound required",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "unknown arguments silently accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "schema compatibility treated as authorization",
        "result": "hard_fail"
      }
    ]
