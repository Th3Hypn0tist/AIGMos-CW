  "semantics": {
    "inheritance_rule": "Topic may reference one or more parent Topics.",
    "multi_parent_rule": "Multiple parent Topics are valid when the child genuinely spans several semantic groupings.",
    "transitive_rule": "Inherited Topic membership is recursively resolvable.",
    "identity_rule": "Child Topic retains its own identity and does not merge into parent identity.",
    "structure_rule": "Topic inheritance is classification inheritance, not structural containment.",
    "cycle_rule": "Inheritance cycles must be explicitly valid under the Topic model or hard-fail."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOPIC_GRAPH_EXPLICIT",
        "rule": "Every machine-significant canonical node is classified by explicit Topic membership or explicitly marked outsider; Topics may inherit and compose other Topics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "Topic inheritance collapses child identity into parent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "multiple parent Topics rejected without semantic reason",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "inheritance interpreted as ownership/containment",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "recursive inherited Topic resolution is impossible",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "invalid Topic inheritance cycle accepted",
        "result": "hard_fail"
      }
    ]
  },
