      "semantics": {
        "purpose": "Define outsider as an explicit visible classification for canonical nodes that do not yet belong to any existing Topic, preventing silent unclassified semantics.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_OUTSIDER_MARK",
        "name": "Mark canonical node as outsider",
        "inputs": [
          "node_ref",
          "reason",
          "review metadata"
        ],
        "outputs": [
          "outsider classification"
        ],
        "errors": [
          "node unresolved",
          "reason missing"
        ],
        "side_effects": [
          "Topic coverage state updated"
        ]
      },
      {
        "id": "OP_OUTSIDER_REVIEW",
        "name": "Review outsider",
        "inputs": [
          "outsider node",
          "current Topic graph"
        ],
        "outputs": [
          "remain outsider | assign existing Topic | create Topic"
        ],
        "errors": [],
        "side_effects": [
          "Topic graph may update"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "rule": "A node with zero Topic memberships must be explicitly marked outsider.",
    "visibility_rule": "Outsider state is machine-visible and human-visible.",
    "reason_rule": "Outsider classification records why no current Topic applies.",
    "review_rule": "Outsiders are candidates for assignment to an existing Topic or creation of a new Topic.",
    "non_error_rule": "Outsider may be a valid temporary semantic state, but never an invisible omission.",
    "lock_rule": "Lock eligibility must explicitly account for remaining outsiders."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOPIC_GRAPH_EXPLICIT",
        "rule": "Every machine-significant canonical node is classified by explicit Topic membership or explicitly marked outsider; Topics may inherit and compose other Topics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "zero-Topic node is silently accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "outsider lacks reason/visibility",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "outsider automatically assigned by heuristic",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "lock validation ignores outsider state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "outsider treated as ownership/authority state",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
