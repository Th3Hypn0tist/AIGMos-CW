{
  "format": {
    "contract_format": "CANONICAL_CONTRACT",
    "format_version": "1.6"
  },
  "identity": {
    "id": "AIGMOS_TOPIC_CHANGE_PLACEMENT_CONTRACT",
    "name": "Topic-Guided Change Placement",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define Topic-first placement for new specification material: determine all applicable existing Topics first, create additional Topics freely when needed, and keep cross-cutting mechanisms traceable through every affected semantic chain.",
  "scope": {
    "owns": [
      "Topic-Guided Change Placement semantics"
    ],
    "does_not_own": [
      "runtime implementation details",
      "presentation semantics"
    ]
  },
  "members": [
    {
      "id": "TOPIC_TOPIC_CHANGE",
      "name": "Topic-Guided Change",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define Topic-first placement for new specification material: determine all applicable existing Topics first, create additional Topics freely when needed, and keep cross-cutting mechanisms traceable through every affected semantic chain.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [
      {
        "id": "OP_TOPIC_PLACE_CHANGE",
        "name": "Place new semantic change by Topic",
        "inputs": [
          "candidate semantics",
          "existing Topic graph"
        ],
        "outputs": [
          "existing Topic assignments | new Topic proposal"
        ],
        "errors": [
          "semantic placement unresolved"
        ],
        "side_effects": []
      },
      {
        "id": "OP_TOPIC_NEW_DEFINE",
        "name": "Define new Topic for change",
        "inputs": [
          "Topic identity",
          "purpose",
          "parents/components",
          "candidate members"
        ],
        "outputs": [
          "new Topic definition"
        ],
        "errors": [
          "identity collision",
          "invalid refs"
        ],
        "side_effects": [
          "Topic graph updated"
        ]
      }
    ],
    "events": [],
    "flows": []
  },
  "semantics": {
    "decision_sequence": [
      "identify the semantic mechanism/change",
      "resolve all existing Topics it belongs to",
      "assign all applicable Topic memberships",
      "if coverage remains semantically incomplete, define a new Topic",
      "compose/inherit existing Topics where that expresses the mechanism",
      "otherwise mark outsider explicitly until resolved"
    ],
    "multi_topic_rule": "A mechanism may belong to multiple Topics; e.g. Trigger can be its own Topic and also belong to Core.",
    "chain_rule": "A mechanism such as order creation may be its own Topic and span the entire affected chain.",
    "local_rule": "Topic declarations stay with the nodes/subtrees they classify for recursive readability.",
    "no_scarcity_rule": "Do not reduce Topic count at the cost of semantic clarity.",
    "documentation_rule": "Prefer Topic inheritance/composition over redundant explanatory documents."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TOPIC_GRAPH_EXPLICIT",
        "rule": "Every machine-significant canonical node is classified by explicit Topic membership or explicitly marked outsider; Topics may inherit and compose other Topics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "change forced into exactly one Topic",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "new Topic suppressed solely to minimize Topic count",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "cross-cutting chain effects omitted from Topic membership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "Topic stored only in disconnected central directory when local recursive declaration is required",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "redundant documentation created where Topic composition expresses the mechanism",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_MEMBERSHIP",
      "target_ref": "AIGMOS_TOPIC_MEMBERSHIP_CONTRACT",
      "purpose": "Changes receive explicit memberships."
    },
    {
      "id": "REF_COMPOSITION",
      "target_ref": "AIGMOS_TOPIC_COMPOSITION_CONTRACT",
      "purpose": "Cross-cutting mechanisms may compose existing Topics."
    }
  ],
  "prose": {
    "summary": "Define Topic-first placement for new specification material: determine all applicable existing Topics first, create additional Topics freely when needed, and keep cross-cutting mechanisms traceable through every affected semantic chain.",
    "notes": [
      "Unlocked until reconciled against the assembled 1.4 Topic graph and repository-wide validation."
    ]
  },
