    "name": "WebRTC Peer Transport",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define WebRTC as the peer-to-peer transport binding used by DWH and messaging where configured, keeping peer semantic identity separate from transient ICE/session/channel state.",
  "scope": {
    "owns": [
      "WebRTC Peer Transport semantics"
    ],
    "does_not_own": [
      "application payload semantics",
      "IdentityCore identity ownership",
      "AccessCore authorization policy"
    ]
  },
  "members": [
    {
      "id": "TOPIC_WEBRTC_TRANSPORT",
      "name": "WebRTC Peer Transport",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define WebRTC as the peer-to-peer transport binding used by DWH and messaging where configured, keeping peer semantic identity separate from transient ICE/session/channel state.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
