  "semantics": {
    "protocol": "WebRTC",
    "role": "peer transport",
    "identity_rule": "Peer semantic identity is explicit and independent from ICE candidate, DTLS/SRTP session or data-channel identifier.",
    "p2p_rule": "Application payload path is peer-to-peer after successful establishment.",
    "signaling_rule": "Signaling/rendezvous is bootstrap coordination only.",
    "channel_rule": "Data channels are transient transport resources.",
    "cleanup_rule": "Failed/closed/cancelled transport releases channel/session/ICE resources.",
    "authority_rule": "Successful WebRTC establishment does not grant application data or operation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_SECURITY_SEPARATION",
        "rule": "Transport session, cryptographic material, signaling metadata and semantic identity remain separate; secure transport never implies application authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "ICE/session id used as semantic peer identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "successful transport grants application authorization",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "signaling relay treated as default payload path",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "closed session leaks transport resources",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "peer identity inferred solely from network endpoint",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_MSG",
      "target_ref": "AIGMOS_P2P_MESSAGING_CONTRACT",
      "purpose": "Messaging may use WebRTC peer transport."
    },
    {
      "id": "REF_DWH",
      "target_ref": "AIGMOS_DWH_TRANSPORT_ENVELOPE_CONTRACT",
      "purpose": "DWH may use WebRTC for remote payload transport."
    }
  ],
  "prose": {
    "summary": "Define WebRTC as the peer-to-peer transport binding used by DWH and messaging where configured, keeping peer semantic identity separate from transient ICE/session/channel state.",
    "notes": [
      "Unlocked pending reconciliation against existing WebRTC/PGP/rendezvous contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
