  "semantics": {
    "role": "peer discovery/bootstrap/signaling",
    "official_rule": "Official rendezvous/signaling service may be available to applicable license holders.",
    "private_rule": "Private rendezvous/signaling service is permitted where supported.",
    "metadata_rule": "Service carries only metadata required for peer discovery/session establishment.",
    "payload_rule": "Application payload is not owned by or semantically terminated at rendezvous.",
    "cleanup_rule": "Bootstrap records are removed or expired after establishment/cancellation according to explicit policy.",
    "identity_rule": "Rendezvous record/session identity is not the peer's semantic identity.",
    "availability_rule": "Relay availability is service state and not license or peer identity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_SECURITY_SEPARATION",
        "rule": "Transport session, cryptographic material, signaling metadata and semantic identity remain separate; secure transport never implies application authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "rendezvous stores application payload by default",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "rendezvous record becomes peer semantic identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "private relay forbidden without explicit rule",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "bootstrap metadata retained indefinitely without policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "relay availability treated as authorization",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_CLEAN",
      "target_ref": "AIGMOS_MESSAGING_RENDEZVOUS_CLEANUP_CONTRACT",
      "purpose": "Bootstrap metadata is bounded and cleaned."
    },
    {
      "id": "REF_LICENSE",
      "target_ref": "AIGMOS_LICENSED_SHARED_SERVICES_CONTRACT",
      "purpose": "Official rendezvous is a licensed shared service where applicable."
    }
  ],
  "prose": {
    "summary": "Define rendezvous/signaling as explicit bootstrap metadata exchange for peer establishment, with official licensed relay and private relay options, and no ownership of application payload semantics.",
