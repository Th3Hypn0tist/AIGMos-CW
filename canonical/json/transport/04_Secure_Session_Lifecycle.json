  },
  "identity": {
    "id": "AIGMOS_SECURE_SESSION_LIFECYCLE_CONTRACT",
    "name": "Secure Session Lifecycle",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define bounded secure transport session lifecycle from configured peer through signaling, handshake, protected channel readiness, active exchange, expiry/cancel/error and cleanup.",
  "scope": {
    "owns": [
      "Secure Session Lifecycle semantics"
    ],
    "does_not_own": [
      "application payload semantics",
      "IdentityCore identity ownership",
      "AccessCore authorization policy"
    ]
  },
  "members": [
    {
      "id": "TOPIC_SECURE_SESSION_LIFECYCLE",
      "name": "Secure Session Lifecycle",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define bounded secure transport session lifecycle from configured peer through signaling, handshake, protected channel readiness, active exchange, expiry/cancel/error and cleanup.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "states": [
      "configured",
      "discovering",
      "signaling",
      "handshaking",
      "secure_ready",
      "active",
      "expiring",
      "closed",
      "failed"
    ],
    "transition_rule": "State transitions are explicit and observable.",
    "ready_rule": "Application payload is accepted only after required handshake/protection state reaches secure_ready/active.",
    "timeout_rule": "Discovery/signaling/handshake/session idle/expiry limits are explicit and finite.",
    "cleanup_rule": "All terminal paths release transient signaling/channel/session-key resources.",
    "identity_rule": "Session lifecycle state never redefines peer semantic identity.",
    "reauth_rule": "Transport session renewal does not replace IAM/AccessCore reauthentication where resource policy requires it.",
    "failure_rule": "Failure never silently downgrades to an unprotected channel."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TRANSPORT_SECURITY_SEPARATION",
        "rule": "Transport session, cryptographic material, signaling metadata and semantic identity remain separate; secure transport never implies application authorization."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "application payload accepted before required secure state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "handshake timeout unbounded",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failure downgrades silently to insecure transport",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "session cleanup omits keys/channels/signaling state",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "transport renewal bypasses required IAM/AC reauth",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_WEBRTC",
      "target_ref": "AIGMOS_WEBRTC_TRANSPORT_CONTRACT",
      "purpose": "Lifecycle governs peer transport."
    },
    {
      "id": "REF_PGP",
      "target_ref": "AIGMOS_PGP_SESSION_PROTECTION_CONTRACT",
      "purpose": "Lifecycle owns session-key/protection cleanup."
    }
  ],
  "prose": {
    "summary": "Define bounded secure transport session lifecycle from configured peer through signaling, handshake, protected channel readiness, active exchange, expiry/cancel/error and cleanup.",
    "notes": [
      "Unlocked pending reconciliation against existing WebRTC/PGP/rendezvous contracts and whole-tree Contract Format 1.4 validation."
