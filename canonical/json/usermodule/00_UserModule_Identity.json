    "root": "#UM",
    "identity_rule": "Every UserModule definition has an explicit stable canonical identity.",
    "path_rule": "Library/storage/package path is discovery/distribution metadata, not semantic identity.",
    "instance_rule": "A runtime UserModule instance has its own explicit identity where multiple instances are possible.",
    "type_rule": "Primary UserModule type is explicit and validated.",
    "version_rule": "Additive evolution may preserve identity/version compatibility; breaking semantics require the owning versioning rule/new identity.",
    "registry_rule": "Registered definition and runtime availability/lifecycle are separate.",
    "authority_rule": "Module registration/visibility does not grant execution or mutation authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "USERMODULE_TYPE_LIFECYCLE_EXPLICIT",
        "rule": "UserModule identity, primary type, schema, instance identity and lifecycle state are explicit and never inferred from filesystem location or implementation behavior."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "module identity inferred solely from path/package filename",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "definition identity conflated with instance identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "module type inferred from code behavior only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "registered module treated as running",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "registration grants authority",
        "result": "hard_fail"
      }
    ]
  },
