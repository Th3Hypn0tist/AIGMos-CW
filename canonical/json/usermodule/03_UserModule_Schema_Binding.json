    "schema_rule": "UserModule references an explicit canonical schema identity/version.",
    "existing_rule": "Instance Editor may create a module/schema binding from an existing compatible schema without copying semantic ownership.",
    "domain_rule": "Selected Domain modules are explicit composition refs rather than inferred imports.",
    "instance_rule": "Per-instance data binding is explicit and follows local/relation semantics where DWH applies.",
    "relation_rule": "Cross-schema/domain relations require explicit canonical relation refs.",
    "validation_rule": "Schema compatibility and required relations validate before module activation.",
    "ownership_rule": "Binding a schema/domain does not transfer ownership of their semantics to the UserModule."
  },
  "constraints": {
    "invariants": [
      {
        "id": "USERMODULE_TYPE_LIFECYCLE_EXPLICIT",
        "rule": "UserModule identity, primary type, schema, instance identity and lifecycle state are explicit and never inferred from filesystem location or implementation behavior."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "schema semantics copied into module as duplicate authority",
        "result": "hard_fail"
      },
      {
