        "condition": "domain module inferred from directory/import name only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "relation inferred without canonical ref",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "incompatible schema activated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "schema binding transfers semantic ownership",
        "result": "hard_fail"
      }
    ]
  },
