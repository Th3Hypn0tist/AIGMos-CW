  "semantics": {
    "boundary_rule": "Local module data is scoped to the full runtime UserModule instance identity.",
    "definition_rule": "Module definition identity and instance data identity are distinct.",
    "schema_rule": "Instance data surface follows the module's explicit schema binding.",
    "relation_rule": "Cross-instance access requires explicit canonical relation or remote/external binding.",
    "input_rule": "Input-type modules write only into their declared instance/input surfaces.",
    "view_rule": "View-type modules project data and do not acquire local data ownership merely by reading it.",
    "adapter_rule": "Adapter-type modules map between surfaces without merging their identities.",
    "isolation_rule": "Same schema/type/name across instances never merges their local data."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TYPE_BOUNDARY_EXPLICIT",
        "rule": "UserModule type behavior is explicit and narrow: input acquires/writes inert data, adapter translates/mounts, view projects, and no type silently acquires another type's authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "same schema merges instance data",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "instance data addressed only by module definition identity where multiple instances exist",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "cross-instance data read without relation/binding",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "view reading data transfers ownership",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "adapter mapping merges source/target identity",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_UM",
      "target_ref": "AIGMOS_USERMODULE_IDENTITY_CONTRACT",
      "purpose": "Instance data is scoped to explicit UserModule instance."
