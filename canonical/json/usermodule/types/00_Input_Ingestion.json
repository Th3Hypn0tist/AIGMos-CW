  "semantics": {
    "type": "input",
    "source_rule": "Input source identity/binding is explicit.",
    "validation_rule": "Incoming value/payload validates against the declared input/schema contract before write.",
    "write_rule": "Validated input writes to the full `#UM` instance data surface or declared `#INPUT:*` child surface.",
    "inert_rule": "Written input is inert data and never directly executes commands/operations.",
    "origin_rule": "Source/origin provenance is retained where machine-significant.",
    "lifecycle_rule": "Input listener/poller state is runtime state separate from input definition.",
    "authority_rule": "Ability to ingest/write input data does not grant arbitrary module mutation or command authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TYPE_BOUNDARY_EXPLICIT",
        "rule": "UserModule type behavior is explicit and narrow: input acquires/writes inert data, adapter translates/mounts, view projects, and no type silently acquires another type's authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "input payload directly executes command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "payload writes outside declared instance/input surface",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "input validation skipped",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "source/origin identity unavailable",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "input runtime listener state treated as definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "input write grants unrelated authority",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_INPUT",
      "target_ref": "AIGMOS_I_INPUT_ROOT_CONTRACT",
      "purpose": "Input type follows #I semantics."
    },
