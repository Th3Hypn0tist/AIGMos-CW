  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define Input-type UserModule behavior as acquisition/validation of external or local source data followed by explicit write into the module instance's declared inert data surface.",
  "scope": {
    "owns": [
      "UserModule Input Ingestion semantics"
    ],
    "does_not_own": [
      "unrelated module types",
      "AccessCore policy",
      "presentation semantics outside declared view scope"
    ]
  },
