      "id": "REF_DYN",
      "target_ref": "AIGMOS_INPUT_DYNAMIC_NAMESPACE_FAMILY_CONTRACT",
      "purpose": "Dynamic input instances use validated #INPUT:* children."
    }
  ],
  "prose": {
    "summary": "Define Input-type UserModule behavior as acquisition/validation of external or local source data followed by explicit write into the module instance's declared inert data surface.",
