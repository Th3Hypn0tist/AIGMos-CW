  "semantics": {
    "type": "adapter",
    "source_rule": "Adapter source identity/surface is explicit.",
    "target_rule": "Adapter target identity/surface is explicit.",
    "translation_rule": "Type/schema/address translation is explicit and validated.",
    "mount_rule": "Adapter may mount a source symbol into a target namespace according to namespace-mounting semantics.",
    "ownership_rule": "Adapter does not become semantic owner of source or target data.",
    "execution_rule": "Adapter has no independent hidden command/effect authority.",
    "failure_rule": "Unmappable/invalid input fails explicitly rather than guessing/normalizing arbitrary semantics."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TYPE_BOUNDARY_EXPLICIT",
        "rule": "UserModule type behavior is explicit and narrow: input acquires/writes inert data, adapter translates/mounts, view projects, and no type silently acquires another type's authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "adapter becomes semantic owner of source/target",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "adapter executes hidden command",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "source/target resolved fuzzily",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "invalid translation guessed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "mount bypasses namespace collision/authority validation",
        "result": "hard_fail"
      }
    ]
  },
