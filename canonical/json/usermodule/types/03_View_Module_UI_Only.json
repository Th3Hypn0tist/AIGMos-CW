    "type": "view",
    "projection_rule": "View projects existing canonical/runtime data into a human-facing representation.",
    "ownership_rule": "View does not own the domain semantics it displays.",
    "mutation_rule": "Any user action that changes state invokes a separate declared canonical operation owned elsewhere.",
    "layout_rule": "UI layout/grouping/order never creates semantic containment, dependency or authority.",
    "identity_rule": "Widget/control identity does not replace represented resource identity.",
    "authority_rule": "Visibility of a control/resource does not grant operation authority.",
    "failure_rule": "Unavailable/denied data is shown as such rather than synthesized."
  },
  "constraints": {
    "invariants": [
      {
        "id": "MODULE_TYPE_BOUNDARY",
        "rule": "Command, input, adapter and view module types have distinct effect boundaries: command is one-shot operation, input writes declared instance data, adapter mounts/translates symbols without owning them, and view is UI-only."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "view directly owns domain mutation",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "UI nesting creates semantic parent",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "visible control grants authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "widget identity replaces resource identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "denied data synthesized as valid",
        "result": "hard_fail"
      }
    ]
