    "checks": [
      "required node identities",
      "identity uniqueness",
      "canonical ref resolution",
      "registry target resolution",
      "external ref declaration",
      "historical-vs-active separation"
    ],
    "identity_rule": "Every required machine-significant node identity is present and exact.",
    "collision_rule": "Conflicting active identity definitions hard-fail.",
    "reference_rule": "Required internal refs resolve exactly once.",
    "external_rule": "External refs must be explicitly declared as external and follow their owning boundary contract.",
    "history_rule": "Historical/migration artifacts do not compete as active definitions.",
    "diagnostic_rule": "Every failed ref reports source identity, field/ref and attempted target."
  },
  "constraints": {
    "invariants": [
      {
        "id": "VALIDATION_NONAUTHORITATIVE",
        "rule": "Validation proves or rejects conformance; it never invents missing semantics or becomes semantic owner."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "required identity missing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "active identity collision",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "required internal ref unresolved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "required ref resolves ambiguously",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "undeclared external reference accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "historical source competes with active definition",
        "result": "hard_fail"
      }
    ]
  },
