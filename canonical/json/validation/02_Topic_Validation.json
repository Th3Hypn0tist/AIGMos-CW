    "name": "Topic Validation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define repository-wide validation of Topic membership, multi-Topic classification, inheritance, composition and explicit outsider state.",
  "scope": {
    "owns": [
      "Topic Validation semantics"
    ],
    "does_not_own": [
      "source semantic content",
      "runtime implementation",
      "presentation semantics"
    ]
  },
