        "purpose": "Define repository-wide validation of Topic membership, multi-Topic classification, inheritance, composition and explicit outsider state.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "checks": [
      "direct Topic membership",
      "multi-Topic preservation",
      "parent Topic refs",
      "composed Topic refs",
      "recursive Topic closure",
      "outsider classification",
      "Topic-local readability"
    ],
    "coverage_rule": "Every machine-significant canonical node resolves to one or more Topics or explicit outsider.",
    "multi_rule": "Validator preserves all applicable Topic memberships and never selects one canonical preferred Topic by default.",
    "inheritance_rule": "Parent chains resolve recursively.",
    "composition_rule": "Composed Topics retain all component traceability.",
    "outsider_rule": "Outsiders remain visible validation findings with reasons.",
    "locality_rule": "Topic information must be discoverable with the semantic nodes/subtrees it classifies according to the 1.4 Topic model."
  },
  "constraints": {
    "invariants": [
      {
        "id": "VALIDATION_NONAUTHORITATIVE",
        "rule": "Validation proves or rejects conformance; it never invents missing semantics or becomes semantic owner."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "node has no Topic and no outsider classification",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "multi-Topic membership collapsed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "parent/composed Topic ref unresolved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "invalid Topic recursion accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "outsider hidden from report",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "Topic semantics require disconnected undocumented lookup heuristic",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_TOPIC",
      "target_ref": "AIGMOS_TOPIC_COVERAGE_VALIDATION_CONTRACT",
      "purpose": "Validates full Topic coverage."
    },
    {
      "id": "REF_OUT",
      "target_ref": "AIGMOS_TOPIC_OUTSIDER_CONTRACT",
      "purpose": "Explicit outsider state is preserved."
    }
  ],
  "prose": {
    "summary": "Define repository-wide validation of Topic membership, multi-Topic classification, inheritance, composition and explicit outsider state.",
