  "semantics": {
    "dimensions": [
      "containment",
      "relation",
      "ownership",
      "authority",
      "dependency"
    ],
    "separation_rule": "Each structural edge is validated in its own dimension and is never inferred from another dimension.",
    "ownership_rule": "Every machine-significant owned semantic surface resolves to an authoritative owner.",
    "relation_rule": "Relation uses conform to explicit relation definitions/endpoints/cardinality where applicable.",
    "authority_rule": "Authority is never inferred from ownership, containment or Topic membership.",
    "dependency_rule": "Required dependencies resolve and missing dependencies are never silently enabled.",
    "composition_rule": "Domain/Universal Module/Meta compositions reference owned semantics instead of duplicating them."
  },
  "constraints": {
    "invariants": [
      {
        "id": "VALIDATION_NONAUTHORITATIVE",
        "rule": "Validation proves or rejects conformance; it never invents missing semantics or becomes semantic owner."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "structural dimensions collapsed",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "semantic owner missing/conflicting",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "relation use lacks valid relation definition",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "authority inferred from ownership/containment/Topic",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "required dependency unresolved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "composition duplicates authoritative substrate semantics",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
