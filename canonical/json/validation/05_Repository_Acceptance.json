  "semantics": {
    "required_dimensions": [
      "format",
      "identity_reference",
      "topic",
      "structure_ownership",
      "behavior_causality",
      "graph_closure",
      "migration_coverage",
      "repository_manifest",
      "source_roles",
      "lock_eligibility"
    ],
    "aggregation_rule": "Acceptance result retains each dimension separately; one passing score cannot hide another failing dimension.",
    "whole_tree_rule": "Acceptance is computed over the complete candidate active tree, not only changed files.",
    "migration_rule": "Retained legacy semantics are mapped, intentionally retired, or explicitly unresolved.",
    "outsider_rule": "Remaining outsiders are visible and evaluated against lock/replacement policy.",
    "replacement_rule": "Only accepted candidate tree is eligible for explicit clean-tree replacement approval.",
    "evidence_rule": "Acceptance emits machine-readable evidence refs suitable for repository-level lock state."
  },
  "constraints": {
    "invariants": [
      {
        "id": "VALIDATION_NONAUTHORITATIVE",
        "rule": "Validation proves or rejects conformance; it never invents missing semantics or becomes semantic owner."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "failing validation dimension hidden by aggregate pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "only changed files validated for final acceptance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "migration coverage incomplete but candidate accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "repository manifest/source-role closure incomplete",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "replacement approved without whole-tree acceptance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "repository locked without current acceptance evidence",
        "result": "hard_fail"
      }
    ]
  },
