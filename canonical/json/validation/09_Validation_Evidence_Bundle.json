  },
  "identity": {
    "id": "AIGMOS_VALIDATION_EVIDENCE_BUNDLE_CONTRACT",
    "name": "Validation Evidence Bundle",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define an immutable evidence bundle tying validation results to exact repository/package snapshots, manifests, hashes, migration coverage and validator metadata.",
  "scope": {
    "owns": [
      "Validation Evidence Bundle semantics"
    ],
    "does_not_own": [
      "validated source semantics",
      "runtime implementation",
      "presentation-only reporting"
    ]
  },
  "members": [
    {
      "id": "TOPIC_VALIDATION_EVIDENCE",
      "name": "Validation Evidence Bundle",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define an immutable evidence bundle tying validation results to exact repository/package snapshots, manifests, hashes, migration coverage and validator metadata.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "bundle_contents": [
      "validation result refs",
      "repository manifest ref",
      "Master ref",
      "target snapshot/hash refs",
      "migration report refs",
      "closure report refs",
      "applied exception refs",
      "validator metadata"
    ],
    "snapshot_rule": "Evidence bundle identifies the exact validated candidate tree.",
    "hash_rule": "Where physical-package integrity matters, evidence references applicable package/member hashes.",
    "trace_rule": "Every acceptance/lock decision can trace to its evidence bundle.",
    "immutability_rule": "Evidence bundle is immutable once issued.",
    "staleness_rule": "Any semantic/source change outside the validated snapshot makes prior evidence stale for the changed scope.",
    "export_rule": "Evidence may be packaged/exported without changing semantic meaning."
  },
  "constraints": {
    "invariants": [
      {
        "id": "VALIDATION_EVIDENCE_EXPLICIT",
        "rule": "Validation outcomes, findings, exceptions, evidence, baselines and release decisions are explicit machine-readable facts and never silently rewrite source semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "evidence bundle cannot identify exact candidate snapshot",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "lock/acceptance decision lacks evidence trace",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "bundle mutated after issuance",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "changed source continues using stale evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "bundle claims physical integrity without applicable hash evidence",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_RESULT",
      "target_ref": "AIGMOS_VALIDATION_RESULT_MODEL_CONTRACT",
      "purpose": "Evidence bundle includes immutable validation results."
    },
    {
      "id": "REF_HASH",
      "target_ref": "AIGMOS_DISTRIBUTION_HASH_MANIFEST_CONTRACT",
      "purpose": "Package integrity may be anchored by hashes."
    }
  ],
  "prose": {
    "summary": "Define an immutable evidence bundle tying validation results to exact repository/package snapshots, manifests, hashes, migration coverage and validator metadata.",
    "notes": [
      "Unlocked until exercised against the complete clean Contract Format 1.4 candidate tree."
    ]
  },
