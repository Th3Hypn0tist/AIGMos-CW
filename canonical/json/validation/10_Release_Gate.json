  "identity": {
    "id": "AIGMOS_CANONICAL_RELEASE_GATE_CONTRACT",
    "name": "Canonical Release Gate",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define the final machine-readable release/replacement gate for a Contract Format 1.4 canonical tree, composing repository acceptance, evidence freshness, regression status and explicit approval.",
  "scope": {
    "owns": [
      "Canonical Release Gate semantics"
    ],
    "does_not_own": [
      "validated source semantics",
      "runtime implementation",
      "presentation-only reporting"
    ]
  },
  "members": [
    {
      "id": "TOPIC_VALIDATION_RELEASE_GATE",
      "name": "Canonical Release Gate",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define the final machine-readable release/replacement gate for a Contract Format 1.4 canonical tree, composing repository acceptance, evidence freshness, regression status and explicit approval.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "required_inputs": [
      "repository acceptance result",
      "validation evidence bundle",
      "migration coverage result",
      "graph closure result",
      "regression comparison",
      "replacement/release approval"
    ],
    "gate_states": [
      "blocked",
      "ready_for_approval",
      "approved"
    ],
    "blocked_rule": "Any mandatory failing/incomplete dimension, stale evidence or unresolved regression blocks release.",
    "ready_rule": "ready_for_approval means all machine gates pass but explicit approval has not yet been recorded.",
    "approval_rule": "approved requires explicit authorized approval and exact candidate snapshot identity.",
    "replacement_rule": "Only approved candidate is eligible to replace the current canonical tree.",
    "change_rule": "Any semantic change after approval invalidates approval for the changed snapshot and returns the candidate to validation.",
    "lock_rule": "Repository-level locked/released state traces to the exact approved evidence bundle.",
    "rollback_rule": "Release metadata preserves previous accepted snapshot for rollback/recovery."
  },
  "constraints": {
    "invariants": [
      {
        "id": "VALIDATION_EVIDENCE_EXPLICIT",
        "rule": "Validation outcomes, findings, exceptions, evidence, baselines and release decisions are explicit machine-readable facts and never silently rewrite source semantics."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "release proceeds with failing/incomplete mandatory dimension",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "stale evidence accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "unexpected regression ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "machine gates silently auto-approve replacement",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "approved snapshot changed without invalidating approval",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "release lacks rollback/previous snapshot trace",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_ACCEPT",
      "target_ref": "AIGMOS_REPOSITORY_ACCEPTANCE_CONTRACT",
      "purpose": "Release requires whole-tree repository acceptance."
    },
    {
      "id": "REF_EVID",
      "target_ref": "AIGMOS_VALIDATION_EVIDENCE_BUNDLE_CONTRACT",
      "purpose": "Release is tied to immutable current evidence."
    },
    {
      "id": "REF_REPLACE",
      "target_ref": "AIGMOS_CANONICAL_CLEAN_TREE_REPLACEMENT_CONTRACT",
      "purpose": "Approved release candidate may replace the old tree."
    }
  ],
  "prose": {
    "summary": "Define the final machine-readable release/replacement gate for a Contract Format 1.4 canonical tree, composing repository acceptance, evidence freshness, regression status and explicit approval.",
    "notes": [
