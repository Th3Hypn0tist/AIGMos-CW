  "constraints": {
    "invariants": [
      {
        "id": "LOCALIZATION_PRESENTATION_ONLY",
        "rule": "Localization changes human-facing labels and explanatory text only; canonical identities, commands and machine semantics remain language-independent."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "translated command/internal identifier detected but accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "placeholder compatibility broken",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "coverage calculated from filesystem names instead of label registry",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "stale translation remains marked reviewed after incompatible source/context change",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "missing label identity hidden",
        "result": "hard_fail"
      }
    ]
  },
