  },
  "identity": {
    "id": "AIGMOS_LOCALIZATION_VALIDATION_CONTRACT",
    "name": "Localization Validation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define machine validation of label identity, context, translation coverage, placeholder compatibility and machine-identifier separation across language packs.",
  "scope": {
    "owns": [
      "Localization Validation semantics"
    ],
    "does_not_own": [
      "command identities",
      "internal canonical identifiers",
      "domain semantics outside label presentation"
    ]
  },
  "members": [
    {
      "id": "TOPIC_LOCALIZATION_VALIDATION",
      "name": "Localization Validation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define machine validation of label identity, context, translation coverage, placeholder compatibility and machine-identifier separation across language packs.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "checks": [
      "label identity uniqueness",
      "source/context completeness",
      "pack key resolution",
      "required language coverage",
      "placeholder/token compatibility",
      "machine identifier non-translation",
      "fallback determinism"
    ],
    "placeholder_rule": "Runtime placeholders/tokens present in source text must remain semantically compatible in translations.",
    "coverage_rule": "Coverage is measured against the active label registry/snapshot.",
    "language_rule": "Each declared language pack validates independently.",
    "severity_rule": "Missing optional translation may be warning; missing required release translation follows deployment/release policy.",
    "diff_rule": "Changed source/context invalidates translation review state where policy requires.",
    "report_rule": "Validation reports missing/stale/invalid translations by exact label identity."
  },
  "constraints": {
    "invariants": [
      {
        "id": "LOCALIZATION_PRESENTATION_ONLY",
        "rule": "Localization changes human-facing labels and explanatory text only; canonical identities, commands and machine semantics remain language-independent."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "translated command/internal identifier detected but accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "placeholder compatibility broken",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "coverage calculated from filesystem names instead of label registry",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "stale translation remains marked reviewed after incompatible source/context change",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "missing label identity hidden",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_LABEL",
      "target_ref": "AIGMOS_CANONICAL_UI_LABEL_CONTRACT",
      "purpose": "Validation operates over canonical labels."
    },
    {
      "id": "REF_PACK",
      "target_ref": "AIGMOS_LANGUAGE_PACK_CONTRACT",
      "purpose": "Validation checks each pack."
    }
  ],
  "prose": {
    "summary": "Define machine validation of label identity, context, translation coverage, placeholder compatibility and machine-identifier separation across language packs.",
    "notes": [
      "Unlocked pending reconciliation against Expose/UI label contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
