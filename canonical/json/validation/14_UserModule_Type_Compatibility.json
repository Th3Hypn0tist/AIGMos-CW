        "condition": "input directly executes payload",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "adapter owns hidden effects",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "broad composite misdeclared as narrow single type",
        "result": "hard_fail"
      },
