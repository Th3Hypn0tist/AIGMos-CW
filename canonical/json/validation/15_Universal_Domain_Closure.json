    "name": "Universal Module and Domain Closure Validation",
    "type": "canonical_contract",
    "version": "1.0"
  },
  "status": "unlocked",
  "source_role": "definition",
  "purpose": "Define repository-wide closure validation for Universal Module substrates and Domain compositions, including owner uniqueness, unresolved refs, duplicate semantics and circular dependency safety.",
  "scope": {
    "owns": [
      "Universal Module and Domain Closure Validation semantics"
    ],
    "does_not_own": [
      "component semantics owned elsewhere",
      "presentation-only grouping",
      "runtime authorization"
    ]
  },
  "members": [
    {
      "id": "TOPIC_UNIVERSAL_DOMAIN_CLOSURE_VALIDATION",
      "name": "Universal Module and Domain Closure Validation",
      "type": "topic",
      "status": "unlocked",
      "semantics": {
        "purpose": "Define repository-wide closure validation for Universal Module substrates and Domain compositions, including owner uniqueness, unresolved refs, duplicate semantics and circular dependency safety.",
        "metadata": {}
      }
    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "checks": [
      "Universal Module identity uniqueness",
      "substrate owner completeness",
      "Domain substrate refs",
      "Domain delta completeness",
      "binding validity",
      "dependency closure",
      "duplicate semantic ownership",
      "cycle safety"
    ],
    "owner_rule": "Every substrate semantic surface has exactly one authoritative owner.",
    "domain_rule": "Every Domain-resolved required component closes to an active accepted source.",
    "duplication_rule": "Copied substrate semantics inside Domain hard-fail unless explicitly distinct new delta semantics.",
    "cycle_rule": "Universal Module/Domain dependency cycles must satisfy explicit recursive semantics or hard-fail.",
    "dependency_rule": "Missing required substrate/dependency is never auto-enabled/invented.",
    "release_rule": "Closure failure blocks repository acceptance/lock."
  },
  "constraints": {
    "invariants": [
      {
        "id": "UNIVERSAL_DOMAIN_COMPOSITION",
        "rule": "Universal Modules are reusable substrates and Domains are explicit compositions of those substrates plus domain-specific deltas; composition never duplicates substrate ownership."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "substrate semantic owner missing/conflicting",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "Domain required substrate unresolved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "copied substrate accepted as duplicate authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "dependency cycle unvalidated",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "missing module silently invented/auto-enabled",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "repository accepted with closure failure",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_VALID",
      "target_ref": "AIGMOS_COMPOSITION_VALIDATION_CONTRACT",
      "purpose": "Universal/Domain closure specializes composition validation."
    }
  ],
  "prose": {
    "summary": "Define repository-wide closure validation for Universal Module substrates and Domain compositions, including owner uniqueness, unresolved refs, duplicate semantics and circular dependency safety.",
    "notes": [
      "Unlocked pending reconciliation against existing universal_module/domain contracts and whole-tree Contract Format 1.4 validation."
    ]
  },
