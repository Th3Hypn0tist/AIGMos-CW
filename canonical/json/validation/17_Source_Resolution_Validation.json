    }
  ],
  "behavior": {
    "states": [],
    "interfaces": [],
    "operations": [],
    "events": [],
    "flows": []
  },
  "semantics": {
    "checks": [
      "bootstrap source exactness",
      "canonical tree root",
      "source-role completeness",
      "same-identity conflict detection",
      "active/historical separation",
      "candidate/accepted separation",
      "local/package normalized equivalence",
      "source provenance"
    ],
    "bootstrap_rule": "Format bootstrap source and canonical tree source are validated as separate layers.",
    "conflict_rule": "Ambiguous active same-identity sources hard-fail.",
    "precedence_rule": "No precedence may depend only on mtime/path/archive ordering.",
    "equivalence_rule": "Where both carriers exist, same accepted snapshot must normalize equivalently.",
    "evidence_rule": "Validation report records exact selected/rejected source artifacts and reason.",
    "release_rule": "Unresolved source-resolution failures block repository acceptance/release."
  },
  "constraints": {
    "invariants": [
      {
        "id": "SOURCE_RESOLUTION_DETERMINISTIC",
        "rule": "Canonical source resolution is deterministic, exact-identity based and provenance-preserving; filesystem location, transport or freshness never silently changes semantic authority."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "ambiguous active source accepted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "source role missing",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "precedence relies on freshness/path/archive order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "local/package divergence ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "validation cannot explain selected source authority",
        "result": "hard_fail"
      },
      {
        "id": "GATE_6",
        "condition": "repository accepted with unresolved source-resolution failure",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_REG",
      "target_ref": "AIGMOS_CANONICAL_SOURCE_REGISTRY_CONTRACT",
