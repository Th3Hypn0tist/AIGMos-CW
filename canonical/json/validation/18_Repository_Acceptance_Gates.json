    "mandatory_gates": [
      "Contract Format/bootstrap validation",
      "identity uniqueness",
      "source-role/source-resolution closure",
      "Topic coverage/composition closure",
      "reference closure",
      "ownership/authority/dependency validity",
      "schema/relation validity",
      "namespace/root completeness",
      "UserModule type compatibility",
      "composition non-duplication",
      "local/package source equivalence",
      "roundtrip/conformance profile as required"
    ],
    "fail_rule": "Any mandatory hard-fail blocks acceptance.",
    "warning_rule": "Warnings may remain only where the owning profile explicitly permits them.",
    "evidence_rule": "Each gate emits machine-readable pass/fail evidence.",
    "profile_rule": "Acceptance profile/version is explicit.",
    "determinism_rule": "Same candidate snapshot/profile produces the same acceptance result.",
    "status_rule": "Acceptance validation does not itself change contract status or replace the tree."
  },
  "constraints": {
    "invariants": [
      {
        "id": "ACCEPTANCE_EXPLICIT",
        "rule": "Candidate canonical trees become accepted/locked only through explicit reproducible validation and clean replacement; review state, acceptance state and runtime activation remain distinct."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "mandatory hard-fail ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "acceptance profile unspecified",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "same snapshot/profile yields nondeterministic result",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "gate result lacks machine-readable evidence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "validation silently changes accepted tree",
        "result": "hard_fail"
      }
    ]
  },
