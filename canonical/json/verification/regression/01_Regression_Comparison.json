  "semantics": {
    "base_rule": "Exact regression baseline is referenced.",
    "candidate_rule": "Exact candidate target/test result is referenced.",
    "comparison_rule": "Per-check byte/semantic/performance equivalence criteria are explicit.",
    "allowed_rule": "Known intended changes are explicitly declared and reviewed.",
    "finding_states": [
      "unchanged",
      "improved",
      "intended_change",
      "regression",
      "unknown"
    ],
    "unknown_rule": "Uncomparable/unknown result never silently passes.",
    "authority_rule": "No-regression result does not itself release/deploy."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "all differences marked regression despite declared semantic profile",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "unknown comparison treated unchanged",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "intended change auto-approved",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "baseline selected by timestamp",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "no regression auto-deploys",
        "result": "hard_fail"
      }
    ]
  },
