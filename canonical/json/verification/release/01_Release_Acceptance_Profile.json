    "unknown_rule": "Missing/unknown required evidence blocks acceptance.",
    "authorization_rule": "Profile pass does not substitute for release approval authority.",
    "deployment_rule": "Release acceptance remains separate from deployment."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "all tests optional by default",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "missing security evidence ignored",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "acceptance profile inferred from version number",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "profile pass deploys automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "unknown requirement treated pass",
        "result": "hard_fail"
      }
    ]
