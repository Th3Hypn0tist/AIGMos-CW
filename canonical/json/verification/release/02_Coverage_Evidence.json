    "identity_rule": "Each coverage evaluation has explicit identity.",
    "dimensions": [
      "contracts",
      "operations",
      "states",
      "branches",
      "error_paths",
      "authorization_rules",
      "protocol_routes",
      "migrations",
      "security_boundaries",
      "other declared dimension"
    ],
    "source_rule": "Coverage derives from exact test suite/run/result mapping.",
    "percentage_rule": "Numeric coverage is descriptive evidence, not correctness proof.",
    "gap_rule": "Untested required semantics are explicit gaps.",
    "risk_rule": "Risk/criticality-weighted coverage may be explicit.",
    "authority_rule": "Coverage threshold pass grants no deployment rights."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "100 percent coverage claimed proof of correctness",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "untested destructive path hidden",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "coverage mapped by filename only",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "skipped tests counted covered",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "coverage pass auto-releases",
        "result": "hard_fail"
      }
    ]
  },
