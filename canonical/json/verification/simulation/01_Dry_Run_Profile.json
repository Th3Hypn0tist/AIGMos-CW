    "identity_rule": "Each reusable dry-run profile has explicit identity.",
    "operation_rule": "Supported operation identities are exact.",
    "effect_rule": "Which validations/resolutions/planning/external calls are executed is explicit.",
    "noeffect_rule": "No-effect guarantee applies only when the exact operation/profile declares it.",
    "result_rule": "Dry-run produces predicted/candidate evidence distinct from real execution result.",
    "destructive_rule": "Destructive dry-run never performs destructive effect.",
