        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "predicted result shown accepted result",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "destructive preview deletes target",
        "result": "hard_fail"
      },
