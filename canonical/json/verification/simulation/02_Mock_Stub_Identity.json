  "semantics": {
    "identity_rule": "Each test double has an explicit identity/version.",
    "target_rule": "Emulated real dependency identity/interface is exact.",
    "behavior_rule": "Response/state/failure behavior is explicit.",
    "compatibility_rule": "Mock compatibility surface is explicit and cannot imply complete equivalence.",
    "network_rule": "Mock endpoint binding is test environment metadata.",
    "label_rule": "Mock must remain identifiable as non-production.",
    "authority_rule": "Mock behavior/credentials grant no production authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "mock endpoint accidentally selected in production",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "mock claimed full semantic equivalence",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "fake credential reused in prod",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "nearest service name selects mock",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "test result hides mock use",
        "result": "hard_fail"
      }
    ]
  },
