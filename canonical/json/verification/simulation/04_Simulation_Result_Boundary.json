  "semantics": {
    "identity_rule": "Each simulation result has explicit evidence identity.",
    "run_rule": "Result references exact sandbox/dry-run/mock/fault test execution.",
    "target_rule": "Simulated target/profile is explicit.",
    "status_rule": "Simulation success/failure is distinct from production success/failure.",
    "payload_rule": "Predicted changes/results are inert.",
    "comparison_rule": "Simulation may be compared to later real execution through explicit comparison evidence.",
    "authority_rule": "Simulation result cannot be used as proof an effect actually occurred."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "dry-run result marked actual write",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "simulation changes production status",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "predicted hash stored as real artifact hash",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "mock result treated live endpoint result",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "simulation success triggers follow-up effect",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_DRY",
      "target_ref": "AIGMOS_DRY_RUN_PROFILE_CONTRACT",
      "purpose": "Dry-run results remain simulated evidence."
    }
  ],
  "prose": {
    "summary": "Define predicted/simulated observations as evidence distinct from real operation results and prohibit simulated success from mutating production state.",
    "notes": [
      "Unlocked pending whole-tree reconciliation and Contract Format 1.4 validation."
    ]
  },
