    "identity_rule": "Each suite has an explicit identity/version.",
    "member_rule": "Suite members are exact test case refs.",
    "order_rule": "Execution order is explicit only where semantically required.",
    "dependency_rule": "Test dependencies/setup dependencies are explicit.",
    "parallel_rule": "Parallelizability/isolation requirements are explicit.",
    "threshold_rule": "Suite pass/fail/partial criteria are explicit.",
    "authority_rule": "Suite membership does not change test or target ownership."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "directory contents define suite silently",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "file order determines dependent test order",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "one passing test masks failures without threshold policy",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "suite owns target semantics",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "suite pass grants release automatically",
        "result": "hard_fail"
      }
    ]
  },
