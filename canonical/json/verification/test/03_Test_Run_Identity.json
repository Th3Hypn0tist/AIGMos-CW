  "semantics": {
    "identity_rule": "Each test run has a distinct execution identity.",
    "test_rule": "Exact test case/suite revision is referenced.",
    "target_rule": "Exact target artifact/runtime/config revision is referenced.",
    "environment_rule": "Environment/tool/backend/profile revisions are explicit.",
    "time_rule": "Start/end timestamps are evidence only.",
    "isolation_rule": "Isolation/sandbox mode is explicit.",
    "result_rule": "Run produces separate result evidence.",
    "authority_rule": "Running a test does not authorize unrelated production operations."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "test result reused across target versions",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "environment omitted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "run identity reused as test definition identity",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "timestamp proves target revision",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "test runner gets universal production rights",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_SUITE",
      "target_ref": "AIGMOS_TEST_SUITE_IDENTITY_CONTRACT",
      "purpose": "Runs instantiate exact suites/cases."
    }
  ],
