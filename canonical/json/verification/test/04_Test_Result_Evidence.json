  "semantics": {
    "identity_rule": "Each result has an explicit evidence identity.",
    "run_rule": "Result references exact test run.",
    "states": [
      "pass",
      "fail",
      "skip",
      "error",
      "partial",
      "unknown"
    ],
    "assertion_rule": "Individual assertion/check results are explicit.",
    "observation_rule": "Observed values/events/results retain exact source/context refs where applicable.",
    "failure_rule": "Error, fail and skip remain semantically distinct.",
    "history_rule": "Results are historical evidence and are never rewritten into a new run's result.",
    "authority_rule": "Pass result grants no production authority."
  },
  "constraints": {
    "invariants": [
      {
        "id": "TEST_NONAUTHORITY",
        "rule": "Test definitions, fixtures, results, coverage, simulations and release evidence never become production semantic authority or grant production execution rights merely by existing or passing."
      },
      {
        "id": "EVIDENCE_REPRODUCIBILITY",
        "rule": "Verification evidence binds exact test/profile/source/runtime revisions and declared environment inputs so a pass/fail result cannot silently float across unrelated versions or targets."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "skipped test counted pass",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "old result relabeled for new version",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "failed assertion hidden by final status",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "result becomes source truth",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "pass grants deployment rights",
        "result": "hard_fail"
      }
    ]
  },
  "references": [
    {
      "id": "REF_RUN",
      "target_ref": "AIGMOS_TEST_RUN_IDENTITY_CONTRACT",
      "purpose": "Results bind exact test executions."
    }
  ],
  "prose": {
    "summary": "Define immutable pass/fail/skip/error/partial verification evidence with exact observations, assertions and run/target provenance.",
