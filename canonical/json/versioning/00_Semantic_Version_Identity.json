    "identity_rule": "Stable semantic identity and version/revision are separate fields.",
    "version_rule": "Version syntax/profile is explicit.",
    "compatibility_rule": "Version ordering alone does not prove semantic compatibility.",
    "revision_rule": "Content revision may change while preserving compatible identity semantics.",
    "breaking_rule": "Breaking semantic change follows explicit new-identity/evolution rule.",
    "authority_rule": "Higher version has no runtime authority/preference by itself."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
    "hard_gates": [
      {
        "id": "GATE_1",
        "condition": "highest version automatically trusted",
        "result": "hard_fail"
      },
      {
        "id": "GATE_2",
        "condition": "version number changes identity always",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "version order means compatible",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "newer wins conflicts automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_5",
        "condition": "version grants authority",
        "result": "hard_fail"
      }
    ]
  },
