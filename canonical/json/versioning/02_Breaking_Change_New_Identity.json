  "semantics": {
    "breaking_rule": "Semantic incompatibility that cannot preserve prior meaning requires an explicit new canonical identity.",
    "migration_rule": "Old→new migration/mapping may be declared separately.",
    "alias_rule": "Legacy alias may point to new identity only with explicit compatibility/migration semantics.",
    "history_rule": "Old identity remains historically interpretable.",
    "version_rule": "Merely incrementing a version is insufficient when identity meaning breaks.",
    "authority_rule": "New identity does not inherit old runtime/AccessCore rights automatically."
  },
  "constraints": {
    "invariants": [
      {
        "id": "PACKAGE_IDENTITY_INTEGRITY",
        "rule": "Package, artifact, module, certification, license and installed-instance identities remain distinct; hashes prove content integrity only within their declared profile and never grant runtime authority."
      },
      {
        "id": "ENTITLEMENT_NONAUTHORITY",
        "rule": "License or certification entitlement permits declared product/service use only; it never substitutes for IAM identity, AccessCore authorization, runtime validation or dispatcher gating."
      }
    ],
