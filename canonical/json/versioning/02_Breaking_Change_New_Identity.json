        "condition": "new identity inherits rights automatically",
        "result": "hard_fail"
      },
      {
        "id": "GATE_3",
        "condition": "old identity deleted from history",
        "result": "hard_fail"
      },
      {
        "id": "GATE_4",
        "condition": "alias masks incompatibility",
        "result": "hard_fail"
      },
      {
